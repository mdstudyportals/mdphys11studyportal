    if (j === npAt(s)){ s.el.currentTime = 0; s.el.play().catch(function(){}); return; }
    if (npIsPl(s)){ plLoad(s, j, true, s === NP); return; }
    if (s === CUR && cur === s.i){ npAuto = j; show(j); return; }
    if (s !== NP) return;
    npGo(s, j);
  }
  function npQueue(){
    var q = $("npQ"); if (!NP) return;
    if (npIsPl(NP)){
      var pp = pages[NP.i];
      q.innerHTML = '<div class="qh">Up next · ' + esc(pp.t) + '</div>' + pp.tr.map(function(t, j){
        return '<button type="button" data-qt="' + j + '" class="' + (j === NP.tr ? "now" : "") + '"><span class="n">' + (j === NP.tr ? "♪" : j + 1) + '</span><span>' + esc(t.t) + '</span></button>'; }).join("");
      return;
    }
