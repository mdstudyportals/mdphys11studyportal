  } catch(e){}
  if (!out.ar && out.aa) out.ar = out.aa; delete out.aa;
  if (out.cm && out.ar && out.cm.toLowerCase() === out.ar.toLowerCase()) delete out.cm;
  return out.t || out.ar || out.cm || out.al ? out : null;
}
// Title (and artist, for "Artist - Title") from a file name: no track numbers, underscores, download-site prefixes or bitrates
function audioName(n){
  var s = String(n || "").replace(/^.*[\/\\]/, ""); try { s = decodeURIComponent(s); } catch(e){}
  s = s.replace(/\.[a-z0-9]{2,5}$/i, "").replace(/_+/g, " ").replace(/\s+/g, " ").trim();
  s = s.replace(/^(y2mate(\.com)?|ytmp3(\.cc)?|mp3juices|savefrom(\.net)?|ytmate|x2convert|flvto)\s*[-–—:]\s*/i, "");
  s = s.replace(/[\s(\[]*\b(128|160|192|256|320)\s*kbps\b[)\]]?$/i, "").replace(/\s*[(\[](official\s*(music\s*)?(video|audio)|lyrics?(\s*video)?|audio|hd|hq|4k|visuali[sz]er)[)\]]\s*/ig, " ").trim();
  s = s.replace(/^\(?\d{1,3}\)?(\s*[-.)]\s*|\s+)(?=\S)/, "");                 // track number
  if (!/\s/.test(s) && /[-.]/.test(s)) s = s.replace(/[-.]+/g, " ").trim();   // "rain-focus" → "rain focus"
  if (/^[a-z]/.test(s)) s = s.charAt(0).toUpperCase() + s.slice(1);
  var m = /^(.+?)\s+[-–—]\s+(.+)$/.exec(s);
  if (m && !/^\d+$/.test(m[1]) && m[1].length <= 60) return {ar: m[1].trim(), t: m[2].trim()};
  return {t: s || String(n || "")};
}

  // artist and composer under a track's title
  function trBy(t){ return [t.ar || "", t.cm && t.cm !== t.ar ? "Composer: " + t.cm : ""].filter(Boolean).join(" · "); }
  // Online songs: the portal reads each song's own tags once it has the file (kept for offline), so a playlist whose titles are
  // only file names ("rain-focus") shows the real title, artist and composer. Titles the instructor typed are kept.
  ML.tags = null;
  async function mlTagsLoad(){ if (!ML.tags) ML.tags = (await mlGet("lists", "#tags")) || {}; return ML.tags; }
  function mlFileLike(t, src){
    var stem = String(src || "").replace(/[?#].*$/, "").replace(/^.*\//, ""); try { stem = decodeURIComponent(stem); } catch(e){}
    stem = stem.replace(/\.[a-z0-9]{2,5}$/i, ""); var a = String(t || "").trim().toLowerCase(), b = stem.toLowerCase();
    return !a || /\.(mp3|m4a|aac|ogg|oga|opus|wav|flac)$/i.test(a) || a === b ? 2 : a === b.replace(/[-_]+/g, " ").trim() ? 1 : 0;
  }
  function mlApply(tr){
    var T = ML.tags || {};
    tr.forEach(function(t){
      var g = T[t.src] || null;
      if (mlFileLike(t.t, t.src)){
        if (g && g.t) t.t = g.t;                                            // the song's own title
        else if (mlFileLike(t.t, t.src) === 2){ var n = audioName(t.src); t.t = n.t || t.t; if (!t.ar && n.ar && !g) t.ar = n.ar; }   // only a raw file name is tidied
      }
      if (g){ if (!t.ar && g.ar) t.ar = g.ar; if (!t.cm && g.cm) t.cm = g.cm; }
    });
    return tr;
  }
  async function mlReadTags(L){                                             // tags of the songs on this device not read yet
    var T = await mlTagsLoad(), got = false;
    for (var j = 0; j < L.tr.length; j++){
      var src = L.tr[j].src; if (T[src] !== undefined) continue;
      var b = await mlGet("files", src); if (!b) continue;
      T[src] = (await audioTags(b)) || 0; got = true;
    }
    if (got) await mlPut("lists", "#tags", T).catch(function(){});
    return got;
  }
  async function mlFetchList(base){                                          // playlist.json (from Portal Builder) or the list inside the page
    var raw = null;
    try { var r = await fetch(base + "playlist.json?t=" + Date.now(), {cache: "no-store"}); if (r.ok) raw = await r.json(); } catch(e){}
    if (!raw){
      var h = await (await fetch(base + "?t=" + Date.now(), {cache: "no-store"})).text();
      var mt = /var\s+TITLE\s*=\s*("(?:[^"\\]|\\.)*")/.exec(h), mk = /var\s+TRACKS\s*=\s*(\[[\s\S]*?\n\s*\]);/.exec(h); if (!mk) throw new Error("no list");
      var js = mk[1]; try { raw = {tracks: JSON.parse(js)}; } catch(e){ raw = {tracks: JSON.parse(js.replace(/([{,]\s*)([A-Za-z_]\w*)\s*:/g, '$1"$2":').replace(/,\s*([}\]])/g, "$1"))}; }
      if (mt) try { raw.title = JSON.parse(mt[1]); } catch(e){}
      var mlg = /var\s+LOGO\s*=\s*("(?:[^"\\]|\\.)*")/.exec(h); if (mlg) try { raw.logo = JSON.parse(mlg[1]); } catch(e){}
    }
    var tr = (raw.tracks || []).filter(function(t){ return t && t.file; }).map(function(t){ var u = new URL(t.file, base).href; return {t: String(t.title || t.file), ar: String(t.artist || ""), cm: String(t.composer || ""), d: +t.d || 0, m: mlMime(u), src: u}; });
    if (!tr.length) throw new Error("empty");
    var lg = "", lga = ""; try { if (raw.logo && /\.(png|jpe?g|webp|gif|svg)$/i.test(String(raw.logo))) lg = new URL(raw.logo, base).href; if (raw.logoAnim && /\.svg$/i.test(String(raw.logoAnim))) lga = new URL(raw.logoAnim, base).href; } catch(e){}
    return {title: raw.title || "", tr: tr, logo: lg, logoAnim: lga, at: Date.now()};
  }
  async function mlLogo(p, L){                                               // a GitHub playlist's logo, from this device when kept
    var u = L && L.logo || ""; if (p.lgSrc === u && (p.lgU || !u)) return false;
    if (p.lgU && /^blob:/.test(p.lgU)) URL.revokeObjectURL(p.lgU);
    var b = u ? await mlGet("files", u) : null; p.lgSrc = u; p.lgU = b ? URL.createObjectURL(b) : u;
    if (p.lgaU && /^blob:/.test(p.lgaU)) URL.revokeObjectURL(p.lgaU);
    var ua = L && L.logoAnim || "", ba = ua ? await mlGet("files", ua) : null; p.lgaU = ba ? URL.createObjectURL(new Blob([ba], {type: "image/svg+xml"})) : ua; return true;
  }
  async function mlLoadAll(){                                               // the lists kept on this device, ready before anything opens
    for (var i = 0; i < pages.length; i++){ var p = pages[i]; if (!p.ml) continue; var L = await mlGet("lists", p.ml); if (L && L.tr){ p.tr = L.tr; await mlLogo(p, L); } }
    if (navigator.onLine !== false) pages.forEach(function(p, i){ if (p.ml && p.tr.length) mlSync(i, false); });   // keep saved playlists current
  }
  async function mlSync(i, show){                                           // new list from GitHub + save its songs for offline
    var p = pages[i]; if (!p || !p.ml || ML.busy[p.ml]) return; ML.busy[p.ml] = 1;
    try {
      var L = await mlFetchList(p.ml); await mlTagsLoad(); mlApply(L.tr);
      var changed = JSON.stringify(L.tr.map(function(t){ return [t.src, t.t, t.ar, t.cm]; })) !== JSON.stringify(p.tr.map(function(t){ return [t.src, t.t, t.ar, t.cm]; }));
      L.tr.forEach(function(t){ var o = p.tr.filter(function(x){ return x.src === t.src; })[0]; if (o && o.d) t.d = o.d; });
      await mlPut("lists", p.ml, L).catch(function(){});
      var playing = (CUR && CUR.i === i && npPlaying(CUR)) || (NP && NP.i === i && npPlaying(NP));
      if (changed && !playing){ p.tr = L.tr; if (cur === i) mlView(i); } else if (changed) p.tr = L.tr;
      var miss = [];
      for (var j = 0; j < L.tr.length; j++) if (!(await mlGet("files", L.tr[j].src))) miss.push(L.tr[j]);
      var gone = [];
      for (var k = 0; k < miss.length; k++){
        ML.st[p.ml] = {n: k, of: miss.length}; if (cur === i) mlStatus(i);
        var r = null; try { r = await fetch(miss[k].src); } catch(e){ if (navigator.onLine === false) throw e; }
        if (!r || !r.ok){ gone.push(miss[k].src); continue; }                // the playlist was reached, so this song isn't online
        var b = await r.blob(); await mlPut("files", miss[k].src, new Blob([b], {type: miss[k].m}));
      }
      ML.st[p.ml] = gone.length ? {gone: gone} : null;
      if (L.logo && !(await mlGet("files", L.logo))){ try { var rl = await fetch(L.logo); if (rl.ok) await mlPut("files", L.logo, await rl.blob()); } catch(e){} }
      if (L.logoAnim && !(await mlGet("files", L.logoAnim))){ try { var ra = await fetch(L.logoAnim); if (ra.ok) await mlPut("files", L.logoAnim, await ra.blob()); } catch(e){} }
      p.lgSrc = null; await mlLogo(p, L);
      if (cur === i && !((CUR && CUR.i === i && npPlaying(CUR)) || (NP && NP.i === i && npPlaying(NP)))){ var cv = document.querySelector(".plv .plcov"); if (cv && plOwn(p) && (!cv.querySelector("img") || cv.querySelector("img").getAttribute("src") !== plOwn(p))) mlView(i); }
      if (await mlReadTags(L)){                                             // titles, artists and composers from the songs themselves
        mlApply(L.tr); await mlPut("lists", p.ml, L).catch(function(){});
        L.tr.forEach(function(t){ p.tr.forEach(function(x){ if (x.src === t.src){ x.t = t.t; x.ar = t.ar; x.cm = t.cm; } }); });
        var busy = (CUR && CUR.i === i && npPlaying(CUR)) || (NP && NP.i === i && npPlaying(NP));
        if (cur === i && !busy) mlView(i);
      }
      await mlGc();
    } catch(e){ ML.st[p.ml] = {err: /quota|space|storage/i.test(String(e && (e.name + e.message))) ? "space" : "net"}; }
    finally { delete ML.busy[p.ml]; if (cur === i) mlStatus(i); }
  }
  async function mlGc(){                                                    // songs no playlist uses any more
    var keep = {}, lists = await mlKeys("lists");
    for (var k = 0; k < lists.length; k++){ var L = await mlGet("lists", lists[k]); (L && L.tr || []).forEach(function(t){ keep[t.src] = 1; }); if (L && L.logo) keep[L.logo] = 1; if (L && L.logoAnim) keep[L.logoAnim] = 1; }
    var files = await mlKeys("files");
    for (var f = 0; f < files.length; f++) if (!keep[files[f]]) await mlPut("files", files[f], null).catch(function(){});
    var T = await mlTagsLoad(), drop = Object.keys(T).filter(function(s){ return !keep[s]; }); if (drop.length){ drop.forEach(function(s){ delete T[s]; }); await mlPut("lists", "#tags", T).catch(function(){}); }
  }
  async function mlTrack(i, j){
    var p = pages[i], t = p.tr[j], key = "ml" + t.src; if (cache[key]) return cache[key];
    var b = await mlGet("files", t.src);
    if (!b){ if (navigator.onLine === false) throw new Error("offline"); var r = null; try { r = await fetch(t.src); } catch(e){} if (!r || !r.ok) throw new Error("missing"); b = new Blob([await r.blob()], {type: t.m}); mlPut("files", t.src, b).catch(function(){}); }
    var o = {blob: b, url: URL.createObjectURL(b)}; cache[key] = o; return o;
  }
  async function mlStatus(i){
    var p = pages[i], el = $("mlSt"); if (!el || !p || !p.ml) return;
    var st = ML.st[p.ml], have = 0, bytes = 0;
    for (var j = 0; j < p.tr.length; j++){ var b = await mlGet("files", p.tr[j].src); if (b){ have++; bytes += b.size; } }
    var off = navigator.onLine === false;
    el.innerHTML = st && st.of ? "Saving on this device for offline… " + (st.n + 1) + " of " + st.of :
      st && st.err === "space" ? "<b>This device is out of space</b> — some songs couldn't be kept for offline." :
      have && have === p.tr.length ? (off ? "Offline — playing the copy kept on this device." : "✓ Kept on this device — plays offline too (" + size(bytes) + "). Updates from your instructor when you're online.") :
      off ? (have ? have + " of " + p.tr.length + " songs kept on this device — the others need internet." : "Play this playlist once with internet to keep it on this device for offline.") :
      st && st.gone ? (user && user.inst ? "<b>" + st.gone.length + " of " + p.tr.length + " songs aren't in your music repository</b> (e.g. <code>" + esc(st.gone[0].replace(/^https?:\/\/[^\/]+/, "")) + "</code>) — upload its <b>music</b> folder; Portal Builder's <b>Check what's on GitHub</b> lists what's missing." : (st.gone.length >= p.tr.length ? "These songs aren't online yet — your instructor is adding them." : st.gone.length + " of " + p.tr.length + " songs aren't online yet — your instructor is adding them. The others play.")) :
      st && st.err ? "Couldn't update this playlist just now — it plays what's kept on this device." : have + " of " + p.tr.length + " songs kept on this device.";
  }
  async function mlOpen(i){
    var p = pages[i], v = $("view");
    if (!p.tr.length){
      v.hidden = false;
      if (navigator.onLine === false){ v.innerHTML = '<div class="linkwrap"><div class="linkcard"><span class="big">' + ic("playlist") + '</span><div class="lt"><b>' + esc(p.t) + '</b><span>Music playlist</span></div></div><p class="lnote">You\'re offline. Play this playlist once with internet and it\'s kept on this device, so it plays offline after that.</p></div>'; return; }
      v.innerHTML = '<div class="linkwrap"><p class="lnote">Getting the playlist…</p></div>';
      try { var L = await mlFetchList(p.ml); await mlTagsLoad(); mlApply(L.tr); p.tr = L.tr; await mlPut("lists", p.ml, L).catch(function(){}); await mlLogo(p, L); }
      catch(e){
        var nf = /no list|empty/.test(e && e.message || "");                // the address answered, but there is no playlist there
        v.innerHTML = '<div class="linkwrap"><p class="lnote">' + (nf ? "This playlist wasn't found at its online address." + (user && user.inst ? ' Check that the playlist\'s folder (with its index.html and playlist.json) is uploaded to your music repository, that the repository is Public with Pages turned on, and that this address is right: <code>' + esc(p.ml) + '</code>' : " Let your instructor know.") : "This playlist couldn't be reached just now. Check the internet connection and try again.") + '</p></div>';
        return;
      }
      if (cur !== i) return;
    }
    mlView(i);
    if (navigator.onLine !== false) mlSync(i, true);
  }
  function mlView(i){                                                       // the playlist, marked as online music, with its offline status
    plView(i); var v = $("view");
    var hd = v.querySelector(".plhd > div:last-child"); if (hd && !$("mlSt")) hd.insertAdjacentHTML("beforeend", '<div class="mlst" id="mlSt"></div>');
    var k = v.querySelector(".plk"); if (k) k.textContent = "Music playlist";
    mlStatus(i);
  }

  function startApp(){
    pages.forEach(function(p){ if (mlIs(p)){ p.ml = mlBase(p.u); p.k = "playlist"; p.tr = []; p.rq = null; p.e = ""; } });
    if (pages.some(function(p){ return p.ml; })) mlLoadAll();
    $("login").hidden = true; $("app").hidden = false; closePop();
    $("aTitle").textContent = D.title || "Portal";
    $("aSub").textContent = D.subtitle || "";
    var label = user.inst ? "<b>Instructor</b><br>" + (user.n ? user.n + " students" : "all materials") : user.name ? "<b>"+esc(user.name)+"</b><br>"+esc(user.sn) : "<b>"+esc(user.sn)+"</b><br>"+esc(user.em);
    $("who").innerHTML = label;
    var html = '<div class="navwho">' + label + '</div>', lastG = null, lastT = null, folded = tgFolded();
    pages.forEach(function(p, i){
      var g = (p.g || "").trim(), t = tgOf(p), tk = t ? "t" + t.k : null;
      if (tk !== lastT){
        if (lastT) html += '</div></div></div>';
        if (t){ var cnt = pages.filter(function(x){ var y = tgOf(x); return y && y.k === t.k; }).length;
          html += '<div class="tg' + (folded.indexOf(t.n) > -1 ? " fold" : "") + '" data-tg="' + esc(t.n) + '"><button type="button" class="tghd" aria-expanded="' + (folded.indexOf(t.n) > -1 ? "false" : "true") + '"><span>' + esc(t.n) + '</span><span class="tgn">' + cnt + '</span><span class="tgc">▾</span></button><div class="tgw"><div class="tgb">'; }
        lastT = tk; lastG = null;
      }
      if (g !== lastG){ if (g) html += '<div class="grp">' + esc(g) + '</div>'; lastG = g; }
      html += '<button class="item" data-i="' + i + '">' + (p.k === "portal" ? psIcon(p) : ic(p.k === "link" ? (IC[p.ico] ? p.ico : "link") : IC[p.k] ? p.k : "file")) + '<span>' + esc(p.t || ("Item " + (i+1))) + '</span></button>';
    });
    if (lastT) html += '</div></div></div>';
    if (SC && pages.some(function(p){ return p.sc; })) html += '<div class="scstat ok" id="scStatus"></div>';
    if (!user.inst) html += '<div class="navvis" id="navVis" hidden></div>';
    html += '<div class="khint">Shortcuts: <kbd>N</kbd> next · <kbd>P</kbd> previous · <kbd>F</kbd> full screen' + (D.ink !== false ? ' · <kbd>A</kbd> annotate' : '') + ' · <kbd>?</kbd> more</div>';
    $("nav").innerHTML = html;
    visCount(); paintBadges(); flushScores(); fmStart(); navCascade(); psPinsPaint(); wnStart(); upStart(); todStart(); synStart();
    if (D.watermark) paintWatermark();
    if (pages.length) show(0); else { $("empty").hidden = false; $("pTitle").textContent = ""; }
  }

  function paintWatermark(){
    var t = [user.name, user.sn, user.em].filter(Boolean).join("  ·  ");
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="460" height="220"><text x="20" y="130" transform="rotate(-22 230 110)" font-family="Arial,sans-serif" font-size="15" fill="#808080" fill-opacity="0.2">' + esc(t) + '</text></svg>';
    $("wm").style.backgroundImage = 'url("data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg) + '")';
  }

  // ---------- content loading ----------
  async function domReady(){
    if (document.readyState === "loading"){
      $("loadTxt").textContent = "Still loading the portal file…";
      await new Promise(function(r){ document.addEventListener("DOMContentLoaded", r, {once:true}); });
    }
  }
  async function getTrack(i, j, prog){                                       // one track of a playlist (its own pieces: c<item>t<track>_<n>)
    var p = pages[i], tr = p.tr && p.tr[j]; if (!tr) throw new Error("This track is missing.");
    if (p.ml) return mlTrack(i, j);
    var pre = tr.rp || ("c" + p.a + "t" + j), key = "k" + pre; if (cache[key]) return cache[key];   // a song shared by several playlists is stored (and opened) once
    await domReady();
    var blob = await loadPieces(pre, tr.c, tr.m, false, prog);
    var o = {blob: blob, url: URL.createObjectURL(blob)};
    cache[key] = o; return o;
  }
  async function loadPieces(pre, count, mime, gz, prog){
    var parts = [];
    for (var n=0;n<count;n++){
      var cid = pre + "_" + n, el = document.getElementById(cid), t = el ? el.textContent : "";
      if (!el && typeof window.PORTAL_CHUNK === "function") t = await window.PORTAL_CHUNK(cid);
      if (!t) throw new Error("This item is missing from the portal file. The download may be incomplete.");
      var dot = t.indexOf(".");
      parts.push(new Blob([await dec(CK, {iv: t.slice(0, dot), ct: t.slice(dot + 1)})]));
      t = "";
      if (prog) prog((n + 1) / count);
      if (n % 4 === 3) await tick();
    }
    var blob = new Blob(parts, {type: mime || "application/octet-stream"});
    if (gz) blob = new Blob([await gunzipBlob(blob)], {type: mime});
    return blob;
  }
  async function getAsset(i, prog){
    if (cache[i]) return cache[i];
    var p = pages[i], o;
    if (p.inline != null){
      o = {text: p.inline};
    } else {
      await domReady();
      var parts = [];
      for (var n=0;n<p.c;n++){
        var cid = (p.rp || ("c" + p.a)) + "_" + n, el = document.getElementById(cid), t = el ? el.textContent : "";
        // Opened through the Portal Opener: the materials are kept on the device piece by piece and fetched only when needed
        if (!el && typeof window.PORTAL_CHUNK === "function") t = await window.PORTAL_CHUNK(cid);
        if (!t) throw new Error("This item is missing from the portal file. The download may be incomplete.");
        var dot = t.indexOf(".");
        parts.push(new Blob([await dec(CK, {iv: t.slice(0, dot), ct: t.slice(dot + 1)})]));   // each piece handed over as it is unlocked: lower peak memory
        t = "";
        if (prog) prog((n + 1) / p.c);
        if (n % 4 === 3) await tick();
      }
      var blob = new Blob(parts, {type: p.m || "application/octet-stream"});
      if (p.gz) blob = new Blob([await gunzipBlob(blob)], {type: p.m});
      o = {blob: blob, url: URL.createObjectURL(blob)};
      if (p.k === "html") o.text = await blob.text();
    }
    cache[i] = o;
    return o;
  }
  function evict(keep){
    Object.keys(cache).forEach(function(k){
      var o = cache[k], tm = /^(\d+)t(\d+)$/.exec(k);
      if (tm){                                                              // playlist tracks: keep only the ones now playing
        if ([NP, CUR].some(function(x){ return x && x.i === +tm[1] && x.tr === +tm[2]; })) return;
        URL.revokeObjectURL(o.url); delete cache[k]; return;
      }
      if (+k !== keep && !(NP && NP.i === +k) && !(CUR && CUR.i === +k) && o.blob && o.blob.size > 25*1048576){ URL.revokeObjectURL(o.url); delete cache[k]; }
    });
  }

  // ---------- practice score recording ----------
  // Scored items (quick checks, mock tests) report "points / total". Results are kept on this device and sent to the
  // instructor's Google Sheet whenever the device is online; the sheet keeps each student's best attempt.
  // Practice-mode results can be skipped, and a study file holding several tests (Mock Test 1, Mock Test 2…) reports each separately.
  var SC = null, scoreSess = {}, sending = false, scState = "", skipToldAt = {};
  var SC_PREFIX = "portal-scores:" + (D.id || "x") + ":";
  function scKey(){ return SC_PREFIX + normSN(user.sn); }
  function scLoad(k){ try { var o = JSON.parse(localStorage.getItem(k || scKey())) || {}; o.latest = o.latest || {}; o.queue = o.queue || []; return o; } catch(e){ return {latest:{}, queue:[]}; } }
  function scStore(o, k){ try { localStorage.setItem(k || scKey(), JSON.stringify(o)); return true; } catch(e){ return false; } }
  function itemKey(p){ return String(p.t || "").trim().toLowerCase(); }
  function newSess(){ return {attempt: rid(), last: null, hooked: false, opened: Date.now(), start: null, mark: null, n: 0}; }
  function rid(){ var a = crypto.getRandomValues(new Uint8Array(9)); return Array.prototype.map.call(a, function(b){ return (b % 36).toString(36); }).join(""); }
  function tidy(s){ return String(s).replace(/\s+/g, " ").trim().replace(/\b([a-z])/g, function(m){ return m.toUpperCase(); }).replace(/\b([ivx]{1,4})\b/gi, function(m){ return m.toUpperCase(); }); }

  // Test codes (no spaces): <base><kind><n>, e.g. L2MDPHYS11QC1, L2MDPHYS11MT2, L11MDPHYS11ME1
  //   base = L<lesson no.><subject code> (set per item in Portal Builder) · QCn = quick checks of Part n combined · MTn/MEn = Mock Test/Exam n
  function romanNum(s){ var v = {i:1,v:5,x:10}, t = 0, a = String(s).toLowerCase(); for (var k=0;k<a.length;k++){ var c = v[a[k]] || 0, nx = v[a[k+1]] || 0; t += c < nx ? -c : c; } return t; }
  function numOf(s){ return /^\d+$/.test(s) ? +s : romanNum(s); }
  function baseCode(p, i){
    if (p.code) return p.code;
    var m = /\blesson\s*(\d+)|\bL\s*(\d+)\b|\bweek\s*(\d+)|\bmodule\s*(\d+)/i.exec((p.t || "") + " " + (p.nm || "")), n = 0;
    if (m) n = +(m[1] || m[2] || m[3] || m[4]);
    if (!n){ n = 1; for (var k = 0; k < i; k++) if (pages[k] && pages[k].sc) n++; }
    return "L" + n + (D.subj || "");
  }
  function kindLabel(code){
    var m = /^(QC|MT|ME)(\d+)$/.exec(code) || [];
    return code === "QCTOTAL" ? "Quick checks (whole lesson)" : m[1] === "MT" ? "Mock Test " + m[2] : m[1] === "ME" ? "Mock Exam " + m[2] : code;
  }
  // ---- answer key safeguard: once a lesson's answer key is opened, its best scores so far are final
  var lockToldAt = {};
  function lockId(p){ return p.sid || ("t:" + itemKey(p)); }
  function isLocked(p){ if (ivOn()) return false; var l = scLoad().locks; return !!(l && l[lockId(p)]); }
  function lockItem(i){
    var p = pages[i]; if (!SC || !p || !p.sc || !user || isLocked(p)) return;
    var st = scLoad(), now = new Date().toISOString();
    st.locks = st.locks || {}; st.locks[lockId(p)] = now;
    st.queue.push({type: "lock", id: rid(), portal: D.id, portalTitle: D.title || "", sn: user.sn, name: user.name, email: user.em, tok: user.tok || "",
                   item: baseCode(p, i), itemTitle: p.t, itemId: lockId(p), at: now});
    st.to = {u: SC.u, k: SC.k};
    scStore(st); paintBadges(); flushScores();
    toast("Answer key opened — your best scores in this lesson are now final. New attempts won't be recorded.");
  }
  var keyAsk = null;
  function askKey(go){
    var m = $("keyAsk"); keyAsk = go;
    (document.fullscreenElement || document.webkitFullscreenElement ? $("stage") : document.body).appendChild(m);
    m.hidden = false; $("keyNo").focus();
  }
  function closeKeyAsk(ok){ var m = $("keyAsk"), go = keyAsk; m.hidden = true; keyAsk = null; if (ok && go) go(); }
  $("keyNo").onclick = function(){ closeKeyAsk(false); };
  $("keyYes").onclick = function(){ closeKeyAsk(true); };
  $("keyAsk").addEventListener("click", function(e){ if (e.target === this) closeKeyAsk(false); });
  $("keyAsk").addEventListener("keydown", function(e){ if (e.key === "Escape"){ e.stopPropagation(); closeKeyAsk(false); } });
  var KEY_CTRL = /\banswer\s*keys?\b|\bkey\s+to\s+corrections?\b|\b(show|reveal|view|see|open|display)\s+all\s+(the\s+)?(correct\s+)?answers\b|\b(show|reveal|view|see|open|display)\s+(me\s+)?the\s+(answer\s+)?key\b/i;
  var KEY_HEAD = /^\s*(the\s+)?(answer\s*keys?|key\s+to\s+corrections?)\b/i;
  var CTRL_SEL = 'a,button,nav,label,select,option,[role=button],[role=tab],[role=link],[role=navigation],[role=menuitem]';
  var BTN_SEL = 'button,[role=button],input[type=button],input[type=submit],summary';
  // A heading that names the answer key (not a link or button that merely points to it)
  function keyHeadsVisible(d){
    var out = [];
    try { d.querySelectorAll("h1,h2,h3,h4,h5,h6,summary,legend,caption,th,.title,.heading,strong,b").forEach(function(el){
      if (el.tagName !== "SUMMARY" && el.closest(CTRL_SEL)) return;
      if (visible(el) && KEY_HEAD.test(el.textContent || "")) out.push(el);
    }); } catch(e){}
    return out;
  }
  // A visible button that reveals the key ("Show the key", "Open answer key") — the key itself is still closed
  function keyGateIn(root){
    try { return [].some.call(root.querySelectorAll(BTN_SEL), function(b){ var t = labelOf(b); return visible(b) && !b.disabled && t && t.length <= 80 && KEY_CTRL.test(t); }); } catch(e){ return false; }
  }
  // A link to an answer-key page that is itself behind a reveal button: following the link shows nothing yet
  function gatedTarget(d, el){
    if (!el || el.tagName !== "A") return false;
    var h = el.getAttribute("href") || "", id = h.indexOf("#") >= 0 ? h.slice(h.indexOf("#") + 1).replace(/^[!\/]+/, "").split(/[\/?&]/)[0] : "";
    if (!id) return false;
    var t = null; try { t = d.getElementById(decodeURIComponent(id)) || d.querySelector('[data-view="' + id.replace(/"/g, "") + '"],[data-page="' + id.replace(/"/g, "") + '"],[name="' + id.replace(/"/g, "") + '"]'); } catch(e){}
    if (!t) return false;
    var region = t.closest('[data-view],[data-page],.view,.page,.slide,section,article') || t;
    if (region === t && t.parentElement && !t.querySelector(BTN_SEL)) region = t.parentElement;
    return [].some.call(region.querySelectorAll(BTN_SEL), function(b){ var x = labelOf(b) || b.textContent || ""; return x.length <= 80 && KEY_CTRL.test(x.trim()); });
  }
  // "Study More" on a term cover (e.g. End of Midterm) → the first item of that cover's own section (Midterm),
  // not the start of the whole portal. Runs before the page's own button code, so it works with any cover.
  var COVER_RE = /^\W*(welcome\b|end of\b|start of\b|opening\b|closing\b|term cover\b)|\b(cover( page)?|opener|kick-?off)\s*$/i;
  // Study materials vs the rest. A cover (welcome page, term start/end, course end) is known by the builder from its content
  // (cov: 1), by the instructor's choice (cov: 0 = study material), or else by its title. Music isn't a study material either;
  // a playlist of lecture recordings is.
  function isCover(p){ return !!p && (p.cov === 1 || (p.cov !== 0 && (!!p.wel || COVER_RE.test(p.t || "")))); }
  var MUSIC_SVC = /^(Spotify|YouTube Music|Apple Music|SoundCloud|Deezer|Tidal|Amazon Music)$/i, STUDY_AUDIO = /lecture|recording|recorded|podcast|discussion|lesson|review|class|talk|audio notes?|explainer/i;
  function isMusic(p){
    if (!p) return false;
    if (p.ml || (p.k === "link" && (MUSIC_SVC.test(p.svc || "") || (/GitHub/i.test(p.svc || "") && /music|playlist|audio|song|sound|lo-?fi|beats|mix/i.test(p.u || ""))))) return true;
    if (p.k === "playlist") return !STUDY_AUDIO.test((p.t || "") + " " + (p.g || ""));
    if (p.k === "audio") return /music|song|playlist|lo-?fi|beats|ambien|rain|ocean|white noise|pink noise|brown noise|focus sound/i.test((p.t || "") + " " + (p.g || "")) && !STUDY_AUDIO.test(p.t || "");
    return false;
  }
  function sectionStart(i){
    var g = String(pages[i].g || "").trim(), a = i, z = i;
    while (a > 0 && String(pages[a - 1].g || "").trim() === g) a--;
    while (z + 1 < pages.length && String(pages[z + 1].g || "").trim() === g) z++;
    for (var k = a; k <= z; k++) if (k !== i && !isCover(pages[k]) && !notYet(pages[k])) return k;   // first open resource: skip covers and not-yet-open items
    return a !== i ? a : Math.min(i + 1, z);
  }
  // ---------- overall tabs (terms) set in Portal Builder: a tab holds several sections ----------
  var TGS = (function(){ var m = {}; (D.tg || []).forEach(function(t, k){ (t.s || []).forEach(function(sec){ m[String(sec).trim()] = {n: t.n, k: k}; }); }); return m; })();
  function tgOf(p){ var g = String(p && p.g || "").trim(); return g && TGS[g] ? TGS[g] : null; }
  function tgFolded(v){ var k = "portal-tgf:" + D.id + ":" + (user ? user.sn : "");
    try { if (v) { localStorage.setItem(k, JSON.stringify(v)); return v; } var x = JSON.parse(localStorage.getItem(k) || "[]"); return Array.isArray(x) ? x : []; } catch(e){ return v || []; } }
  var TERM_W = [[/\bpre[\s-]?lim(inar(y|ies))?\b/i, "Prelim"], [/\bmid[\s-]?terms?\b/i, "Midterm"], [/\bsemi[\s-]?finals?\b/i, "Semi-final"], [/\bpre[\s-]?finals?\b/i, "Pre-final"], [/\bfinals?\b/i, "Final"]];
  function termWord(x){ for (var k = 0; k < TERM_W.length; k++) if (TERM_W[k][0].test(x || "")) return TERM_W[k][1]; return ""; }
  function termOfSec(p){ var t = tgOf(p); if (t) return "tab:" + t.n; if (D.tg && D.tg.length) return ""; var w = termWord(p.g); return w ? "w:" + w : ""; }
  // "Study More" on an end cover → the first resource of the first section of its term (its overall tab, or the term named in
  // its section or title); without one, the start of its own section
  function termStart(i){
    var p = pages[i], key = termOfSec(p);
    if (!key && !(D.tg && D.tg.length)){ var w = termWord(p.t); if (w) key = "w:" + w; }
    if (!key) return sectionStart(i);
    for (var a = 0; a < pages.length; a++) if (termOfSec(pages[a]) === key) break;
    if (a >= pages.length) return sectionStart(i);
    for (var k = a; k < pages.length && termOfSec(pages[k]) === key; k++) if (k !== i && !isCover(pages[k]) && !notYet(pages[k]) && pages[k].k !== "portal") return k;
    return a !== i ? a : sectionStart(i);
  }
  var REST_RE = /^(rest|rest well|rest well doc|take a rest|time to rest)$/i, OUT_RE = /^(sign out|log out|logout|exit|exit portal|close portal|end session)$/i;
  function hookStudyMore(w, i, tok){
    w.addEventListener("click", function(e){
      var el = e.target && e.target.closest ? e.target.closest('a,button,[role=button],input[type=button],input[type=submit]') : null;
      if (!el) return;
      var t = String(el.innerText || el.value || el.textContent || "").replace(/[^A-Za-z]+/g, " ").trim();
      if (/^study more$/i.test(t)){ e.preventDefault(); e.stopImmediatePropagation(); if (tok === navTok) show(termStart(i)); return; }
      // a cover's Rest / Sign out button: the portal's own full-screen farewell and sign-out, never the page's in-page version
      if (REST_RE.test(t) || (OUT_RE.test(t) && isCover(pages[i]))){
        e.preventDefault(); e.stopImmediatePropagation();
        if (tok === navTok) $("out").onclick({type: "click"});
      }
    }, true);
  }

  function guardKey(w, i, tok){
    var p = pages[i]; if (!SC || !p || !p.sc) return;
    var d = w.document, allow = null, seen = keyHeadsVisible(d);           // answer-key headings already showing when opened don't count
    d.addEventListener("click", function(e){
      if (tok !== navTok || isLocked(p) || (CB && CB.type === "exam" && CB.i === i)) return;
      var el = e.target && e.target.closest ? e.target.closest('button,a,summary,[role=button],[role=tab],label,input[type=button],input[type=submit],input[type=checkbox],input[type=radio],li,.tab,.btn') : null;
      if (!el) return;
      var txt = labelOf(el); if (!txt || txt.length > 80 || !KEY_CTRL.test(txt)) return;
      if (allow === el){ allow = null; return; }
      if (gatedTarget(d, el)) return;                                      // just goes to the key page; its own button opens the key
      e.preventDefault(); e.stopImmediatePropagation();
      askKey(function(){ lockItem(i); allow = el; el.click(); });
    }, true);
    return function(){                                                     // called on page changes: an answer key that appeared some other way
      if (isLocked(p)) return;
