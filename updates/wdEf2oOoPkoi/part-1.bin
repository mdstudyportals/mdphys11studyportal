      npSeekTo(inf.t + (a === "next" ? step : -step), s); msTell(a === "next" ? "⏩ Forward " + Math.round(step) + " s" : "⏪ Back " + Math.round(step) + " s");
    }
    else if (a === "next" || a === "prev"){
      if (a === "prev" && inf.seek && inf.t > 3){ npSeekTo(0, s); msTell("⏮ From the start"); }
      else {
        var j = inf.nx ? npPickS(s, a === "next" ? 1 : -1, false) : -1;
        if (j < 0){ if (a === "prev" && inf.seek){ npSeekTo(0, s); msTell("⏮ From the start"); } else msTell(a === "next" ? (npIsPl(s) ? "End of the playlist" : "No next track in this section") : "No earlier track"); }
        else { npStep(s, a === "next" ? 1 : -1); if (npIsPl(s)) msTell(a === "next" ? "⏭ Next track" : "⏮ Previous track"); }
