  }
  function npNextIdx(i, dir){                                                // uploaded recordings in the same section
    var g = String(pages[i].g || "").trim();
    for (var k = i + dir; k >= 0 && k < pages.length; k += dir){ if (String(pages[k].g || "").trim() !== g) break; if (pages[k].k === "audio" && !notYet(pages[k]) && npAllowed(k)) return k; }
    return -1;
  }
  async function npGo(s, j){ if (j < 0) return; try { var o = await getAsset(j); s.i = j; s.el.src = o.url; s.el.play().catch(function(){}); npPaint(); toast("Now playing: " + pages[j].t); } catch(e){} }
  function npMuteToggle(s){
    s = s || NP; if (!s) return;
    if (s.kind === "media") s.el.muted = !s.el.muted;
    else if (s.el){ s.muted = !s.muted; npSend(s, s.muted ? "mute" : "unmute"); }
    if (s === NP) npPaint();
  }
  function npHideToggle(force){
    if (!NP || NP.kind !== "media") return;
