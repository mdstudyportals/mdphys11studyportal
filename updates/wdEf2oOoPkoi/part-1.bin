              if (tok !== navTok) return; var m = e.target;
              [NP, CUR].forEach(function(o){ if (!o) return; if (o === NP){ if (o.kind === "media") try { npPosSetK(npPosK(o), o.el.currentTime); } catch(x){} npClose(); } else if (npPlaying(o) && (npCtl(o) || o.ctl)) npToggle(o); });
              pageMediaPause(m);
