    var encDict = ctx.obj({});
    encDict.set(N("Filter"), N("Standard")); encDict.set(N("V"), L.PDFNumber.of(5)); encDict.set(N("R"), L.PDFNumber.of(6));
    encDict.set(N("Length"), L.PDFNumber.of(256)); encDict.set(N("P"), L.PDFNumber.of(P));
    var std = ctx.obj({}); std.set(N("AuthEvent"), N("DocOpen")); std.set(N("CFM"), N("AESV3")); std.set(N("Length"), L.PDFNumber.of(32));
    var cf = ctx.obj({}); cf.set(N("StdCF"), std);
    encDict.set(N("CF"), cf); encDict.set(N("StmF"), N("StdCF")); encDict.set(N("StrF"), N("StdCF"));
    encDict.set(N("O"), hexStr(O)); encDict.set(N("U"), hexStr(U)); encDict.set(N("OE"), hexStr(OE)); encDict.set(N("UE"), hexStr(UE));
    encDict.set(N("Perms"), hexStr(Perms)); encDict.set(N("EncryptMetadata"), L.PDFBool.True);
    ctx.trailerInfo.Encrypt = ctx.register(encDict);
    var id = hexStr(rnd(16)); ctx.trailerInfo.ID = ctx.obj([id, id]);
    return doc.save({useObjectStreams: false, addDefaultPage: false, updateFieldAppearances: false});
  }
  $("view").addEventListener("contextmenu", function(e){ if (!DL_ALL) e.preventDefault(); });

  var DL_ALL = D.dl === true, DL_PDF = DL_ALL || D.dl === "pdf";
  // ---------- PDF viewer (pdf.js) ----------
  async function showPdf(o, tok){
    if (!window.pdfjsLib) throw new Error("The PDF viewer is missing from this portal file.");
    if (!pdfjsLib.GlobalWorkerOptions.workerSrc){
      var w = document.getElementById("pdfjs-worker");
      pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(new Blob([w.textContent], {type:"text/javascript"}));
    }
    $("loadTxt").textContent = "Preparing pages…";
    var data = new Uint8Array(await o.blob.arrayBuffer());
    var doc = await pdfjsLib.getDocument({data: data, isEvalSupported: false}).promise;
    if (tok !== navTok){ doc.destroy(); return; }
    var first = await doc.getPage(1);
    var v = $("view"); v.innerHTML = '<div class="pdf"></div>';
    var sc = v.firstChild;
    pdfS = {doc: doc, zoom: 1, sc: sc, base: first.getViewport({scale:1}), pg: [], gen: 0};
    for (var n=1;n<=doc.numPages;n++){
      var el = document.createElement("div"); el.className = "pg"; el.dataset.n = n;
      sc.appendChild(el);
      pdfS.pg.push({el: el, page: n === 1 ? first : null, vp: n === 1 ? pdfS.base : null, gen: -1, task: null});
    }
    pdfS.io = new IntersectionObserver(function(ents){
      ents.forEach(function(en){
        var s = pdfS; if (!s) return;
        var p = s.pg[+en.target.dataset.n - 1];
        if (en.isIntersecting) renderPg(s, p); else dropPg(p);
      });
    }, {root: sc, rootMargin: "800px 0px"});
    pdfS.pg.forEach(function(p){ pdfS.io.observe(p.el); });
    sc.addEventListener("scroll", pdfLabel, {passive:true});
    $("pdfCtl").hidden = false;
    layoutPdf();
  }
  function pdfScale(s){ var w = Math.min(s.sc.clientWidth - 32, 960); return Math.max(0.2, w / s.base.width) * s.zoom; }
  function layoutPdf(){
    var s = pdfS; if (!s) return;
    s.gen++; var sc = pdfScale(s);
    s.pg.forEach(function(p){
      var vp = p.vp || s.base;
      p.el.style.width = Math.floor(vp.width * sc) + "px"; p.el.style.height = Math.floor(vp.height * sc) + "px";
      dropPg(p);
    });
    // re-render what's visible
    s.io.disconnect(); s.pg.forEach(function(p){ s.io.observe(p.el); });
    pdfLabel();
  }
  async function renderPg(s, p){
    if (p.gen === s.gen || p.busy) return;
    p.busy = true;
    try{
      var gen = s.gen;
      if (!p.page){ p.page = await s.doc.getPage(+p.el.dataset.n); p.vp = p.page.getViewport({scale:1}); }
      if (s.dead) return;
      var sc = pdfScale(s), dpr = Math.min(window.devicePixelRatio || 1, 2);
      p.el.style.width = Math.floor(p.vp.width * sc) + "px"; p.el.style.height = Math.floor(p.vp.height * sc) + "px";
      var vp = p.page.getViewport({scale: sc * dpr});
      var c = document.createElement("canvas"); c.className = "pc"; c.width = Math.floor(vp.width); c.height = Math.floor(vp.height);
      p.task = p.page.render({canvasContext: c.getContext("2d"), viewport: vp});
      await p.task.promise;
      if (s.dead || gen !== s.gen) return;
      var old = p.el.querySelector("canvas.pc"); if (old) old.remove();
      p.el.insertBefore(c, p.el.firstChild); p.gen = gen;
      if (canInk(pages[cur])){
        var icv = p.el.querySelector("canvas.ink");
        if (!icv){ icv = document.createElement("canvas"); icv.className = "ink"; p.el.appendChild(icv); addSurface(boxSurface("p" + p.el.dataset.n, p.el, icv)); }
        else redrawKey("p" + p.el.dataset.n);
      }
    } catch(e){ if (!(e && e.name === "RenderingCancelledException")) console.error(e); }
    finally { p.busy = false; p.task = null; if (pdfS === s && p.gen !== s.gen && isNear(s, p)) renderPg(s, p); }
  }
  function isNear(s, p){ var r = p.el.getBoundingClientRect(), R = s.sc.getBoundingClientRect(); return r.bottom > R.top - 800 && r.top < R.bottom + 800; }
  function dropPg(p){
    if (p.task){ try { p.task.cancel(); } catch(e){} }
    var c = p.el.querySelector("canvas.pc"); if (c){ c.width = 0; c.height = 0; c.remove(); }
    var ic2 = p.el.querySelector("canvas.ink"); if (ic2){ dropSurface(ic2); ic2.width = 0; ic2.height = 0; ic2.remove(); }
    p.gen = -1;
  }
  function pdfLabel(){
    var s = pdfS; if (!s) return;
    var mid = s.sc.getBoundingClientRect().top + s.sc.clientHeight/3, n = 1;
    for (var k=0;k<s.pg.length;k++){ if (s.pg[k].el.getBoundingClientRect().top <= mid) n = k+1; else break; }
    $("pdfPg").textContent = n + " / " + s.pg.length;
  }
  function zoom(f){
    var s = pdfS; if (!s) return;
    var rel = s.sc.scrollTop / Math.max(1, s.sc.scrollHeight);
    s.zoom = Math.max(0.4, Math.min(4, s.zoom * f));
    layoutPdf();
    s.sc.scrollTop = rel * s.sc.scrollHeight;
  }
  $("zIn").onclick = function(){ zoom(1.25); };
  $("zOut").onclick = function(){ zoom(0.8); };
  var rT; window.addEventListener("resize", function(){ clearTimeout(rT); rT = setTimeout(layoutPdf, 200); });

  // ---------- navigation ----------
  function openNav(){ $("nav").classList.add("open"); $("scrim").hidden = false; }
  function closeNav(){ $("nav").classList.remove("open"); $("scrim").hidden = true; }
  $("nav").addEventListener("click", function(e){ var b = e.target.closest("button.item"); if (b){ show(+b.dataset.i); closeNav(); } });
  var NAVKEY = "portal-nav:" + (D.id || "x"), narrow = window.matchMedia ? matchMedia("(max-width: 900px)") : {matches:false};
  try { if (localStorage.getItem(NAVKEY) === "c") document.body.classList.add("navc"); } catch(e){}
  $("menuBtn").onclick = function(){
    if (narrow.matches){ openNav(); return; }
    var c = document.body.classList.toggle("navc");
    try { localStorage.setItem(NAVKEY, c ? "c" : ""); } catch(e){}
    $("menuBtn").setAttribute("aria-label", c ? "Show contents" : "Hide contents");
    setTimeout(layoutPdf, 260);
  };
  if (narrow.addEventListener) narrow.addEventListener("change", function(){ closeNav(); setTimeout(layoutPdf, 260); });
  (function(){ var st = $("stage"); if (!(st.requestFullscreen || st.webkitRequestFullscreen)) $("fs").hidden = true; })();
  $("scrim").onclick = closeNav;
  $("prev").onclick = function(){ show(cur - 1); };
  $("next").onclick = function(){ show(cur + 1); };
  function isFs(){ return !!(document.fullscreenElement || document.webkitFullscreenElement); }
  function toggleFs(){
    var st = $("stage");
    if (isFs()){ (document.exitFullscreen || document.webkitExitFullscreen).call(document); }
    else if (st.requestFullscreen) st.requestFullscreen().catch(function(){});
    else if (st.webkitRequestFullscreen) st.webkitRequestFullscreen();
  }
  $("fs").onclick = toggleFs;
  $("fsExit").onclick = toggleFs;
  $("fsPrev").onclick = function(){ show(cur - 1); };
  $("fsNext").onclick = function(){ show(cur + 1); };

  // floating controls fade out after a few seconds without movement
  var idleT;
  function wake(){
    var b = $("fsbar"); b.classList.remove("idle");
    clearTimeout(idleT); idleT = setTimeout(function(){ if (!b.matches(":hover")) b.classList.add("idle"); }, 2800);
  }
  ["mousemove","touchstart","click"].forEach(function(t){ $("stage").addEventListener(t, wake, {passive:true}); });
  $("fsbar").addEventListener("mouseleave", wake);
  // In full screen the shortcut list opens inside the full-screen area so it stays visible
  function toggleKeys(force){
    var k = $("keys"), open = force === undefined ? k.hidden : force;
    if (open){ (isFs() ? $("stage") : document.body).appendChild(k); }
    k.hidden = !open;
  }
  $("keys").addEventListener("click", function(e){ if (e.target === this) toggleKeys(false); });

  function onKey(e){
    if (!user) return;
    if (/^Media/.test(e.key || "") && msKey(e)) return;
    var t = e.target;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName || ""))) return;
    var k = e.key && e.key.length === 1 ? e.key.toLowerCase() : e.key;
    if (INK.on && (e.ctrlKey || e.metaKey) && !e.altKey && (k === "z" || k === "y")){
      if (k === "y" || e.shiftKey) inkRedo(); else inkUndo();
      e.preventDefault(); return;
    }
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (k === "Escape"){
      if (!$("keys").hidden){ toggleKeys(false); e.preventDefault(); }
      else if (INK.on){ setInk(false); e.preventDefault(); }
      else if ($("nav").classList.contains("open")) closeNav();
      return;
    }
    if (k === "a" && canInk(pages[cur])){ setInk(!INK.on); e.preventDefault(); return; }
    if (INK.on){
      var tools = {"1":"pen","2":"hl","3":"eraser","4":"text"};
      if (tools[k]){ setTool(tools[k]); e.preventDefault(); return; }
      if (k === "c"){ $("inkColor").click(); e.preventDefault(); return; }
      if (k === "s"){ $("inkSize").click(); e.preventDefault(); return; }
      if (k === "z"){ if (e.shiftKey) inkRedo(); else inkUndo(); e.preventDefault(); return; }
    }
    if (!$("keys").hidden && k !== "?"){ toggleKeys(false); }
    var mt = NP || CUR;                                                     // music / video: K play-pause, J/L ∓10 s, U mute, H hide the player
    if (k === "v" && NP && !e.shiftKey && !CB && D.np !== false){ npModeToggle(); e.preventDefault(); return; }
    if (mt && !e.shiftKey && (k === "k" || k === "j" || k === "l" || k === "u" || k === "h") && !CB){
      if (k === "k" && npCtl(mt)){ npToggle(mt); setTimeout(npPaint, 300); }
      else if ((k === "j" || k === "l") && npInfo(mt).seek){ npSeekTo(npInfo(mt).t + (k === "l" ? 10 : -10), mt); setTimeout(npTick, 150); }
      else if (k === "u" && npInfo(mt).muted != null) npMuteToggle(mt);
      else if (k === "h" && NP) npHideToggle();
      else return;
      e.preventDefault(); return;
    }
    if (k === "n") show(cur + 1);
    else if (k === "p") show(cur - 1);
    else if (k === "f"){ if ($("stage").requestFullscreen || $("stage").webkitRequestFullscreen) toggleFs(); }
    else if (k === "m") $("menuBtn").click();
    else if (k === "?") toggleKeys();
    else return;
    e.preventDefault();
  }
  document.addEventListener("keydown", onKey);
  document.addEventListener("fullscreenchange", function(){ setTimeout(layoutPdf, 100); if (isFs()) wake(); else toggleKeys(false); });
  document.addEventListener("webkitfullscreenchange", function(){ setTimeout(layoutPdf, 100); if (isFs()) wake(); });
  function checkOpen(){ if (user && user.exp && isClosed(user.exp)){ var x = user.exp; $("out").onclick(); showClosed(x); } }
  setInterval(checkOpen, 60000);
  window.addEventListener("pagehide", inkFlush);
  document.addEventListener("visibilitychange", function(){ if (document.hidden) inkFlush(); });
  document.addEventListener("visibilitychange", function(){ if (!document.hidden){ checkOpen(); flushScores(); } });
  // Fading farewell on sign-out: "Rest well, Doc." for medicine portals, "Rest well." for others (set in Portal Builder)
  function farewell(){
    var b = $("bye"), done = false;
    b.querySelector("h2").textContent = D.bye || "Rest well.";
    b.hidden = false; void b.offsetWidth; b.classList.add("on");
    function end(){ if (done) return; done = true; b.classList.remove("on"); setTimeout(function(){ b.hidden = true; }, 650); document.removeEventListener("keydown", end, true); }
    b.onclick = end; document.addEventListener("keydown", end, true);
    setTimeout(end, 2600);
  }
  $("out").onclick = function(e){
    npStopAll();
    if (CB && CB.type === "pt") ptSubmit(true, "signed out"); CB = null; rqCur = null; $("rqBar").hidden = true; $("ptWrap").hidden = true; $("err").textContent = "";
    if (e) farewell();                                                    // a real click; not when the portal closes itself
    inkFlush(); setInk(false); ink.key = null; SC = null; scoreSess = {};
    fmSignOut(); $("psPins").hidden = true; $("psPins").innerHTML = ""; if (!UPS.busy) upBar("");
    navTok++; clearView(); toggleKeys(false); $("wnBox").hidden = true; WNS = null;
    Object.keys(cache).forEach(function(k){ if (cache[k].url) URL.revokeObjectURL(cache[k].url); });
    cache = {}; pages = []; user = null; cur = -1; CK = null;
    $("nav").innerHTML = ""; $("wm").style.backgroundImage = ""; $("loading").hidden = true;
    $("app").hidden = true; $("login").hidden = false; $("sn").focus();
  };
})();
</script>
