    MS.last = now; MS.lastSrc = src;
    var s = msTarget(); if (!s) return;
    var on = npPlaying(s), inf = npInfo(s), step = det && det.seekOffset > 0 ? det.seekOffset : 10;
    if (CB && (a === "play" || (a === "toggle" && !on) || a === "next" || a === "prev")){ toast("Music and videos stay paused during closed-book activities."); return; }
    if (a === "toggle") a = on ? "pause" : "play";
    if (a === "play"){ if (!on) npToggle(s); msTell("▶ Playing"); }
    else if (a === "pause"){ if (on) npToggle(s); msTell("⏸ Paused"); }
    else if (a === "stop"){
      if (s.kind === "media"){ s.el.pause(); try { s.el.currentTime = 0; } catch(e){} } else if (on) npToggle(s);
      msTell("⏹ Stopped");
    }
    else if (a === "back" || a === "fwd"){
      if (!inf.seek){ msTell("Can't skip in this player"); return; }
      npSeekTo(inf.t + (a === "fwd" ? step : -step), s); msTell(a === "fwd" ? "⏩ Forward " + Math.round(step) + " s" : "⏪ Back " + Math.round(step) + " s");
    }
    else if (a === "to"){ if (inf.seek && det && typeof det.seekTime === "number"){ if (det.fastSeek && s.kind === "media" && s.el.fastSeek) s.el.fastSeek(det.seekTime); else npSeekTo(det.seekTime, s); } }
    else if ((a === "next" || a === "prev") && s.pl){ npPlCmd(s, a); msTell(a === "next" ? "⏭ Next track" : "⏮ Previous track"); }
    else if ((a === "next" || a === "prev") && !inf.nx){
      // a video or a single recording has no "next track": the device's ⏭ / ⏮ (headphone double / triple press, Mac F9 / F7,
      // lock-screen buttons) skip forward / back instead
