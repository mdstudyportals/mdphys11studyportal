  }
  function pageMediaPause(except){                                         // sounds inside an HTML lesson page
    try { var f = $("frame"), d = f && f.contentDocument; if (!d) return; d.querySelectorAll("audio,video").forEach(function(m){ if (m !== except && !m.paused) m.pause(); }); } catch(e){}
  }
  function npSection(i){                                                      // uploaded recordings (or videos) in the same section, in order
    var g = String(pages[i].g || "").trim(), a = i, z = i, out = [], kk = pages[i].k === "video" ? "video" : "audio";
    while (a > 0 && String(pages[a - 1].g || "").trim() === g) a--;
    while (z + 1 < pages.length && String(pages[z + 1].g || "").trim() === g) z++;
    for (var k = a; k <= z; k++) if (pages[k].k === kk && !notYet(pages[k]) && npAllowed(k)) out.push(k);
    return out;
  }
  // What "next" means: the next track of a playlist, or the next recording in the same section
  function npKeys(s){ return npIsPl(s) ? pages[s.i].tr.map(function(x, j){ return j; }) : npSection(s.i); }
  function npAt(s){ return npIsPl(s) ? s.tr : s.i; }
  function npPickS(s, dir, auto){                                            // next / previous respecting shuffle and repeat
    var list = npKeys(s), pr = npPref(), c0 = npAt(s), at = list.indexOf(c0);
    if (!list.length) return -1;
    if (auto && pr.rep === "one") return c0;
    if (pr.shuf && dir > 0 && list.length > 1){ var others = list.filter(function(k){ return k !== c0; }); return others[Math.floor(Math.random() * others.length)]; }
    var j = at + dir;
    if (j >= list.length) return pr.rep === "all" ? list[0] : -1;
    if (j < 0) return pr.rep === "all" ? list[list.length - 1] : -1;
    return list[j];
  }
  function npPick(i, dir, auto){ return npPickS({i: i, kind: "media"}, dir, auto); }
  function npStep(s, dir){                                                   // next / previous chosen by the student
    var j = npPickS(s, dir, false);
    if (j < 0) return false;
    if (npIsPl(s)) plLoad(s, j, true, s === NP);
    else if (s === CUR && cur === s.i){ npAuto = j; show(j); }
