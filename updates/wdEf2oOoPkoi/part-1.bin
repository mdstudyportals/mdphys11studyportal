    target:'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/>',
    spark:'<path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>',
    home:'<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><rect x="9.5" y="13" width="5" height="5" rx="1"/>',
    eyeoff:'<path d="M3 3l18 18M10.6 6.1A10 10 0 0 1 12 6c5 0 9 6 9 6a17 17 0 0 1-2.6 3.3M6.5 7.6C4.3 9.2 3 12 3 12s4 6 9 6a9 9 0 0 0 4.3-1.1M9.9 9.9a3 3 0 0 0 4.2 4.2"/>',
    timer:'<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9 2h6"/>',
    aa:'<path d="M3 19 8 5l5 14M4.8 14h6.4M15 19l3.2-8 3.3 8M16 16.5h4.4"/>',
    theme:'<circle cx="13.5" cy="6.5" r="1.5"/><circle cx="17.5" cy="10.5" r="1.5"/><circle cx="8.5" cy="7.5" r="1.5"/><circle cx="6.5" cy="12.5" r="1.5"/><path d="M12 2a10 10 0 0 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.3 0-1.1.9-2 2-2h2.4A5.6 5.6 0 0 0 22 9.8C22 5.5 17.5 2 12 2z"/>'
  };
  function ic(n){ return '<svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + IC[n] + '</svg>'; }

  function b64d(s){ var b = atob(s), u = new Uint8Array(b.length); for (var i=0;i<b.length;i++) u[i]=b.charCodeAt(i); return u; }
  function normSN(s){ return String(s).replace(/[\s\-]/g,"").toUpperCase(); }
  function normEm(s){ return String(s).trim().toLowerCase(); }
  function esc(s){ return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];}); }
  function size(n){ if (!n) return ""; return n < 1048576 ? Math.max(1,Math.round(n/1024)) + " KB" : (n/1048576).toFixed(n < 104857600 ? 1 : 0) + " MB"; }
  function tick(){ return new Promise(function(r){ setTimeout(r, 0); }); }

  async function derive(secret, salt, iter){
    var base = await crypto.subtle.importKey("raw", te.encode(secret), "PBKDF2", false, ["deriveKey"]);
    return crypto.subtle.deriveKey({name:"PBKDF2", salt:b64d(salt), iterations:iter, hash:"SHA-256"}, base, {name:"AES-GCM", length:256}, false, ["decrypt"]);
  }
  async function dec(key, o){ return new Uint8Array(await crypto.subtle.decrypt({name:"AES-GCM", iv:b64d(o.iv)}, key, b64d(o.ct))); }
  async function gunzipBlob(b){ return new Response(b.stream().pipeThrough(new DecompressionStream("gzip"))).blob(); }

  // ---------- static UI ----------
  document.title = D.title || "Portal";
  $("lTitle").textContent = D.title || "Portal";
  $("lSub").textContent = D.subtitle || "";
  if (D.note){ $("lNote").textContent = D.note; $("lNote").hidden = false; }
  $("menuBtn").innerHTML = ic("menu");
  $("prev").innerHTML = ic("prev") + '<span class="label">Previous</span>';
  $("next").innerHTML = '<span class="label">Next</span>' + ic("next");
  $("fs").innerHTML = ic("fs") + '<span class="label">Full screen</span>';
  $("inkBtn").innerHTML = ic("pen") + '<span class="label">Annotate</span>';
  document.querySelectorAll("#inkbar [data-tool]").forEach(function(b){ b.innerHTML = ic(b.dataset.tool); });
  $("inkUndo").innerHTML = ic("undo"); $("inkRedo").innerHTML = ic("redo"); $("inkClear").innerHTML = ic("trash");
  $("fsPrev").innerHTML = ic("prev"); $("fsNext").innerHTML = ic("next"); $("fsExit").innerHTML = ic("close");
  $("prev").title = "Previous (P)"; $("next").title = "Next (N)"; $("fs").title = "Full screen (F)"; $("menuBtn").title = "Contents (M)";
  $("dlBtn").innerHTML = ic("dl") + '<span class="label">Download</span>';
  document.querySelectorAll("[data-theme-btn]").forEach(function(b){ b.innerHTML = '<span class="aa" aria-hidden="true">A<small>a</small></span>'; b.setAttribute("aria-label", "Reading settings"); b.title = "Reading settings: day / night, text size, font, spacing, reading aids"; });

  // ---------- reading settings (appearance, text, reading aids) ----------
  // Saved per portal on this device. They reach HTML handouts (styles added into the page) and post-tests.
  var pop = $("themePop"), popFor = null;
  function rsGet(){ return PT.apply().rs; }
  function rsSet(k, v){ var p = PT.get(); p.rs = p.rs || {}; p.rs[k] = v; PT.set(p); rsApply(); }
  var RS_FONTS = null, RS_FACES = {};
  function rsFontData(){ if (!RS_FONTS) try { RS_FONTS = JSON.parse($("rs-fonts").textContent); } catch(e){ RS_FONTS = {}; } return RS_FONTS; }
  function b64buf(b){ var s = atob(b), u = new Uint8Array(s.length); for (var i = 0; i < s.length; i++) u[i] = s.charCodeAt(i); return u.buffer; }
  function rsLoadFonts(doc, win){                                            // add the two reading fonts to a document (portal or handout)
    var key = doc === document ? "top" : "f", f = rsFontData();
    if (doc.__rsFonts) return; doc.__rsFonts = true;
    [["PortalAtk", "atk"], ["PortalDys", "dys"]].forEach(function(n){
      (f[n[1]] || []).forEach(function(b, i){
        try { var ff = new win.FontFace(n[0], b64buf(b), {weight: i ? "700" : "400", style: "normal"}); doc.fonts.add(ff); ff.load().catch(function(){}); } catch(e){}
      });
    });
  }
  var RS_DOC_CSS = [
    'html[data-rs-font=atk] body,html[data-rs-font=atk] body :not(i):not(svg):not(svg *):not(code):not(pre):not(kbd):not([class*=icon]):not([class*=Icon]):not(.material-icons):not(.fa):not([class^=fa-]){font-family:"PortalAtk",system-ui,sans-serif!important}',
    'html[data-rs-font=dys] body,html[data-rs-font=dys] body :not(i):not(svg):not(svg *):not(code):not(pre):not(kbd):not([class*=icon]):not([class*=Icon]):not(.material-icons):not(.fa):not([class^=fa-]){font-family:"PortalDys",system-ui,sans-serif!important}',
    'html[data-rs-lh=m] :is(p,li,dd,dt,td,th,blockquote,figcaption,label,span,div){line-height:1.8!important}',
    'html[data-rs-lh=l] :is(p,li,dd,dt,td,th,blockquote,figcaption,label,span,div){line-height:2.1!important}',
    'html[data-rs-ls=w] body *{letter-spacing:.05em!important;word-spacing:.16em!important}',
    'html[data-rs-la] :is(p,li,dd,blockquote,td){text-align:left!important;hyphens:manual!important}',
    'html[data-rs-ul] a{text-decoration:underline!important}',
    'html[data-rs-hc]{filter:contrast(1.22)}',
    'html[data-rs-rm] *,html[data-rs-rm] *::before,html[data-rs-rm] *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}'
  ].join("\n");
  function rsToDoc(w){                                                       // a handout page: same settings
    try {
      var d = w.document, h = d.documentElement, R = rsGet();
      if (!d.getElementById("portal-rs")){ var st = d.createElement("style"); st.id = "portal-rs"; st.textContent = RS_DOC_CSS; (d.head || h).appendChild(st); }
      if (R.font) rsLoadFonts(d, w);
      ["font", "lh", "ls"].forEach(function(k){ if (R[k]) h.setAttribute("data-rs-" + k, R[k]); else h.removeAttribute("data-rs-" + k); });
      ["hc", "ul", "la", "rm"].forEach(function(k){ if (R[k]) h.setAttribute("data-rs-" + k, ""); else h.removeAttribute("data-rs-" + k); });
      h.style.zoom = R.size && R.size !== 1 ? R.size : "";                    // text size: the whole handout scales, so its layout stays intact
      if (!w.__rsHook){ w.__rsHook = true; ["pointermove", "touchmove"].forEach(function(ev){ d.addEventListener(ev, function(e){ rulerAt(e, w); }, {passive: true}); }); }
    } catch(e){}
  }
  function rsApply(){
    var R = rsGet();
    if (R.font) rsLoadFonts(document, window);
    try { var f = $("frame"); if (f && !f.hidden && f.contentWindow) rsToDoc(f.contentWindow); } catch(e){}
    $("rsRuler").hidden = !R.ruler; if (!R.ruler) rulerY = -1;
    if (!pop.hidden) paintPop();
    if (user && D.watermark) paintWatermark();
  }
  // Reading ruler: a clear band at the pointer, the rest of the screen dimmed a little
  var rulerY = -1, RS_ZY = 0;   // RS_ZY: whether pointer positions inside a zoomed handout need scaling (checked once)
  function rulerAt(e, w){
    if ($("rsRuler").hidden) return;
    var t = e.touches ? e.touches[0] : e; if (!t) return;
    var y = t.clientY;
    if (w && w !== window){ try { y = t.clientY * (RS_ZY && parseFloat(w.document.documentElement.style.zoom) || 1) + w.frameElement.getBoundingClientRect().top; } catch(x){} }
    rulerY = y; paintRuler();
  }
  function paintRuler(){
    var R = rsGet(), band = Math.round(46 * (R.size || 1)), top = Math.max(0, rulerY - band / 2);
    var el = $("rsRuler"); if (el.hidden || rulerY < 0) return;
    el.querySelector(".rsr-top").style.height = top + "px";
    var b = el.querySelector(".rsr-band"); b.style.top = top + "px"; b.style.height = band + "px";
    el.querySelector(".rsr-bot").style.top = (top + band) + "px";
  }
  ["pointermove", "touchmove"].forEach(function(ev){ document.addEventListener(ev, function(e){ if (pop.hidden || !pop.contains(e.target)) rulerAt(e, window); }, {passive: true}); });
  function paintPop(){
    var st = PT.apply(), R = st.rs;
    pop.querySelectorAll("#modeSeg button").forEach(function(b){ b.setAttribute("aria-pressed", b.dataset.m === st.mode); });
    var pct = Math.round((R.size || 1) * 100); $("rsSize").value = pct; $("rsSizeV").textContent = pct + "%";
    pop.querySelectorAll("[data-rs]").forEach(function(g){ var k = g.dataset.rs; g.querySelectorAll("button").forEach(function(b){ b.setAttribute("aria-pressed", (R[k] || "") === b.dataset.v); }); });
    pop.querySelectorAll("[data-rs-t]").forEach(function(c){ c.checked = !!R[c.dataset.rsT]; });
  }
  PT.onchange = function(){ if (!pop.hidden) paintPop(); if (user && D.watermark) paintWatermark(); };
  function openPop(btn){
    popFor = btn; rsLoadFonts(document, window); paintPop(); pop.hidden = false;
    var r = btn.getBoundingClientRect(), w = pop.offsetWidth;
    pop.style.top = Math.min(r.bottom + 8, Math.max(8, innerHeight - pop.offsetHeight - 8)) + "px";
    pop.style.left = Math.max(8, Math.min(r.right - w, innerWidth - w - 8)) + "px";
  }
  function closePop(){ pop.hidden = true; popFor = null; }
  document.addEventListener("click", function(e){
    var b = e.target.closest("[data-theme-btn]");
    if (b){ if (popFor === b) closePop(); else openPop(b); return; }
    if (!pop.hidden && !pop.contains(e.target)) closePop();
  });
  document.addEventListener("keydown", function(e){ if (e.key === "Escape") closePop(); });
  pop.addEventListener("click", function(e){
    e.stopPropagation();
    var p = PT.get(), m = e.target.closest("[data-m]"), g = e.target.closest("[data-rs] button"), st = e.target.closest("[data-rs-step]");
    if (m){ p.mode = m.dataset.m; PT.set(p); rsApply(); }
    else if (g){ rsSet(g.parentNode.dataset.rs, g.dataset.v); }
    else if (st){ var v = Math.max(90, Math.min(160, Math.round((rsGet().size || 1) * 100) + 10 * +st.dataset.rsStep)); rsSet("size", v / 100); }
    else if (e.target.id === "themeReset"){ var keep = {mode: p.mode}; PT.set(keep); rsApply(); }
  });
  $("rsSize").addEventListener("input", function(){ rsSet("size", +this.value / 100); });
  pop.addEventListener("change", function(e){ var c = e.target.closest("[data-rs-t]"); if (c) rsSet(c.dataset.rsT, c.checked ? 1 : 0); });
  rsApply();

  // ---------- closing date ----------
  // Effective "now" never goes below the file's build time or the latest time this browser has seen,
  // so turning the device clock back doesn't reopen a closed portal.
  var SEEN_KEY = "portal-seen:" + (D.id || "x");
  function endOfDay(s){ var p = String(s).split("-"); return new Date(+p[0], +p[1]-1, +p[2], 23, 59, 59, 999).getTime(); }
  function fmtDate(s){ var p = String(s).split("-"); return new Date(+p[0], +p[1]-1, +p[2]).toLocaleDateString(undefined, {year:"numeric", month:"long", day:"numeric"}); }
  function effNow(){
    var seen = 0; try { seen = +localStorage.getItem(SEEN_KEY) || 0; } catch(e){}
    var eff = Math.max(Date.now(), seen, Date.parse(D.built) || 0);
    try { localStorage.setItem(SEEN_KEY, String(eff)); } catch(e){}
    return eff;
  }
  function isClosed(exp){ return !!exp && effNow() > endOfDay(exp); }
  function showClosed(exp){
    $("form").hidden = true; $("avail").hidden = true; $("foot").hidden = true;
    $("closed").innerHTML = "<b>" + ic("lock") + "This portal has closed</b><p>Access ended on " + esc(fmtDate(exp)) + ". If you still need these materials, contact your instructor.</p>";
    $("closed").hidden = false;
  }
  if (D.exp){
    if (isClosed(D.exp)) showClosed(D.exp);
    else { $("avail").innerHTML = ic("cal") + "Available until " + esc(fmtDate(D.exp)); $("avail").hidden = false; }
  }

  if (D.scoring){ $("scNote").innerHTML = ic("chart") + "<span>Scores from quick checks and mock tests are recorded for your instructor when you're online.</span>"; $("scNote").hidden = false; }

  if (D.cbx !== false || D.hasPt){ $("cbNote").innerHTML = ic("lock") + "<span><b>Closed-book activities:</b> " + (D.hasPt ? "post-tests" + (D.cbx !== false ? " and " : "") : "") + (D.cbx !== false ? "mock tests in exam mode" : "") + ". Unlike the readings and quick checks, switching tabs or apps, or opening any other page of the portal" + (D.hasPt ? " closes a post-test" : "") + (D.hasPt && D.cbx !== false ? " and" : "") + (D.cbx !== false ? " signs you out during a mock test in exam mode (so does opening the answer key)" : "") + ".</span>"; $("cbNote").hidden = false; }
  if (D.hasRq){ var rn = document.createElement("p"); rn.className = "scnote"; rn.innerHTML = ic("cal") + "<span>Items marked <b>Required</b> are recorded as attendance when finished within their set period. Required videos can't be skipped ahead and play at up to 1.25×.</span>"; $("cbNote").parentNode.insertBefore(rn, $("cbNote")); }

  var supported = !!(window.crypto && crypto.subtle && window.DecompressionStream);
  if (!supported){
    $("err").textContent = "This browser can't open the portal. Please use a recent version of Chrome, Edge, Firefox or Safari.";
    $("go").disabled = true;
  }

  // ---------- sign in ----------
  var pages = [], cur = -1, user = null, CK = null, cache = {}, navTok = 0;

  // Arriving from another portal's shortcut: fill in the same student's details and sign in (the details never leave this device)
  setTimeout(function(){
    var who = null;
    try { var m = /[#&]signin=([^&]+)/.exec(location.hash); if (m){ who = JSON.parse(decodeURIComponent(escape(atob(decodeURIComponent(m[1]))))); history.replaceState(null, "", location.href.split("#")[0]); } } catch(e){}
    try { if (!who && window.parent !== window && parent.PORTAL_OPENER && parent.PORTAL_OPENER.takeSignin) who = parent.PORTAL_OPENER.takeSignin(D.id, D.title); } catch(e){}
    if (who && who.sn && who.em && !$("login").hidden && !$("go").disabled){
      $("sn").value = who.sn; $("em").value = who.em;
      if ($("form").requestSubmit) $("form").requestSubmit(); else $("go").click();
    }
  }, 250);
  $("form").addEventListener("submit", async function(ev){
    ev.preventDefault();
    var sn = $("sn").value, em = $("em").value;
    $("err").textContent = "";
    if (!normSN(sn) || !normEm(em)){ $("err").textContent = "Enter both your student number and your email address."; return; }
    var btn = $("go");
    btn.disabled = true; btn.innerHTML = '<span class="spin"></span> Checking…';
    try{
      var key = await derive(normSN(sn) + "\n" + normEm(em), D.kdf.salt, D.kdf.iter);
      var entry = null;
      for (var i=0;i<D.keys.length && !entry;i++){
        try { entry = JSON.parse(td.decode(await dec(key, D.keys[i]))); } catch(e){}
      }
      if (!entry){ $("err").textContent = "No match. Check your student number and email address, or ask your instructor."; return; }
      var exp = entry.x || D.exp;   // entry.x is sealed inside the encrypted key, so editing the file's date doesn't help
      if (isClosed(exp)){ showClosed(exp); return; }
      CK = await crypto.subtle.importKey("raw", b64d(entry.k), "AES-GCM", false, ["decrypt"]);
      var raw = await dec(CK, D.content);
      if (D.content.gz) raw = new Uint8Array(await (await gunzipBlob(new Blob([raw]))).arrayBuffer());
      var bundle = JSON.parse(td.decode(raw));
      pages = (bundle.pages || []).map(function(p, i){
        if (p.h != null) return {t:p.t, g:p.g, k:"html", m:"text/html", inline:p.h};   // portals made with the first version
        return p;
      });
      user = { name: entry.n || "", sn: entry.s || sn.trim(), em: normEm(em), exp: exp || null };
      SC = bundle.score && bundle.score.u ? bundle.score : null;
      user.tok = entry.t || "";
      $("sn").value = ""; $("em").value = "";
      startApp();
    } catch(e){
      console.error(e);
      $("err").textContent = "Something went wrong while opening the portal. Try again, or use another browser.";
    } finally {
      btn.disabled = false; btn.textContent = "Open";
    }
  });

  // ---------- app shell ----------
  function startApp(){
    $("login").hidden = true; $("app").hidden = false; closePop();
    $("aTitle").textContent = D.title || "Portal";
    $("aSub").textContent = D.subtitle || "";
    var label = user.name ? "<b>"+esc(user.name)+"</b><br>"+esc(user.sn) : "<b>"+esc(user.sn)+"</b><br>"+esc(user.em);
    $("who").innerHTML = label;
    var html = '<div class="navwho">' + label + '</div>', lastG = null;
    pages.forEach(function(p, i){
      var g = (p.g || "").trim();
      if (g !== lastG){ if (g) html += '<div class="grp">' + esc(g) + '</div>'; lastG = g; }
      html += '<button class="item" data-i="' + i + '">' + (p.k === "portal" ? psIcon(p) : ic(p.k === "link" ? (IC[p.ico] ? p.ico : "link") : IC[p.k] ? p.k : "file")) + '<span>' + esc(p.t || ("Item " + (i+1))) + '</span></button>';
    });
    if (SC && pages.some(function(p){ return p.sc; })) html += '<div class="scstat ok" id="scStatus"></div>';
    html += '<div class="khint">Shortcuts: <kbd>N</kbd> next · <kbd>P</kbd> previous · <kbd>F</kbd> full screen' + (D.ink !== false ? ' · <kbd>A</kbd> annotate' : '') + ' · <kbd>?</kbd> more</div>';
    $("nav").innerHTML = html;
    paintBadges(); flushScores(); fmStart(); psPinsPaint(); wnStart(); upStart();
    if (D.watermark) paintWatermark();
    if (pages.length) show(0); else { $("empty").hidden = false; $("pTitle").textContent = ""; }
  }

  function paintWatermark(){
    var t = [user.name, user.sn, user.em].filter(Boolean).join("  ·  ");
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="460" height="220"><text x="20" y="130" transform="rotate(-22 230 110)" font-family="Arial,sans-serif" font-size="15" fill="#808080" fill-opacity="0.2">' + esc(t) + '</text></svg>';
    $("wm").style.backgroundImage = 'url("data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg) + '")';
  }

  // ---------- content loading ----------
  async function domReady(){
    if (document.readyState === "loading"){
      $("loadTxt").textContent = "Still loading the portal file…";
      await new Promise(function(r){ document.addEventListener("DOMContentLoaded", r, {once:true}); });
    }
  }
  async function getTrack(i, j, prog){                                       // one track of a playlist (its own pieces: c<item>t<track>_<n>)
    var key = i + "t" + j; if (cache[key]) return cache[key];
    var p = pages[i], tr = p.tr && p.tr[j]; if (!tr) throw new Error("This track is missing.");
    await domReady();
    var blob = await loadPieces("c" + p.a + "t" + j, tr.c, tr.m, false, prog);
    var o = {blob: blob, url: URL.createObjectURL(blob)};
    cache[key] = o; return o;
  }
  async function loadPieces(pre, count, mime, gz, prog){
    var parts = [];
    for (var n=0;n<count;n++){
      var cid = pre + "_" + n, el = document.getElementById(cid), t = el ? el.textContent : "";
      if (!el && typeof window.PORTAL_CHUNK === "function") t = await window.PORTAL_CHUNK(cid);
      if (!t) throw new Error("This item is missing from the portal file. The download may be incomplete.");
      var dot = t.indexOf(".");
      parts.push(new Blob([await dec(CK, {iv: t.slice(0, dot), ct: t.slice(dot + 1)})]));
      t = "";
      if (prog) prog((n + 1) / count);
      if (n % 4 === 3) await tick();
    }
    var blob = new Blob(parts, {type: mime || "application/octet-stream"});
    if (gz) blob = new Blob([await gunzipBlob(blob)], {type: mime});
    return blob;
  }
  async function getAsset(i, prog){
    if (cache[i]) return cache[i];
    var p = pages[i], o;
    if (p.inline != null){
      o = {text: p.inline};
    } else {
      await domReady();
      var parts = [];
      for (var n=0;n<p.c;n++){
        var cid = "c" + p.a + "_" + n, el = document.getElementById(cid), t = el ? el.textContent : "";
        // Opened through the Portal Opener: the materials are kept on the device piece by piece and fetched only when needed
        if (!el && typeof window.PORTAL_CHUNK === "function") t = await window.PORTAL_CHUNK(cid);
        if (!t) throw new Error("This item is missing from the portal file. The download may be incomplete.");
        var dot = t.indexOf(".");
        parts.push(new Blob([await dec(CK, {iv: t.slice(0, dot), ct: t.slice(dot + 1)})]));   // each piece handed over as it is unlocked: lower peak memory
        t = "";
        if (prog) prog((n + 1) / p.c);
        if (n % 4 === 3) await tick();
      }
      var blob = new Blob(parts, {type: p.m || "application/octet-stream"});
      if (p.gz) blob = new Blob([await gunzipBlob(blob)], {type: p.m});
      o = {blob: blob, url: URL.createObjectURL(blob)};
      if (p.k === "html") o.text = await blob.text();
    }
    cache[i] = o;
    return o;
  }
  function evict(keep){
    Object.keys(cache).forEach(function(k){
      var o = cache[k], tm = /^(\d+)t(\d+)$/.exec(k);
      if (tm){                                                              // playlist tracks: keep only the ones now playing
        if ([NP, CUR].some(function(x){ return x && x.i === +tm[1] && x.tr === +tm[2]; })) return;
        URL.revokeObjectURL(o.url); delete cache[k]; return;
      }
      if (+k !== keep && !(NP && NP.i === +k) && !(CUR && CUR.i === +k) && o.blob && o.blob.size > 25*1048576){ URL.revokeObjectURL(o.url); delete cache[k]; }
    });
  }

  // ---------- practice score recording ----------
  // Scored items (quick checks, mock tests) report "points / total". Results are kept on this device and sent to the
  // instructor's Google Sheet whenever the device is online; the sheet keeps each student's best attempt.
  // Practice-mode results can be skipped, and a study file holding several tests (Mock Test 1, Mock Test 2…) reports each separately.
  var SC = null, scoreSess = {}, sending = false, scState = "", skipToldAt = {};
  var SC_PREFIX = "portal-scores:" + (D.id || "x") + ":";
  function scKey(){ return SC_PREFIX + normSN(user.sn); }
  function scLoad(k){ try { var o = JSON.parse(localStorage.getItem(k || scKey())) || {}; o.latest = o.latest || {}; o.queue = o.queue || []; return o; } catch(e){ return {latest:{}, queue:[]}; } }
  function scStore(o, k){ try { localStorage.setItem(k || scKey(), JSON.stringify(o)); return true; } catch(e){ return false; } }
  function itemKey(p){ return String(p.t || "").trim().toLowerCase(); }
  function newSess(){ return {attempt: rid(), last: null, hooked: false, opened: Date.now(), start: null, mark: null, n: 0}; }
  function rid(){ var a = crypto.getRandomValues(new Uint8Array(9)); return Array.prototype.map.call(a, function(b){ return (b % 36).toString(36); }).join(""); }
  function tidy(s){ return String(s).replace(/\s+/g, " ").trim().replace(/\b([a-z])/g, function(m){ return m.toUpperCase(); }).replace(/\b([ivx]{1,4})\b/gi, function(m){ return m.toUpperCase(); }); }

  // Test codes (no spaces): <base><kind><n>, e.g. L2MDPHYS11QC1, L2MDPHYS11MT2, L11MDPHYS11ME1
  //   base = L<lesson no.><subject code> (set per item in Portal Builder) · QCn = quick checks of Part n combined · MTn/MEn = Mock Test/Exam n
  function romanNum(s){ var v = {i:1,v:5,x:10}, t = 0, a = String(s).toLowerCase(); for (var k=0;k<a.length;k++){ var c = v[a[k]] || 0, nx = v[a[k+1]] || 0; t += c < nx ? -c : c; } return t; }
  function numOf(s){ return /^\d+$/.test(s) ? +s : romanNum(s); }
  function baseCode(p, i){
    if (p.code) return p.code;
    var m = /\blesson\s*(\d+)|\bL\s*(\d+)\b|\bweek\s*(\d+)|\bmodule\s*(\d+)/i.exec((p.t || "") + " " + (p.nm || "")), n = 0;
    if (m) n = +(m[1] || m[2] || m[3] || m[4]);
    if (!n){ n = 1; for (var k = 0; k < i; k++) if (pages[k] && pages[k].sc) n++; }
    return "L" + n + (D.subj || "");
  }
  function kindLabel(code){
    var m = /^(QC|MT|ME)(\d+)$/.exec(code) || [];
    return code === "QCTOTAL" ? "Quick checks (whole lesson)" : m[1] === "MT" ? "Mock Test " + m[2] : m[1] === "ME" ? "Mock Exam " + m[2] : code;
  }
  // ---- answer key safeguard: once a lesson's answer key is opened, its best scores so far are final
  var lockToldAt = {};
  function lockId(p){ return p.sid || ("t:" + itemKey(p)); }
  function isLocked(p){ var l = scLoad().locks; return !!(l && l[lockId(p)]); }
  function lockItem(i){
    var p = pages[i]; if (!SC || !p || !p.sc || !user || isLocked(p)) return;
    var st = scLoad(), now = new Date().toISOString();
    st.locks = st.locks || {}; st.locks[lockId(p)] = now;
    st.queue.push({type: "lock", id: rid(), portal: D.id, portalTitle: D.title || "", sn: user.sn, name: user.name, email: user.em, tok: user.tok || "",
                   item: baseCode(p, i), itemTitle: p.t, itemId: lockId(p), at: now});
    st.to = {u: SC.u, k: SC.k};
    scStore(st); paintBadges(); flushScores();
    toast("Answer key opened — your best scores in this lesson are now final. New attempts won't be recorded.");
  }
  var keyAsk = null;
  function askKey(go){
    var m = $("keyAsk"); keyAsk = go;
    (document.fullscreenElement || document.webkitFullscreenElement ? $("stage") : document.body).appendChild(m);
    m.hidden = false; $("keyNo").focus();
  }
  function closeKeyAsk(ok){ var m = $("keyAsk"), go = keyAsk; m.hidden = true; keyAsk = null; if (ok && go) go(); }
  $("keyNo").onclick = function(){ closeKeyAsk(false); };
  $("keyYes").onclick = function(){ closeKeyAsk(true); };
  $("keyAsk").addEventListener("click", function(e){ if (e.target === this) closeKeyAsk(false); });
  $("keyAsk").addEventListener("keydown", function(e){ if (e.key === "Escape"){ e.stopPropagation(); closeKeyAsk(false); } });
  var KEY_CTRL = /\banswer\s*keys?\b|\bkey\s+to\s+corrections?\b|\b(show|reveal|view|see|open|display)\s+all\s+(the\s+)?(correct\s+)?answers\b|\b(show|reveal|view|see|open|display)\s+(me\s+)?the\s+(answer\s+)?key\b/i;
  var KEY_HEAD = /^\s*(the\s+)?(answer\s*keys?|key\s+to\s+corrections?)\b/i;
  var CTRL_SEL = 'a,button,nav,label,select,option,[role=button],[role=tab],[role=link],[role=navigation],[role=menuitem]';
  var BTN_SEL = 'button,[role=button],input[type=button],input[type=submit],summary';
  // A heading that names the answer key (not a link or button that merely points to it)
  function keyHeadsVisible(d){
    var out = [];
    try { d.querySelectorAll("h1,h2,h3,h4,h5,h6,summary,legend,caption,th,.title,.heading,strong,b").forEach(function(el){
      if (el.tagName !== "SUMMARY" && el.closest(CTRL_SEL)) return;
      if (visible(el) && KEY_HEAD.test(el.textContent || "")) out.push(el);
    }); } catch(e){}
    return out;
  }
  // A visible button that reveals the key ("Show the key", "Open answer key") — the key itself is still closed
  function keyGateIn(root){
    try { return [].some.call(root.querySelectorAll(BTN_SEL), function(b){ var t = labelOf(b); return visible(b) && !b.disabled && t && t.length <= 80 && KEY_CTRL.test(t); }); } catch(e){ return false; }
  }
  // A link to an answer-key page that is itself behind a reveal button: following the link shows nothing yet
  function gatedTarget(d, el){
    if (!el || el.tagName !== "A") return false;
    var h = el.getAttribute("href") || "", id = h.indexOf("#") >= 0 ? h.slice(h.indexOf("#") + 1).replace(/^[!\/]+/, "").split(/[\/?&]/)[0] : "";
    if (!id) return false;
    var t = null; try { t = d.getElementById(decodeURIComponent(id)) || d.querySelector('[data-view="' + id.replace(/"/g, "") + '"],[data-page="' + id.replace(/"/g, "") + '"],[name="' + id.replace(/"/g, "") + '"]'); } catch(e){}
    if (!t) return false;
    var region = t.closest('[data-view],[data-page],.view,.page,.slide,section,article') || t;
    if (region === t && t.parentElement && !t.querySelector(BTN_SEL)) region = t.parentElement;
    return [].some.call(region.querySelectorAll(BTN_SEL), function(b){ var x = labelOf(b) || b.textContent || ""; return x.length <= 80 && KEY_CTRL.test(x.trim()); });
  }
  // "Study More" on a term cover (e.g. End of Midterm) → the first item of that cover's own section (Midterm),
  // not the start of the whole portal. Runs before the page's own button code, so it works with any cover.
  var COVER_RE = /^\W*(welcome\b|end of\b|start of\b|opening\b|closing\b|term cover\b)|\bcover( page)?\s*$/i;
  function sectionStart(i){
    var g = String(pages[i].g || "").trim(), a = i, z = i;
    while (a > 0 && String(pages[a - 1].g || "").trim() === g) a--;
    while (z + 1 < pages.length && String(pages[z + 1].g || "").trim() === g) z++;
    for (var k = a; k <= z; k++) if (k !== i && !COVER_RE.test(pages[k].t || "") && !notYet(pages[k])) return k;   // first open resource: skip covers and not-yet-open items
    return a !== i ? a : Math.min(i + 1, z);
  }
  function hookStudyMore(w, i, tok){
    w.addEventListener("click", function(e){
      var el = e.target && e.target.closest ? e.target.closest('a,button,[role=button],input[type=button],input[type=submit]') : null;
      if (!el) return;
      var t = String(el.innerText || el.value || el.textContent || "").replace(/[^A-Za-z]+/g, " ").trim();
      if (!/^study more$/i.test(t)) return;
      e.preventDefault(); e.stopImmediatePropagation();
      if (tok === navTok) show(sectionStart(i));
    }, true);
  }

  function guardKey(w, i, tok){
    var p = pages[i]; if (!SC || !p || !p.sc) return;
    var d = w.document, allow = null, seen = keyHeadsVisible(d);           // answer-key headings already showing when opened don't count
    d.addEventListener("click", function(e){
      if (tok !== navTok || isLocked(p) || (CB && CB.type === "exam" && CB.i === i)) return;
      var el = e.target && e.target.closest ? e.target.closest('button,a,summary,[role=button],[role=tab],label,input[type=button],input[type=submit],input[type=checkbox],input[type=radio],li,.tab,.btn') : null;
      if (!el) return;
      var txt = labelOf(el); if (!txt || txt.length > 80 || !KEY_CTRL.test(txt)) return;
      if (allow === el){ allow = null; return; }
      if (gatedTarget(d, el)) return;                                      // just goes to the key page; its own button opens the key
      e.preventDefault(); e.stopImmediatePropagation();
      askKey(function(){ lockItem(i); allow = el; el.click(); });
    }, true);
    return function(){                                                     // called on page changes: an answer key that appeared some other way
      if (isLocked(p)) return;
      var now = keyHeadsVisible(d).filter(function(el){ return seen.indexOf(el) < 0; });
      if (!now.length) return;
      var region = now[0].closest('[data-view],[data-page],.view,.page,.slide') || d.body;
      if (keyGateIn(region) || keyGateIn(d.body)) return;                  // key page is showing but its reveal button hasn't been pressed
      lockItem(i);
    };
  }
  function recordScore(i, score, total, how, info){
    var p = pages[i]; if (!SC || !p || !p.sc || !user) return;
    if (isLocked(p)){
      if (!lockToldAt[i] || Date.now() - lockToldAt[i] > 60000){ lockToldAt[i] = Date.now(); toast("Not recorded — the answer key for this lesson was opened, so your best scores before that are final."); }
      return;
    }
    info = info || {};
    score = Number(score); total = Number(total);
    if (!isFinite(score) || !isFinite(total) || total <= 0 || score < 0 || score > total) return;
    var kc = info.code || "QCTOTAL", code = baseCode(p, i) + kc, label = kindLabel(kc);
    var tid = (p.sid || ("t:" + itemKey(p))) + "#" + kc.toLowerCase();
    var sk = i + "#" + kc;
    if (info.mode === "practice" && p.xp !== false && !/^QC/.test(kc)){   // practice mode of a mock: not recorded
      if (!skipToldAt[sk] || Date.now() - skipToldAt[sk] > 60000){ skipToldAt[sk] = Date.now(); toast(label + ": practice mode — this score isn't recorded. Use Exam mode to record your score."); }
      return;
    }
    var ses = scoreSess[sk] || (scoreSess[sk] = newSess());
    var base = scoreSess[i];                                                       // timing marks are tracked per item
    var fresh = how === "hook" || ses.last == null || score < ses.last || info.restart;
    if (how === "hook") ses.hooked = true;
    if (fresh){
      // timed from the latest of: opening the item, choosing this test/mode, or (after an earlier result) the first new answer
      var t0 = [(base && base.opened) || ses.opened, info.since || 0, (base && base.rec && base.mark) || 0];
      ses.attempt = rid(); ses.start = Math.max.apply(null, t0); ses.n++;
    }
    ses.last = score; if (base){ base.mark = null; base.rec = true; }
    var secs = Math.max(0, Math.round((Date.now() - ses.start) / 1000));
    var st = scLoad(), pct = Math.round(score / total * 1000) / 10, prev = st.latest[tid];
    var better = !prev || score > (prev.bestScore || 0) || (score === prev.bestScore && pct > prev.best);   // best = most points
    st.latest[tid] = {item: i, name: code, label: label, score: score, total: total, pct: pct,
                      best: better ? pct : prev.best, bestScore: better ? score : prev.bestScore, bestTotal: better ? total : prev.bestTotal, at: new Date().toISOString()};
    var r = {id: rid(), portal: D.id, portalTitle: D.title || "", sn: user.sn, name: user.name, email: user.em, tok: user.tok || "",
             item: code, itemTitle: p.t, itemId: tid, ix: i, score: score, total: total, secs: secs, attempt: ses.attempt, at: new Date().toISOString(),
             closeAt: user.exp ? new Date(endOfDay(user.exp)).toISOString() : ""};
    st.queue = st.queue.filter(function(q){ return !(q.itemId === r.itemId && q.attempt === r.attempt); });   // keep only the newest of a running attempt
    st.queue.push(r);
    if (st.queue.length > 500) st.queue = st.queue.slice(-500);
    st.to = {u: SC.u, k: SC.k};
    scStore(st);
    paintBadges();
    flushScores().then(function(){
