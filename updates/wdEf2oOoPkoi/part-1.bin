    Object.keys(cache).forEach(function(k){ if (cache[k].url) URL.revokeObjectURL(cache[k].url); });
    cache = {}; pages = []; user = null; cur = -1; CK = null; IV = null; ivPaint(); SYN.m = null; SYN.th = {}; SYN.last = -1; todApply(); SYNHTML = ""; $("synBox").hidden = true; $("synBtn").hidden = true; $("synFrame").srcdoc = ""; $("synFrame").dataset.who = "";
    $("nav").innerHTML = ""; $("wm").style.backgroundImage = ""; $("loading").hidden = true;
    $("app").hidden = true; $("login").hidden = false; $("sn").focus();
  };
})();
</script>
