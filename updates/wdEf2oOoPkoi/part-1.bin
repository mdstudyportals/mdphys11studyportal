<script>
(function(){
  "use strict";
  var D = JSON.parse(document.getElementById("portal-data").textContent);
  var $ = function(id){ return document.getElementById(id); };
  // ---------- online updates (optional, set in Portal Builder) ----------
  // The instructor uploads each new version next to the Portal Opener. A portal opened from its file on a computer fetches it
  // when online and keeps it on this computer; from then on, opening the (older) file opens the newer version instead —
  // before anything else of this file runs. Nothing is sent anywhere; the material stays locked to the class list.
  var UPK = "portal-upd:" + D.id, UPOFF = "portal-upd-off:" + D.id, UP_AUTO = 60 * 1048576;
  function upLs(k, v){ try { if (v === undefined) return localStorage.getItem(k); if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch(e){} return null; }
  function upFlag(){ try { return JSON.parse(upLs(UPK) || "null"); } catch(e){ return null; } }
  function upCan(){ return !!D.upd && /^https?:\/\//.test(D.upd) && location.protocol === "file:" && window.parent === window; }
  function upOn(){ return upCan() && upLs(UPOFF) !== "1"; }
  function upDb(cb){ try { var q = indexedDB.open("portal-updates", 1); q.onupgradeneeded = function(){ q.result.createObjectStore("files"); }; q.onsuccess = function(){ cb(q.result); }; q.onerror = function(){ cb(null); }; q.onblocked = function(){ cb(null); }; } catch(e){ cb(null); } }
  function upGetRec(cb){ upDb(function(db){ if (!db) return cb(null); try { var r = db.transaction("files").objectStore("files").get(D.id); r.onsuccess = function(){ cb(r.result || null); }; r.onerror = function(){ cb(null); }; } catch(e){ cb(null); } }); }
  function upPutRec(rec){ return new Promise(function(ok, bad){ upDb(function(db){ if (!db) return bad(new Error("no storage"));
    try { var t = db.transaction("files", "readwrite"); if (rec) t.objectStore("files").put(rec, D.id); else t.objectStore("files").delete(D.id); t.oncomplete = function(){ ok(); }; t.onerror = t.onabort = function(){ bad(t.error || new Error("storage")); }; } catch(e){ bad(e); } }); }); }
  function upClear(){ upLs(UPK, null); return upPutRec(null).catch(function(){}); }
  var UP_SWAP = (function(){ var f = upFlag(); return !!(f && upOn() && !/[#&]noupdate\b/.test(location.hash) && Date.parse(f.built) > (Date.parse(D.built) || 0)); })();
  if (UP_SWAP){                                                            // open the newer version kept on this computer
    var upGo = function(){
      try { $("pVer").textContent = "Opening the newest version…"; $("go").disabled = true; } catch(e){}
      upGetRec(function(rec){
        if (!rec || !rec.blob){ upLs(UPK, null); location.reload(); return; }
        rec.blob.text().then(function(t){ window.__portalUpd = 1; document.open(); document.write(t); document.close(); }, function(){ upLs(UPK, null); location.reload(); });
      });
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", upGo); else upGo();
    return;
  }
  if (/^data:image\//.test(D.logo || "")){                                // the portal's own logo: browser tab, sign-in screen, top bar
    if (!document.querySelector('link[rel~="icon"]')) try { var fl = document.createElement("link"); fl.rel = "icon"; fl.type = "image/png"; fl.href = /^data:image\//.test(D.favi || "") ? D.favi : D.logo; document.head.appendChild(fl); } catch(e){}
    ["lLogo", "aLogo"].forEach(function(id){ var im = $(id); if (im){ im.src = D.logo; im.hidden = false; } });
  }
  var te = new TextEncoder(), td = new TextDecoder();

  var IC = {
    html:'<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
    image:'<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>',
    pdf:'<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M8.5 16v-4h1.2a1.2 1.2 0 0 1 0 2.4H8.5M13 12v4h.8a2 2 0 0 0 0-4zM17.5 12h-1.6v4M15.9 14h1.3"/>',
    video:'<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10 9 5 3-5 3z"/>',
    audio:'<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
    playlist:'<path d="M3 6h11M3 11h11M3 16h7"/><path d="M17 17V6l4-1"/><circle cx="15" cy="17" r="2.2"/>',
    portal:'<rect x="3" y="4" width="13" height="16" rx="2"/><path d="M12 12h9M18 9l3 3-3 3"/>',
    link:'<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>',
    ext:'<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>',
    file:'<path d="m21 11-8.6 8.6a5 5 0 0 1-7-7l8.5-8.6a3.4 3.4 0 0 1 4.8 4.8l-8.6 8.5a1.7 1.7 0 0 1-2.4-2.4l7.9-7.9"/>',
    menu:'<path d="M4 6h16M4 12h16M4 18h16"/>',
