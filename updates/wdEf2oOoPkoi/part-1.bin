  function npTick(){                                                         // progress bar and times
    if (!NP || $("npMini").hidden || npSeeking) return;
    var inf = npInfo(NP);
    $("npCur").textContent = clock(inf.t); $("npDur").textContent = inf.d ? clock(inf.d) : "–:––";
    $("npSeek").value = inf.d ? Math.round(inf.t / inf.d * 1000) : 0;
  }
  setInterval(function(){ if (NP && !document.hidden) npTick(); }, 400);
  var npSeeking = false;
  function npSeekTo(sec, s){
    s = s || NP; if (!s) return; var d = npInfo(s).d; sec = Math.max(0, d ? Math.min(d - 0.25, sec) : sec);
    if (s.kind === "media"){ s.el.currentTime = sec; return; }
    s.t = sec; s.tAt = performance.now();
