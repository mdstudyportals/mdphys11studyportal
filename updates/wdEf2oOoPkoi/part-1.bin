<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="robots" content="noindex,nofollow">
<meta name="portal-runtime" content="chunks-external">
<title>Medical Physiology</title>
<meta name="theme-color" content="#8c1d2f">
<meta name="application-name" content="MDPHYS 11">
<meta name="apple-mobile-web-app-title" content="MDPHYS 11">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">

<script>
window.PT = (function(){
  var DEF = {"accent":"maroon","mode":"auto","outline":"#d4a017","id":"wdEf2oOoPkoi"};
  var P = {
    forest:{n:"Forest", l:"#0f5c4d", d:"#62c2a8"},
    navy:  {n:"Navy",   l:"#1f3f8f", d:"#8fb0ff"},
    maroon:{n:"Maroon", l:"#8c1d2f", d:"#f08b9b"},
    plum:  {n:"Plum",   l:"#5b2a86", d:"#c4a1f0"},
    ocean: {n:"Ocean",  l:"#0b6e8a", d:"#6cc8e3"},
    amber: {n:"Amber",  l:"#8a5300", d:"#f0c46a"},
    rose:  {n:"Rose",   l:"#a1305f", d:"#f39ac0"},
    slate: {n:"Slate",  l:"#2f3a44", d:"#b8c4ce"}
  };
  function rgb(h){ h = h.replace("#",""); return [0,2,4].map(function(i){ return parseInt(h.substr(i,2),16); }); }
  function hex(c){ return "#" + c.map(function(v){ v = Math.max(0,Math.min(255,Math.round(v))); return (v<16?"0":"") + v.toString(16); }).join(""); }
  function lum(h){ var c = rgb(h).map(function(v){ v/=255; return v<=0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055,2.4); }); return 0.2126*c[0]+0.7152*c[1]+0.0722*c[2]; }
  function mix(h, t, f){ var a = rgb(h), b = rgb(t); return hex(a.map(function(v,i){ return v + (b[i]-v)*f; })); }
  function fit(h, target, test){ var c = h; for (var i=0;i<20 && !test(lum(c));i++) c = mix(c, target, 0.12); return c; }
  function pal(a){
    if (P[a]) return P[a];
    if (/^#[0-9a-f]{6}$/i.test(a||"")) return {n:"Custom", l:fit(a,"#000000",function(L){return L<=0.16;}), d:fit(a,"#ffffff",function(L){return L>=0.32;})};
    return P.forest;
  }
  var KEY = "portal-theme:" + (DEF.id || "x");
  function get(){ try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch(e){ return {}; } }
  function set(o){ try { localStorage.setItem(KEY, JSON.stringify(o)); } catch(e){} }
  var mq = window.matchMedia ? matchMedia("(prefers-color-scheme: dark)") : {matches:false};
  function apply(){
    var p = get(), mode = p.mode || DEF.mode || "auto", acc = DEF.accent || "forest";   // colours: the instructor's (set in Portal Builder)
    var dark = mode === "dark" || (mode === "auto" && mq.matches);
    var r = document.documentElement, c = pal(acc), a = dark ? c.d : c.l;
    r.setAttribute("data-theme", dark ? "dark" : "light");
    r.style.setProperty("--accent", a);
    r.style.setProperty("--accent-ink", lum(a) > 0.4 ? "#0c1210" : "#ffffff");
    var o = DEF.outline || "none";
    var rs = p.rs || {}, R = {size: 1, font: "", lh: "", ls: "", hc: 0, ul: 0, la: 0, rm: 0, ruler: 0};
    Object.keys(R).forEach(function(k){ if (rs[k] != null) R[k] = rs[k]; });
    r.style.setProperty("--rs-size", R.size);
    ["font", "lh", "ls"].forEach(function(k){ if (R[k]) r.setAttribute("data-rs-" + k, R[k]); else r.removeAttribute("data-rs-" + k); });
    ["hc", "ul", "la", "rm"].forEach(function(k){ if (R[k]) r.setAttribute("data-rs-" + k, ""); else r.removeAttribute("data-rs-" + k); });
    if (o && o !== "none"){ var c2 = pal(o); r.style.setProperty("--accent2", dark ? c2.d : c2.l); r.setAttribute("data-outline", ""); }
    else { r.style.removeProperty("--accent2"); r.removeAttribute("data-outline"); }
    return {mode:mode, accent:acc, outline:o || "none", dark:dark, rs:R};
  }
  if (mq.addEventListener) mq.addEventListener("change", function(){ apply(); if (window.PT && PT.onchange) PT.onchange(); });
  apply();
  return {P:P, DEF:DEF, pal:pal, get:get, set:set, apply:apply};
})();
</script>
<style>
:root{
  --accent:#0f5c4d;--accent-ink:#fff;
  --bg:color-mix(in srgb,var(--accent) 5%,#f5f4f0);
  --panel:color-mix(in srgb,var(--accent) 2%,#fffefb);
  --line:color-mix(in srgb,var(--accent) 12%,#e3ded2);
  --accent-soft:color-mix(in srgb,var(--accent) 12%,var(--panel));
  --ink:#1c2320;--muted:#5b6560;--danger:#a3361f;--stage:#e6e4de;
  --shadow:0 1px 2px rgba(0,0,0,.04),0 10px 30px rgba(20,30,25,.10);
  --serif:Georgia,"Iowan Old Style","Palatino Linotype",Palatino,serif;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  color-scheme:light;
}
:root[data-theme=dark]{
  --bg:color-mix(in srgb,var(--accent) 6%,#0f1211);
  --panel:color-mix(in srgb,var(--accent) 6%,#171c1a);
  --line:color-mix(in srgb,var(--accent) 14%,#2a312e);
  --ink:#e7ece9;--muted:#9ea9a3;--danger:#ef8f76;--stage:#0b0d0c;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.4);
  color-scheme:dark;
}
@supports not (color:color-mix(in srgb,red,blue)){
  :root{--bg:#f3f0e8;--panel:#fffdf8;--line:#e1dbcd;--accent-soft:#e8eeea}
  :root[data-theme=dark]{--bg:#111513;--panel:#1a201d;--line:#2b3430;--accent-soft:#222a27}
}
/* secondary (outline) color — only when the instructor or student picks one */
:root[data-outline] #login .card{border:2px solid var(--accent2)}
:root[data-outline] .note{border-left:4px solid var(--accent2)}
:root[data-outline] .eyebrow,:root[data-outline] .grp,:root[data-outline] .poph{color:var(--accent2)}
:root[data-outline] .btn:not(.ghost){box-shadow:inset 0 0 0 2px var(--accent2)}
:root[data-outline] .btn.ghost{border-color:color-mix(in srgb,var(--accent2) 55%,var(--line))}
:root[data-outline] input:focus{border-color:var(--accent2);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent2) 28%,transparent)}
:root[data-outline] header.top{border-bottom:3px solid var(--accent2)}
:root[data-outline] nav{border-right-color:color-mix(in srgb,var(--accent2) 45%,var(--line))}
:root[data-outline] .bar{border-bottom-color:color-mix(in srgb,var(--accent2) 45%,var(--line))}
:root[data-outline] nav button.item[aria-current=true]{box-shadow:inset 4px 0 0 var(--accent2)}
:root[data-outline] .filecard>div,:root[data-outline] .linkcard,:root[data-outline] .pop{border:2px solid var(--accent2)}
:root[data-outline] .pbar i{background:var(--accent2)}
*{box-sizing:border-box}
:root{--vh:100vh}
@supports (height:100dvh){:root{--vh:100dvh}}
html,body{height:100%;margin:0}
button,a.btn{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
body{background:var(--bg);color:var(--ink);font:15px/1.5 var(--sans);-webkit-font-smoothing:antialiased}
button,input{font:inherit;color:inherit}
[hidden]{display:none!important}
svg.i{width:18px;height:18px;flex:none}

/* ---------- Login ---------- */
#login{min-height:100%;display:flex;align-items:center;justify-content:center;padding:32px 16px}
.card{position:relative;width:100%;max-width:420px;background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:32px 28px 26px}
.card .tbtn{position:absolute;top:14px;right:14px}
.eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-weight:700}
.eyebrow svg{width:14px;height:14px}
h1{font-family:var(--serif);font-weight:600;font-size:28px;line-height:1.2;margin:10px 0 4px;letter-spacing:-.01em}
.sub{color:var(--muted);margin:0 0 6px}
.note{margin:14px 0 0;padding:10px 12px;background:var(--accent-soft);border-radius:8px;font-size:14px;white-space:pre-line}
form{margin-top:22px;display:grid;gap:14px}
label{display:grid;gap:6px;font-size:13px;font-weight:600;color:var(--muted)}
input[type=text],input[type=email]{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg);font-size:16px;font-weight:400;color:var(--ink);outline:none;transition:border-color .15s,box-shadow .15s}
input:focus{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:0;border-radius:8px;padding:11px 16px;font-weight:600;cursor:pointer;background:var(--accent);color:var(--accent-ink);text-decoration:none}
.btn:disabled{opacity:.5;cursor:default}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line);padding:7px 11px;font-weight:500}
.btn.ghost:hover:not(:disabled){background:var(--accent-soft)}
.btn.icon{padding:7px 8px}
.err{color:var(--danger);font-size:14px;min-height:21px;margin:0}
.avail{display:flex;align-items:center;gap:6px;margin:14px 0 0;font-size:13px;color:var(--muted)}
.avail svg{width:15px;height:15px}
.closed{margin-top:20px;padding:16px;border-radius:10px;background:color-mix(in srgb,var(--danger) 10%,var(--panel));border:1px solid color-mix(in srgb,var(--danger) 35%,var(--line))}
.closed b{display:flex;align-items:center;gap:8px;color:var(--danger);font-size:15px;margin-bottom:4px}
.closed p{margin:0;font-size:14px}
.foot{margin-top:18px;padding-top:14px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted)}
.spin{width:16px;height:16px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:sp .7s linear infinite;flex:none}
@keyframes sp{to{transform:rotate(360deg)}}

/* ---------- Theme popover ---------- */
.pop{position:fixed;z-index:60;width:260px;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:12px 14px 14px}
.poph{font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700;margin:4px 0 8px}
.seg{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:8px;overflow:hidden;margin-bottom:14px}
.seg button{border:0;background:transparent;padding:7px 4px;cursor:pointer;font-size:13.5px}
.seg button+button{border-left:1px solid var(--line)}
.seg button[aria-pressed=true]{background:var(--accent);color:var(--accent-ink);font-weight:600}
.aa{font:700 16px/1 Georgia,"Times New Roman",serif;letter-spacing:-.02em}.aa small{font-size:12px;font-weight:700}
.rspop{width:300px;max-height:calc(100vh - 80px);overflow:auto}
.rspop .poph{display:flex;justify-content:space-between;align-items:baseline;margin-top:14px}
.rspop .poph:first-child{margin-top:4px}
.rsv{font-size:12px;letter-spacing:0;text-transform:none;color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums}
.rspop .seg.col3{display:grid;grid-template-columns:repeat(3,1fr)}
.rspop .seg.col2,.rspop #modeSeg{display:grid;grid-template-columns:repeat(2,1fr)}
.rspop #modeSeg{grid-template-columns:repeat(3,1fr)}
.rspop .seg button{min-height:34px}
.rsrow{display:flex;align-items:center;gap:8px}
.rsrow input{flex:1;accent-color:var(--accent)}
.rsab{width:34px;height:34px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font:700 13px/1 inherit;cursor:pointer}
.rsab.big{font-size:17px}
.f-atk{font-family:"PortalAtk",system-ui,sans-serif!important}.f-dys{font-family:"PortalDys",system-ui,sans-serif!important;font-size:12px!important}
.rstog{display:flex;gap:10px;align-items:flex-start;padding:7px 2px;font-size:13px;cursor:pointer;border-top:1px solid var(--line)}
.rstog:first-of-type{border-top:0}
.rstog input{margin-top:2px;accent-color:var(--accent);width:16px;height:16px;flex:none}
.rstog b{display:block;font-weight:650}
.rstog span{color:var(--muted);line-height:1.35}.rstog span b{color:var(--ink)}
.rsnote{font-size:11.5px;color:var(--muted);margin:10px 0 6px;line-height:1.4}
/* reading settings in the portal itself */
:root[data-rs-font=atk] body{font-family:"PortalAtk",system-ui,sans-serif}
:root[data-rs-font=dys] body{font-family:"PortalDys",system-ui,sans-serif}
:root[data-rs-font] body :is(h1,h2,h3,.brand,.lt b){font-family:inherit}
nav button.item{font-size:calc(14.5px * var(--rs-size,1))}
#ptWrap{font-size:calc(15px * var(--rs-size,1))}
#ptWrap .ptq legend,#ptWrap .ptq .lg,#ptWrap .ptq label,#ptWrap .ptq .opt{font-size:1em}
#ptWrap .ptq .rat,#ptWrap .pth p{font-size:.92em}
:root[data-rs-lh=m] #ptWrap,:root[data-rs-lh=m] .rqbar,:root[data-rs-lh=m] .lnote{line-height:1.8}
:root[data-rs-lh=l] #ptWrap,:root[data-rs-lh=l] .rqbar,:root[data-rs-lh=l] .lnote{line-height:2.1}
:root[data-rs-ls=w] #ptWrap,:root[data-rs-ls=w] nav button.item,:root[data-rs-ls=w] .rqbar{letter-spacing:.05em;word-spacing:.16em}
:root[data-rs-hc]{--ink:#000;--muted:#2b2b2b;--line:#6b6b6b}
:root[data-rs-hc][data-theme=dark]{--ink:#fff;--muted:#e2e2e2;--line:#a5a5a5}
:root[data-rs-hc] :focus-visible{outline:3px solid var(--ink)!important;outline-offset:2px}
:root[data-rs-hc] .pdfpage canvas,:root[data-rs-hc] #view img{filter:contrast(1.18)}
:root[data-rs-ul] a{text-decoration:underline!important}
:root[data-rs-rm] *,:root[data-rs-rm] *::before,:root[data-rs-rm] *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
#rsRuler{position:fixed;inset:0;z-index:58;pointer-events:none}
#rsRuler>div{position:absolute;left:0;right:0}
#rsRuler .rsr-top{top:0;background:rgba(0,0,0,.28)}
#rsRuler .rsr-bot{bottom:0;background:rgba(0,0,0,.28)}
#rsRuler .rsr-band{border-top:2px solid var(--accent);border-bottom:2px solid var(--accent);background:color-mix(in srgb,var(--accent) 6%,transparent)}
.sw{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.sw button{aspect-ratio:1;border-radius:50%;border:2px solid transparent;cursor:pointer;padding:0;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
.sw button[aria-pressed=true]{outline:2px solid var(--ink);outline-offset:2px}
.sw button.none{background:linear-gradient(135deg,transparent 44%,var(--muted) 44% 56%,transparent 56%) var(--bg)!important;box-shadow:inset 0 0 0 1px var(--line)}
.sw button.ring{background:transparent!important;box-shadow:inset 0 0 0 5px var(--c)}
.sw+.poph{margin-top:14px}
.linkbtn{margin-top:12px;border:0;background:none;padding:0;color:var(--accent);font-size:13px;cursor:pointer;text-decoration:underline;text-underline-offset:2px}

/* ---------- App ---------- */
#app{height:100%;height:var(--vh);display:grid;grid-template-rows:auto 1fr}
header.top{display:flex;align-items:center;gap:10px;padding:10px 16px;background:var(--panel);border-bottom:1px solid var(--line);min-width:0}
.brand{min-width:0;flex:1}
.llogo{display:block;width:68px;height:68px;object-fit:contain;margin:0 0 14px}
.alogo{flex:none;width:34px;height:34px;object-fit:contain}
.wnic.lgo{background:none;width:42px;height:42px}.wnic.lgo img{width:42px;height:42px;object-fit:contain}
@media (max-width:600px){.alogo{width:28px;height:28px}}
.brand b{display:block;font-family:var(--serif);font-size:18px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brand span{display:block;font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.who{font-size:13px;color:var(--muted);text-align:right;white-space:nowrap;margin-right:4px}
.who b{color:var(--ink);font-weight:600}
.body{display:grid;grid-template-columns:280px 1fr;min-height:0;transition:grid-template-columns .2s ease}
body.navc .body{grid-template-columns:0 1fr}
body.navc nav{visibility:hidden;padding:0;border:0}
nav{background:var(--panel);border-right:1px solid var(--line);overflow:auto;padding:14px 10px 24px}
.grp{font-size:11.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:700;padding:14px 10px 6px}
.grp:first-of-type{padding-top:4px}
nav button.item{display:flex;gap:10px;align-items:flex-start;width:100%;text-align:left;border:0;background:transparent;padding:8px 10px;border-radius:7px;cursor:pointer;line-height:1.35}
nav button.item svg{width:16px;height:16px;margin-top:2px;opacity:.7}
nav button.item:hover{background:var(--accent-soft)}
nav button.item[aria-current=true]{background:var(--accent);color:var(--accent-ink)}
nav button.item[aria-current=true] svg{opacity:1}
main{display:flex;flex-direction:column;min-width:0;min-height:0}
main>.stage{flex:1 1 0}
main>.bar,main>.rqbar{flex:none}
.bar{display:flex;align-items:center;gap:6px;padding:8px 12px;border-bottom:1px solid var(--line);background:var(--bg);min-width:0}
.bar h2{flex:1;margin:0 6px 0 2px;font-size:15px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.ctl{display:flex;align-items:center;gap:4px}
.ctl .lbl{font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums;min-width:52px;text-align:center}
.sep{width:1px;height:22px;background:var(--line);margin:0 4px}
.stage{position:relative;min-height:0;background:var(--stage);overflow:hidden}
.stage>iframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff}
#view{position:absolute;inset:0;overflow:auto}
#wm{position:absolute;inset:0;pointer-events:none;z-index:5;background-repeat:repeat}
.overlay{position:absolute;inset:0;z-index:6;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:var(--muted);font-size:14px;text-align:center;padding:24px;background:var(--stage)}
.pbar{width:220px;height:6px;border-radius:99px;background:var(--line);overflow:hidden}
.pbar i{display:block;height:100%;width:0;background:var(--accent)}
.stage:fullscreen{background:var(--stage)}
.stage:-webkit-full-screen{background:var(--stage);width:100%;height:100%}

/* viewers */
.imgwrap{min-height:100%;display:flex;align-items:center;justify-content:center;padding:16px}
.imgwrap img{max-width:100%;max-height:calc(var(--vh) - 160px);object-fit:contain;cursor:zoom-in;box-shadow:0 2px 14px rgba(0,0,0,.15);background:#fff}
.stage:fullscreen .imgwrap img{max-height:calc(var(--vh) - 32px)}
.imgwrap.zoom{display:block}
.imgwrap.zoom img{max-width:none;max-height:none;cursor:zoom-out}
.media{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#000}
.media video{max-width:100%;max-height:100%;width:100%;height:100%;object-fit:contain;background:#000}
.filecard{min-height:100%;display:flex;align-items:center;justify-content:center;padding:24px}
.filecard>div{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:28px;max-width:440px;width:100%;text-align:center}
.filecard .big{width:56px;height:56px;border-radius:14px;background:var(--accent-soft);color:var(--accent);display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px}
.filecard .big svg{width:28px;height:28px}
.filecard h3{margin:0 0 4px;font-size:17px;word-break:break-word}
.filecard p{margin:0 0 16px;color:var(--muted);font-size:13.5px}
.filecard audio{width:100%;margin-top:6px}
.plv{max-width:760px;margin:0 auto;padding:26px 20px 48px}
.plhd{display:flex;gap:18px;align-items:center}
.plcov{flex:none;width:116px;height:116px;border-radius:18px;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;box-shadow:var(--shadow);overflow:hidden}
.plcov svg{width:50px;height:50px}.plcov img{width:100%;height:100%;object-fit:contain;background:var(--panel)}
.plk{font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
.plhd h2{margin:3px 0 4px;font-size:23px;line-height:1.2;word-break:break-word}
.plmeta{color:var(--muted);font-size:13.5px}
.plctl{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:18px 0 10px}
.plctl .btn{min-height:40px}.plctl .btn svg.i{width:17px;height:17px}
.plctl .btn.ghost.on{color:var(--accent);border-color:var(--accent);background:var(--accent-soft)}
.plctl .sp{flex:1}
.plnow{font-size:13.5px;color:var(--muted);margin:0 0 8px;min-height:1.4em}.plnow b{color:var(--ink)}
.plplayer audio{width:100%;display:block}
.pllist{list-style:none;margin:14px 0 0;padding:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--panel)}
.pllist button{display:grid;grid-template-columns:30px 1fr auto;gap:12px;align-items:center;width:100%;border:0;border-top:1px solid var(--line);background:none;color:var(--ink);font:inherit;text-align:left;padding:10px 16px;cursor:pointer}
.pllist li:first-child button{border-top:0}
.pllist button:hover{background:var(--accent-soft)}
.pllist .n{color:var(--muted);font-variant-numeric:tabular-nums;text-align:right;font-size:13.5px}
.pllist .tt{min-width:0}.pllist .tt b{display:block;font-weight:600;font-size:14.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pllist .tt span{display:block;font-size:12.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pllist .d{color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums}
.pllist button.now{background:var(--accent-soft)}.pllist button.now .tt b,.pllist button.now .n{color:var(--accent)}
@media (max-width:560px){.plhd{gap:14px}.plcov{width:84px;height:84px;border-radius:14px}.plcov svg{width:38px;height:38px}.plhd h2{font-size:19px}.plctl .btn .lbl{display:none}}
.npframe{position:absolute;z-index:24;border-radius:10px;overflow:hidden;background:#000}
.npframe iframe{display:block;width:100%;height:100%;border:0}
.npmini{position:absolute;right:14px;bottom:14px;z-index:25;width:340px;max-width:calc(100% - 28px);background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.22);overflow:hidden}
.npmini .nph{display:flex;align-items:center;gap:6px;padding:6px 6px 6px 10px}
.npmini .npt,.npchip .npct{flex:1;min-width:0;border:0;background:none;font:inherit;font-size:13px;font-weight:600;color:var(--ink);text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;padding:2px 0}
.npmini .npt:hover,.npchip .npct:hover{text-decoration:underline}
.npb{flex:none;width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:8px;background:transparent;color:var(--ink);cursor:pointer;font-size:13px}
.npb:hover{background:var(--accent-soft)}
.npb svg.i{width:15px;height:15px}
.npmini .npbody{position:relative}
.npmini.vid .npbody{aspect-ratio:16/9}
.npmini.aud .npbody{height:84px}
.npmini.small .npbody{aspect-ratio:auto;height:0;overflow:hidden}
.npmini.small{width:300px}
.npmini.slim:not(.yt):not(.lg){width:320px}
.npmini.slim .npctl{display:flex;align-items:center;gap:4px;padding:4px 8px 5px}
.npmini.slim .npbar{flex:1;order:2;min-width:0}
.npmini.slim .npbtns:not(.np2){order:1;margin:0;gap:0}
.npmini.slim .npbtns .sp,.npmini.slim .npbtns.np2,.npmini.slim #npPrev,.npmini.slim #npBack,.npmini.slim #npFwd,.npmini.slim #npNext,.npmini.slim #npVol,.npmini.slim .npq,.npmini.slim #npLg{display:none!important}
.npmini.slim .npbtns .npb.pp{width:32px;height:32px}
.npmini.slim .npbtns .npb.pp svg.i{width:15px;height:15px}
.npmini.yt{width:356px}
.npmini.yt .npbody{aspect-ratio:16/9;min-height:200px}
.npmini.lg{width:520px}
.npmini.lg.small{width:340px}
.npmini.npmedia.aud .npbody{height:0;overflow:hidden}
.npmini .nph{cursor:grab;touch-action:none;user-select:none}
.npmini.drag{transition:none;opacity:.92}
.npmini.drag .nph{cursor:grabbing}
.npmini.pos-bl{left:14px;right:auto}.npmini.pos-tl{left:14px;right:auto;top:14px;bottom:auto}.npmini.pos-tr{top:14px;bottom:auto}
.npctl{padding:4px 8px 6px;border-top:1px solid var(--line)}
.npmini.nocl .npctl{display:none}
.npbar{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums}
.npbar input{flex:1;min-width:0;accent-color:var(--accent);height:16px;margin:0}
.npbar .tm{min-width:34px}.npbar .tm:last-child{text-align:right}
.npbtns{display:flex;align-items:center;gap:2px;margin-top:2px}
.npbtns .sp{flex:1}
.npbtns .npb.pp{width:38px;height:38px;border-radius:50%;background:var(--accent);color:var(--accent-ink,#fff)}
.npbtns .npb.pp:hover{filter:brightness(1.08);background:var(--accent)}
.npbtns .npb.pp svg.i{width:18px;height:18px}
.npbtns .npb.rate{width:auto;padding:0 6px;font-size:12px;font-weight:700}
.npb[disabled]{opacity:.35;cursor:default}
.npmini .npbar.noseek input{opacity:.4;pointer-events:none}
.npbtns .vol{width:76px;accent-color:var(--accent);margin:0 4px 0 0}
.npbtns.np2{margin-top:0}.npbtns.np2 .npb{height:26px}
.npbtns .npb.on{color:var(--accent);background:var(--accent-soft)}
.npbtns .npb .one{position:absolute;font:700 8px/1 system-ui;margin:9px 0 0 9px}
.npbtns .npb{position:relative}
.npbtns .npb.tmr{width:auto;min-width:30px;padding:0 5px;gap:3px;font-size:11.5px;font-weight:700;font-variant-numeric:tabular-nums}
.npq{max-height:170px;overflow:auto;border-top:1px solid var(--line);padding:4px 0}
.npq button{display:flex;gap:8px;align-items:center;width:100%;border:0;background:none;color:var(--ink);font:inherit;font-size:13px;text-align:left;padding:6px 12px;cursor:pointer}
.npq button:hover{background:var(--accent-soft)}
.npq button.now{font-weight:700;color:var(--accent)}
.npq button .n{width:18px;color:var(--muted);font-variant-numeric:tabular-nums;flex:none;text-align:right}
.npq .qh{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:700;padding:4px 12px}
.npmini .nptag{flex:none;border:1px solid #c98a00;color:#9a6700;background:#fff5d6;border-radius:99px;font:700 10.5px/1 system-ui;padding:3px 7px;cursor:pointer;margin-right:2px}
:root[data-theme=dark] .npmini .nptag{background:#3a2e00;color:#ffd666;border-color:#806300}
.spfull{margin:14px auto 0;max-width:720px;border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--panel)}
.spfull.warn{border-color:#c98a00;box-shadow:inset 4px 0 0 #c98a00}
.spfull b{display:block;font-size:14.5px;margin-bottom:4px}
.spfull p{margin:0 0 10px;font-size:13.5px;line-height:1.5}
.spfull p.fine{margin:10px 0 0;font-size:12.5px;color:var(--muted)}
.spfull .row{display:flex;gap:8px;flex-wrap:wrap}
.npchip .npctm{font-size:11.5px;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums;white-space:nowrap}
@media (max-width:560px){.npbtns .vol{width:64px}}
.npmini .npbody>video{display:block;width:100%;height:100%;background:#000}
.npmini .npbody>audio{display:block;width:calc(100% - 16px);margin:8px}
.npmini.aud .npbody:has(>audio){height:auto}
.eq{display:inline-flex;gap:2px;align-items:flex-end;height:12px;flex:none}
.eq i{width:3px;background:var(--accent);border-radius:1px;height:4px}
.npchip.on .eq i{animation:eqb .9s ease-in-out infinite}
.eq i:nth-child(2){animation-delay:.2s}.eq i:nth-child(3){animation-delay:.4s}
@keyframes eqb{0%,100%{height:3px}50%{height:12px}}
@media (prefers-reduced-motion:reduce){.eq i{animation:none!important}}
.npchip{display:flex;align-items:center;gap:4px;max-width:260px;min-width:0;padding:2px 2px 2px 10px;border:1px solid var(--line);border-radius:999px;background:var(--bg)}
@media (max-width:760px){.npchip .npct{display:none}.npchip{padding-left:8px}}
@media (max-width:560px){.npmini,.npmini.lg{right:8px;bottom:8px;width:calc(100% - 16px)}.npmini.pos-bl,.npmini.pos-tl{left:8px}.npmini.pos-tl,.npmini.pos-tr{top:8px}#npLg{display:none}}
.linkwrap{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:20px 16px}
.embed{width:min(100%,960px);border-radius:12px;overflow:hidden;background:#000;box-shadow:var(--shadow)}
.embed.video{width:min(100%,960px,calc((100vh - 290px) * 16 / 9));aspect-ratio:16/9}
.embed.full{height:calc(var(--vh) - 290px);min-height:320px;background:#fff}
.embed.audio{background:transparent;box-shadow:none}
.stage:fullscreen .embed.video{width:min(100%,calc((100vh - 180px) * 16 / 9))}
.stage:fullscreen .embed.full{height:calc(var(--vh) - 180px)}
.embed iframe{display:block;width:100%;height:100%;border:0}
.opcard .lt span{display:block}
.opcard .opw strong{display:inline;font-weight:700;color:var(--ink)}
nav button.item[aria-current=true] .opb{color:inherit;border-color:currentColor}
.opcard .opin{margin-top:4px;font-weight:600;color:var(--accent);font-variant-numeric:tabular-nums}
nav button.item.opl{opacity:.62}
nav .opb{margin-left:auto;font-size:10.5px;font-weight:700;padding:1px 6px;border-radius:99px;border:1px dashed var(--muted);color:var(--muted);white-space:nowrap;flex:none}
nav .opb::before{content:"🔒 "}
.linkcard{display:flex;align-items:center;gap:14px;width:min(100%,960px);background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;box-shadow:var(--shadow)}
.linkcard .big{width:42px;height:42px;border-radius:10px;background:var(--accent-soft);color:var(--accent);display:inline-flex;align-items:center;justify-content:center;flex:none}
.linkcard .lt{flex:1;min-width:0}
.linkcard .lt b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.linkcard .lt span{display:block;font-size:12.5px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.linkcard .btn{flex:none;padding:9px 14px}
.lnote{margin:0;font-size:12.5px;color:var(--muted);text-align:center;max-width:640px}
@media (max-width:560px){.linkcard{flex-wrap:wrap}.linkcard .btn{width:100%}.embed.video{width:100%}}
.pdf{position:absolute;inset:0;overflow:auto;padding:16px 16px 40px}
.pdf .pg{margin:0 auto 14px;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.18),0 6px 18px rgba(0,0,0,.08);position:relative}


/* ---------- full-screen controls + keyboard shortcuts ---------- */
.fsbar{position:absolute;left:50%;bottom:max(16px,calc(env(safe-area-inset-bottom) + 8px));transform:translateX(-50%);z-index:8;display:none;align-items:center;gap:2px;background:rgba(18,20,19,.84);color:#fff;border-radius:999px;padding:5px 6px;box-shadow:0 8px 28px rgba(0,0,0,.35);max-width:calc(100% - 24px);transition:opacity .3s}
.stage:fullscreen .fsbar,.stage:-webkit-full-screen .fsbar{display:flex}
.fsbar.idle{opacity:0;pointer-events:none}
.fsbar button{border:0;background:transparent;color:#fff;width:42px;height:42px;border-radius:50%;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;flex:none}
.fsbar button:hover:not(:disabled){background:rgba(255,255,255,.16)}
.fsbar button:disabled{opacity:.3;cursor:default}
.fsbar .t{font-size:13.5px;padding:0 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;max-width:44vw}
.fsbar .pos{font-size:12px;opacity:.65;font-variant-numeric:tabular-nums;padding-right:6px;white-space:nowrap}
.fsbar .sp{width:1px;height:22px;background:rgba(255,255,255,.25);margin:0 4px}
.khint{margin:18px 10px 0;padding-top:12px;border-top:1px solid var(--line);font-size:12px;color:var(--muted);line-height:1.7}
kbd{display:inline-block;min-width:20px;padding:0 5px;border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;background:var(--bg);font:600 11.5px/18px var(--sans);text-align:center;color:var(--ink)}
@media (pointer:coarse){.khint{display:none}}
.nsbox{margin:0 0 16px;padding:12px 14px;border-radius:10px;background:#fbefd5;color:#3d2b00;border:1px solid #d9a33a;font-size:14px;line-height:1.5}
.nsbox a{color:inherit;font-weight:700;word-break:break-all}
#openNote{margin:14px 0 0}
#dskBox{position:fixed;inset:0;z-index:85;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:16px}
#dskBox .box{background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);width:min(100%,560px);max-height:min(86vh,760px);display:flex;flex-direction:column;overflow:hidden}
#dskBox .dtabs{display:grid;grid-template-columns:repeat(4,1fr);margin:14px 0 4px}#dskBox .dtabs button{min-height:36px;padding:4px 6px;line-height:1.2}
#dskBox ol{margin:8px 0 0;padding-left:20px;font-size:14px;line-height:1.55}#dskBox ol li{margin:0 0 6px}
#dskBox .dskdl{display:flex;gap:12px;align-items:center;margin:12px 0 4px;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}
#dskBox .dskdl img{width:48px;height:48px;object-fit:contain;flex:none}
#dskBox .dskdl div{flex:1;font-size:13px;color:var(--muted)}
#dskBox .dskdl b{display:block;color:var(--ink);font-size:14px}
#dskBox .fine{font-size:12.5px;color:var(--muted);margin:10px 0 0}
.dskl{display:block;margin:12px auto 0;font-size:12.5px}
.pspins{display:flex;gap:6px}.pspins[hidden]{display:none}
.pspins .btn{gap:6px;white-space:nowrap;max-width:210px}.pspins .btn span{overflow:hidden;text-overflow:ellipsis}
.psv{max-width:640px;margin:0 auto;padding:34px 20px 48px}
.pscard{display:flex;gap:18px;align-items:center}
.psic{flex:none;width:96px;height:96px;border-radius:22px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center}.psic svg{width:46px;height:46px}
.psk{font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
.pscard h2{margin:3px 0 4px;font-size:23px;line-height:1.2}
.pscard p{margin:0;color:var(--muted);font-size:14.5px;line-height:1.5}
.psgo{margin:22px 0 0;min-height:52px;font-size:16.5px;padding:0 22px}.psgo svg.i{width:20px;height:20px}
.pshint{margin:14px 0 0;font-size:13.5px;color:var(--muted);line-height:1.55}
.psmsg{margin:14px 0 0;padding:12px 14px;border-radius:12px;font-size:14px;line-height:1.55;background:#fbefd5;color:#3d2b00;border:1px solid #d9a33a}
.psmsg[hidden]{display:none}.psmsg .btn{margin-top:8px}.psmsg .pssub{display:block;margin-top:8px;font-size:12.5px;opacity:.85}
@media (max-width:600px){.pspins .btn span{display:none}.pspins .btn{padding:0 9px}.pscard{gap:14px}.psic{width:70px;height:70px;border-radius:16px}.psic svg{width:34px;height:34px}.pscard h2{font-size:20px}}
#fmBox{position:fixed;inset:0;z-index:84;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:16px}
#fmBox .box{background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);width:min(100%,600px);max-height:min(90vh,820px);display:flex;flex-direction:column;overflow:hidden}
#fmBox select{width:100%;font:inherit;font-size:15px;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink)}
.fmlbl{display:block;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:14px 0 6px}
.fmcard{margin:12px 0 0;border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--bg)}
#fmBox .fmcard h4{margin:2px 0 0;font-size:17px;text-transform:none;letter-spacing:0;color:var(--ink)}
.fmcard .fmtag{font-size:12px;font-weight:700;color:var(--accent)}
.fmcard p{margin:8px 0 0;font-size:13.8px;line-height:1.55}
.fmcard ol{margin:8px 0 0;padding-left:20px;font-size:13.8px;line-height:1.55}.fmcard ol li{margin:0 0 4px}
.fmcard .fmev{font-size:12.5px;color:var(--muted);border-left:3px solid var(--accent);padding-left:10px}
.fmtl{display:flex;gap:4px;margin:10px 0 0;flex-wrap:wrap}
.fmtl span{font-size:11.5px;font-weight:700;padding:4px 8px;border-radius:7px;background:var(--accent-soft);color:var(--accent)}
.fmtl span.br{background:var(--line);color:var(--muted)}
.fmtl span.now{outline:2px solid var(--accent);outline-offset:1px}
.fmrun{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:14px 0 0}
.fmrun .fmclock{font-size:30px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.fmrun .fmph{font-size:13px;color:var(--muted)}.fmrun .fmph b{color:var(--ink);font-size:14.5px}
.fmrun .sp{flex:1}
.fmnow{margin:10px 0 0;padding:10px 12px;border-radius:10px;background:var(--accent-soft);font-size:14px;line-height:1.5}
.fmdue{display:flex;flex-direction:column;gap:6px;margin:6px 0 0}
.fmdue .row{display:flex;gap:8px;align-items:center;padding:8px 10px;border:1px solid var(--line);border-radius:10px;background:var(--bg)}
.fmdue .row span{flex:1;min-width:0;font-size:14px}.fmdue .row small{display:block;color:var(--muted);font-size:12px}
.fmset{display:flex;flex-direction:column;gap:8px;margin:16px 0 4px;padding-top:12px;border-top:1px solid var(--line);font-size:14px}
.fmset label{display:flex;gap:8px;align-items:flex-start}.fmset input{margin-top:3px;accent-color:var(--accent)}
.fmset .fine{font-size:12.5px;color:var(--muted)}
.fmchip{display:flex;align-items:center;gap:2px;border:1px solid var(--accent);background:var(--accent-soft);border-radius:99px;padding:2px 3px 2px 10px;max-width:240px}
.fmchip[hidden]{display:none}
.fmchip #fmChipT{border:0;background:none;color:var(--accent);font:inherit;font-size:13px;font-weight:700;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums;padding:4px 2px}
.fmchip.brk{border-color:var(--line);background:var(--bg)}.fmchip.brk #fmChipT{color:var(--muted)}
.fmchip .npb{width:28px;height:28px}
.fmbtn{position:relative}.fmbtn .fmdot{position:absolute;top:-4px;right:-4px;min-width:17px;height:17px;border-radius:99px;background:var(--accent);color:var(--accent-ink);font:700 10.5px/17px system-ui;text-align:center;padding:0 4px}
#fmPad{position:fixed;z-index:30;left:16px;bottom:16px;width:min(360px,calc(100vw - 32px));background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);display:flex;flex-direction:column;padding:10px 12px 12px}
#fmPad[hidden]{display:none}
.fmpadhd{display:flex;align-items:center;gap:6px}.fmpadhd b{font-size:14.5px}.fmpadhd .sp{flex:1}
.fmpadtip{margin:6px 0 8px;font-size:12.8px;color:var(--muted);line-height:1.45}
#fmPadTx{width:100%;min-height:150px;max-height:40vh;resize:vertical;font:inherit;font-size:14px;line-height:1.5;padding:10px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink)}
.fmpadft:empty{display:none}.fmpadft{margin-top:8px;display:flex;gap:6px;flex-wrap:wrap}
@media (max-width:600px){.fmchip{max-width:none;padding-left:6px}.fmchip #fmChipT .lb{display:none}#fmPad{left:8px;right:8px;bottom:8px;width:auto}}
#wnBox{position:fixed;inset:0;z-index:84;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:16px}
#wnBox .box{background:var(--panel);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);width:min(100%,560px);max-height:min(86vh,760px);display:flex;flex-direction:column;overflow:hidden}
.wnhd{display:flex;gap:12px;align-items:center;padding:18px 18px 12px 20px;border-bottom:1px solid var(--line)}
.wnhd h3{margin:0;font-size:18px}.wnhd>div{flex:1;min-width:0}.wnhd>div span{font-size:12.5px;color:var(--muted)}
.wnic{flex:none;width:38px;height:38px;border-radius:11px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center}
.wnic svg{width:20px;height:20px}
.wnbody{overflow:auto;padding:6px 20px 14px}
.wnbody h4{margin:16px 0 8px;font-size:11.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}
.wnnote{background:var(--accent-soft);border-radius:10px;padding:11px 14px;font-size:14px;line-height:1.5;white-space:pre-wrap}
.wnf{display:flex;gap:12px;padding:9px 0;border-top:1px solid var(--line)}.wnf:first-of-type{border-top:0}
.wnf .i{flex:none;width:18px;height:18px;margin-top:2px;color:var(--accent)}
.wnf>div>b{display:block;font-size:14.5px;margin-bottom:2px}.wnf p{margin:0;font-size:13.5px;line-height:1.5;color:var(--ink)}
.wnf kbd{font-size:11.5px}
.wnitems{display:flex;flex-direction:column;gap:4px}
.wnitems button{display:flex;gap:10px;align-items:center;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:9px;padding:8px 11px;font:inherit;font-size:14px;text-align:left;cursor:pointer}
.wnitems button:hover{border-color:var(--accent)}.wnitems button .i{width:16px;height:16px;color:var(--accent);flex:none}
.wnitems button small{margin-left:auto;color:var(--muted);font-size:12px;white-space:nowrap}
.wnft{display:flex;gap:12px;align-items:center;justify-content:space-between;padding:12px 18px 14px 20px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted)}
.wnbtn{position:relative}.wnbtn .i{width:18px;height:18px}
nav button.item .newb{flex:none;margin-left:auto;font-size:10.5px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;padding:2px 7px;border-radius:99px;background:var(--accent);color:var(--accent-ink)}
nav button.item[aria-current=true] .newb{background:rgba(255,255,255,.25);color:inherit}
nav button.item .scb+.newb,nav button.item .newb+.scb{margin-left:6px}
@media (max-width:600px){.wnft{flex-direction:column;align-items:stretch}.wnft .btn{width:100%}}
.inst{margin:14px 0 0;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;font-size:12.5px;color:var(--muted)}
.inst .btn{width:100%}.inst .btn[hidden]{display:none}
.pver{margin:14px 0 0;text-align:center;font-size:11.5px;color:var(--muted)}
#keys{position:fixed;inset:0;z-index:70;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:16px}
#keys .box{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:20px 22px;width:min(100%,360px)}
#keys h3{margin:0 0 12px;font-size:16px}
#keys table{border-collapse:collapse;width:100%;font-size:14px}
#keys td{padding:6px 0;border-bottom:1px solid var(--line)}
#keys td:first-child{width:96px;white-space:nowrap}
#keys p{margin:12px 0 0;font-size:12.5px;color:var(--muted)}
.stage>#keys{position:absolute}

/* ---------- answer key prompt ---------- */
.rqbar{display:flex;gap:10px;align-items:center;padding:8px 14px;font-size:13.5px;background:var(--accent-soft);border-bottom:1px solid var(--line);color:var(--ink)}
.rqbar svg.i{width:16px;height:16px;flex:none;color:var(--accent)}
.rqbar>span{flex:1;min-width:0}
.rqbar .pr{font-variant-numeric:tabular-nums;font-weight:600;white-space:nowrap}
.rqbar.off{background:var(--bg);color:var(--muted)}
.rqbar.cb{background:#fde9c8;color:#5a3a00}
.rqbar.cb svg.i{color:#8a5a00}
.rqbar .btn{flex:none}
nav .rqb{margin-left:auto;font-size:10.5px;font-weight:700;padding:1px 6px;border-radius:99px;background:var(--accent);color:var(--accent-ink,#fff);white-space:nowrap;flex:none}
nav .rqb.ok{background:transparent;color:var(--accent);border:1px solid var(--accent)}
nav .rqb.off{background:transparent;color:var(--muted);border:1px solid var(--line)}
#ptWrap{position:absolute;inset:0;z-index:30;background:var(--bg);overflow:auto;-webkit-overflow-scrolling:touch}
.ptin{max-width:760px;margin:0 auto;padding:20px 16px 40px}
.pth h3{margin:0 0 8px;font-size:20px}
.pth p{display:flex;gap:8px;align-items:flex-start;margin:0 0 16px;padding:10px 12px;border-radius:10px;background:#fde9c8;color:#5a3a00;font-size:13.5px}
.pth p svg.i{width:16px;height:16px;flex:none;margin-top:2px}
.ptq{border:1px solid var(--line);border-radius:12px;background:var(--panel);padding:14px 16px;margin:0 0 12px;min-width:0}
.ptq legend,.ptq .lg{font-size:15px;padding:0 4px;margin:0 0 8px;float:none;width:auto}
.ptq label{display:flex;gap:10px;align-items:flex-start;padding:8px 10px;border-radius:8px;cursor:pointer;font-size:14.5px}
.ptq label:hover{background:var(--accent-soft)}
.ptq input{margin-top:3px;accent-color:var(--accent);flex:none}
.ptq .opt{padding:7px 10px;border-radius:8px;font-size:14.5px;margin:2px 0}
.ptq .opt.right{background:#dcefe5;color:#17523c;font-weight:600}
.ptq .opt.wrong{background:#f7dcd3;color:#8a2a17}
.ptq .rat{margin:10px 0 0;padding:10px 12px;border-left:3px solid var(--accent);background:var(--accent-soft);border-radius:0 8px 8px 0;font-size:13.5px}
.ptf{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:16px;font-size:13.5px;color:var(--muted)}
#cbAsk{position:fixed;inset:0;z-index:86;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:16px}
.stage>#cbAsk{position:absolute}
#cbAsk .box{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:20px 22px;width:min(100%,440px)}
#cbAsk h3{margin:0 0 8px;font-size:17px}
#cbAsk p{margin:0 0 12px;font-size:14px;color:var(--ink)}
#cbAsk p.fine{font-size:12.5px;color:var(--muted)}
#cbAsk .row{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:4px}
@media (max-width:640px){.rqbar{flex-wrap:wrap;font-size:12.5px;padding:8px 12px}}
#keyAsk,#dlAsk{position:fixed;inset:0;z-index:85;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:16px}
.stage>#keyAsk,.stage>#dlAsk{position:absolute}
#keyAsk .box,#dlAsk .box{background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:20px 22px;width:min(100%,420px)}
#keyAsk h3,#dlAsk h3{margin:0 0 8px;font-size:17px}
#keyAsk p,#dlAsk p{margin:0 0 16px;font-size:14px;color:var(--ink)}
#dlAsk p.fine{font-size:12.5px;color:var(--muted);margin-top:-6px}
#keyAsk .row,#dlAsk .row{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
#dlAsk .who{display:block;text-align:left;text-indent:0;margin:8px 0 0;padding:8px 10px;border-radius:8px;background:var(--bg);border:1px solid var(--line);font-size:13px}

/* ---------- sign-out farewell ---------- */
#bye{position:fixed;inset:0;z-index:95;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:24px;text-align:center;cursor:pointer;
  background:radial-gradient(120% 90% at 50% 38%,color-mix(in srgb,var(--accent) 50%,#0c0f0e) 0%,#0a0c0b 72%);color:#f6f1e4;opacity:0;transition:opacity .6s ease}
#bye.on{opacity:1}
#bye .moon{width:58px;height:58px;color:#f1d48a;opacity:.95;transform:translateY(6px) scale(.96);transition:transform 1.4s ease}
#bye h2{margin:0;font-family:var(--serif);font-weight:600;font-size:clamp(36px,7.5vw,68px);letter-spacing:.005em;line-height:1.1;transform:translateY(10px);transition:transform 1.4s ease}
#bye p{margin:0;font-size:14px;color:#f6f1e4;opacity:.62;letter-spacing:.04em}
#bye.on .moon,#bye.on h2{transform:none}
@media (prefers-reduced-motion:reduce){#bye,#bye .moon,#bye h2{transition:opacity .3s ease}#bye .moon,#bye h2{transform:none}}

/* ---------- practice scores ---------- */
nav button.item .scb{margin-left:auto;flex:none;white-space:nowrap;font-size:11px;font-weight:700;font-variant-numeric:tabular-nums;padding:1px 7px;border-radius:99px;background:var(--accent-soft);color:var(--accent);align-self:center}
nav button.item .scb.none{background:transparent;color:var(--muted);font-weight:500}
nav button.item[aria-current=true] .scb{background:rgba(255,255,255,.22);color:inherit}
.scstat{margin:14px 10px 0;padding:8px 10px;border-radius:8px;font-size:12.5px;line-height:1.4}
.scstat.ok{background:var(--accent-soft);color:var(--accent)}
.scstat.wait{background:color-mix(in srgb,#d4a017 16%,var(--panel));color:var(--ink)}
.scstat.bad{background:color-mix(in srgb,var(--danger) 14%,var(--panel));color:var(--danger)}
.scnote{display:flex;gap:6px;align-items:flex-start;margin:10px 0 0;font-size:12.5px;color:var(--muted)}
.scnote svg{width:15px;height:15px;margin-top:2px}

/* ---------- annotations ---------- */
.inkbar{position:absolute;top:10px;left:50%;transform:translateX(-50%);z-index:9;display:flex;align-items:center;gap:2px;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);max-width:calc(100% - 16px);overflow-x:auto;scrollbar-width:none}
.inkbar::-webkit-scrollbar{display:none}
.inkbar button{flex:none;width:38px;height:38px;border:0;border-radius:8px;background:transparent;color:var(--ink);cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.inkbar button:hover:not(:disabled){background:var(--accent-soft)}
.inkbar button[aria-pressed=true]{background:var(--accent);color:var(--accent-ink)}
.inkbar button:disabled{opacity:.35;cursor:default}
.inkbar .dot{width:18px;height:18px;border-radius:50%;box-shadow:inset 0 0 0 2px rgba(0,0,0,.18)}
.inkbar .sz{display:block;border-radius:50%;background:currentColor}
.inkbar .sep{flex:none;width:1px;height:24px;background:var(--line);margin:0 3px}
.inkbar button.done{width:auto;padding:0 12px;font-weight:600;background:var(--accent);color:var(--accent-ink)}
#inkBtn[aria-pressed=true]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.imgbox{position:relative;display:inline-block;line-height:0}
.imgbox canvas.ink,.pdf .pg canvas.ink{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.pdf .pg canvas.pc{display:block;width:100%;height:100%}
#view.inking .imgwrap img{cursor:crosshair}
#view.inking .pdf{padding-top:64px}
#view.inking .imgwrap{padding-top:64px}
body.inking .stage>iframe{top:58px;height:calc(100% - 58px);outline:3px solid var(--accent);outline-offset:-3px}
#upBar{position:fixed;left:16px;bottom:16px;z-index:79;width:min(380px,calc(100% - 32px));background:#1f2321;color:#fff;padding:12px 14px;border-radius:12px;font-size:13.5px;line-height:1.45;box-shadow:var(--shadow)}
#upBar[hidden]{display:none}#upBar .upa:empty{display:none}#upBar .upa{margin-top:8px;display:flex;gap:8px;flex-wrap:wrap}
#upBar button{font:inherit;font-weight:600;border:0;border-radius:8px;padding:6px 12px;cursor:pointer;background:#fff;color:#1f2321}#upBar button.l{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.4)}
#upBar .upp{height:4px;border-radius:4px;background:rgba(255,255,255,.18);margin-top:8px;overflow:hidden}#upBar .upp i{display:block;height:100%;width:0;background:#62c2a8;transition:width .3s}
.upline a{color:inherit;text-decoration:underline;cursor:pointer}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:80;background:#1f2321;color:#fff;padding:10px 16px;border-radius:10px;font-size:14px;box-shadow:var(--shadow);max-width:calc(100% - 32px)}

/* ---------- responsive: laptop → tablet → phone ---------- */
.btn{white-space:nowrap}
header.top{padding-left:max(16px,env(safe-area-inset-left));padding-right:max(16px,env(safe-area-inset-right));padding-top:max(10px,env(safe-area-inset-top))}
#login{padding-top:max(32px,env(safe-area-inset-top));padding-bottom:max(32px,env(safe-area-inset-bottom))}
nav{padding-bottom:max(24px,env(safe-area-inset-bottom))}
.pdf,.linkwrap{padding-bottom:max(40px,calc(env(safe-area-inset-bottom) + 20px))}
@media (max-width:1100px){
  .body{grid-template-columns:250px 1fr}
  .bar .label{display:none}
  .bar .btn.ghost{padding:7px 9px}
}
@media (max-width:900px){          /* tablets in portrait, small laptops, phones: contents slide in */
  .body,body.navc .body{grid-template-columns:1fr}
  nav,body.navc nav{visibility:visible;position:fixed;z-index:20;top:0;bottom:0;left:0;width:min(86vw,340px);padding:14px 10px max(24px,env(safe-area-inset-bottom));padding-top:max(14px,env(safe-area-inset-top));padding-left:max(10px,env(safe-area-inset-left));border-right:1px solid var(--line);transform:translateX(-102%);transition:transform .22s ease;box-shadow:var(--shadow)}
  nav.open{transform:none}
  #scrim{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:19}
}
@media (max-width:600px){          /* phones */
  .who{display:none}
  header.top{padding-top:max(8px,env(safe-area-inset-top));padding-bottom:8px;padding-left:max(10px,env(safe-area-inset-left));padding-right:max(10px,env(safe-area-inset-right));gap:6px}
  .bar{padding:6px 8px;gap:4px}
  .bar .btn.ghost{padding:6px 7px}
  .ctl .lbl{min-width:40px;font-size:12px}
  .navwho{display:block!important;padding:8px 10px 12px;border-bottom:1px solid var(--line);margin-bottom:6px;font-size:13px;color:var(--muted)}
  .imgwrap img{max-height:calc(var(--vh) - 130px)}
  .brand b{font-size:16px}
}
@media (pointer:coarse){           /* touch screens: bigger targets */
  nav button.item{padding:11px 10px}
  .bar .btn.ghost,header .btn.ghost{min-height:40px;min-width:40px}
  .seg button{padding:10px 4px}
}
@media (orientation:landscape) and (max-height:500px){   /* phones sideways: give the content the room */
  header.top{padding-top:4px;padding-bottom:4px}
  .brand span{display:none}
  .bar{padding-top:3px;padding-bottom:3px}
}
.navwho{display:none}
</style>
</head>
<body>

<section id="login">
  <div class="card">
    <noscript><style>#login form,#login .pver,#login .scnote{display:none!important}</style><div class="nsbox"><b>This is a preview — the portal can't open here.</b><br>On a phone or tablet, open <a href="https://github.com/justinromelbernardo-png/yt-player-1.git">https://github.com/justinromelbernardo-png/yt-player-1.git</a> in Safari or Chrome, tap <b>Choose the portal file</b>, and pick this file.</div></noscript>
    <button class="btn ghost icon tbtn" type="button" data-theme-btn aria-label="Theme" title="Theme"></button>
    <img class="llogo" id="lLogo" alt="" hidden>
    <span class="eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Restricted access</span>
    <h1 id="lTitle"></h1>
    <p class="sub" id="lSub"></p>
    <div class="note" id="lNote" hidden></div>
    <form id="form" autocomplete="on" novalidate>
      <label>Student number
        <input type="text" id="sn" name="studentno" autocomplete="username" autocapitalize="characters" spellcheck="false" required>
      </label>
      <label>Email address
        <input type="email" id="em" name="email" autocomplete="email" autocapitalize="none" spellcheck="false" required>
      </label>
      <p class="err" id="err" role="alert"></p>
      <button class="btn" id="go" type="submit">Open</button>
    </form>
    <div class="inst" id="instBox" hidden><button type="button" class="btn ghost" id="instBtn"></button><span id="instTxt"></span></div>
    <button type="button" class="linkbtn dskl" id="dskLink" hidden>Put this portal on your desktop, with its own icon</button>
    <div class="nsbox" id="openNote" hidden></div>
    <p class="pver" id="pVer"></p>
    <p class="pver upline" id="upLine" hidden></p>
    <div class="closed" id="closed" hidden></div>
    <p class="avail" id="avail" hidden></p>
    <p class="scnote" id="scNote" hidden></p>
    <p class="scnote" id="cbNote" hidden></p>
    <div class="foot" id="foot">Use the student number and email address on file with your instructor. This page works offline; your details are checked on this device only.</div>
  </div>
</section>

<section id="app" hidden>
  <header class="top">
    <button class="btn ghost icon" id="menuBtn" aria-label="Show contents"></button>
    <img class="alogo" id="aLogo" alt="" hidden>
    <div class="brand"><b id="aTitle"></b><span id="aSub"></span></div>
    <div class="who" id="who"></div>
    <div class="npchip" id="npChip" hidden role="group" aria-label="Now playing"><span class="eq" aria-hidden="true"><i></i><i></i><i></i></span><button type="button" id="npChipT" class="npct"></button><span class="npctm" id="npChipTm" hidden></span><button type="button" class="npb" id="npChipShow" hidden aria-label="Show the player" title="Show the player (H)"></button><button type="button" class="npb" id="npChipPP"></button><button type="button" class="npb" id="npChipX" aria-label="Stop and close" title="Stop and close">✕</button></div>
    <button class="btn ghost icon" type="button" id="instTop" aria-label="Install this portal as an app" title="Install this portal as an app" hidden></button>
    <div class="pspins" id="psPins" hidden></div>
    <div class="fmchip" id="fmChip" hidden role="group" aria-label="Focus timer"><button type="button" id="fmChipT"></button><button type="button" class="npb" id="fmChipPP"></button></div>
    <button class="btn ghost icon fmbtn" type="button" id="fmBtn" aria-label="Focus mode" title="Focus mode — study techniques with the strongest evidence" hidden></button>
    <button class="btn ghost icon wnbtn" type="button" id="wnBtn" aria-label="What's new" title="What's new in this portal" hidden></button>
    <button class="btn ghost icon" type="button" data-theme-btn aria-label="Theme" title="Theme"></button>
    <button class="btn ghost" id="out">Sign out</button>
  </header>
  <div class="body">
    <nav id="nav" aria-label="Contents"></nav>
    <main>
      <div class="bar">
        <h2 id="pTitle"></h2>
        <div class="ctl" id="pdfCtl" hidden>
          <button class="btn ghost icon" id="zOut" title="Zoom out" aria-label="Zoom out">−</button>
          <span class="lbl" id="pdfPg"></span>
          <button class="btn ghost icon" id="zIn" title="Zoom in" aria-label="Zoom in">+</button>
          <span class="sep"></span>
        </div>
        <button class="btn ghost" id="inkBtn" title="Annotate (A)" aria-pressed="false" hidden></button>
        <button class="btn ghost" id="dlBtn" title="Download" hidden></button>
        <button class="btn ghost" id="prev" title="Previous"></button>
        <button class="btn ghost" id="next" title="Next"></button>
        <button class="btn ghost" id="fs" title="Full screen"></button>
      </div>
      <div id="rqBar" class="rqbar" hidden></div>
      <div class="stage" id="stage">
        <div id="ptWrap" hidden></div>
        <div class="npmini" id="npMini" hidden role="region" aria-label="Now playing">
          <div class="nph" id="npDrag" title="Drag to move the player"><span class="eq" aria-hidden="true"><i></i><i></i><i></i></span><button type="button" id="npT" class="npt"></button>
            <button type="button" class="nptag" id="npTag" hidden title="Spotify is playing a 30-second preview — click for how to hear whole songs">Preview</button>
            <button type="button" class="npb" id="npSize"></button><button type="button" class="npb" id="npLg"></button><button type="button" class="npb" id="npHide" aria-label="Hide the player, keep playing" title="Hide the player — keep playing (H)"></button><button type="button" class="npb" id="npOpen" aria-label="Open its page" title="Open its page"></button><button type="button" class="npb" id="npX" aria-label="Stop and close" title="Stop and close">✕</button></div>
          <div class="npbody" id="npMiniSlot"></div>
          <div class="npq" id="npQ" hidden></div>
          <div class="npctl" id="npCtl">
            <div class="npbar"><span id="npCur" class="tm">0:00</span><input type="range" id="npSeek" min="0" max="1000" step="1" value="0" aria-label="Position"><span id="npDur" class="tm">0:00</span></div>
            <div class="npbtns">
              <button type="button" class="npb" id="npPrev" aria-label="Previous" title="Previous / start again"></button>
              <button type="button" class="npb" id="npBack" aria-label="Back 10 seconds" title="Back 10 seconds"></button>
              <button type="button" class="npb pp" id="npPP"></button>
              <button type="button" class="npb" id="npFwd" aria-label="Forward 10 seconds" title="Forward 10 seconds"></button>
              <button type="button" class="npb" id="npNext" aria-label="Next" title="Next in this section"></button>
              <span class="sp"></span>
              <button type="button" class="npb" id="npMute"></button>
              <input type="range" id="npVol" class="vol" min="0" max="100" step="5" value="100" aria-label="Volume" title="Volume">
            </div>
            <div class="npbtns np2">
              <button type="button" class="npb" id="npShuf" aria-label="Shuffle" title="Shuffle this section"></button>
              <button type="button" class="npb" id="npRep" aria-label="Repeat" title="Repeat"></button>
              <button type="button" class="npb" id="npList" aria-label="Up next" title="Up next in this section"></button>
              <button type="button" class="npb tmr" id="npTimer" aria-label="Study timer" title="Study timer — pause the music after a set time"></button>
              <span class="sp"></span>
              <button type="button" class="npb rate" id="npRate" title="Playback speed">1×</button>
              <button type="button" class="npb" id="npPip" aria-label="Picture-in-picture" title="Picture-in-picture: float the video over other windows"></button>
            </div>
          </div>
        </div>
        <iframe id="frame" title="Content" allow="fullscreen; clipboard-write; autoplay" allowfullscreen hidden></iframe>
        <div id="view" hidden></div>
        <div id="wm"></div>
        <div class="inkbar" id="inkbar" hidden role="toolbar" aria-label="Annotation tools">
          <button type="button" data-tool="pen" title="Pen (1)" aria-label="Pen"></button>
          <button type="button" data-tool="hl" title="Highlighter (2)" aria-label="Highlighter"></button>
          <button type="button" data-tool="eraser" title="Eraser (3)" aria-label="Eraser"></button>
          <button type="button" data-tool="text" title="Text note (4)" aria-label="Text note"></button>
          <span class="sep"></span>
