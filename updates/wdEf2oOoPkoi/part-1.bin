    var solid = function(v){ var x = thCol(v); return x && x[3] > .55 ? x : null; };
    var px = function(v){ return parseFloat(v) || 0; };
    var COVER = ".cover,.hero,[class*=cover],[class*=hero],.title-slide,.splash";
    function skip(el, a){ return typeof a === "function" ? a(el) : !!el.closest(a); }
    function first(sels, avoid, test){
      for (var a = 0; a < sels.length; a++){
        var L; try { L = doc.querySelectorAll(sels[a]); } catch(e){ continue; }
        for (var k = 0; k < L.length && k < 60; k++){ var el = L[k]; if (avoid && skip(el, avoid)) continue; if (!test || test(el, cs(el))) return el; }
      }
