    for (var i=0;i+3<p.length;i+=2) if (segDist(pt[0], pt[1], p[i], p[i+1], p[i+2], p[i+3]) <= rr) return true;
    return false;
  }
  function eraseAt(sf, pt){
    var arr = strokesOf(sf.key), r = 9 / sf.scaleUnit(), changed = false;
    for (var i = arr.length - 1; i >= 0; i--){
      if (hit(arr[i], pt, r)){ ink.hist.push({a:"del", k:sf.key, s:arr[i], i:i}); arr.splice(i, 1); changed = true; }
    }
    if (changed){ ink.redo = []; inkSave(); redrawKey(sf.key); inkBarState(); }
  }
  // Text notes: click to add, click an existing note to edit it. Ctrl/Cmd+Enter or clicking away saves; Esc cancels.
  function textNote(sf, pt, e){
    var arr = strokesOf(sf.key), r = 2 / sf.scaleUnit(), old = null;
    for (var i = arr.length - 1; i >= 0; i--) if (arr[i].t === "text" && hit(arr[i], pt, r)){ old = arr[i]; break; }
    var pos = sf.place(e), d = pos.doc, ta = d.createElement("textarea");
    var fsCss = old ? old.f * (sf.scaleUnit()) : INK_SIZE[INK.size].txt;
    var at = old ? sf.map(old.x, old.y) : null, dpr = dprNow();
    var left = old ? (at[0] / dpr) + (sf.cv.getBoundingClientRect().left) : pos.x, top = old ? (at[1] / dpr) + (sf.cv.getBoundingClientRect().top) : pos.y;
    [["position","fixed"],["left",left+"px"],["top",top+"px"],["z-index","2147483647"],["min-width","160px"],["min-height","2.6em"],["max-width","70vw"],
     ["font","600 " + fsCss + "px system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif"],["line-height","1.3"],["color", old ? old.c : INK_PEN[INK.color]],
     ["background","#fff8c5"],["border","2px solid #b8962e"],["border-radius","6px"],["padding","4px 6px"],["box-shadow","0 4px 16px rgba(0,0,0,.25)"],["resize","both"],["outline","none"]]
      .forEach(function(r){ ta.style.setProperty(r[0], r[1], "important"); });
    ta.placeholder = "Type a note…"; ta.value = old ? old.s : "";
    d.body.appendChild(ta);
    setTimeout(function(){ ta.focus(); }, 0);
    var done = false;
    function commit(keep){
      if (done) return; done = true;
      var txt = ta.value.replace(/\s+$/, ""); ta.remove();
      if (!keep) return;
      if (old){
        var idx = arr.indexOf(old);
        if (!txt){ if (idx > -1){ arr.splice(idx, 1); ink.hist.push({a:"del", k:sf.key, s:old, i:idx}); } }
        else if (txt !== old.s){ ink.hist.push({a:"edit", k:sf.key, s:old, prev:old.s}); old.s = txt; }
      } else if (txt){
        var st = {t:"text", c: INK_PEN[INK.color], f: sf.scaleUnit() === 1 ? INK_SIZE[INK.size].txt : Math.round(INK_SIZE[INK.size].txt / sf.scaleUnit() * 100000) / 100000, x: sf.round(pt[0]), y: sf.round(pt[1]), s: txt};
        arr.push(st); ink.hist.push({a:"add", k:sf.key, s:st});
      }
      ink.redo = []; inkSave(); redrawKey(sf.key); inkBarState();
    }
    ta.addEventListener("blur", function(){ commit(true); });
    ta.addEventListener("keydown", function(ev){
      ev.stopPropagation();
      if (ev.key === "Escape"){ ev.preventDefault(); commit(false); }
      else if (ev.key === "Enter" && (ev.ctrlKey || ev.metaKey)){ ev.preventDefault(); ta.blur(); }
    });
  }
  // ---- undo / redo / clear
  function applyHist(h, undo){
    var arr = strokesOf(h.k);
    if (h.a === "add"){ if (undo){ var i = arr.indexOf(h.s); if (i > -1) arr.splice(i, 1); } else arr.push(h.s); }
    else if (h.a === "del"){ if (undo) arr.splice(Math.min(h.i, arr.length), 0, h.s); else { var j = arr.indexOf(h.s); if (j > -1) arr.splice(j, 1); } }
    else if (h.a === "edit"){ var t = h.s.s; h.s.s = h.prev; h.prev = t; }
    else if (h.a === "clear"){ var cur = ink.data; ink.data = h.data; h.data = cur; }
  }
  function inkUndo(){ var h = ink.hist.pop(); if (!h) return; applyHist(h, true); ink.redo.push(h); inkSave(); redrawKey(); inkBarState(); }
  function inkRedo(){ var h = ink.redo.pop(); if (!h) return; applyHist(h, false); ink.hist.push(h); inkSave(); redrawKey(); inkBarState(); }
  function inkClear(){
    if (!hasNotes()) return;
    if (!confirm("Clear all your notes on this item? You can undo this until you leave the item.")) return;
    ink.hist.push({a:"clear", data: ink.data}); ink.data = {}; ink.redo = []; inkSave(); redrawKey(); inkBarState();
  }
  function hasNotes(){ return Object.keys(ink.data).some(function(k){ return ink.data[k] && ink.data[k].length; }); }

  // ---- mode + toolbar
  function setInk(on){
    if (on && !canInk(pages[cur])) on = false;
    INK.on = !!on;
    document.body.classList.toggle("inking", INK.on);
    $("inkbar").hidden = !INK.on;
    $("inkBtn").setAttribute("aria-pressed", INK.on);
    ink.surfaces.forEach(inkPointerMode);
    $("view").classList.toggle("inking", INK.on);
    inkBarState();
  }
  function setTool(t){ INK.tool = t; ink.surfaces.forEach(inkPointerMode); inkBarState(); }
  function inkBarState(){
    var bar = $("inkbar"); if (!bar) return;
    bar.querySelectorAll("[data-tool]").forEach(function(b){ b.setAttribute("aria-pressed", b.dataset.tool === INK.tool); });
    var hl = INK.tool === "hl", col = (hl ? INK_HL : INK_PEN)[INK.color];
    $("inkColor").querySelector(".dot").style.background = col;
    $("inkColor").title = "Color: " + (hl ? INK_HL_NAMES : INK_NAMES)[INK.color] + " (C)";
    var sz = $("inkSize").querySelector(".sz"); sz.style.height = sz.style.width = [6, 10, 15][INK.size] + "px";
    $("inkSize").title = "Size: " + INK_SIZE[INK.size].n + " (S)";
    $("inkUndo").disabled = !ink.hist.length; $("inkRedo").disabled = !ink.redo.length; $("inkClear").disabled = !hasNotes();
  }

  var toastT;
  function toast(m){ var t = $("toast"); t.textContent = m; t.hidden = false; clearTimeout(toastT); toastT = setTimeout(function(){ t.hidden = true; }, 3500); }
  $("inkBtn").onclick = function(){ setInk(!INK.on); };
  $("inkDone").onclick = function(){ setInk(false); };
  $("inkbar").addEventListener("click", function(e){ var b = e.target.closest("[data-tool]"); if (b) setTool(b.dataset.tool); });
  $("inkColor").onclick = function(){ INK.color = (INK.color + 1) % INK_PEN.length; inkBarState(); };
  $("inkSize").onclick = function(){ INK.size = (INK.size + 1) % INK_SIZE.length; inkBarState(); };
  $("inkUndo").onclick = inkUndo; $("inkRedo").onclick = inkRedo; $("inkClear").onclick = inkClear;

  // ---------- page display ----------
  var pdfS = null;
  function clearView(){
    if (pdfS){ pdfS.dead = true; if (pdfS.io) pdfS.io.disconnect(); try { pdfS.doc.destroy(); } catch(e){} pdfS = null; }
    $("view").innerHTML = ""; $("view").hidden = true;
    $("frame").hidden = true; $("frame").srcdoc = "";
    $("pdfCtl").hidden = true; $("dlBtn").hidden = true;
    ink.surfaces = [];
    $("wm").classList.remove("onview");
  }

  // ---------- required items (attendance), post-tests, closed-book sensor ----------
  // An item marked Required in Portal Builder has a logging period (from → until). Inside it: a video can't be skipped ahead
  // and plays at 1.25× at most; a reading needs a minimum time and reaching its end. Finishing is recorded as attendance.
  // A post-test (optional) opens once the item is finished: one closed-book attempt; its key and rationales open after the
  // period ends, when the test itself is no longer available. After the period the item stays viewable, but nothing is logged.
  var CB = null, rqCur = null, lastAct = Date.now(), rqTold = 0;
  function rqOf(p){ return p && p.rq && p.rq.until ? p.rq : null; }
  function rqT(s){ var t = Date.parse(s); return isNaN(t) ? 0 : t; }
  function rqPhase(r){ var n = effNow(); if (r.from && n < rqT(r.from)) return "early"; return n <= rqT(r.until) ? "open" : "closed"; }
  function rqGet(p){ var st = scLoad(), o = st.rq && st.rq[lockId(p)]; return o || {max: 0, secs: 0, end: false, done: null, pt: null}; }
  function rqPut(p, o){ var st = scLoad(); st.rq = st.rq || {}; st.rq[lockId(p)] = o; scStore(st); }
  function fmtWhen(s){ return new Date(rqT(s)).toLocaleString(undefined, {month: "short", day: "numeric", hour: "numeric", minute: "2-digit"}); }
  function clock(s){ s = Math.max(0, Math.floor(s)); var h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60; return (h ? h + ":" + String(m).padStart(2, "0") : m) + ":" + String(x).padStart(2, "0"); }
  function rqMedia(p){ return p.k === "video" || p.k === "audio" || (p.k === "link" && !rqTm(p)); }
  function rqTm(p){ return !!(p && p.k === "link" && p.rq && p.rq.tm); }        // a link whose player reports nothing: time kept open counts
  function rqKind(p){ return p.k === "link" ? (p.ico === "audio" ? "Recording" : "Video") + " (" + (p.svc || "online") + ")" : p.k === "video" ? "Video" : p.k === "audio" ? "Recording" : p.k === "pdf" ? "Reading (PDF)" : "Reading / activity"; }
  function rqTell(m){ if (Date.now() - rqTold > 2500){ rqTold = Date.now(); toast(m); } }
  function rqQueue(rec){
    if (!SC || !user) return;
    var st = scLoad();
    st.queue.push(Object.assign({id: rid(), portal: D.id, portalTitle: D.title || "", sn: user.sn, name: user.name, email: user.em, tok: user.tok || "", at: new Date(effNow()).toISOString()}, rec));
    st.to = {u: SC.u, k: SC.k}; scStore(st); flushScores();
  }
  function rqSend(i){
    var p = pages[i], r = rqOf(p), s = rqGet(p); if (!r || !s.done) return;
    rqQueue({type: "attend", item: p.t, itemTitle: p.t, itemId: lockId(p), ix: i, kind: rqKind(p), done: s.done, secs: Math.round(s.secs || 0), until: r.until,
             hasPt: !!(r.pt && r.pt.length), pt: s.pt ? {score: s.pt.score, total: s.pt.total, at: s.pt.at, left: !!s.pt.left, why: s.pt.why || ""} : null});
  }
  function rqComplete(i){
    var p = pages[i], r = rqOf(p), s = rqGet(p); if (!r || s.done || rqPhase(r) !== "open") return;
    s.done = new Date(effNow()).toISOString(); rqPut(p, s); rqSend(i);
    toast(r.pt && r.pt.length ? "Completed and recorded. The post-test is now open." : "Completed — recorded as attendance.");
    rqPaint(); paintRq();
  }
  function paintRq(){ paintOp(); paintRq2(); }
  function paintRq2(){
    document.querySelectorAll("nav button.item").forEach(function(b){
      var p = pages[+b.dataset.i], old = b.querySelector(".rqb"); if (old) old.remove();
      var r = rqOf(p); if (!r) return;
      var s = rqGet(p), ph = rqPhase(r), x = document.createElement("span"); x.className = "rqb";
      var needPt = r.pt && r.pt.length && !s.pt;
      if (s.done && !needPt){ x.textContent = "✓ Done"; x.classList.add("ok"); }
      else if (s.done && ph === "open"){ x.textContent = "Post-test"; }
      else if (ph === "open"){ x.textContent = "Required"; }
      else if (ph === "early"){ x.textContent = "Soon"; x.classList.add("off"); }
      else { x.textContent = s.done ? "✓ Done" : "Closed"; x.classList.add(s.done ? "ok" : "off"); }
      x.title = ph === "open" ? "Required — recorded until " + fmtWhen(r.until) : ph === "early" ? "Recording opens " + fmtWhen(r.from) : "Recording ended " + fmtWhen(r.until);
      b.appendChild(x);
    });
  }
  // The strip above the content: what is required, progress, and the post-test button
  function rqPaint(){
    var bar = $("rqBar"), p = pages[cur], r = rqOf(p);
    if (CB && CB.type === "exam" && CB.i === cur){
      bar.className = "rqbar cb"; bar.hidden = false;
      bar.innerHTML = ic("lock") + "<span><b>Closed-book exam mode is on.</b> Leaving this page, switching tabs or apps, opening any other page of the portal, or opening the answer key signs you out.</span>";
      return;
    }
    if (CB && CB.type === "pt" && CB.i === cur){
      bar.className = "rqbar cb"; bar.hidden = false;
      bar.innerHTML = ic("lock") + "<span><b>Post-test in progress — closed book.</b> Switching tabs or apps, or opening any other page of the portal, closes it and submits your answers as they are.</span>";
      return;
    }
    if (!r){ bar.hidden = true; return; }
    var s = rqGet(p), ph = rqPhase(r), n = r.pt ? r.pt.length : 0, h = "", btn = "", cls = "rqbar";
    var what = rqMedia(p) ? "watch it to the end" : rqTm(p) ? "keep it open here for at least " + (+r.min || 0) + " min" : "spend at least " + (+r.min || 0) + " min on it and reach the end";
    if (ph === "early") h = "<b>Required " + esc(rqKind(p).toLowerCase()) + ".</b> Recording opens " + esc(fmtWhen(r.from)) + " and ends " + esc(fmtWhen(r.until)) + ". You can preview it now; it isn't recorded yet.";
    else if (ph === "open" && !s.done){
      var prog = rqMedia(p) ? "Watched " + clock(s.max) + (rqCur && rqCur.dur ? " of " + clock(rqCur.dur) : "")
                            : rqTm(p) ? "Time open " + clock(s.secs) + " / " + clock((+r.min || 0) * 60) + " — it counts only while this page is on screen and you're online"
                            : "Time " + clock(s.secs) + " / " + clock((+r.min || 0) * 60) + " · end " + (s.end ? "reached ✓" : "not reached yet");
      h = "<b>Required — " + what + " by " + esc(fmtWhen(r.until)) + ".</b> " + (rqMedia(p) ? "No skipping ahead; speed up to 1.25×. " : "") + '<span class="pr">' + prog + "</span>" + (n ? " A " + n + "-item post-test follows." : "");
    } else if (ph === "open" && s.done && n && !s.pt){
      h = "<b>Completed ✓ recorded.</b> Post-test: " + n + " item" + (n === 1 ? "" : "s") + ", <b>closed book</b>, one attempt — take it by " + esc(fmtWhen(r.until)) + ".";
      btn = '<button class="btn sm" id="rqGo" type="button">Take the post-test</button>'; cls += " go";
    } else if (ph === "open" && s.done){
      h = "<b>Completed ✓ recorded as attendance.</b>" + (s.pt ? " Post-test score: <b>" + s.pt.score + " / " + s.pt.total + "</b>. The answer key and rationales open after " + esc(fmtWhen(r.until)) + "." : ""); cls += " ok";
    } else {
      h = (s.done ? "<b>Completed on time ✓ (recorded).</b> " : "<b>The recording period ended " + esc(fmtWhen(r.until)) + ".</b> You can still view this, but it is no longer recorded. ") +
          (n ? (s.pt ? "Post-test: " + s.pt.score + "/" + s.pt.total + ". " : "The post-test is closed. ") : "");
      if (n) btn = '<button class="btn ghost sm" id="rqGo" type="button">Answer key and rationales</button>';
      cls += s.done ? " ok" : " off";
    }
    bar.className = cls; bar.innerHTML = ic(s.done ? "lock" : "cal") + "<span>" + h + "</span>" + btn; bar.hidden = false;
    var g = $("rqGo"); if (g) g.onclick = function(){ if (rqPhase(r) === "closed") ptReview(cur); else ptAsk(cur); };
  }
  // Video / audio: no skipping ahead, 1.25× at most, resumes where the student stopped
  function rqWatch(el, i, tok){
    var p = pages[i], r = rqOf(p); if (!r) return;
    var s = rqGet(p), lastT = null, saved = 0, enf = rqPhase(r) === "open" && !s.done;
    rqCur = {i: i, media: true, dur: 0};
    el.addEventListener("loadedmetadata", function(){ rqCur.dur = el.duration || 0; if (enf && s.max > 1 && s.max < el.duration - 1) el.currentTime = s.max; rqPaint(); });
    el.addEventListener("ratechange", function(){ if (enf && el.playbackRate > 1.25){ el.playbackRate = 1.25; rqTell("Required viewing: speed is limited to 1.25×."); } });
    el.addEventListener("seeking", function(){ lastT = null; if (enf && el.currentTime > s.max + 0.75){ el.currentTime = s.max; rqTell("Required viewing: you can't skip ahead. You can go back and replay."); } });
    el.addEventListener("pause", function(){ lastT = null; if (enf){ rqPut(p, s); rqPaint(); } });
    el.addEventListener("timeupdate", function(){
      if (tok !== navTok || !enf) return;
      if (rqPhase(r) !== "open"){ enf = false; rqPaint(); return; }
      var t = el.currentTime;
      if (!el.seeking && !el.paused){
        if (lastT != null){ var d = t - lastT; if (d > 0 && d < 2){ s.secs += d / (el.playbackRate || 1); if (t <= s.max + 2) s.max = Math.max(s.max, t); } }
        lastT = t;
      }
      if (Date.now() - saved > 4000){ saved = Date.now(); rqPut(p, s); rqPaint(); }
    });
    el.addEventListener("ended", function(){
      if (tok !== navTok || !enf) return;
      if (s.max >= (el.duration || 0) - 2){ s.end = true; s.max = el.duration || s.max; rqPut(p, s); enf = false; rqComplete(i); }
    });
  }
  // Online video / audio (YouTube through your player page, Spotify): the same rules, from the position the player reports.
  // Only real playing counts; skipping ahead or playing faster than 1.25× sends it back to where the student has reached.
  function rqSeek(e, t){ try { if (e.ctl && e.ctl.seek) e.ctl.seek(t); else if (e.el) e.el.contentWindow.postMessage({portalYT: 1, cmd: "seek", v: t}, "*"); } catch(x){} e._t = t; }
  function rqEmbTick(){
    (NP && NP !== CUR ? [CUR, NP] : [CUR]).forEach(function(e){
      if (!e || e.kind !== "embed" || e.i == null) return;
      var p = pages[e.i], r = rqOf(p); if (!r || p.k !== "link" || rqTm(p)) return;
      if (cur === e.i && (!rqCur || rqCur.i !== e.i || rqCur.dur !== (e.d || 0))){ rqCur = {i: e.i, media: true, dur: e.d || 0}; rqPaint(); }
      var s = e.rqS || (e.rqS = rqGet(p));
      if (s.done || rqPhase(r) !== "open" || typeof e.t !== "number" || !e.tAt || e._at === e.tAt) return;
      var first = !e._at, w = first ? 0 : (e.tAt - e._at) / 1000, prev = first ? e.t : e._t, d = e.t - prev; e._at = e.tAt; e._t = e.t;
      var pv = /Spotify/.test(e.svc) && e.preview;
      if (pv){ rqTell("Required: a 30-second Spotify preview doesn't count. Sign in to Spotify in this browser, then reload the player."); return; }
      if (first && s.max > 5 && e.t < s.max - 5 && !(e.d && s.max >= e.d - 3)){ rqSeek(e, s.max); toast("Required viewing: continuing where you stopped (" + clock(s.max) + ")."); return; }
      var allow = w * 1.25 + 0.6;
      if (e.t > s.max + Math.max(4, allow + 2)){ rqSeek(e, s.max); rqTell(d > 0 && d <= w * 2.2 + 1 ? "Required viewing: speed is limited to 1.25×." : "Required viewing: you can't skip ahead. You can go back and replay."); return; }
      if (e.state === "playing" && w > 0 && d > 0){ var adv = Math.min(d, allow); s.secs += Math.min(d, w); if (prev <= s.max + 1) s.max = Math.max(s.max, Math.min(e.t, prev + adv)); }
      if (e.d && s.max >= e.d - 2.5){ s.end = true; s.max = e.d; rqPut(p, s); e.rqS = null; rqComplete(e.i); return; }
      if (Date.now() - (e._sv || 0) > 4000){ e._sv = Date.now(); rqPut(p, s); if (cur === e.i) rqPaint(); }
    });
  }
  setInterval(rqEmbTick, 1000);
  // Reading / activity: time actually spent with the page in front, plus reaching the end
  function rqEnd(){
    try {
      if (pages[cur].k === "pdf"){ var sc = pdfS && pdfS.sc; return !!sc && sc.scrollTop + sc.clientHeight >= sc.scrollHeight - 80; }
      var w = $("frame").contentWindow, de = w.document.scrollingElement || w.document.documentElement;
      return de.scrollHeight <= w.innerHeight + 80 || w.scrollY + w.innerHeight >= de.scrollHeight - 80;
    } catch(e){ return false; }
  }
  ["pointerdown", "keydown", "wheel", "touchstart", "mousemove", "scroll"].forEach(function(ev){ document.addEventListener(ev, function(){ lastAct = Date.now(); }, {passive: true, capture: true}); });
  function rqActHook(w){ ["pointerdown", "keydown", "wheel", "touchstart", "mousemove", "scroll"].forEach(function(ev){ w.addEventListener(ev, function(){ lastAct = Date.now(); }, {passive: true, capture: true}); }); }
  setInterval(function(){
    if (!user || cur < 0) return;
    if (CB && CB.type === "exam"){                                          // exam in progress: still on the test? finished?
      try {
        var kh = keyHeadsVisible(CB.d).filter(function(el){ return CB.keys.indexOf(el) < 0; });
        if (kh.length && !keyGateIn(kh[0].closest('[data-view],[data-page],.view,.page,.slide') || CB.d.body)){ cbLeft("opened the answer key", true); return; }
        if (CB.box && !visible(CB.box)){ cbLeft(kh.length ? "opened the answer key page" : "opened another page of the handout", kh.length > 0); return; }
        if (CB.snap != null){ var now = examSnap(CB.d); if (now && now !== CB.snap){ CB = null; rqPaint(); } }
      } catch(e){}
      return;
    }
    var p = pages[cur], r = rqOf(p);
    if (!r || rqMedia(p) || !rqCur || rqCur.i !== cur || !rqCur.ready) return;
    if (rqPhase(r) !== "open"){ if (rqCur.open){ rqCur.open = false; rqPaint(); paintRq(); } return; }
    rqCur.open = true;
    var s = rqCur.s; if (s.done || CB) return;
    if (rqTm(p)){                                                          // a video link: on screen and online (watching needs no clicks)
      if (document.hidden || navigator.onLine === false || !$("loading").hidden) return;
      s.secs += 1; s.end = true;
    } else {
      if (document.hidden || !document.hasFocus() || Date.now() - lastAct > 180000 || !$("loading").hidden) return;   // only while actually reading
      s.secs += 1; if (!s.end && rqEnd()) s.end = true;
    }
    if (++rqCur.n % 5 === 0){ rqPut(p, s); rqPaint(); }
    if (s.secs >= (+r.min || 0) * 60 && s.end){ rqPut(p, s); rqComplete(cur); }
  }, 1000);
  function rqRead(i){ var p = pages[i]; if (!rqOf(p) || rqMedia(p)) return; rqCur = {i: i, s: rqGet(p), n: 0, ready: true, open: rqPhase(rqOf(p)) === "open"}; }

  // ---- generic confirmation (closed-book notices)
  var cbGo = null;
  function ask(title, html, yes, go){
    var m = $("cbAsk"); cbGo = go;
    $("cbAskT").textContent = title; $("cbAskB").innerHTML = html; $("cbYes").textContent = yes;
    (document.fullscreenElement || document.webkitFullscreenElement ? $("stage") : document.body).appendChild(m);
    m.hidden = false; $("cbYes").focus();
  }
  function askClose(ok){ var g = cbGo; cbGo = null; $("cbAsk").hidden = true; if (ok && g) g(); }
  $("cbNo").onclick = function(){ askClose(false); };
  $("cbYes").onclick = function(){ askClose(true); };
  $("cbAsk").addEventListener("keydown", function(e){ if (e.key === "Escape"){ e.stopPropagation(); askClose(false); } });
  var CB_RULE = "This is a <b>closed-book</b> activity, unlike the readings and quick checks. ";

  // ---- post-test
  function ptAsk(i){
    var p = pages[i], r = rqOf(p), s = rqGet(p);
    if (!r || !r.pt || !r.pt.length || s.pt || !s.done || rqPhase(r) !== "open") return;
    ask("Start the post-test?", "<p>" + CB_RULE + r.pt.length + " item" + (r.pt.length === 1 ? "" : "s") + ", <b>one attempt</b>.</p>" +
        "<p>Once you start, <b>switching tabs or apps for 5 seconds or more, or opening any other page of the portal, closes the post-test</b> and submits your answers as they are. Notifications don't count.</p>" +
        "<p class='fine'>You see your score right after submitting. The answer key and rationales open after " + esc(fmtWhen(r.until)) + ".</p>", "Start post-test", function(){ ptStart(i); });
  }
  function ptStart(i){
    var p = pages[i], r = rqOf(p); if (cur !== i) return;
    document.querySelectorAll("#view video, #view audio").forEach(function(m){ try { m.pause(); } catch(e){} });
    if (isFs()) try { (document.exitFullscreen || document.webkitExitFullscreen).call(document); } catch(e){}
    CB = {type: "pt", i: i, t0: Date.now()}; brief = 0; away = null; npQuiet(); rqPaint();
    var h = '<div class="ptin"><div class="pth"><h3>Post-test — ' + esc(p.t) + '</h3><p>' + ic("lock") + '<span><b>Closed book.</b> Stay on this page: switching tabs or apps, or opening any other page of the portal, closes the post-test and submits your answers as they are.</span></p></div><form id="ptForm">';
    r.pt.forEach(function(q, n){
      h += '<fieldset class="ptq"><legend><b>' + (n + 1) + '.</b> ' + esc(q.q) + '</legend>' + q.o.map(function(o, k){
        return '<label><input type="radio" name="q' + n + '" value="' + k + '"><span><b>' + String.fromCharCode(65 + k) + '.</b> ' + esc(o) + '</span></label>'; }).join("") + '</fieldset>';
    });
    h += '<div class="ptf"><span id="ptCount">0 of ' + r.pt.length + ' answered</span><button class="btn" type="submit">Submit post-test</button></div></form></div>';
    var w = $("ptWrap"); w.innerHTML = h; w.hidden = false; w.scrollTop = 0;
    $("ptForm").addEventListener("change", function(){ $("ptCount").textContent = w.querySelectorAll("input:checked").length + " of " + r.pt.length + " answered"; });
    $("ptForm").addEventListener("submit", function(e){
      e.preventDefault();
      var left = r.pt.length - w.querySelectorAll("input:checked").length;
      if (left) ask("Submit with unanswered items?", "<p>" + left + " item" + (left === 1 ? " is" : "s are") + " unanswered and will be marked wrong. You can't reopen the post-test after submitting.</p>", "Submit anyway", function(){ ptSubmit(false); });
      else ptSubmit(false);
    });
  }
  function ptSubmit(left, why){
    if (!CB || CB.type !== "pt") return;
    var i = CB.i, p = pages[i], r = rqOf(p), w = $("ptWrap"), ans = [], score = 0;
    r.pt.forEach(function(q, n){ var c = w.querySelector('input[name="q' + n + '"]:checked'), a = c ? +c.value : -1; ans.push(a); if (a === q.a) score++; });
    CB = null; askClose(false);
    var s = rqGet(p); s.pt = {at: new Date(effNow()).toISOString(), ans: ans, score: score, total: r.pt.length, left: !!left, why: why || ""}; rqPut(p, s);
    w.hidden = true; w.innerHTML = "";
    rqSend(i);
    if (left) rqQueue({type: "event", item: p.t, itemTitle: p.t, itemId: lockId(p), what: "Post-test closed early: " + (why || "left the page") + " — submitted as it was (" + ans.filter(function(a){ return a >= 0; }).length + " of " + r.pt.length + " answered)"});
    toast(left ? "Post-test closed and submitted as it was (score " + score + " / " + r.pt.length + ") — you " + (why || "left the page") + "." : "Post-test submitted and recorded — your score: " + score + " / " + r.pt.length + ". The answer key opens after " + fmtWhen(r.until) + ".");
    if (cur === i) rqPaint(); paintRq();
  }
  function ptReview(i){
    var p = pages[i], r = rqOf(p), s = rqGet(p); if (!r || !r.pt || rqPhase(r) !== "closed") return;
    var mine = s.pt ? s.pt.ans : null;
    var h = '<div class="ptin"><div class="pth"><h3>Post-test answer key — ' + esc(p.t) + '</h3><p><span>' + (s.pt ? "Your score: <b>" + s.pt.score + " / " + s.pt.total + "</b>" + (s.pt.left ? " (closed early)" : "") : "You didn't take this post-test. It closed on " + esc(fmtWhen(r.until)) + ".") + '</span></p></div>';
    r.pt.forEach(function(q, n){
      h += '<div class="ptq rev"><p class="lg"><b>' + (n + 1) + '.</b> ' + esc(q.q) + '</p>' + q.o.map(function(o, k){
        var c = k === q.a ? " right" : mine && mine[n] === k ? " wrong" : "";
        return '<div class="opt' + c + '"><b>' + String.fromCharCode(65 + k) + '.</b> ' + esc(o) + (k === q.a ? " ✓" : "") + (mine && mine[n] === k ? ' <i>(your answer)</i>' : "") + '</div>'; }).join("") +
        (mine && mine[n] < 0 ? '<div class="opt wrong"><i>Not answered</i></div>' : "") + (q.r ? '<p class="rat"><b>Rationale.</b> ' + esc(q.r) + '</p>' : "") + '</div>';
    });
    h += '<div class="ptf"><span></span><button class="btn" type="button" id="ptClose">Close</button></div></div>';
    var w = $("ptWrap"); w.innerHTML = h; w.hidden = false; w.scrollTop = 0;
    $("ptClose").onclick = function(){ w.hidden = true; w.innerHTML = ""; };
  }

  // ---- closed-book sensor: post-test → closes and submits; mock test in exam mode → signs the student out
  var CB_EXAM = /\b(exam|timed|test|assessment)\s*mode\b|^\W*(start|begin|take)\s+(the\s+)?(mock\s+)?exam\b/i;
  function cbLeft(why, key){
    if (!CB) return;
    if (CB.type === "pt"){ ptSubmit(true, why); return; }
    var i = CB.i, p = pages[i]; CB = null;
    var locked = false;
    if (key && p && SC && p.sc && !isLocked(p)){ lockItem(i); locked = true; }   // answer key during the exam: best scores so far become final
    if (p) rqQueue({type: "event", item: p.t, itemTitle: p.t, itemId: lockId(p), what: "Left a mock test in exam mode: " + why + (locked ? " — best scores locked" : "") + " — signed out"});
    $("out").onclick();
    $("err").textContent = "You were signed out because you " + why + " during a mock test in exam mode. Mock tests in exam mode are closed-book." +
      (key && p && p.sc ? " Your best scores in this lesson from before are now final; later attempts won't be recorded." : "");
  }
  // Leaving only counts when it is real: away for 5 seconds or more. A notification banner, the notification shade or an
  // incoming-call banner doesn't hide the page, and on phones and tablets losing focus alone is ignored. A short slip
  // (back within 5 seconds) is forgiven twice per test, with a warning.
  var away = null, brief = 0, AWAY_MS = 5000, TOUCH = !!(window.matchMedia && matchMedia("(pointer: coarse)").matches);
  function cbAway(why){ if (!CB || away) return; away = {t: Date.now(), why: why, timer: setTimeout(cbCheck, AWAY_MS)}; }
  function cbGone(){ return document.hidden || (!TOUCH && !document.hasFocus()); }
  function cbCheck(){ if (!away) return; if (!CB){ away = null; return; } if (cbGone()){ var w = away.why; away = null; cbLeft(w); } else cbBack(); }
  function cbBack(){
    if (!away || cbGone()) return;
    var a = away; clearTimeout(a.timer); away = null; if (!CB) return;
    if (Date.now() - a.t >= AWAY_MS || ++brief > 2) cbLeft(a.why);
    else toast("Closed book — stay on this page. That was short interruption " + brief + " of 2 allowed.");
  }
  function cbBlur(){ if (CB && !TOUCH) setTimeout(function(){ if (CB && !document.hidden && !document.hasFocus()) cbAway("switched to another window or app"); }, 300); }
  document.addEventListener("visibilitychange", function(){ if (document.hidden) cbAway("switched to another tab or app"); else cbBack(); });
  window.addEventListener("blur", cbBlur);
  window.addEventListener("focus", function(){ setTimeout(cbBack, 50); });
  window.addEventListener("pagehide", function(){ if (CB && CB.type === "pt") ptSubmit(true, "closed the portal"); });
  function examSnap(d){ try { return scanAll(d, d.body.innerText || "").filter(function(x){ return x.total >= 5; }).map(function(x){ return x.score + "/" + x.total; }).join(","); } catch(e){ return ""; } }
  function guardExam(w, i, tok){
    if (D.cbx === false) return;
    var d = w.document, allow = null;
    d.addEventListener("click", function(e){
      if (tok !== navTok) return;
      var el = e.target && e.target.closest ? e.target.closest('button,a,[role=tab],[role=button],[role=radio],label,input[type=button],input[type=submit],input[type=radio],.tab,.btn') : null;
      if (!el) return;
      var full = labelOf(el);
      if (CB && CB.type === "exam" && CB.i === i && full && full.length <= 80 && KEY_CTRL.test(full)){          // answer key during the exam
        e.preventDefault(); e.stopImmediatePropagation(); cbLeft("tried to open the answer key", true); return;
      }
      var txt = shortLabel(full); if (!txt || txt.length > 60) return;
      if (CB && CB.type === "exam" && PRAC_RE.test(txt) && !CB_EXAM.test(txt)){ CB = null; rqPaint(); return; }      // switched to practice mode
      if (!CB_EXAM.test(txt) || PRAC_RE.test(txt)) return;
      if (allow === el){ allow = null; return; }
      if (CB && CB.type === "exam") return;
      e.preventDefault(); e.stopImmediatePropagation();
      ask("Start exam mode?", "<p>" + CB_RULE + "</p><p>While the mock test is in exam mode, <b>switching tabs or apps for 5 seconds or more, opening any other page of the portal or of this handout, or opening the answer key signs you out of the portal.</b> Opening the answer key also makes your best scores in this lesson final. Notifications don't count.</p><p class='fine'>Close your notes and other tabs first. Closed-book mode ends when you submit the exam.</p>", "Start exam mode", function(){
        if (tok !== navTok) return;
        var box = el.closest('[data-view],[data-page],.view,.page,.slide,section,article');
        CB = {type: "exam", i: i, box: box, d: d, snap: null, keys: keyHeadsVisible(d)}; brief = 0; away = null; npQuiet();
        allow = el; el.click();
        setTimeout(function(){ if (CB && CB.type === "exam") CB.snap = examSnap(d); }, 400);
        rqPaint();
      });
    }, true);
    w.addEventListener("blur", cbBlur); w.addEventListener("focus", function(){ setTimeout(cbBack, 50); });
  }

  // ---------- Now playing: music and videos keep playing while the student moves to other pages ----------
  // A link embed (YouTube, Spotify, Apple Music…) lives in its own layer over the page, so it never reloads: on its page the
  // layer sits over the page's player area; on other pages it shrinks into the mini-player. Uploaded audio and video move
  // between the page and the mini-player (a media element keeps playing when moved). Pausing is always the student's choice.
  // One item plays in the background at a time; required items still being recorded stay on their own page.
  var NP = null, CUR = null, npRAF = 0, npAuto = -1;
  // Uploaded videos in the mini-player: "video" (picture shown) or "listen" (slim bar, sound only). The student's choice is
  // remembered on this device; the default comes from Portal Builder. YouTube always shows its picture (YouTube's rules
  // don't allow hiding the video or playing audio only, and its player must be at least 200 px tall).
  function npMode(){ var m = null; try { m = localStorage.getItem("portal-np-mode:" + D.id); } catch(e){} return m === "listen" || m === "video" ? m : (D.npv === "listen" ? "listen" : "video"); }
  function npSetMode(m){ try { localStorage.setItem("portal-np-mode:" + D.id, m); } catch(e){} }
  function npYT(p){ return p.k === "link" && /youtube|youtu\.be|yt-player/i.test((p.svc || "") + " " + (p.e || "")); }
  function npOn(){ return D.np !== false; }
  function npAllowed(i){ var p = pages[i], r = rqOf(p); return !(r && rqPhase(r) === "open" && !rqGet(p).done); }
  function npKind(p){ return p.k === "link" ? (/youtube|vimeo|video/i.test(p.svc || "") || p.l === "video" ? "vid" : "aud") : p.k === "video" ? "vid" : "aud"; }
  function npPlaying(s){ if (!s) return false; if (s.kind === "media") return !s.el.paused && !s.el.ended; return s.state == null ? !!s.touched : s.state === "playing"; }
  function npCtl(s){ return s && (s.kind === "media" || s.state != null); }
  // Embed layer: one positioned box per embed, following a target (its page slot, or the mini-player slot)
  function npFrame(p, i){
    var box = document.createElement("div"); box.className = "npframe"; $("stage").appendChild(box);
    var s = {i: i, kind: "embed", box: box, el: null, svc: p.svc || "", state: null, touched: false, ctl: null};
    function plain(){                                                     // an ordinary embed (also the fallback for Spotify)
      if (s.el || !box.isConnected) return;
      var f = document.createElement("iframe");
      f.title = p.t; f.setAttribute("allow", "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture");
      f.allowFullscreen = true; f.referrerPolicy = "strict-origin-when-cross-origin";
      box.appendChild(f); f.src = p.e; s.el = f;
    }
    var uri = spUri(p.e);
    if (uri){                                                             // Spotify: its official iFrame API, so play/pause can be controlled
      var slot = document.createElement("div"); box.appendChild(slot);
      var late = setTimeout(function(){ if (!s.ctl){ slot.remove(); plain(); } }, 8000);
      spApi(function(API){
        if (s.el || !box.isConnected) return;
        try {
          API.createController(slot, {uri: uri, width: "100%", height: "100%"}, function(ctl){
            clearTimeout(late); s.ctl = ctl; s.el = box.querySelector("iframe");
            ctl.addListener("playback_update", function(e){
              var d = e && e.data; if (!d) return; var was = s.state;
              if (d.duration && /^spotify:(track|album|playlist|artist)/.test(uri)){       // ≈30 s long = Spotify is playing its preview
                var pv = d.duration >= 25000 && d.duration <= 31000;
                if (pv !== !!s.preview){ s.preview = pv; spPreview(s); }
              }
              s.state = d.isPaused ? "paused" : "playing";
              if (d.duration) s.d = d.duration / 1000; if (typeof d.position === "number"){ s.t = d.position / 1000; s.tAt = performance.now(); }
              if (s === NP && was !== s.state) npPaint();
            });
          });
        } catch(x){ clearTimeout(late); slot.remove(); plain(); }
      }, function(){ clearTimeout(late); slot.remove(); plain(); });
    } else plain();
    npLoop(); return s;
  }
  // Spotify plays whole songs only for listeners signed in to Spotify in this browser; otherwise 30-second previews
  var spWarned = false;
  function spPreview(s){
    var h = $("spHelp");
    if (h && CUR === s){ h.classList.toggle("warn", !!s.preview); $("spHelpT").textContent = s.preview ? "This is playing a 30-second preview" : "Playing whole songs"; }
    if (s.preview && !spWarned){ spWarned = true; toast("Spotify is playing 30-second previews. To hear whole songs, sign in to Spotify in this browser — or open it in the Spotify app."); }
    if (NP) npPaint();
  }
  function spAppUrl(p){                                                    // the Spotify app: spotify: link on computers; phones open the app from the normal link
    var uri = spUri(p.e);
    return uri && !matchMedia("(pointer:coarse)").matches ? uri : p.u;
  }
  // "https://open.spotify.com/embed/track/ID?…" → "spotify:track:ID"
  function spUri(u){ var m = /open\.spotify\.com\/embed\/(?:intl-[\w-]+\/)?(track|album|playlist|episode|show|artist)\/([A-Za-z0-9]+)/.exec(u || ""); return m ? "spotify:" + m[1] + ":" + m[2] : ""; }
  var SP = {api: null, wait: [], fail: [], loading: false};
  function spApi(ok, bad){
    if (SP.api){ ok(SP.api); return; }
    SP.wait.push(ok); SP.fail.push(bad);
    if (SP.loading) return; SP.loading = true;
    window.onSpotifyIframeApiReady = function(API){ SP.api = API; var w = SP.wait; SP.wait = []; SP.fail = []; w.forEach(function(f){ f(API); }); };
    var sc = document.createElement("script"); sc.async = true; sc.src = window.__spotifyApi || "https://open.spotify.com/embed/iframe-api/v1";
    sc.onerror = function(){ SP.loading = false; var f = SP.fail; SP.wait = []; SP.fail = []; f.forEach(function(g){ g(); }); };
    document.head.appendChild(sc);
  }
  function npPlace(s, target){
    if (!s || s.kind !== "embed") return;
    var b = s.box, st = $("stage").getBoundingClientRect();
    if (!target || !target.isConnected || target.offsetParent === null){ b.style.cssText = "left:-10000px;top:0;width:320px;height:180px"; return; }   // off screen, still playing
    var r = target.getBoundingClientRect();
    b.style.cssText = "left:" + (r.left - st.left) + "px;top:" + (r.top - st.top) + "px;width:" + r.width + "px;height:" + r.height + "px;z-index:" + (target.id === "npMiniSlot" ? 26 : 24);   // in the mini-player: above its panel
  }
  function npLoop(){
    if (npRAF) return;
    (function tick(){
      if (!NP && !CUR){ npRAF = 0; return; }
      if (CUR && CUR.kind === "embed") npPlace(CUR, $("npSlot"));
      if (NP && NP.kind === "embed") npPlace(NP, $("npMiniSlot"));
      npRAF = requestAnimationFrame(tick);
    })();
  }
  function npKill(s){ if (!s) return; if (s.kind === "embed"){ if (s.ctl) try { s.ctl.destroy(); } catch(e){} s.box.remove(); } else { try { s.el.pause(); } catch(e){} s.el.removeAttribute("src"); try { s.el.load(); } catch(e){} s.el.remove(); } }
  // Leaving the current page: keep its media going in the mini-player if it is playing
  function npLeave(next){
    var s = CUR; CUR = null;
    if (!s) return;
    if (npOn() && next !== s.i && npPlaying(s) && npAllowed(s.i)){
      if (NP && NP !== s) npKill(NP);
      NP = s;
      if (s.kind === "media"){ s.el.controls = false; $("npMiniSlot").appendChild(s.el); s.el.addEventListener("click", npClickToggle); }
      npPaint(); npLoop();
    } else if (s !== NP) npKill(s);
  }
  // Opening a page whose media is the one in the mini-player: hand it back to the page
  function npTake(i){
    if (NP && NP.i === i){ CUR = NP; NP = null; if (CUR.kind === "media"){ CUR.el.controls = true; CUR.el.removeEventListener("click", npClickToggle); } npPaint(); return CUR; }
    return null;
  }
  function npClickToggle(){ if (NP && NP.el === this) npToggle(NP); }
  function npClose(){ if (NP){ npKill(NP); NP = null; } npHidden = false; $("npQ").hidden = true; npPaint(); }
  function npStopAll(){ npClose(); if (CUR){ npKill(CUR); CUR = null; } }
  function npToggle(s){
    s = s || NP; if (!s) return;
    var play = !npPlaying(s);
    if (s.kind === "media"){ if (play) s.el.play().catch(function(){}); else s.el.pause(); return; }
    if (s.ctl){ if (play) s.ctl.resume(); else s.ctl.pause(); return; }
    if (!s.el) return;
    if (/spotify/i.test(s.svc) || /open\.spotify\.com/.test(s.el.src)) s.el.contentWindow.postMessage({command: play ? "resume" : "pause"}, "*");
    else s.el.contentWindow.postMessage({portalYT: 1, cmd: play ? "play" : "pause"}, "*");
  }
  function npQuiet(){ [NP, CUR].forEach(function(s){ if (!s || !npPlaying(s)) return; if (npCtl(s)) npToggle(s); else if (s === NP) npClose(); }); }   // closed-book activity starting
  // Player preferences on this device: repeat, shuffle, volume, hidden; position resume for uploaded media
  function npPref(){ try { return JSON.parse(localStorage.getItem("portal-np:" + D.id) || "{}") || {}; } catch(e){ return {}; } }
  function npPrefSet(k, v){ var o = npPref(); o[k] = v; try { localStorage.setItem("portal-np:" + D.id, JSON.stringify(o)); } catch(e){} }
  function npPosKey(p){ return p.sid || p.t; }
  function npPosK(s){ return npPosKey(pages[s.i]) + (npIsPl(s) ? "#" + s.tr : ""); }   // playlists: one position per track
  function npPosGetK(k){ try { return (JSON.parse(localStorage.getItem("portal-npos:" + D.id) || "{}") || {})[k] || 0; } catch(e){ return 0; } }
  function npPosSetK(k, t){ try { var o = JSON.parse(localStorage.getItem("portal-npos:" + D.id) || "{}") || {}; if (t > 0) o[k] = Math.round(t); else delete o[k]; localStorage.setItem("portal-npos:" + D.id, JSON.stringify(o)); } catch(e){} }
  function npIsPl(s){ return !!(s && s.kind === "media" && pages[s.i] && pages[s.i].k === "playlist"); }
  function npPosGet(p){ try { return (JSON.parse(localStorage.getItem("portal-npos:" + D.id) || "{}") || {})[npPosKey(p)] || 0; } catch(e){ return 0; } }
  function npPosSet(p, t){ try { var o = JSON.parse(localStorage.getItem("portal-npos:" + D.id) || "{}") || {}; if (t > 0) o[npPosKey(p)] = Math.round(t); else delete o[npPosKey(p)]; localStorage.setItem("portal-npos:" + D.id, JSON.stringify(o)); } catch(e){} }
  var npHidden = false, TIMER = null;
  function npLarge(){ try { return localStorage.getItem("portal-np-lg:" + D.id) === "1"; } catch(e){ return false; } }
  function npPos(){ try { return localStorage.getItem("portal-np-pos:" + D.id) || "br"; } catch(e){ return "br"; } }
  // What the mini-player knows and can do for the item now in it
  function npInfo(s){
    var o = {t: 0, d: 0, muted: null, seek: false, rate: false, pip: false, list: false};
    if (!s) return o;
    if (s.kind === "media"){
      var e = s.el; o.t = e.currentTime || 0; o.d = isFinite(e.duration) ? e.duration : 0; o.muted = e.muted; o.seek = o.d > 0; o.rate = true; o.vol = e.muted ? 0 : e.volume;
      o.pip = pages[s.i].k === "video" && !!document.pictureInPictureEnabled && !e.disablePictureInPicture; o.list = pages[s.i].k === "audio" || pages[s.i].k === "playlist";
      return o;
    }
    if (s.d){ o.d = s.d; o.t = Math.min(s.d, (s.t || 0) + (s.state === "playing" && s.tAt ? (performance.now() - s.tAt) / 1000 : 0)); o.seek = true; }
    if (s.muted != null && !s.ctl) o.muted = s.muted;
    if (s.vol != null && !s.ctl) o.vol = s.muted ? 0 : s.vol / 100;
    return o;
  }
  function npPaint(){
    var m = $("npMini"), c = $("npChip");
    if (!NP){ m.hidden = true; c.hidden = true; return; }
    var p = pages[NP.i], on = npPlaying(NP), ctl = npCtl(NP), k = npKind(p), up = p.k === "video", slim = npMode() === "listen", listen = up && slim, yt = npYT(p), inf = npInfo(NP);
    m.hidden = false; c.hidden = false;
    m.className = "npmini " + k + (NP.kind === "media" ? " npmedia" : "") + (yt ? " yt" : "") + (listen ? " small" : "") + (slim ? " slim" : "") + (npLarge() && !slim ? " lg" : "") + (ctl ? "" : " nocl") +
                  (npPos() !== "br" ? " pos-" + npPos() : "");
    var ttl = npIsPl(NP) && p.tr[NP.tr] ? p.tr[NP.tr].t : p.t;
    $("npT").textContent = ttl; $("npChipT").textContent = ttl; $("npT").title = "Go to “" + p.t + "”";
    [$("npPP"), $("npChipPP")].forEach(function(b){ b.hidden = !ctl; b.innerHTML = on ? NP_ICO.pause : NP_ICO.play; b.setAttribute("aria-label", on ? "Pause" : "Play"); b.title = on ? "Pause" : "Play"; });
    $("npChip").classList.toggle("on", on);
    var sz = $("npSize"); sz.hidden = false;                                 // full player ↔ slim bar (any media; YouTube/Spotify keep their picture)
    sz.innerHTML = slim ? NP_ICO.full : NP_ICO.slim;
    sz.title = slim ? "Full player — " + (up || yt || k === "vid" ? "show the video and " : "show ") + "all controls (V)" : "Slim bar — " + (up ? "hide the video, " : "") + "just play/pause and progress (V)";
    sz.setAttribute("aria-label", sz.title); sz.setAttribute("aria-pressed", slim);
    npModePaint();
    var lg = $("npLg"); lg.hidden = k !== "vid" || slim;                   // videos: larger / smaller player
    lg.innerHTML = npLarge() ? NP_ICO.shrink : NP_ICO.grow; lg.title = npLarge() ? "Smaller player" : "Larger player"; lg.setAttribute("aria-label", lg.title);
    $("npOpen").innerHTML = NP_ICO.open;
    $("npTag").hidden = !NP.preview;
    $("npPrev").innerHTML = NP_ICO.prev; $("npNext").innerHTML = NP_ICO.next; $("npBack").innerHTML = NP_ICO.back; $("npFwd").innerHTML = NP_ICO.fwd; $("npPip").innerHTML = NP_ICO.pip;
    $("npPrev").hidden = NP.kind !== "media"; $("npNext").hidden = !inf.list; $("npNext").disabled = npPickS(NP, 1, false) < 0;
    $("npBack").hidden = $("npFwd").hidden = !inf.seek;
    $("npMute").hidden = inf.muted == null; $("npMute").innerHTML = inf.muted ? NP_ICO.mute : NP_ICO.vol; $("npMute").title = inf.muted ? "Unmute" : "Mute"; $("npMute").setAttribute("aria-label", $("npMute").title);
    $("npRate").hidden = !inf.rate; if (inf.rate) $("npRate").textContent = (NP.el.playbackRate || 1) + "×";
    $("npPip").hidden = !inf.pip;
    $("npSeek").parentNode.classList.toggle("noseek", !inf.seek);
    var pr = npPref(), rp = pr.rep || "off";
    $("npShuf").hidden = $("npRep").hidden = $("npList").hidden = !inf.list;
    $("npShuf").innerHTML = NP_ICO.shuf; $("npShuf").classList.toggle("on", !!pr.shuf); $("npShuf").setAttribute("aria-pressed", !!pr.shuf); $("npShuf").title = pr.shuf ? "Shuffle: on" : "Shuffle: off";
    $("npRep").innerHTML = NP_ICO.rep + (rp === "one" ? '<span class="one">1</span>' : ""); $("npRep").classList.toggle("on", rp !== "off");
    $("npRep").title = rp === "one" ? "Repeat: this track" : rp === "all" ? (npIsPl(NP) ? "Repeat: whole playlist" : "Repeat: whole section") : "Repeat: off";
    $("npList").innerHTML = NP_ICO.list; $("npList").classList.toggle("on", !$("npQ").hidden);
    if (!inf.list) $("npQ").hidden = true; else if (!$("npQ").hidden) npQueue();
    $("npTimer").hidden = !ctl && NP.kind !== "media";
    $("npVol").hidden = inf.vol == null; if (inf.vol != null && document.activeElement !== $("npVol")) $("npVol").value = Math.round(inf.vol * 100);
    $("npHide").innerHTML = NP_ICO.hide; $("npHide").hidden = NP.kind !== "media";      // only our own files: YouTube and Spotify must stay visible
    $("npChipShow").innerHTML = NP_ICO.show; $("npChipShow").hidden = !npHidden;
    if (npHidden && NP.kind === "media") m.hidden = true; else npHidden = false;
    var r2 = document.querySelector(".npbtns.np2");                          // second row only when it has something
    r2.hidden = ![].some.call(r2.children, function(c){ return c.tagName === "BUTTON" && !c.hidden; });
    npTimerPaint();
    npTick();
    msSync();
  }
  function npTick(){                                                         // progress bar and times
    if (!NP || $("npMini").hidden || npSeeking) return;
    var inf = npInfo(NP);
    $("npCur").textContent = clock(inf.t); $("npDur").textContent = inf.d ? clock(inf.d) : "–:––";
    $("npSeek").value = inf.d ? Math.round(inf.t / inf.d * 1000) : 0;
  }
  setInterval(function(){ if (NP && !document.hidden) npTick(); }, 400);
  var npSeeking = false;
  function npSeekTo(sec, s){
    s = s || NP; if (!s) return; var d = npInfo(s).d; sec = Math.max(0, d ? Math.min(d - 0.25, sec) : sec);
    if (s.kind === "media"){ s.el.currentTime = sec; return; }
    s.t = sec; s.tAt = performance.now();
    if (s.ctl){ try { s.ctl.seek(sec); } catch(e){} return; }
    if (s.el) s.el.contentWindow.postMessage({portalYT: 1, cmd: "seek", v: sec}, "*");
  }
  function npNextIdx(i, dir){                                                // uploaded recordings in the same section
    var g = String(pages[i].g || "").trim();
    for (var k = i + dir; k >= 0 && k < pages.length; k += dir){ if (String(pages[k].g || "").trim() !== g) break; if (pages[k].k === "audio" && !notYet(pages[k]) && npAllowed(k)) return k; }
    return -1;
  }
  async function npGo(s, j){ if (j < 0) return; try { var o = await getAsset(j); s.i = j; s.el.src = o.url; s.el.play().catch(function(){}); npPaint(); toast("Now playing: " + pages[j].t); } catch(e){} }
  function npMuteToggle(s){
    s = s || NP; if (!s) return;
    if (s.kind === "media") s.el.muted = !s.el.muted;
    else if (s.el){ s.muted = !s.muted; s.el.contentWindow.postMessage({portalYT: 1, cmd: s.muted ? "mute" : "unmute"}, "*"); }
    if (s === NP) npPaint();
  }
  function npHideToggle(force){
    if (!NP || NP.kind !== "media") return;
    npHidden = force === undefined ? !npHidden : force;
    npPaint(); if (npHidden) toast("Player hidden — still playing. Use the bar at the top (or H) to show it again.");
  }
  var NP_ICO = (function(){
    function sv(d, f){ return '<svg viewBox="0 0 24 24" class="i"><path d="' + d + '" ' + (f ? 'fill="currentColor" stroke="none"' : 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"') + '/></svg>'; }
    return {
      play: sv("M8 5v14l11-7z", 1), pause: sv("M7 5h4v14H7zM13 5h4v14h-4z", 1),
      prev: sv("M6 5h2v14H6zM20 5v14L9 12z", 1), next: sv("M16 5h2v14h-2zM4 5v14l11-7z", 1),
      back: sv("M11 5 4 12l7 7M20 12H4"), fwd: sv("M13 5l7 7-7 7M4 12h16"),
      vol: sv("M4 9v6h4l5 4V5L8 9zM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"), mute: sv("M4 9v6h4l5 4V5L8 9zM17 9l5 6M22 9l-5 6"),
      pip: sv("M3 5h18v14H3zM12 12h7v5h-7z"), open: sv("M14 4h6v6M20 4l-8 8M18 14v5H5V6h5"),
      shuf: sv("M3 6h4l10 12h4M17 3l4 3-4 3M3 18h4l3-3.6M14 9.6 17 6h4M17 15l4 3-4 3"), rep: sv("M4 11V9a3 3 0 0 1 3-3h13M17 3l3 3-3 3M20 13v2a3 3 0 0 1-3 3H4M7 21l-3-3 3-3"),
      list: sv("M4 6h12M4 12h12M4 18h8M18 15v6l4-3z"), timer: sv("M12 8v5l3 2M9 2h6M12 22a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"),
      hide: sv("M5 12h14"), slim: sv("M3 10h18v4H3z"), full: sv("M3 5h18v14H3zM10 9.5l4.5 2.5-4.5 2.5z"), show: sv("M5 15l7-7 7 7"),
      grow: sv("M14 4h6v6M10 20H4v-6M20 4l-6 6M4 20l6-6"), shrink: sv("M4 14h6v6M20 10h-6V4M10 14l-6 6M14 10l6-6"),
      listen: '<svg viewBox="0 0 24 24" class="i"><path d="M4 14v-2a8 8 0 0 1 16 0v2" fill="none" stroke="currentColor" stroke-width="2"/><rect x="3" y="13" width="5" height="7" rx="1.5" fill="currentColor"/><rect x="16" y="13" width="5" height="7" rx="1.5" fill="currentColor"/></svg>',
      video: '<svg viewBox="0 0 24 24" class="i"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 9v6l5-3z" fill="currentColor"/></svg>'
    };
  })();
  function npBind(s){                                                       // uploaded audio / video: follow its state; playlist for audio
    if (s.kind !== "media" || s.bound) return; s.bound = true;
    var pv = npPref().vol; if (pv != null) s.el.volume = Math.max(0, Math.min(1, pv));
    var saved = 0;
    s.el.addEventListener("loadedmetadata", function(){                        // pick up where the student stopped (not for required items being recorded)
      var at = npPosGetK(npPosK(s));
      if (s.el.autoplay || !npAllowed(s.i) || !at || at < 5 || at > (s.el.duration || 0) - 5) return;
      s.el.currentTime = at; toast("Resumed at " + clock(at) + " — drag the bar to start over.");
    });
    s.el.addEventListener("timeupdate", function(){ if (Date.now() - saved > 5000 && npAllowed(s.i)){ saved = Date.now(); npPosSetK(npPosK(s), s.el.currentTime); } });
    s.el.addEventListener("pause", function(){ if (npAllowed(s.i) && !s.el.ended) npPosSetK(npPosK(s), s.el.currentTime); });
    s.el.addEventListener("ended", function(){ npPosSetK(npPosK(s), 0); });
    ["play", "pause", "ended", "volumechange", "ratechange", "loadedmetadata", "durationchange"].forEach(function(ev){ s.el.addEventListener(ev, function(){ if (s === NP) npPaint(); if (npIsPl(s)) plPaint(); }); });
    s.el.addEventListener("ended", function(){ if (npIsPl(s) || (npOn() && pages[s.i].k === "audio")) npNext(s); });
  }
  function npSection(i){                                                      // uploaded recordings in the same section, in order
    var g = String(pages[i].g || "").trim(), a = i, z = i, out = [];
    while (a > 0 && String(pages[a - 1].g || "").trim() === g) a--;
    while (z + 1 < pages.length && String(pages[z + 1].g || "").trim() === g) z++;
    for (var k = a; k <= z; k++) if (pages[k].k === "audio" && !notYet(pages[k]) && npAllowed(k)) out.push(k);
    return out;
  }
  // What "next" means: the next track of a playlist, or the next recording in the same section
  function npKeys(s){ return npIsPl(s) ? pages[s.i].tr.map(function(x, j){ return j; }) : npSection(s.i); }
  function npAt(s){ return npIsPl(s) ? s.tr : s.i; }
  function npPickS(s, dir, auto){                                            // next / previous respecting shuffle and repeat
    var list = npKeys(s), pr = npPref(), c0 = npAt(s), at = list.indexOf(c0);
    if (!list.length) return -1;
    if (auto && pr.rep === "one") return c0;
    if (pr.shuf && dir > 0 && list.length > 1){ var others = list.filter(function(k){ return k !== c0; }); return others[Math.floor(Math.random() * others.length)]; }
    var j = at + dir;
    if (j >= list.length) return pr.rep === "all" ? list[0] : -1;
    if (j < 0) return pr.rep === "all" ? list[list.length - 1] : -1;
    return list[j];
  }
  function npPick(i, dir, auto){ return npPickS({i: i, kind: "media"}, dir, auto); }
  function npStep(s, dir){                                                   // next / previous chosen by the student
    var j = npPickS(s, dir, false);
    if (j < 0) return false;
    if (npIsPl(s)) plLoad(s, j, true, s === NP);
    else if (s === CUR && cur === s.i){ npAuto = j; show(j); }
    else npGo(s, j);
    return true;
  }
  async function npNext(s){                                                 // a track ended: repeat it, or play the next one
    var j = npPickS(s, 1, true);
    if (j < 0){ if (npIsPl(s)) plPaint(); return; }
    if (j === npAt(s)){ s.el.currentTime = 0; s.el.play().catch(function(){}); return; }
    if (npIsPl(s)){ plLoad(s, j, true, s === NP); return; }
    if (s === CUR && cur === s.i){ npAuto = j; show(j); return; }
    if (s !== NP) return;
    npGo(s, j);
  }
  function npQueue(){
    var q = $("npQ"); if (!NP) return;
    if (npIsPl(NP)){
      var pp = pages[NP.i];
      q.innerHTML = '<div class="qh">Up next · ' + esc(pp.t) + '</div>' + pp.tr.map(function(t, j){
        return '<button type="button" data-qt="' + j + '" class="' + (j === NP.tr ? "now" : "") + '"><span class="n">' + (j === NP.tr ? "♪" : j + 1) + '</span><span>' + esc(t.t) + '</span></button>'; }).join("");
      return;
    }
    var list = npSection(NP.i);
    q.innerHTML = '<div class="qh">Up next · ' + esc(String(pages[NP.i].g || "This section")) + '</div>' + list.map(function(k, n){
      return '<button type="button" data-q="' + k + '" class="' + (k === NP.i ? "now" : "") + '"><span class="n">' + (k === NP.i ? "♪" : n + 1) + '</span><span>' + esc(pages[k].t) + '</span></button>'; }).join("");
  }
  // Study timer: pauses the music after the set time (a natural break, Pomodoro-style)
  var TIMES = [0, 15, 25, 45, 60];
  function npTimerPaint(){
    var b = $("npTimer"), left = TIMER ? Math.max(0, TIMER.end - Date.now()) : 0, m = Math.ceil(left / 60000);
    b.innerHTML = NP_ICO.timer + (TIMER ? "<span>" + m + "m</span>" : "");
    b.classList.toggle("on", !!TIMER);
    b.title = TIMER ? "Study timer: pauses in " + clock(left / 1000) + " (click to change)" : "Study timer — pause the music after 15, 25, 45 or 60 minutes";
    var c = $("npChipTm"); c.hidden = !TIMER; if (TIMER) c.textContent = "⏲ " + clock(left / 1000);
  }
  setInterval(function(){
    if (!TIMER) return;
    if (Date.now() >= TIMER.end){
      TIMER = null;
      var s = NP || CUR;
      if (s && npPlaying(s)){ if (npCtl(s)) npToggle(s); else if (s === NP) npClose(); }
      toast("Study timer: music paused — time for a short break.");
    }
    if (NP) npTimerPaint(); else { var c = $("npChipTm"); c.hidden = true; }
  }, 1000);
  window.addEventListener("message", function(e){
    var d = e.data, s = [CUR, NP].filter(function(x){ return x && x.kind === "embed" && !x.ctl && x.el && x.el.contentWindow === e.source; })[0];
    if (!s || !d) return;
    if (typeof d === "string"){ try { d = JSON.parse(d); } catch(x){ return; } }
    if (d.portalYT && d.state){                                               // YouTube, through the player page
      s.state = d.state === "playing" ? "playing" : "paused";
      if (typeof d.t === "number"){ s.t = d.t; s.tAt = performance.now(); } if (d.d) s.d = d.d; if (typeof d.muted === "boolean") s.muted = d.muted; if (typeof d.vol === "number") s.vol = d.vol;
    }
    else if (d.type === "playback_update" && d.payload) s.state = d.payload.isPaused ? "paused" : "playing"; // Spotify embed
    else return;
    if (s === NP) npPaint();
  });
  window.addEventListener("blur", function(){                              // a click into an embed: the student is using it
    setTimeout(function(){ var a = document.activeElement; [CUR, NP].forEach(function(s){ if (s && s.kind === "embed" && s.el === a) s.touched = true; }); }, 0);
  });
  // ---------- media-button sensor ----------
  // Play, pause, stop, skip and next/previous from outside the page: headphone and earphone buttons (wired or Bluetooth),
  // keyboard media keys (Mac F7–F9, Windows media keys), the Mac Touch Bar and Control Center, Windows' media overlay,
  // and the lock screen / notification controls on phones and tablets. The device sends these to the page through the
  // Media Session API (and, on some computers, as media-key presses), and they act on the music or video now playing.
  // The same rules apply as with the on-screen buttons: no skipping ahead in required viewing, nothing plays during closed-book activities.
  var MS = {last: 0, lastSrc: "", tgt: null, meta: "", posAt: 0, outs: -1};
  function msTarget(){                                                     // the playing item first, then the mini-player, then this page's player
    var c = [NP, CUR].filter(function(s){ return s && npCtl(s); });
    return c.filter(npPlaying)[0] || c[0] || null;
  }
  function msTell(t){ toast(t + " — media button"); }
  function msAct(a, det, src){
    var now = Date.now();
    if (src !== MS.lastSrc && now - MS.last < 450) return;                 // the same press reported twice (media key + media session)
    MS.last = now; MS.lastSrc = src;
    var s = msTarget(); if (!s) return;
    var on = npPlaying(s), inf = npInfo(s), step = det && det.seekOffset > 0 ? det.seekOffset : 10;
    if (CB && (a === "play" || (a === "toggle" && !on) || a === "next" || a === "prev")){ toast("Music and videos stay paused during closed-book activities."); return; }
    if (a === "toggle") a = on ? "pause" : "play";
    if (a === "play"){ if (!on) npToggle(s); msTell("▶ Playing"); }
    else if (a === "pause"){ if (on) npToggle(s); msTell("⏸ Paused"); }
    else if (a === "stop"){
      if (s.kind === "media"){ s.el.pause(); try { s.el.currentTime = 0; } catch(e){} } else if (on) npToggle(s);
      msTell("⏹ Stopped");
    }
    else if (a === "back" || a === "fwd"){
      if (!inf.seek){ msTell("Can't skip in this player"); return; }
      npSeekTo(inf.t + (a === "fwd" ? step : -step), s); msTell(a === "fwd" ? "⏩ Forward " + Math.round(step) + " s" : "⏪ Back " + Math.round(step) + " s");
    }
    else if (a === "to"){ if (inf.seek && det && typeof det.seekTime === "number"){ if (det.fastSeek && s.kind === "media" && s.el.fastSeek) s.el.fastSeek(det.seekTime); else npSeekTo(det.seekTime, s); } }
    else if (a === "next" || a === "prev"){
      if (a === "prev" && inf.seek && inf.t > 3){ npSeekTo(0, s); msTell("⏮ From the start"); }
      else {
        var j = s.kind === "media" && (pages[s.i].k === "audio" || npIsPl(s)) ? npPickS(s, a === "next" ? 1 : -1, false) : -1;
        if (j < 0){ if (a === "prev" && inf.seek){ npSeekTo(0, s); msTell("⏮ From the start"); } else msTell(a === "next" ? (npIsPl(s) ? "End of the playlist" : "No next track in this section") : "No earlier track"); }
        else { npStep(s, a === "next" ? 1 : -1); if (npIsPl(s)) msTell(a === "next" ? "⏭ Next track" : "⏮ Previous track"); }
      }
    }
    setTimeout(function(){ if (NP) npPaint(); msSync(); }, 250);
  }
  function msSync(){                                                       // keep the lock screen / Control Center in step
    if (!("mediaSession" in navigator)) return;
    var ms = navigator.mediaSession, s = msTarget();
    try {
      if (!s || s.kind !== "media"){ if (MS.tgt){ ms.playbackState = "none"; MS.tgt = null; MS.meta = ""; } return; }
      var p = pages[s.i], tt = npIsPl(s) && p.tr[s.tr] ? p.tr[s.tr] : null, key = s.i + "|" + (tt ? s.tr : "") + "|" + p.t;
      if (MS.meta !== key){
        MS.meta = key; MS.tgt = s;
        var art = /^data:image\//.test(D.icon || "") ? D.icon : /^data:image\//.test(D.logo || "") ? D.logo : "";
        ms.metadata = new MediaMetadata({title: (tt ? tt.t : p.t) || "", artist: (tt && tt.ar) || D.title || "", album: tt ? p.t : String(p.g || "").trim(), artwork: art ? [{src: art, sizes: "256x256", type: "image/png"}] : []});
      }
      ms.playbackState = npPlaying(s) ? "playing" : "paused";
      var e = s.el, d = e.duration;
      if (ms.setPositionState && isFinite(d) && d > 0 && Date.now() - MS.posAt > 900){
        MS.posAt = Date.now(); ms.setPositionState({duration: d, playbackRate: e.playbackRate || 1, position: Math.min(d, Math.max(0, e.currentTime || 0))});
      }
    } catch(x){}
  }
  setInterval(msSync, 1000);
  if ("mediaSession" in navigator){
    [["play", "play"], ["pause", "pause"], ["stop", "stop"], ["seekbackward", "back"], ["seekforward", "fwd"], ["seekto", "to"], ["previoustrack", "prev"], ["nexttrack", "next"]].forEach(function(x){
      try { navigator.mediaSession.setActionHandler(x[0], function(det){ msAct(x[1], det, "ms"); }); } catch(e){}
    });
  }
  var MS_KEYS = {MediaPlayPause: "toggle", MediaPlay: "play", MediaPause: "pause", MediaStop: "stop", MediaTrackNext: "next", MediaTrackPrevious: "prev", MediaFastForward: "fwd", MediaRewind: "back"};
  function msKey(e){                                                       // media keys that reach the page as key presses (some computers and browsers)
    var a = MS_KEYS[e.key]; if (!a || !user) return false;
    e.preventDefault(); setTimeout(function(){ msAct(a, null, "key"); }, 120);
    return true;
  }
  // Headphones unplugged or Bluetooth disconnected: pause, so the sound doesn't suddenly play out loud.
  // Phones and tablets do this by themselves; on computers it works where the browser lists the sound outputs.
  async function msOuts(){ try { return (await navigator.mediaDevices.enumerateDevices()).filter(function(d){ return d.kind === "audiooutput"; }).length; } catch(e){ return -1; } }
  if (navigator.mediaDevices && navigator.mediaDevices.addEventListener){
    msOuts().then(function(n){ MS.outs = n; });
    navigator.mediaDevices.addEventListener("devicechange", function(){
      msOuts().then(function(n){
        var was = MS.outs; MS.outs = n;
        if (was > 0 && n >= 0 && n < was){
          var played = false;
          [NP, CUR].forEach(function(s){ if (s && npPlaying(s) && npCtl(s)){ npToggle(s); played = true; } });
          if (played){ toast("Paused — your headphones or speaker were disconnected."); setTimeout(function(){ if (NP) npPaint(); }, 250); }
        }
      });
    });
  }
  $("npPP").onclick = $("npChipPP").onclick = function(){ npToggle(NP); setTimeout(npPaint, 300); };
  $("npX").onclick = $("npChipX").onclick = function(){ npClose(); };
  var npDragged = 0;
  $("npT").onclick = $("npChipT").onclick = function(){ if (Date.now() - npDragged < 400) return; if (NP) show(NP.i); };
  function npModeSet(m){ npSetMode(m); if (m === "listen") $("npQ").hidden = true; npModePaint(); if (NP) npPaint(); }
  function npModeToggle(){ npModeSet(npMode() === "listen" ? "video" : "listen"); toast(npMode() === "listen" ? "Slim bar — press V for the full player." : "Full player — press V for the slim bar."); }
  function npModePaint(){ $("npModeSeg").querySelectorAll("button").forEach(function(b){ b.setAttribute("aria-pressed", b.dataset.npm === npMode()); }); }
  $("npSize").onclick = function(){ npModeToggle(); };
  $("npModeBox").hidden = D.np === false; npModePaint();
  $("npModeSeg").addEventListener("click", function(e){ var b = e.target.closest("[data-npm]"); if (b) npModeSet(b.dataset.npm); });
  $("npLg").onclick = function(){ try { localStorage.setItem("portal-np-lg:" + D.id, npLarge() ? "0" : "1"); } catch(e){} npPaint(); };
  $("npOpen").onclick = function(){ if (NP) show(NP.i); };
  $("npTag").onclick = function(){ if (NP) show(NP.i); };
  $("npBack").onclick = function(){ if (NP) npSeekTo(npInfo(NP).t - 10); setTimeout(npTick, 120); };
  $("npFwd").onclick = function(){ if (NP) npSeekTo(npInfo(NP).t + 10); setTimeout(npTick, 120); };
  $("npPrev").onclick = function(){ if (!NP || NP.kind !== "media") return; if (NP.el.currentTime > 3 || npPickS(NP, -1, false) < 0) NP.el.currentTime = 0; else npStep(NP, -1); };
  $("npNext").onclick = function(){ if (NP && NP.kind === "media") npStep(NP, 1); };
  $("npMute").onclick = function(){ npMuteToggle(NP); };
  $("npVol").addEventListener("input", function(){
    if (!NP) return; var v = +this.value;
    if (NP.kind === "media"){ NP.el.volume = v / 100; NP.el.muted = v === 0; }
    else if (NP.el){ NP.vol = v; NP.muted = v === 0; NP.el.contentWindow.postMessage({portalYT: 1, cmd: "vol", v: v}, "*"); }
    npPrefSet("vol", v / 100);
  });
  $("npShuf").onclick = function(){ npPrefSet("shuf", !npPref().shuf); npPaint(); };
  $("npRep").onclick = function(){ var r = npPref().rep || "off"; npPrefSet("rep", r === "off" ? "all" : r === "all" ? "one" : "off"); npPaint(); };
  $("npList").onclick = function(){ var q = $("npQ"); q.hidden = !q.hidden; if (!q.hidden) npQueue(); npPaint(); };
  $("npQ").addEventListener("click", function(e){
    var t = e.target.closest("[data-qt]"); if (t && npIsPl(NP)){ var k = +t.dataset.qt; if (k !== NP.tr) plLoad(NP, k, true, true); return; }
    var b = e.target.closest("[data-q]"); if (b && NP && NP.kind === "media"){ var j = +b.dataset.q; if (j !== NP.i) npGo(NP, j); }
  });
  $("npTimer").onclick = function(){
    var cur2 = TIMER ? TIMER.min : 0, k = TIMES.indexOf(cur2), nx = TIMES[(k + 1) % TIMES.length];
    TIMER = nx ? {min: nx, end: Date.now() + nx * 60000} : null;
    npTimerPaint(); toast(nx ? "Study timer: the music pauses in " + nx + " minutes." : "Study timer off.");
  };
  $("npHide").onclick = function(){ npHideToggle(true); };
  $("npChipShow").onclick = function(){ npHideToggle(false); };
  var RATES = [0.75, 1, 1.25, 1.5, 1.75, 2];
  $("npRate").onclick = function(){ if (!NP || NP.kind !== "media") return; var r = NP.el.playbackRate || 1, k = RATES.indexOf(r); NP.el.playbackRate = RATES[(k + 1) % RATES.length]; npPaint(); };
  $("npPip").onclick = async function(){
    if (!NP || NP.kind !== "media") return;
    try { if (document.pictureInPictureElement) await document.exitPictureInPicture(); else await NP.el.requestPictureInPicture(); } catch(e){ toast("Picture-in-picture isn't available here."); }
  };
  $("npSeek").addEventListener("input", function(){ npSeeking = true; var d = npInfo(NP).d; if (d) $("npCur").textContent = clock(this.value / 1000 * d); });
  $("npSeek").addEventListener("change", function(){ var d = npInfo(NP).d; if (d) npSeekTo(this.value / 1000 * d); npSeeking = false; setTimeout(npTick, 150); });
  // Drag the player by its top bar; it settles in the nearest corner (remembered on this device)
  (function(){
    var bar = $("npDrag"), m = $("npMini"), st = null;
    bar.addEventListener("pointerdown", function(e){                      // the title can be grabbed too; a plain tap still opens the page
      if (e.button) return; var b = e.target.closest("button"); if (b && b.id !== "npT") return;
      var r = m.getBoundingClientRect(), sr = $("stage").getBoundingClientRect();
      st = {x: e.clientX, y: e.clientY, l: r.left - sr.left, t: r.top - sr.top, moved: false, id: e.pointerId};
    });
    window.addEventListener("pointermove", function(e){
      if (!st || e.pointerId !== st.id) return; var dx = e.clientX - st.x, dy = e.clientY - st.y;
      if (!st.moved && Math.abs(dx) + Math.abs(dy) < 6) return;
      if (!st.moved) npDragged = Date.now();
      st.moved = true; m.classList.add("drag");
      m.style.left = (st.l + dx) + "px"; m.style.top = (st.t + dy) + "px"; m.style.right = "auto"; m.style.bottom = "auto";
    });
    function end(){
      if (!st) return; var was = st.moved; st = null; if (was) npDragged = Date.now();
      if (!was) return;
      var r = m.getBoundingClientRect(), sr = $("stage").getBoundingClientRect();
      var pos = (r.top + r.height / 2 < sr.top + sr.height / 2 ? "t" : "b") + (r.left + r.width / 2 < sr.left + sr.width / 2 ? "l" : "r");
      try { localStorage.setItem("portal-np-pos:" + D.id, pos); } catch(e){}
      m.classList.remove("drag"); m.style.left = m.style.top = m.style.right = m.style.bottom = "";
      npPaint();
    }
    window.addEventListener("pointerup", end); window.addEventListener("pointercancel", end);
  })();

  async function show(i){
    if (i < 0 || i >= pages.length) return;
    if (CB){ if (CB.type === "pt") ptSubmit(true, "opened another page of the portal"); else { cbLeft("opened another page of the portal"); return; } }
    var tok = ++navTok, p = pages[i];
    npLeave(i);
    cur = i; rqCur = null; $("ptWrap").hidden = true; $("ptWrap").innerHTML = "";
    clearView();
    inkLoad(i);
    $("inkBtn").hidden = !canInk(p);
    $("inkbar").hidden = !(INK.on && canInk(p));
    document.body.classList.toggle("inking", INK.on && canInk(p));
    $("view").classList.toggle("inking", INK.on && canInk(p));
    inkBarState();
    $("pTitle").textContent = p.t || ("Item " + (i+1));
    document.querySelectorAll("nav button.item").forEach(function(b){ b.setAttribute("aria-current", +b.dataset.i === i ? "true" : "false"); });
    wnOpened(i); fmSeen(i);
    $("prev").disabled = i === 0; $("next").disabled = i === pages.length - 1;
    $("fsPrev").disabled = i === 0; $("fsNext").disabled = i === pages.length - 1;
    $("fsTitle").textContent = p.t || ("Item " + (i+1)); $("fsPos").textContent = (i+1) + " / " + pages.length;
    wake(); rqPaint(); paintRq();
    if (p.op && opVerify() && !opOpened()[opKey(p)] && !TS && effNow() >= rqT(p.op)) await syncTime();   // check the time online first
    if (tok !== navTok) return;
    if (notYet(p)){ $("loading").hidden = true; lockedView(p); return; }   // scheduled: not open yet
    $("loadTxt").textContent = "Opening…"; $("loadBar").style.width = "0";
    if (p.k === "link"){ $("loading").hidden = true; linkView(p); return; }
    if (p.k === "playlist"){ $("loading").hidden = true; plView(i); return; }
    if (p.k === "portal"){ $("loading").hidden = true; psView(i); return; }
    $("loading").querySelector(".spin").hidden = false; $("loading").querySelector(".pbar").hidden = false;
    $("loading").hidden = false;
    try{
      var o = await getAsset(i, function(f){ if (tok === navTok){ $("loadBar").style.width = Math.round(f*100) + "%"; if (f < 1) $("loadTxt").textContent = "Opening… " + Math.round(f*100) + "%"; } });
      if (tok !== navTok) return;
      evict(i);
      var v = $("view");
      var canDl = o.blob && (DL_ALL || p.k === "file" || (DL_PDF && p.k === "pdf"));
      if (p.k === "html"){
        $("frame").hidden = false; $("frame").srcdoc = o.text;
        $("frame").onload = function(){
          try {
            var w = $("frame").contentWindow;
            w.addEventListener("keydown", function(e){ if (!e.defaultPrevented) onKey(e); });
            w.document.addEventListener("mousemove", wake, {passive:true});
            w.document.addEventListener("touchstart", wake, {passive:true});
            watchScores(w, i, tok);
            hookStudyMore(w, i, tok);
            rsToDoc(w);
            guardExam(w, i, tok); rqActHook(w); if (tok === navTok) rqRead(i);
            if (canInk(p) && tok === navTok) addSurface(docSurface(w));
          } catch(err){}
        };
      } else {
        v.hidden = false; $("wm").classList.add("onview");
        if (p.k === "image"){
          v.innerHTML = '<div class="imgwrap"><div class="imgbox"><img alt=""><canvas class="ink"></canvas></div></div>';
          var img = v.querySelector("img"); img.alt = p.t || "";
          img.onclick = function(){ if (!INK.on) v.firstChild.classList.toggle("zoom"); };
          img.onload = function(){
            if (!canInk(p)) return;
            var sfi = addSurface(boxSurface("img", img, v.querySelector("canvas.ink")));
            if (window.ResizeObserver) new ResizeObserver(function(){ redrawSurface(sfi); }).observe(img);
          };
          img.src = o.url;
        } else if (p.k === "video"){
          var back = npTake(i);
          if (back){ v.innerHTML = '<div class="media"></div>'; v.querySelector(".media").appendChild(back.el); }
          else {
          v.innerHTML = '<div class="media"><video controls playsinline preload="metadata"></video></div>';
          var vid = v.querySelector("video"); CUR = {i: i, kind: "media", el: vid}; npBind(CUR);
          if (!DL_ALL){ vid.setAttribute("controlsList", "nodownload" + (D.watermark ? " nofullscreen" : "")); vid.disablePictureInPicture = true; }
          vid.onerror = function(){ v.innerHTML = fileCard(p, "This video can't play in this browser. Try Chrome or Edge" + (canDl ? ", or download it." : ".")); bindDl(v, o, p, canDl); };
          rqWatch(vid, i, tok);
          vid.src = o.url;
          }
        } else if (p.k === "pdf"){
          await showPdf(o, tok); if (tok === navTok) rqRead(i);
        } else if (p.k === "audio"){
          v.innerHTML = fileCard(p, "");
          var back2 = npTake(i), a = back2 ? back2.el : document.createElement("audio");
          if (!back2){ a.controls = true; rqWatch(a, i, tok); a.src = o.url; if (!DL_ALL) a.setAttribute("controlsList", "nodownload"); CUR = {i: i, kind: "media", el: a}; npBind(CUR);
                       if (npAuto === i){ npAuto = -1; a.autoplay = true; } }
          v.querySelector(".filecard>div").appendChild(a);
        } else {
          v.innerHTML = fileCard(p, "This file opens in another app on your device."); bindDl(v, o, p, true);
        }
      }
      if (canDl){ $("dlBtn").hidden = false; $("dlBtn").onclick = function(){ save(o, p); }; }
      $("loading").hidden = true;
    } catch(e){
      if (tok !== navTok) return;
      console.error(e);
      $("loadTxt").textContent = (e && e.message) || "This item couldn't be opened.";
      $("loading").querySelector(".spin").hidden = true; $("loading").querySelector(".pbar").hidden = true;
      return;
    }
  }
  function host(u){ try { return new URL(u).hostname.replace(/^www\./, ""); } catch(e){ return u; } }
  // ---------- scheduled materials: an item can open only from a set date and time ----------
  // With a Google Sheet connected, the time is checked online: a scheduled material unlocks only when the sheet's clock says
  // it's time (setting the device clock forward doesn't open it). Once confirmed it stays open, even offline. Inside one
  // session the confirmed time keeps counting with the browser's own timer, which ignores changes to the device clock.
  var TS = null, tsBusy = false, tsTold = {};
  function opVerify(){ return !!(SC && SC.u && D.opv !== false); }
  function opKey(p){ return p.sid || ("L" + (p.u || p.t)); }
  function opOpened(){ try { return JSON.parse(localStorage.getItem("portal-open:" + D.id) || "{}") || {}; } catch(e){ return {}; } }
  function opMark(p){ var o = opOpened(); o[opKey(p)] = 1; try { localStorage.setItem("portal-open:" + D.id, JSON.stringify(o)); } catch(e){} }
  function trusted(){ return TS ? TS.srv + (performance.now() - TS.perf) : null; }
  function opState(p){
    if (!p || !p.op) return "open";
    var at = rqT(p.op);
    if (!opVerify()) return effNow() < at ? "wait" : "open";
    if (opOpened()[opKey(p)]) return "open";
    var t = trusted();
    if (t == null) return effNow() < at ? "wait" : "verify";            // the device says it's time: confirm online first
    if (t >= at){ opMark(p); return "open"; }
    if (Date.now() >= at && !tsTold[opKey(p)]){                         // device clock ahead of the real time
      tsTold[opKey(p)] = 1;
      rqQueue({type: "event", item: p.t, itemTitle: p.t, itemId: opKey(p), what: "Tried to open a scheduled material early — device clock set about " + untilTxt(Date.now() - t) + " ahead"});
    }
    return "wait";
  }
  function notYet(p){ return opState(p) !== "open"; }
  async function syncTime(){
    if (!opVerify() || tsBusy || navigator.onLine === false) return false;
    tsBusy = true;
    try {
      var ctl = new AbortController(), to = setTimeout(function(){ ctl.abort(); }, 9000);
      var t0 = performance.now(), r = await fetch(SC.u + (SC.u.indexOf("?") < 0 ? "?" : "&") + "time=1&_=" + Date.now(), {cache: "no-store", signal: ctl.signal});
      var j = await r.json(); clearTimeout(to);
      if (j && j.now){ var t1 = performance.now(); TS = {srv: +j.now + (t1 - t0) / 2, perf: t1}; return true; }
    } catch(e){} finally { tsBusy = false; }
    return false;
  }
  window.addEventListener("online", function(){ if (user && pages.some(function(x){ return x.op; })) syncTime().then(opRecheck); });
  function opRecheck(){ paintOp(); var p = pages[cur]; if (p && p.op && $("opIn") && !notYet(p)){ show(cur); toast("“" + (p.t || "This material") + "” is now open."); } else if (p && p.op && $("opIn")) lockedView(p); }
  function opWhen(p){ return new Date(rqT(p.op)).toLocaleString(undefined, {weekday: "short", month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit"}); }
  function untilTxt(ms){
    var m = Math.max(0, Math.ceil(ms / 60000)), d = Math.floor(m / 1440), h = Math.floor(m % 1440 / 60), mm = m % 60;
    return d ? d + " day" + (d === 1 ? "" : "s") + (h ? ", " + h + " h" : "") : h ? h + " h" + (mm ? " " + mm + " min" : "") : mm + " min";
  }
  function opLeft(p){ var t = trusted(); return rqT(p.op) - (t != null ? t : effNow()); }
  function lockedView(p){
    var v = $("view"); v.hidden = false;
    var st = opState(p), ahead = opVerify() && TS && Date.now() - trusted() > 120000 && Date.now() >= rqT(p.op);
    var line = st === "verify" ? "Connect to the internet to unlock it — the portal checks the time online once." : "Opens in " + untilTxt(opLeft(p));
    var note = ahead ? "Your device's clock is ahead of the real time, so this material stays locked until " + esc(opWhen(p)) + "."
             : st === "verify" ? "Materials open at their set time, checked online, so they can't be opened early by changing the device's clock. After this one check it stays open, even offline."
             : "It unlocks by itself at that time" + (opVerify() ? " (you'll need to be online then, once)" : "") + ". Keep this portal file; you don't need to download it again.";
    v.innerHTML = '<div class="linkwrap"><div class="linkcard opcard"><span class="big">' + ic("cal") + '</span><div class="lt"><b>' + esc(p.t) + '</b>' +
      '<span class="opw">This material opens on <strong>' + esc(opWhen(p)) + '</strong></span><span class="opin" id="opIn">' + esc(line) + '</span></div>' +
      (st === "verify" ? '<button class="btn sm" type="button" id="opChk">Check now</button>' : "") + '</div><p class="lnote">' + note + '</p></div>';
    var b = $("opChk");
    if (b) b.onclick = async function(){ b.disabled = true; b.textContent = "Checking…"; var ok = await syncTime(); if (!ok) toast("Couldn't check the time — make sure you're connected to the internet."); opRecheck(); };
  }
  function paintOp(){
    document.querySelectorAll("nav button.item").forEach(function(b){
      var p = pages[+b.dataset.i], old = b.querySelector(".opb"); if (old) old.remove();
      b.classList.toggle("opl", notYet(p));
      if (!notYet(p)) return;
      var x = document.createElement("span"); x.className = "opb";
      x.textContent = new Date(rqT(p.op)).toLocaleDateString(undefined, {month: "short", day: "numeric"});
      x.title = "Opens " + opWhen(p); b.appendChild(x);
    });
  }
  setInterval(function(){
    if (!user) return;
    var p = pages[cur];
    if (p && p.op && !$("view").hidden && $("opIn")){
      if (opVerify() && opState(p) === "verify") syncTime().then(opRecheck);
      else if (notYet(p)) $("opIn").textContent = "Opens in " + untilTxt(opLeft(p));
      else { show(cur); toast("“" + (p.t || "This material") + "” is now open."); }
    }
    if (pages.some(function(x){ return x.op; })) paintOp();
  }, 20000);

  // ---------- app version (portal hosted on a website with its app files) ----------
  // Install button where the browser offers it (Chrome, Edge, Android); Add to Home Screen tip on iPhone/iPad;
  // a notice when a newer version has been downloaded in the background.
  (function(){
    var isApp = !!document.querySelector('link[rel="manifest"]') && /^https?:$/.test(location.protocol);
    var standalone = (window.matchMedia && matchMedia("(display-mode: standalone)").matches) || navigator.standalone === true;
    var ios = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    var evt = null;
    $("instBtn").innerHTML = ic("dl") + "Install this portal as an app"; $("instTop").innerHTML = ic("dl");
    function paint(){
      var can = !!evt && !standalone;
      $("instBtn").hidden = !can; $("instTop").hidden = !can;
      var tip = isApp && !standalone && ios && !evt ? "On iPhone or iPad: tap the Share button, then “Add to Home Screen” to keep this portal as an app." : can ? "Adds it to your home screen or desktop with its own icon, and it opens even without internet." : "";
      $("instTxt").textContent = tip; $("instBox").hidden = !can && !tip;
    }
    window.addEventListener("beforeinstallprompt", function(e){ e.preventDefault(); evt = e; paint(); });
    window.addEventListener("appinstalled", function(){ evt = null; paint(); toast("Installed. Open the portal from its icon next time."); });
    function go(){ if (!evt) return; evt.prompt(); evt.userChoice.then(function(){ evt = null; paint(); }, function(){}); }
    $("instBtn").onclick = go; $("instTop").onclick = go;
    paint();
    if (isApp && navigator.serviceWorker && navigator.serviceWorker.controller){
      navigator.serviceWorker.addEventListener("controllerchange", function(){
        if (!user){ location.reload(); return; }
        toast("A new version of this portal is ready. Sign out and open it again to update.");
      });
    }
  })();

  // ---------- desktop shortcut with the portal's own icon (for the downloaded file) ----------
  // A web page can't change the icon of its own file, but a desktop shortcut to it can use any icon:
  // Windows takes an .ico file, a Mac takes a pasted picture (Get Info). Phones and tablets need the app version.
  var DSK = {os: /Windows/i.test(navigator.userAgent) ? "win" : /Mac/i.test(navigator.platform || navigator.userAgent) && !(navigator.maxTouchPoints > 1) ? "mac" : /CrOS/.test(navigator.userAgent) ? "cros" : /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.maxTouchPoints > 1 && /Mac/.test(navigator.platform)) ? "mobile" : "other"};
  function dskIcon(){ return /^data:image\//.test(D.icon || "") ? D.icon : /^data:image\//.test(D.logo || "") ? D.logo : ""; }
  function dskName(){ return String(D.appName || D.title || "Portal").replace(/[\\\/:*?"<>|]+/g, "").trim().slice(0, 40) || "Portal"; }
  function dataBytes(u){ var b = atob(u.split(",")[1]), a = new Uint8Array(b.length); for (var i = 0; i < b.length; i++) a[i] = b.charCodeAt(i); return a; }
  function dskIco(src){                                                    // Windows .ico: PNG images at 16, 32, 48 and 256 px
    return new Promise(function(ok, bad){
      var im = new Image();
      im.onload = function(){
        var sizes = [16, 32, 48, 256], pngs = sizes.map(function(z){ var c = document.createElement("canvas"); c.width = c.height = z; var x = c.getContext("2d"); x.imageSmoothingQuality = "high"; x.drawImage(im, 0, 0, z, z); return dataBytes(c.toDataURL("image/png")); });
        var head = new DataView(new ArrayBuffer(6 + 16 * sizes.length)), off = 6 + 16 * sizes.length;
        head.setUint16(0, 0, true); head.setUint16(2, 1, true); head.setUint16(4, sizes.length, true);
        sizes.forEach(function(z, i){ var o = 6 + 16 * i; head.setUint8(o, z >= 256 ? 0 : z); head.setUint8(o + 1, z >= 256 ? 0 : z); head.setUint16(o + 4, 1, true); head.setUint16(o + 6, 32, true); head.setUint32(o + 8, pngs[i].length, true); head.setUint32(o + 12, off, true); off += pngs[i].length; });
        ok(new Blob([head.buffer].concat(pngs), {type: "image/x-icon"}));
      };
      im.onerror = bad; im.src = src;
    });
  }
  function dskPng(src){ return new Promise(function(ok, bad){ var im = new Image(); im.onload = function(){ var c = document.createElement("canvas"); c.width = c.height = 512; var x = c.getContext("2d"); x.imageSmoothingQuality = "high"; x.drawImage(im, 0, 0, 512, 512); c.toBlob(function(b){ b ? ok(b) : bad(); }, "image/png"); }; im.onerror = bad; im.src = src; }); }
  function dskSave(blob, name){ var a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(function(){ URL.revokeObjectURL(a.href); }, 30000); }
  var DSK_STEPS = {
    win: ['Click <b>Download the icon</b> above. Move the icon file into the same folder as the portal file (keep it there — the shortcut uses it).',
          'Right-click the portal file → <b>Show more options</b> (Windows 11) → <b>Send to</b> → <b>Desktop (create shortcut)</b>.',
          'On the desktop, right-click the new shortcut → <b>Properties</b> → <b>Change Icon…</b> → <b>Browse…</b>, choose the icon file → <b>OK</b> → <b>OK</b>.',
          'Rename the shortcut if you like (right-click → <b>Rename</b>). You can also drag it to the taskbar or Start.'],
    mac: ['Click <b>Download the icon</b> above, then open the downloaded picture (it opens in Preview) and press <b>⌘A</b>, then <b>⌘C</b> to copy it.',
          'In Finder, select the portal file and press <b>⌘I</b> (Get Info).',
          'Click the small icon at the top-left of the Info window and press <b>⌘V</b>. The portal file now shows the portal\'s icon.',
          'For a desktop shortcut, hold <b>⌥ Option</b> and <b>⌘ Command</b> and drag the file to the desktop (this makes an alias). You can also drag it to the Dock, next to the Trash.'],
    cros: ['On a Chromebook, open the portal file, then use the browser menu ⋮ → <b>Bookmarks and lists</b> → <b>Bookmark this tab</b>. The bookmark shows the portal\'s icon.',
           'ChromeOS can\'t put a downloaded file on the shelf with its own icon. If your instructor gave you an app link, open it and install it instead.'],
    mobile: ['Phones and tablets can\'t put a downloaded file on the home screen with its own icon — they always show the Files or browser icon.',
             'If your instructor gave you an <b>app link</b> for this portal, open it in Chrome (Android) or Safari (iPhone, iPad) and choose <b>Install</b> or <b>Share → Add to Home Screen</b>. It then gets the portal\'s icon and opens like an app.']
  };
  function dskOpen(os){
    os = os || (DSK.os === "other" ? "win" : DSK.os);
    var src = dskIcon(), tabs = [["win", "Windows"], ["mac", "Mac"], ["cros", "Chromebook"], ["mobile", "Phone or tablet"]];
    $("dskIc").innerHTML = src ? '<img alt="" src="' + src + '">' : ic("dl");
    var h = '<div class="seg dtabs" role="group" aria-label="Device">' + tabs.map(function(t){ return '<button type="button" data-dsk="' + t[0] + '" aria-pressed="' + (t[0] === os) + '">' + t[1] + '</button>'; }).join("") + '</div>';
    if ((os === "win" || os === "mac") && src) h += '<div class="dskdl"><img alt="" src="' + src + '"><div><b>' + esc(dskName()) + (os === "win" ? ".ico" : ".png") + '</b>' + (os === "win" ? "Icon file for Windows shortcuts" : "Picture to paste as the file's icon") + '</div><button type="button" class="btn" id="dskGet">' + ic("dl") + 'Download the icon</button></div>';
    h += '<ol>' + DSK_STEPS[os].map(function(x){ return '<li>' + x + '</li>'; }).join("") + '</ol>';
    if (os === "win" || os === "mac") h += '<p class="fine">Keep the portal file where it is (for example in Documents) — if you move or rename it, make the shortcut again. When your instructor sends an updated portal, replace the old file with the new one, using the same name, and the shortcut keeps working.</p>';
    $("dskBody").innerHTML = h; $("dskBox").hidden = false; $("dskOk").focus();
    var g = $("dskGet"); if (g) g.onclick = function(){
      g.disabled = true;
      (os === "win" ? dskIco(src) : dskPng(src)).then(function(b){ dskSave(b, dskName() + (os === "win" ? ".ico" : ".png")); toast("Icon downloaded. Now follow the steps below."); }, function(){ toast("Couldn't make the icon in this browser."); }).then(function(){ g.disabled = false; });
    };
  }
  function dskClose(){ $("dskBox").hidden = true; }
  $("dskX").innerHTML = ic("close"); $("dskX").onclick = dskClose; $("dskOk").onclick = dskClose;
  $("dskBox").addEventListener("click", function(e){ if (e.target === this){ dskClose(); return; } var t = e.target.closest("[data-dsk]"); if (t) dskOpen(t.dataset.dsk); });
  document.addEventListener("keydown", function(e){ if (e.key === "Escape" && !$("dskBox").hidden){ dskClose(); e.stopPropagation(); } }, true);
  var DSK_ON = location.protocol === "file:" && !!dskIcon() && DSK.os !== "mobile";
  if (!(window.crypto && window.crypto.subtle)){                          // this browser won't run the portal from here (some phones open files this way)
    var on = /^https:\/\//.test(D.opener || "");
    $("openNote").innerHTML = "<b>This browser can't open the portal file directly.</b><br>" + (on ? 'Open <a href="' + esc(D.opener) + '" target="_blank" rel="noopener">the Portal Opener</a>, tap <b>Choose the portal file</b>, and pick this file.' : "Open it in Chrome, Edge, Safari or Firefox on a computer, or ask your instructor for the phone opener link.");
    $("openNote").hidden = false; $("go").disabled = true;
  }   // only for the downloaded file, on computers
  $("dskLink").hidden = !DSK_ON; $("dskLink").onclick = function(){ dskOpen(); };

  // ---------- online updates: checking, downloading, the update bar ----------
  var UPS = {busy: false};
  function upBar(html, acts, pct){
    var b = $("upBar"); if (!html){ b.hidden = true; return; }
    $("upT").innerHTML = html; $("upPw").hidden = pct == null; if (pct != null) $("upP").style.width = Math.round(pct * 100) + "%";
    var a = $("upA"); a.innerHTML = "";
    (acts || []).forEach(function(x, k){ var bt = document.createElement("button"); bt.type = "button"; bt.textContent = x[0]; if (k) bt.className = "l"; bt.onclick = x[1]; a.appendChild(bt); });
    b.hidden = false;
  }
  function upNote(m){ return m.note ? String(m.note).replace(/[.\s]+$/, "") : ""; }
  function upHave(){ var f = upFlag(); return Math.max(Date.parse(D.built) || 0, f ? Date.parse(f.built) || 0 : 0); }
  function upWhen(iso){ try { return new Date(iso).toLocaleDateString(undefined, {month: "short", day: "numeric", year: "numeric"}); } catch(e){ return ""; } }
  function upLine(){
    var l = $("upLine"); if (!l) return;
    if (!upCan()){ l.hidden = true; return; }
    l.hidden = false;
    l.innerHTML = upOn() ? (window.__portalUpd ? "Updated online to the version of " + esc(upWhen(D.built)) + " · " : "Updates itself when you're online · ") + '<a id="upOff">Turn off on this computer</a>'
                         : 'Online updates are off on this computer · <a id="upOff">Turn on</a>';
    $("upOff").onclick = function(){
      if (upOn()){ upLs(UPOFF, "1"); if (window.__portalUpd){ upClear().then(function(){ location.reload(); }); return; } upClear(); }
      else upLs(UPOFF, null);
      upLine();
    };
  }
  function upStart(){
    if (!upCan()) return;
    var f = upFlag();
    if (f && (Date.parse(D.built) || 0) > (Date.parse(f.built) || 0)) upClear();   // this file is newer than the kept update: drop the update
    if (upOn()) setTimeout(function(){ upCheck(false); }, 2500);
  }
  function upCheck(manual){
    if (!upOn() || UPS.busy || !user || navigator.onLine === false) return;
    UPS.busy = true;
    fetch(D.upd + "latest.json?t=" + Date.now(), {cache: "no-store"}).then(function(r){ return r.ok ? r.json() : null; }).then(function(m){
      UPS.busy = false;
      if (!m || m.id !== D.id || !Array.isArray(m.parts) || !m.parts.length || !(Date.parse(m.built) > upHave())) return;
      if (m.size > UP_AUTO && !manual){
        upBar("<b>A new version of this portal is available</b> (" + size(m.size) + ")" + (m.note ? ": " + esc(upNote(m)) : "") + ". Download it now? It replaces this version on this computer.",
          [["Download now", function(){ upGet(m); }], ["Later", function(){ upBar(""); }]]);
        return;
      }
      upGet(m);
    }).catch(function(){ UPS.busy = false; });
  }
  async function upHash(buf){ var h = new Uint8Array(await crypto.subtle.digest("SHA-256", buf)); return Array.prototype.map.call(h, function(b){ return (b < 16 ? "0" : "") + b.toString(16); }).join(""); }
  async function upGet(m){
    if (UPS.busy && UPS.m === m) return;
    UPS.busy = true; UPS.m = m;
    var got = [], done = 0, blob = null;
    try {
      for (var k = 0; k < m.parts.length; k++){
        var pt = m.parts[k];
        upBar("Downloading the new version of this portal… " + Math.round(done / m.size * 100) + "%", null, done / m.size);
        var r = await fetch(D.upd + encodeURIComponent(pt.n) + "?v=" + encodeURIComponent(m.built), {cache: "no-store"});
        if (!r.ok) throw new Error("missing part");
        var buf = await r.arrayBuffer();
        if (buf.byteLength !== pt.s || await upHash(buf) !== pt.h) throw new Error("check");
        got.push(buf); done += buf.byteLength;
      }
      blob = new Blob(got, {type: "text/html"}); got = null;
      var head = await blob.slice(0, 2000000).text();
      if (head.indexOf('"id":"' + D.id + '"') < 0 || head.indexOf('id="portal-data"') < 0) throw new Error("check");
      await upPutRec({built: m.built, blob: blob, title: m.title || "", note: m.note || "", size: blob.size, name: m.name || ""});
      upLs(UPK, JSON.stringify({built: m.built}));
      upBar("<b>New version ready</b>" + (m.note ? " — " + esc(upNote(m)) : "") + ". It opens the next time you open this portal.",
        [["Restart now", function(){ upRestart(); }], ["Later", function(){ upBar(""); }]]);
    } catch(e){
      try { console.warn("portal update:", e); } catch(x){}
      if (blob && !/check/.test(String(e && e.message))){                  // downloaded, but this browser can't keep it: save it as a file instead
        var url = URL.createObjectURL(blob);
        upBar("<b>A new version of this portal is ready</b>, but this browser can't keep it. Save it and use it in place of this file (same name, same folder).",
          [["Save the new version", function(){ var a = document.createElement("a"); a.href = url; a.download = m.name || "portal.html"; document.body.appendChild(a); a.click(); a.remove(); }], ["Later", function(){ upBar(""); }]]);
      } else upBar("");                                                     // try again next time
    } finally { UPS.busy = false; }
  }
  function upRestart(){                                                    // reopen this file: the new version opens, still signed in
    var tag = psTag();
    try { $("out").onclick(); } catch(e){}
    try { history.replaceState(null, "", location.href.split("#")[0] + tag); } catch(e){}
    location.reload();
  }
  window.addEventListener("online", function(){ if (user) setTimeout(function(){ upCheck(false); }, 1500); });
  upLine();

  // ---------- shortcuts to other portals ----------
  // A computer opens the other portal file from the same folder (new tab); a phone opens it in the Portal Opener;
  // an online (app) portal opens its web address. The student is signed in automatically when the other portal allows it.
  function psIcon(p){ return p.ip ? '<svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="' + esc(p.ip) + '"/></svg>' : ic("portal"); }
  function psOpener(){ try { return window.parent !== window && parent.PORTAL_OPENER && typeof parent.PORTAL_OPENER.portal === "function" ? parent.PORTAL_OPENER : null; } catch(e){ return null; } }
  function psWho(){ return user ? {sn: user.sn, em: user.em} : null; }
  function psTag(){ var w = psWho(); return w ? "#signin=" + encodeURIComponent(btoa(unescape(encodeURIComponent(JSON.stringify(w))))) : ""; }
  function psHint(p){
    if (psOpener()) return "It opens here in the Portal Opener. If it isn't on this phone yet, you'll be asked to choose its file once.";
    if (location.protocol === "file:" && p.fn) return "It opens in a new tab. The first time, if it can't find “" + p.fn + "” on its own, you'll be asked to choose that file wherever you saved it" + (window.showOpenFilePicker ? " — this browser then remembers it." : ".");
    if (p.u) return "It opens " + p.u + " in a new tab.";
    return "Open it the way you usually open your portals.";
  }
  function psShow(i, html){ if (cur === i || !html) return psMsg(i, html); Promise.resolve(show(i)).then(function(){ psMsg(i, html); }); }   // from the top button: go to the shortcut's page first
  function psMsg(i, html){ var m = $("psMsg"); if (!m || cur !== i) { if (html) toast(html.replace(/<[^>]+>/g, "")); return; } m.hidden = !html; m.innerHTML = html || ""; }
  function psProbe(name, cb){                                               // is that file next to this one? (a page loaded as a script: it loads, then fails harmlessly)
    var s = document.createElement("script"), done = false;
    function fin(ok){ if (done) return; done = true; s.remove(); window.removeEventListener("error", hush, true); cb(ok); }
    function hush(e){ if (e && e.filename && e.filename.indexOf(encodeURIComponent(name)) > -1){ e.preventDefault(); e.stopImmediatePropagation(); } }
    window.addEventListener("error", hush, true);
    s.onload = function(){ fin(true); }; s.onerror = function(){ fin(false); }; setTimeout(function(){ fin(true); }, 15000);
    s.src = encodeURIComponent(name); document.head.appendChild(s);
  }
  function psGoFile(p){ var w = window.open(encodeURIComponent(p.fn) + psTag(), "_blank"); if (!w) location.href = encodeURIComponent(p.fn) + psTag(); }
  // Not in the same folder? The student chooses the file once, from anywhere (Downloads, a renamed copy…).
  // Chrome and Edge remember that file (only where it is, never a copy), so later it opens straight away.
  function psKey(p){ return p.pid ? "pid:" + p.pid : "fn:" + (p.fn || p.t); }
  function psDb(cb){ try { var q = indexedDB.open("portal-shortcuts", 1); q.onupgradeneeded = function(){ q.result.createObjectStore("files"); }; q.onsuccess = function(){ cb(q.result); }; q.onerror = function(){ cb(null); }; } catch(e){ cb(null); } }
  var PS_MEM = {};
  function psStore(p, h, cb){
    var k = psKey(p);
    if (h === undefined && PS_MEM[k]) return cb && cb(PS_MEM[k]);
    if (h !== undefined){ if (h) PS_MEM[k] = h; else delete PS_MEM[k]; }
    psDb(function(db){ if (!db) return cb && cb(null);
    try { var os = db.transaction("files", h === undefined ? "readonly" : "readwrite").objectStore("files"), r = h === undefined ? os.get(psKey(p)) : (h ? os.put(h, psKey(p)) : os.delete(psKey(p)));
      r.onsuccess = function(){ cb && cb(h === undefined ? r.result || null : null); }; r.onerror = function(){ cb && cb(null); }; } catch(e){ cb && cb(null); } }); }
  var PS_READY = null;
  function psLaunch(i, text){                                                // opens the chosen portal in a new tab, signed in
    var p = pages[i], w = window.open("", "_blank");
    if (!w){ PS_READY = {i: i, text: text}; $("toast").hidden = true; psShow(i, "<b>" + esc(p.t) + " is ready.</b><br>" + '<button type="button" class="btn sm" data-ps-ready>' + ic("ext") + "Open " + esc(p.t) + "</button>"); return; }
    PS_READY = null; psMsg(i, "");
    w.document.open(); var tag = psTag(); if (tag) try { w.history.replaceState(null, "", tag); } catch(e){}
    w.document.write(text); w.document.close(); $("toast").hidden = true;
  }
  function psGot(i, f, h){
    var p = pages[i]; toast("Opening " + p.t + "…");
    return f.text().then(function(t){
      var head = t.slice(0, 1600000), at = head.indexOf('id="portal-data"'), pid = at > -1 ? ((/^[^>]*>\s*\{\s*"v"\s*:\s*\d+\s*,\s*"id"\s*:\s*"([^"]+)"/.exec(head.slice(at)) || [])[1] || "") : "";
      if (!/<html|<!doctype/i.test(head.slice(0, 2000))){ $("toast").hidden = true; psAsk(i, "“" + esc(f.name) + "” isn't a portal file. Choose <b>" + esc(p.fn) + "</b>."); return; }
      if (p.pid && pid && pid !== p.pid){ var tt = ((/<title>([^<]*)<\/title>/i.exec(head) || [])[1] || f.name).trim(); $("toast").hidden = true; psAsk(i, "That file is <b>" + tt + "</b>, a different portal. Choose <b>" + esc(p.t) + "</b> (" + esc(p.fn) + ")."); return; }
      if (h) psStore(p, h);
      psLaunch(i, t);
    });
  }
  function psPick(i){
    var p = pages[i];
    if (window.showOpenFilePicker){
      window.showOpenFilePicker({types: [{description: "Portal file", accept: {"text/html": [".html", ".htm"]}}]}).then(function(hs){ return hs[0].getFile().then(function(f){ return psGot(i, f, hs[0]); }); })
        .catch(function(e){ if (!e || e.name !== "AbortError") psPickInput(i); });
      return;
    }
    psPickInput(i);
  }
  function psPickInput(i){ var inp = document.createElement("input"); inp.type = "file"; inp.accept = ".html,.htm,text/html"; inp.onchange = function(){ if (inp.files[0]) psGot(i, inp.files[0], null); }; inp.click(); }
  function psAsk(i, why){
    var p = pages[i];
    psShow(i, (why ? why + "<br>" : "<b>Where is " + esc(p.t) + "?</b> It isn't next to this portal, so choose its file once — wherever you saved it (Downloads, Documents…), even if it was renamed.<br>") +
      '<button type="button" class="btn sm" data-ps-pick="' + i + '">Choose the file</button>' +
      '<span class="pssub">' + (window.showOpenFilePicker ? "This browser remembers where it is, so next time it opens straight away." : "Tip: keep both portal files in one folder and the shortcut opens it straight away.") + " Your instructor's file name: <b>" + esc(p.fn) + "</b></span>");
  }
  function psOpen(i){
    var p = pages[i]; if (!p) return;
    var op = psOpener();
    if (op){ op.portal({pid: p.pid || "", title: p.pt || p.t, name: p.fn || ""}, psWho()); return; }
    if (location.protocol === "file:" && p.fn){
      psMsg(i, ""); toast("Opening " + p.t + "…");
      psProbe(p.fn, function(ok){
        if (ok){ psGoFile(p); return; }                                       // same folder: open the file itself
        psStore(p, undefined, function(h){                                    // a file chosen before (Chrome, Edge)
          if (!h || !h.getFile){ $("toast").hidden = true; psAsk(i); return; }
          Promise.resolve(h.queryPermission ? h.queryPermission({mode: "read"}) : "granted")
            .then(function(st){ return st === "granted" ? st : h.requestPermission({mode: "read"}); })
            .then(function(st){ if (st !== "granted") throw {name: "perm"}; return h.getFile(); })
            .then(function(f){ return psGot(i, f, null); })
            .catch(function(e){ $("toast").hidden = true;
              if (e && e.name === "perm"){ psAsk(i, "<b>Allow the browser to open " + esc(p.t) + "</b> when it asks, or choose the file again."); return; }
              psStore(p, null); psAsk(i, "<b>" + esc(p.t) + " was moved, renamed or deleted since last time.</b> Choose its file again."); });
        });
      });
      return;
    }
    if (p.u){ window.open(p.u, "_blank", "noopener"); return; }
    psMsg(i, "Open <b>" + esc(p.t) + "</b> the way you usually open your portals" + (location.protocol === "blob:" ? " — go back to <b>My portals</b> in the Portal Opener." : "."));
  }
  function psView(i){
    var p = pages[i], v = $("view"); v.hidden = false; $("wm").classList.add("onview");
    v.innerHTML = '<div class="psv"><div class="pscard"><span class="psic">' + psIcon(p) + '</span><div><div class="psk">Another portal</div><h2>' + esc(p.t) + '</h2>' + (p.d ? '<p>' + esc(p.d) + '</p>' : "") + '</div></div>' +
      '<button type="button" class="btn psgo" id="psGo">' + ic("ext") + 'Open ' + esc(p.t) + '</button>' +
      '<p class="pshint">' + esc(psHint(p)) + (p.pid ? " You'll be signed in with the same student number and email." : "") + '</p><div class="psmsg" id="psMsg" hidden></div></div>';
    $("psGo").onclick = function(){ psOpen(i); };
  }
  document.addEventListener("click", function(e){
    var b = e.target.closest && e.target.closest("[data-ps-pick],[data-ps-ready]"); if (!b) return;
    if (b.hasAttribute("data-ps-pick")) psPick(+b.dataset.psPick);
    else if (PS_READY) psLaunch(PS_READY.i, PS_READY.text);
  });
  function psPinsPaint(){
    var box = $("psPins"), pins = []; pages.forEach(function(p, i){ if (p.k === "portal" && p.pin && !notYet(p)) pins.push(i); });
    pins = pins.slice(0, 2); box.hidden = !pins.length;
    box.innerHTML = pins.map(function(i){ var p = pages[i]; return '<button type="button" class="btn ghost" data-ps-pin="' + i + '" title="Open ' + esc(p.t) + '">' + psIcon(p) + '<span>' + esc(p.t) + '</span></button>'; }).join("");
  }
  $("psPins").addEventListener("click", function(e){ var b = e.target.closest("[data-ps-pin]"); if (b) psOpen(+b.dataset.psPin); });

  // ---------- Focus mode: study techniques with the strongest evidence, inside a time format the student picks ----------
  // Only high-utility techniques (Dunlosky et al., 2013): retrieval practice, practice questions, distributed (spaced) practice.
  // The time formats (Pomodoro, 90-minute blocks, question blocks) only manage focus; each block tells the student what to do inside it.
  var FM_IV = [1, 3, 7, 14, 30];                                             // spaced-review intervals, in days
  var FM_MODES = {
    pomo: {name: "Learn–Recall Pomodoro", short: "25 min focus · 5 min break", tag: "Pomodoro + active recall",
      what: "Four 25-minute focus blocks with 5-minute breaks, then a 20-minute break. Each block has one job: learn, recall, practise, fix the gaps.",
      why: "Retrieval practice — recalling from memory instead of rereading — is one of the most robust findings in learning science (the testing effect; Roediger & Karpicke, 2006). The timer only keeps you focused; the recall inside it is what makes you learn.",
      best: "Starting dense material when it's hard to get going.",
      how: ["<b>Learn</b> (25 min): read or watch one section of a handout or video.", "<b>Recall</b> (25 min): the Recall pad opens. Close the material, write everything you remember, then check it against the source and mark the gaps.", "<b>Practise</b> (25 min): answer that section's quick checks or questions in practice mode, and read every rationale.", "<b>Fix the gaps</b> (25 min): turn what you missed into flashcards or short notes."],
      ph: [{k: "f", t: "Learn", m: 25, d: "Read or watch one section. Stay on that section only."}, {k: "b", t: "Break", m: 5}, {k: "f", t: "Recall", m: 25, pad: 1, d: "Close the material. Write everything you remember on the Recall pad, then check it against the source and mark the gaps."}, {k: "b", t: "Break", m: 5},
           {k: "f", t: "Practise", m: 25, d: "Answer the quick checks or practice questions for this section (practice mode). Read every rationale, including the ones you got right."}, {k: "b", t: "Break", m: 5}, {k: "f", t: "Fix gaps", m: 25, pad: 1, d: "Turn what you missed into flashcards or short notes on the Recall pad."}, {k: "b", t: "Long break", m: 20, d: "A real rest: stand up, move, drink water."}]},
    deep: {name: "Deep Block", short: "90 min: study · recall · check, then rest", tag: "90-minute block + recall from memory",
      what: "One 90-minute block for a hard mechanism: 60 minutes of study, 20 minutes recalling it from memory, 10 minutes checking — then a real 20-minute rest.",
      why: "Drawing and explaining a mechanism from memory is retrieval practice, which beats rereading (Dunlosky et al., 2013). The long block suits integrating a whole system; the recall at the end is what fixes it in memory.",
      best: "Hard mechanisms and whole systems (e.g. the cardiac cycle, renal physiology), at your sharpest time of day.",
      how: ["<b>Study</b> (60 min): one mechanism or topic, in depth.", "<b>Recall</b> (20 min): close the material, draw or write it from memory on the Recall pad, and explain it aloud as if teaching it.", "<b>Check</b> (10 min): open the material again, compare, and correct your errors.", "<b>Rest</b> (20 min): away from the screen before the next block."],
      ph: [{k: "f", t: "Study", m: 60, d: "Study one mechanism or topic in depth."}, {k: "f", t: "Recall", m: 20, pad: 1, d: "Close the material. Draw or write it from memory on the Recall pad and explain it aloud, as if teaching it."},
           {k: "f", t: "Check", m: 10, pad: 1, d: "Open the material again. Compare with what you wrote and correct the errors."}, {k: "b", t: "Rest", m: 20, d: "A real rest: away from the screen, move, drink water."}]},
    qb: {name: "Question Block", short: "50 min questions · 10 min break", tag: "Practice questions + error log",
      what: "Timed blocks of practice questions, then reviewing every rationale and logging why you missed each one.",
      why: "Practice testing is among the highest-utility techniques (Dunlosky et al., 2013): answering questions strengthens memory and trains you to apply it to cases. An error log turns each miss into something to review.",
      best: "After you've covered a topic; before quizzes and exams.",
      how: ["<b>Questions</b> (50 min): answer the portal's quick checks and mock tests in <b>practice mode</b>, mixed across topics if you can.", "Review every rationale — including the ones you got right.", "On the Recall pad, note each miss and why: knowledge gap, misread, or reasoning error.", "<b>Break</b> (10 min), then another block — or review your notes on a 1–3–7 day schedule."],
      ph: [{k: "f", t: "Questions", m: 50, pad: 1, d: "Answer quick checks and mock tests in practice mode. Review every rationale; log each miss and why on the Recall pad."}, {k: "b", t: "Break", m: 10}]},
    sp: {name: "Spaced Review", short: "Review what's due today · 25 min", tag: "Spaced repetition",
      what: "Review materials at widening intervals — 1, 3, 7, 14 and 30 days after you first study them. The portal keeps the schedule and lists what's due.",
      why: "Spaced (distributed) practice has the strongest evidence of any time-based method (Cepeda et al., 2006; Dunlosky et al., 2013). Reviewing just as you start to forget makes memories last.",
      best: "Volume-heavy content you must keep: drugs, organisms, anatomy, normal values.",
      how: ["The portal notes the day you first open each material.", "Each day, open Focus mode: <b>Due today</b> lists what to review.", "Tap <b>Review</b>: recall it first on the Recall pad, then open the material and check.", "Mark it <b>Done</b> (next review further out) or <b>Again tomorrow</b>."],
      ph: [{k: "f", t: "Review", m: 25, pad: 1, d: "Pick a material that's due. Recall it first on the Recall pad, then open it to check, then mark it done."}, {k: "b", t: "Break", m: 5}]}
  };
  var FM = null, FMT = 0, fmAC = null;
  function fmOn(){ return D.fm !== false; }
  function fmKey(){ return "portal-focus:" + D.id + ":" + normSN(user.sn); }
  function fmLoad(){ try { return JSON.parse(localStorage.getItem(fmKey()) || "null"); } catch(e){ return null; } }
  function fmSave(){ if (!FM || !user) return; try { localStorage.setItem(fmKey(), JSON.stringify(FM)); } catch(e){} }
  function fmDay(off){ var d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() + (off || 0)); return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0"); }
  function fmMs(x){ x = Math.max(0, Math.round(x / 1000)); return Math.floor(x / 60) + ":" + String(x % 60).padStart(2, "0"); }
  function fmStart(){
    clearInterval(FMT);
    $("fmBtn").hidden = !fmOn(); $("fmBtn").innerHTML = ic("target");
    if (!fmOn()){ FM = null; $("fmChip").hidden = true; return; }
    FM = fmLoad() || {};
    if (FM.keep == null) FM.keep = D.fmKeep !== "reset";
    if (FM.snd == null) FM.snd = true;
    FM.rev = FM.rev || {}; FM.pad = FM.pad || "";
    if (FM.mode && !FM_MODES[FM.mode]) FM.mode = "";
    if (FM.run && FM.run.end){ FM.run.left = Math.max(0, FM.run.end - Date.now()); FM.run.end = 0; }   // never runs while signed out
    fmSave(); fmChip(); fmDot();
    if (FM.mode && FM.run) setTimeout(function(){ if (user) toast("Focus mode: " + FM_MODES[FM.mode].name + " — paused at " + fmPh().t + " (" + fmMs(FM.run.left) + " left). Tap the timer at the top to resume."); }, 1600);
    FMT = setInterval(fmTick, 1000);
  }
  function fmSignOut(){
    clearInterval(FMT); $("fmChip").hidden = true; $("fmBox").hidden = true; $("fmPad").hidden = true;
    if (!FM || !user) { FM = null; return; }
    if (FM.keep){ if (FM.run && FM.run.end){ FM.run.left = Math.max(0, FM.run.end - Date.now()); FM.run.end = 0; } }
    else { FM.mode = ""; FM.run = null; FM.pad = ""; }                     // reset the study mode (the review schedule is kept: it's study history)
    fmSave(); FM = null;
  }
  function fmPh(){ var m = FM && FM_MODES[FM.mode]; return m && FM.run ? m.ph[FM.run.i % m.ph.length] : null; }
  function fmLeft(){ return !FM || !FM.run ? 0 : FM.run.end ? Math.max(0, FM.run.end - Date.now()) : FM.run.left || 0; }
  function fmBeep(two){
    if (!FM || !FM.snd || CB) return;
    try {
      fmAC = fmAC || new (window.AudioContext || window.webkitAudioContext)();
      [0, two ? 0.28 : -1].forEach(function(t, n){ if (t < 0) return; var o = fmAC.createOscillator(), g = fmAC.createGain(); o.type = "sine"; o.frequency.value = n ? 784 : 659;
        g.gain.setValueAtTime(0.0001, fmAC.currentTime + t); g.gain.exponentialRampToValueAtTime(0.18, fmAC.currentTime + t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, fmAC.currentTime + t + 0.6);
        o.connect(g); g.connect(fmAC.destination); o.start(fmAC.currentTime + t); o.stop(fmAC.currentTime + t + 0.65); });
    } catch(e){}
  }
  function fmGo(i, quiet){                                                   // move to phase i and start its clock
    var m = FM_MODES[FM.mode]; FM.run = {i: i, end: Date.now() + m.ph[i % m.ph.length].m * 60000, left: 0};
    var ph = fmPh(); fmSave(); fmChip();
    if (!quiet){
      fmBeep(ph.k === "f");
      if (!CB) toast((ph.k === "f" ? "Focus — " : "") + ph.t + " (" + ph.m + " min)" + (ph.d ? ": " + ph.d : ""));
    }
    if (ph.pad && !CB) fmPadOpen(); else if (ph.k === "b") $("fmPad").hidden = true;
    if (!$("fmBox").hidden) fmPaint();
  }
  function fmTick(){
    if (!FM || !user) return;
    if (CB) $("fmPad").hidden = true;                                       // no notes during closed-book activities
    if (FM.run && FM.run.end && Date.now() >= FM.run.end) fmGo(FM.run.i + 1);
    var dk = fmDay(0); if (dk !== FM._d){ FM._d = dk; fmDot(); }            // a new day: refresh what's due
    fmChip();
    if (!$("fmBox").hidden && FM.run) { var c = $("fmClock"); if (c) c.textContent = fmMs(fmLeft()); }
  }
  function fmChip(){
    var c = $("fmChip"), ph = fmPh();
    if (!FM || !FM.mode || !FM.run || !ph){ c.hidden = true; return; }
    c.hidden = false; c.classList.toggle("brk", ph.k === "b");
    $("fmChipT").innerHTML = '<span class="lb">' + esc(ph.t) + ' · </span>' + fmMs(fmLeft());
    $("fmChipT").title = FM_MODES[FM.mode].name + " — " + ph.t + (FM.run.end ? "" : " (paused)") + ". Open Focus mode";
    $("fmChipPP").innerHTML = FM.run.end ? NP_ICO.pause : NP_ICO.play; $("fmChipPP").title = FM.run.end ? "Pause the focus timer" : "Resume the focus timer";
  }
  function fmToggle(){
    if (!FM || !FM.run) return;
    if (FM.run.end){ FM.run.left = Math.max(0, FM.run.end - Date.now()); FM.run.end = 0; }
    else { FM.run.end = Date.now() + (FM.run.left || fmPh().m * 60000); FM.run.left = 0; }
    fmSave(); fmChip(); if (!$("fmBox").hidden) fmPaint();
  }
  function fmSeen(i){                                                        // spaced review: remember when each material was first studied
    if (!FM || !pages[i]) return;
    var p = pages[i]; if (!/^(html|pdf|video|audio|image)$/.test(p.k)) return;
    var k = p.sid || p.t;
    if (!FM.rev[k]){ FM.rev[k] = {f: fmDay(0), s: 0, n: fmDay(FM_IV[0])}; fmSave(); fmDot(); }
  }
  function fmDue(){
    if (!FM) return [];
    var today = fmDay(0), out = [];
    pages.forEach(function(p, i){ var r = FM.rev[p.sid || p.t]; if (r && r.n && r.n <= today) out.push(i); });
    return out;
  }
  function fmDot(){
    var b = $("fmBtn"), d = b.querySelector(".fmdot"), n = FM && FM.mode === "sp" ? fmDue().length : 0;
    if (n && !d){ d = document.createElement("span"); d.className = "fmdot"; b.appendChild(d); }
    if (d){ if (n) d.textContent = n; else d.remove(); }
    b.title = "Focus mode" + (n ? " — " + n + " due for review today" : " — study techniques with the strongest evidence");
  }
  function fmPadOpen(ctx){
    if (CB){ toast("The Recall pad is closed during closed-book activities."); return; }
    var pad = $("fmPad"), ph = fmPh();
    $("fmPadX").innerHTML = ic("close");
    $("fmPadTx").value = FM.pad || "";
    $("fmPadTip").textContent = ctx != null ? "Recall first: write everything you remember about “" + pages[ctx].t + "”. Then open it to check, and mark the gaps." : ph && ph.pad ? ph.d : "Close the material and write everything you remember. Then check it against the source and mark the gaps.";
    $("fmPadT").textContent = ph && ph.pad ? "Recall pad · " + ph.t : "Recall pad";
    $("fmPadFt").innerHTML = ctx != null ? '<button type="button" class="btn sm" data-fm-open="' + ctx + '">Open “' + esc(pages[ctx].t) + '” to check</button>' : "";
    pad.hidden = false; setTimeout(function(){ $("fmPadTx").focus(); }, 50);
  }
  $("fmPadTx").addEventListener("input", function(){ if (FM){ FM.pad = this.value; fmSave(); } });
  $("fmPadClr").onclick = function(){ if (FM && (!FM.pad || confirm("Clear the Recall pad?"))){ FM.pad = ""; $("fmPadTx").value = ""; fmSave(); } };
  $("fmPadX").onclick = function(){ $("fmPad").hidden = true; };
  $("fmPadFt").addEventListener("click", function(e){ var b = e.target.closest("[data-fm-open]"); if (b) show(+b.dataset.fmOpen); });
  function fmPaint(){
    var mode = FM.mode || "", m = FM_MODES[mode], ph = fmPh(), h = "";
    h += '<label class="fmlbl" for="fmSel">Choose a focus mode</label><select id="fmSel"><option value="">Off — no focus mode</option>' +
      Object.keys(FM_MODES).map(function(k){ return '<option value="' + k + '"' + (k === mode ? " selected" : "") + '>' + esc(FM_MODES[k].name + " — " + FM_MODES[k].short) + '</option>'; }).join("") + '</select>';
    if (!m) h += '<div class="fmcard"><p style="margin:0">Pick the mode that fits your schedule and what you’re studying. Each one is built on the techniques with the strongest evidence — <b>active recall</b>, <b>practice questions</b> and <b>spaced repetition</b> — and tells you what to do in every block.</p></div>';
    else {
      h += '<div class="fmcard"><div class="fmtag">' + esc(m.tag) + '</div><h4>' + esc(m.name) + '</h4><p>' + esc(m.what) + '</p>' +
        '<p><b>Best for:</b> ' + esc(m.best) + '</p><p class="fmev"><b>Why it works:</b> ' + esc(m.why) + '</p>' +
        '<p style="margin-top:10px"><b>How to use it here</b></p><ol>' + m.how.map(function(x){ return '<li>' + x + '</li>'; }).join("") + '</ol>' +
        '<div class="fmtl" aria-label="Blocks">' + m.ph.map(function(x, n){ return '<span class="' + (x.k === "b" ? "br" : "") + (ph && FM.run.i % m.ph.length === n ? " now" : "") + '">' + esc(x.t) + ' ' + x.m + "′" + '</span>'; }).join("") + '</div></div>';
      if (FM.run && ph) h += '<div class="fmrun"><div><div class="fmph">' + (FM.run.end ? "Now" : "Paused") + ' · <b>' + esc(ph.t) + '</b></div><div class="fmclock" id="fmClock">' + fmMs(fmLeft()) + '</div></div><span class="sp"></span>' +
        '<button type="button" class="btn" data-fm="pp">' + (FM.run.end ? NP_ICO.pause + "Pause" : NP_ICO.play + "Resume") + '</button><button type="button" class="btn ghost" data-fm="skip">Next block</button><button type="button" class="btn ghost" data-fm="stop">Stop</button></div>' +
        (ph.d ? '<div class="fmnow">' + esc(ph.d) + '</div>' : "");
      else h += '<div class="fmrun"><button type="button" class="btn" data-fm="go">' + NP_ICO.play + 'Start ' + esc(m.ph[0].t.toLowerCase()) + ' (' + m.ph[0].m + ' min)</button><span class="sp"></span></div>';
      if (mode === "sp"){
        var due = fmDue(), all = Object.keys(FM.rev).length;
        h += '<label class="fmlbl">Due today (' + due.length + ')</label>' + (due.length ? '<div class="fmdue">' + due.map(function(i){ var r = FM.rev[pages[i].sid || pages[i].t];
          return '<div class="row"><span>' + esc(pages[i].t) + '<small>First studied ' + esc(r.f) + ' · review ' + (r.s + 1) + ' of ' + FM_IV.length + '</small></span><button type="button" class="btn sm" data-fm="rev" data-i="' + i + '">Review</button><button type="button" class="btn ghost sm" data-fm="done" data-i="' + i + '" title="Next review in ' + FM_IV[Math.min(r.s + 1, FM_IV.length - 1)] + ' days">Done</button><button type="button" class="btn ghost sm" data-fm="again" data-i="' + i + '">Again tomorrow</button></div>'; }).join("") + '</div>'
          : '<p class="fmnow" style="margin-top:6px">' + (all ? "Nothing due today — well done. Keep studying new materials; each one joins the schedule the day you first open it." : "Nothing yet: each material joins the schedule the day you first open it. Come back tomorrow for your first reviews.") + '</p>');
      }
      h += '<div class="fmrun" style="margin-top:12px"><button type="button" class="btn ghost" data-fm="pad">' + ic("pen") + 'Open the Recall pad</button></div>';
    }
    h += '<div class="fmset"><b style="font-size:13px">When I sign out</b>' +
      '<label><input type="radio" name="fmKeep" value="1"' + (FM.keep ? " checked" : "") + '><span>Keep my focus mode — it\'s here, paused, when I sign in again</span></label>' +
      '<label><input type="radio" name="fmKeep" value="0"' + (FM.keep ? "" : " checked") + '><span>Reset it — start fresh each time I sign in</span></label>' +
      '<label><input type="checkbox" id="fmSnd"' + (FM.snd ? " checked" : "") + '><span>Soft chime when a block starts or ends</span></label>' +
      '<span class="fine">Timers keep you focused; the learning comes from recalling and testing yourself inside each block. Your review schedule stays on this device either way.</span></div>';
    $("fmBody").innerHTML = h;
  }
  function fmOpen(){ if (!FM) return; $("fmIc").innerHTML = ic("target"); $("fmX").innerHTML = ic("close"); fmPaint(); $("fmBox").hidden = false; setTimeout(function(){ var x = $("fmSel"); if (x) x.focus(); }, 30); }
  $("fmBtn").onclick = fmOpen; $("fmChipT").onclick = fmOpen; $("fmChipPP").onclick = fmToggle;
  $("fmX").onclick = function(){ $("fmBox").hidden = true; };
  $("fmBox").addEventListener("click", function(e){
    if (e.target === this){ this.hidden = true; return; }
    var b = e.target.closest("[data-fm]"); if (!b || !FM) return;
    var a = b.dataset.fm, i = +b.dataset.i;
    if (a === "go"){ fmAC = fmAC || (window.AudioContext ? new AudioContext() : null); fmGo(0); }
    if (a === "pp") fmToggle();
    if (a === "skip") fmGo(FM.run.i + 1);
    if (a === "stop"){ FM.run = null; fmSave(); fmChip(); fmPaint(); $("fmPad").hidden = true; toast("Focus timer stopped."); }
    if (a === "pad"){ $("fmBox").hidden = true; fmPadOpen(); }
    if (a === "rev"){ $("fmBox").hidden = true; fmPadOpen(i); }
    if (a === "done" || a === "again"){
      var r = FM.rev[pages[i].sid || pages[i].t]; if (!r) return;
      if (a === "done"){ r.s = Math.min(r.s + 1, FM_IV.length); r.n = r.s >= FM_IV.length ? "" : fmDay(FM_IV[r.s]); toast(r.n ? "Next review of “" + pages[i].t + "” in " + FM_IV[r.s] + " days." : "“" + pages[i].t + "” has finished its review schedule."); }
      else { r.n = fmDay(1); toast("“" + pages[i].t + "” is due again tomorrow."); }
      fmSave(); fmDot(); fmPaint();
    }
  });
  $("fmBox").addEventListener("change", function(e){
    if (!FM) return;
    if (e.target.id === "fmSel"){ var was = FM.mode; FM.mode = e.target.value; if (was !== FM.mode){ FM.run = null; $("fmPad").hidden = true; } fmSave(); fmChip(); fmDot(); fmPaint(); setTimeout(function(){ var x = $("fmSel"); if (x) x.focus(); }, 0); }
    if (e.target.name === "fmKeep"){ FM.keep = e.target.value === "1"; fmSave(); toast(FM.keep ? "Your focus mode will be kept when you sign out." : "Your focus mode will reset when you sign out."); }
    if (e.target.id === "fmSnd"){ FM.snd = e.target.checked; fmSave(); }
  });
  document.addEventListener("keydown", function(e){ if (e.key === "Escape"){ if (!$("fmBox").hidden){ $("fmBox").hidden = true; e.stopPropagation(); } } }, true);

  // ---------- What's new: a short guide after each portal update ----------
  // Shown the first time a student opens the portal (a tour of what it can do) and after each update
  // (new features, new materials since their last visit, and the instructor's message). Remembered per student on this device.
  var WN_V = "2026-11-21c", WN_DATE = "2026-11-21", WNS = null;
  function wnFeat(){
    var np = D.np !== false, links = pages.some(function(p){ return p.k === "link" && p.e; }), up = pages.some(function(p){ return p.k === "audio" || p.k === "video"; });
    var music = pages.some(function(p){ return p.svc === "Spotify" || p.svc === "YouTube Music"; });
    return [
      {v: "2026-11-17", ico: "audio", on: np && (links || up), t: "Easier music and video controls",
       d: "Press <kbd>K</kbd> to play or pause, <kbd>J</kbd> / <kbd>L</kbd> to go back or forward 10 seconds and <kbd>U</kbd> to mute. The mini-player now has a volume slider, and uploaded recordings have shuffle, repeat and an <b>Up next</b> list. Uploaded audio and video pick up where you stopped."},
      {v: "2026-11-21c", ico: "dl", on: upCan(), t: "Updates itself online",
       d: "When you open this portal with internet, it fetches your instructor's newest version by itself and opens it next time — no need to download the file again. It still opens offline. You can turn this off under the sign-in button."},
      {v: "2026-11-21c", ico: "video", on: pages.some(function(p){ return p.k === "link" && p.rq && p.rq.until; }), t: "More required videos",
       d: "Vimeo videos and other online videos can now be required viewing. Vimeo counts how much you watched, like YouTube; other players count the time the video stays open on screen."},
      {v: "2026-11-21b", ico: "portal", on: pages.some(function(p){ return p.k === "portal"; }), t: "Shortcuts to your other portals",
       d: "Your instructor added shortcuts to related portals" + (pages.some(function(p){ return p.k === "portal" && p.pin; }) ? " — find them at the top of the portal and in the contents" : " in the contents") + ". On a computer, the first time you'll be asked to choose the other portal's file wherever you saved it; on a phone, they open in the Portal Opener."},
      {v: "2026-11-20b", ico: "target", on: D.fm !== false, t: "Focus mode",
       d: "Tap the <b>target</b> button at the top and choose a mode that fits your schedule: <b>Learn–Recall Pomodoro</b>, <b>Deep Block</b>, <b>Question Block</b> or <b>Spaced Review</b>. Each uses the study methods with the strongest evidence — recalling from memory, practice questions and spaced review — and tells you what to do in every block. A <b>Recall pad</b> opens when it's time to write from memory."},
      {v: "2026-11-20", ico: "playlist", on: pages.some(function(p){ return p.k === "playlist"; }), t: "Playlists",
       d: "Study music and recordings can now come as one playlist. Open it, tap <b>Play all</b> or any track, and it plays through in order — or turn on <b>Shuffle</b> and <b>Repeat</b>. It keeps playing in the mini-player while you study, and next/previous work from the mini-player, your keyboard's media keys and your headphones."},
      {v: "2026-11-17d", ico: "audio", on: np && (links || up), t: "Headphone and keyboard buttons",
       d: "Play, pause, skip and next/previous now work from your earphone or headphone buttons, your keyboard's media keys (on a Mac, F7–F9), Control Center, and the lock screen on your phone or tablet. The portal's own player follows along. They pause by themselves if your headphones disconnect."},
      {v: "2026-11-17c", ico: "home", on: DSK_ON, t: "Put the portal on your desktop",
       d: "Make a desktop shortcut with this portal's own icon, so you can open it like an app. <button type=\"button\" class=\"linkbtn\" data-wn-act=\"dsk\" style=\"margin:4px 0 0;display:block\">Show me how</button>"},
      {v: "2026-11-17c", ico: "home", on: location.protocol !== "file:" && !!document.querySelector('link[rel="manifest"]'), t: "Install the portal as an app",
       d: "Install it from the button at the top (Chrome, Edge, Android) or with <b>Share → Add to Home Screen</b> (iPhone, iPad). It gets its own icon and opens even without internet."},
      {v: "2026-11-17b", ico: "video", on: np && (links || up), t: "Full player or slim bar",
       d: "Switch the mini-player between the <b>full player</b> (video and all controls) and a <b>slim bar</b> with just play/pause, the progress bar and mute — with the button on the mini-player, under <b>Aa → Music &amp; video player</b>, or by pressing <kbd>V</kbd>. Uploaded videos play as sound only in the slim bar; YouTube and Spotify keep their own player visible."},
      {v: "2026-11-17", ico: "eyeoff", on: np && up, t: "Hide the player, keep listening",
       d: "Press <kbd>H</kbd> (or the – button on the mini-player) to hide it while an uploaded recording or video keeps playing. Control it from the bar at the top; press <kbd>H</kbd> again to bring it back."},
      {v: "2026-11-17", ico: "timer", on: np && (links || up), t: "Study timer",
       d: "Tap the timer on the mini-player to pause the music after 15, 25, 45 or 60 minutes — a cue for a short break. The time left shows at the top."},
      {v: "2026-11-17", ico: "audio", on: np && music, t: "YouTube Music and whole Spotify songs",
       d: "YouTube Music links play in the mini-player while you're online (YouTube's player stays visible). Spotify plays whole songs when you're signed in to Spotify in this browser; otherwise open it in the Spotify app, where songs you've downloaded play even offline."},
      {v: "2026-11-16", ico: "aa", on: true, t: "Reading settings (Aa)",
       d: "Change the text size, pick an easy-to-read or dyslexia-friendly font, widen line and letter spacing, turn on high contrast or underlined links, or use a reading ruler. Day, night and automatic modes are there too."},
      {v: "2026-11-15", ico: "audio", on: np && (links || up), t: "Keep playing while you study",
       d: "Music and videos keep playing in a small mini-player when you move to another page. Drag it to any corner or make it larger."},
      {v: "2026-11-12", ico: "cal", on: pages.some(function(p){ return p.op; }), t: "Materials that open on a date",
       d: "Some materials show the date they open and unlock by themselves at that time. A quick online check confirms the time, so changing your device's clock doesn't open them early."},
      {v: "2026-11-12", ico: "lock", on: !!D.hasRq, t: "Required viewing" + (D.hasPt ? " and post-tests" : ""),
       d: "Items marked <b>Required</b> must be viewed by their deadline to count as attendance (videos up to 1.25× speed, no skipping)." + (D.hasPt ? " Post-tests are closed-book: leaving the post-test closes and submits it. Answer keys open after the deadline." : "")},
      {v: "2026-11-10", ico: "dl", on: !!D.dl, t: "Download handouts",
       d: "PDF handouts can be downloaded as a copy stamped with your name, for personal study only" + (D.dlLock !== false ? ", locked with your student number as the password" : "") + "."},
      {v: "2026-11-08", ico: "chart", on: !!(SC && pages.some(function(p){ return p.sc; })), t: "Practice scores",
       d: "Quick checks and mock tests in exam mode are sent to your instructor; your best attempt counts. Opening an answer key locks your best score before it."},
      {v: "2026-11-01", ico: "pen", on: D.ink !== false, t: "Notes on handouts",
       d: "Press <kbd>A</kbd> or the Annotate button to draw, highlight or add typed notes on handouts. Notes stay on this device."}
    ].filter(function(f){ return f.on; });
  }
  function wnKey(){ return "portal-wn:" + D.id + ":" + normSN(user.sn); }
  function wnItemKey(p){ return p.sid || ("t:" + p.t); }
  function wnLoad(){ try { return JSON.parse(localStorage.getItem(wnKey()) || "null"); } catch(e){ return null; } }
  function wnSave(){ try { localStorage.setItem(wnKey(), JSON.stringify(WNS)); } catch(e){} }
  function wnNoteH(){ var n = String(D.wn || "").trim(); return n ? hashStr(n) : ""; }
  try { $("pVer").textContent = "Portal version " + new Date(WN_DATE + "T00:00:00").toLocaleDateString(undefined, {day: "numeric", month: "short", year: "numeric"}) + (/[b-z]$/.test(WN_V) ? " · " + (WN_V.slice(-1).charCodeAt(0) - 96) : "") + (D.built ? " · updated " + new Date(D.built).toLocaleDateString(undefined, {day: "numeric", month: "short", year: "numeric"}) : ""); } catch(e){}
  function wnStart(){
    $("wnBtn").innerHTML = ic("spark"); $("wnBtn").hidden = D.wnOn === false;
    if (D.wnOn === false){ WNS = null; return; }
    var old = wnLoad(), all = pages.map(wnItemKey), feats = wnFeat(), first = !old;
    WNS = old || {v: "", note: "", known: [], fresh: []};
    var newItems = first ? [] : pages.map(function(p, i){ return i; }).filter(function(i){ return WNS.known.indexOf(wnItemKey(pages[i])) < 0; });
    var nf = first ? feats : feats.filter(function(f){ return f.v > (WNS.v || ""); });
    var note = wnNoteH() && wnNoteH() !== WNS.note;
    newItems.forEach(function(i){ var k = wnItemKey(pages[i]); if (WNS.fresh.indexOf(k) < 0) WNS.fresh.push(k); });
    WNS.fresh = WNS.fresh.filter(function(k){ return all.indexOf(k) > -1; });
    var show1 = first || nf.length || note || newItems.length;
    WNS.known = all; WNS.v = WN_V; WNS.note = wnNoteH(); wnSave();
    wnPaint();
    if (show1) setTimeout(function(){ if (user && $("cbAsk").hidden) wnOpen({first: first, feats: nf, note: first || note, items: newItems}); }, 700);
  }
  function wnPaint(){                                                       // "New" tags on materials added since the last visit, until opened
    document.querySelectorAll("nav button.item").forEach(function(b){
      var x = b.querySelector(".newb"), p = pages[+b.dataset.i], on = !!(WNS && p && WNS.fresh.indexOf(wnItemKey(p)) > -1);
      if (on && !x){ x = document.createElement("span"); x.className = "newb"; x.textContent = "New"; b.appendChild(x); }
      else if (!on && x) x.remove();
    });
  }
  function wnOpened(i){
    if (!WNS || !pages[i]) return;
    var k = wnItemKey(pages[i]), j = WNS.fresh.indexOf(k);
    if (j > -1){ WNS.fresh.splice(j, 1); wnSave(); wnPaint(); }
  }
  function wnOpen(o){
    o = o || {first: false, feats: wnFeat(), note: true, items: [], all: true};
    var h = "", built = D.built ? new Date(D.built).toLocaleDateString(undefined, {month: "long", day: "numeric", year: "numeric"}) : "";
    if (/^data:image\//.test(D.logo || "")){ $("wnIc").innerHTML = '<img alt="" src="' + D.logo + '">'; $("wnIc").classList.add("lgo"); } else $("wnIc").innerHTML = ic("spark");
    $("wnT").textContent = o.first ? "Welcome to " + (D.title || "your study portal") : o.all ? "What's in this portal" : "What's new in this update";
    $("wnSub").textContent = o.first ? "A quick guide to what this portal can do" : built ? "Portal updated " + built : "";
    if (o.note && String(D.wn || "").trim()) h += '<h4>From your instructor</h4><div class="wnnote">' + esc(String(D.wn).trim()) + '</div>';
    var fresh = o.items.length ? o.items : (o.all && WNS ? pages.map(function(p, i){ return i; }).filter(function(i){ return WNS.fresh.indexOf(wnItemKey(pages[i])) > -1; }) : []);
    if (fresh.length) h += '<h4>New materials</h4><div class="wnitems">' + fresh.map(function(i){
      var p = pages[i]; return '<button type="button" data-wn-go="' + i + '">' + ic(p.k === "link" ? (IC[p.ico] ? p.ico : "link") : IC[p.k] ? p.k : "file") + '<span>' + esc(p.t) + '</span><small>' + esc(notYet(p) ? "Opens " + opWhen(p) : String(p.g || "")) + '</small></button>'; }).join("") + '</div>';
    if (o.feats.length) h += '<h4>' + (o.first || o.all ? "What you can do here" : "New in the portal") + '</h4>' + o.feats.map(function(f){
      return '<div class="wnf">' + ic(f.ico) + '<div><b>' + esc(f.t) + '</b><p>' + f.d + '</p></div></div>'; }).join("");
    if (!h) h = '<p style="margin:14px 0">Nothing new since your last visit.</p>';
    h += '<p style="margin:14px 0 0;font-size:12.5px;color:var(--muted)">Press <kbd>?</kbd> for all keyboard shortcuts.</p>';
    $("wnBody").innerHTML = h; $("wnBox").hidden = false; $("wnOk").focus();
  }
  function wnClose(){ $("wnBox").hidden = true; }
  $("wnBtn").onclick = function(){ wnOpen(); };
  $("wnOk").onclick = wnClose; $("wnX").onclick = wnClose;
  $("wnX").innerHTML = ic("close");
  $("wnBox").addEventListener("click", function(e){
    if (e.target === this){ wnClose(); return; }
    var b = e.target.closest("[data-wn-go]"); if (b){ wnClose(); show(+b.dataset.wnGo); }
    if (e.target.closest("[data-wn-act=dsk]")){ wnClose(); dskOpen(); }
  });
  document.addEventListener("keydown", function(e){ if (e.key === "Escape" && !$("wnBox").hidden){ wnClose(); e.stopPropagation(); } }, true);

  function linkView(p){
    var v = $("view"); v.hidden = false; $("wm").classList.add("onview");
    var online = navigator.onLine !== false, lay = p.l || "video";
    var h = '<div class="linkwrap">';
    if (p.e && online){
      var st = typeof lay === "number" ? ' style="height:' + lay + 'px"' : "";
      h += '<div class="embed ' + (typeof lay === "number" ? "audio" : lay) + '" id="npSlot"' + st + '></div>';
    }
    var label = p.svc ? "Open in " + p.svc : "Open link", sp = p.svc === "Spotify" && !!spUri(p.e), ytm = p.svc === "YouTube Music";
    h += '<div class="linkcard"><span class="big">' + ic(IC[p.ico] ? p.ico : "link") + '</span><div class="lt"><b>' + esc(p.t) + '</b><span>' + esc((p.svc ? p.svc + " · " : "") + host(p.u)) + '</span></div><a class="btn" href="' + esc(p.u) + '" target="_blank" rel="noopener noreferrer">' + esc(label) + ic("ext") + '</a></div>';
    h += '<p class="lnote">' + (!online ? "You're offline. Connect to the internet, then open this item again."
          : p.e ? "Loads from the internet. If it doesn't appear here, use the " + esc(label) + " button."
          : "Opens in a new browser tab and needs an internet connection.") + '</p>';
    if (sp) h += '<div class="spfull" id="spHelp"><b id="spHelpT">' + (online ? "Whole songs, not 30-second previews" : "Listen offline in the Spotify app") + '</b>' +
      (online ? '<p>Spotify plays full songs here when you\'re signed in to Spotify in this browser — this works best in Chrome, Edge or Firefox on a computer. If you\'re not signed in, or on Safari, iPhone or iPad, it plays 30-second previews; use the Spotify app instead.</p>' : '') +
      '<div class="row">' + (online ? '<a class="btn" href="https://accounts.spotify.com/login?continue=https%3A%2F%2Fopen.spotify.com%2F" target="_blank" rel="noopener noreferrer">Sign in to Spotify' + ic("ext") + '</a><button type="button" class="btn ghost" id="spReload">I\'ve signed in — reload the player</button>' : '') +
      '<a class="btn ' + (online ? "ghost" : "") + '" id="spApp" href="' + esc(spAppUrl(p)) + '" target="_blank" rel="noopener noreferrer">Open in the Spotify app' + ic("ext") + '</a></div>' +
      '<p class="fine">In the Spotify app, songs you\'ve downloaded with Spotify Premium play even without internet. The app plays on its own, so use its controls (or your keyboard\'s media keys) — the portal\'s mini-player can\'t control it.</p></div>';
    if (ytm) h += '<div class="spfull"><b>YouTube Music in the portal</b><p>Plays inside the portal while you\'re online, with YouTube\'s player showing (YouTube doesn\'t allow hiding it). Songs downloaded with YouTube Music Premium play only inside the YouTube Music app, so for offline listening use the ' + esc(label) + ' button on your phone, or study music your instructor uploaded to the portal.</p></div>';
    h += '</div>';
    v.innerHTML = h;
    if ($("spReload")) $("spReload").onclick = function(){
      if (CUR && CUR.kind === "embed"){ npKill(CUR); CUR = null; }
      if (NP && NP.i === cur){ npKill(NP); NP = null; npPaint(); }
      show(cur);
    };
    if (p.e && online){ var i = cur; CUR = npTake(i) || npFrame(p, i); npLoop(); }
    if (rqTm(p)) rqRead(cur);
  }
  window.addEventListener("online", function(){ if (cur >= 0 && pages[cur] && pages[cur].k === "link") show(cur); });
  window.addEventListener("offline", function(){ if (cur >= 0 && pages[cur] && pages[cur].k === "link") show(cur); });
  // ---------- playlists: several tracks under one item, played in order (or shuffled), carried on in the mini-player ----------
  function plLastK(p){ return npPosKey(p) + "#last"; }
  function plDur(sec){ sec = Math.round(sec || 0); if (!sec) return ""; var h = Math.floor(sec / 3600), m = Math.floor(sec % 3600 / 60), x = sec % 60; return h ? h + ":" + String(m).padStart(2, "0") + ":" + String(x).padStart(2, "0") : m + ":" + String(x).padStart(2, "0"); }
  function plTotal(p){ var t = 0; p.tr.forEach(function(x){ t += x.d || 0; }); if (!t) return ""; var m = Math.round(t / 60); return m >= 60 ? Math.floor(m / 60) + " h " + (m % 60) + " min" : m + " min"; }
  function plView(i){
    var p = pages[i], v = $("view"); v.hidden = false; $("wm").classList.add("onview");
    var art = /^data:image\//.test(D.icon || "") ? D.icon : /^data:image\//.test(D.logo || "") ? D.logo : "";
    v.innerHTML = '<div class="plv" data-i="' + i + '"><div class="plhd"><div class="plcov">' + (art ? '<img alt="" src="' + art + '">' : ic("playlist")) + '</div>' +
      '<div><div class="plk">Playlist</div><h2>' + esc(p.t) + '</h2><div class="plmeta">' + esc([p.tr.length + " track" + (p.tr.length === 1 ? "" : "s"), plTotal(p)].filter(Boolean).join(" · ")) + '</div></div></div>' +
      '<div class="plctl"><button type="button" class="btn" id="plPP"></button>' +
      '<button type="button" class="btn ghost icon" id="plPrev" aria-label="Previous track" title="Previous track">' + NP_ICO.prev + '</button>' +
      '<button type="button" class="btn ghost icon" id="plNext" aria-label="Next track" title="Next track">' + NP_ICO.next + '</button><span class="sp"></span>' +
      '<button type="button" class="btn ghost" id="plShuf">' + NP_ICO.shuf + '<span class="lbl">Shuffle</span></button>' +
      '<button type="button" class="btn ghost" id="plRep"></button></div>' +
      '<p class="plnow" id="plNow"></p><div class="plplayer"></div>' +
      '<ol class="pllist">' + p.tr.map(function(t, j){
        return '<li><button type="button" data-tr="' + j + '"><span class="n">' + (j + 1) + '</span><span class="tt"><b>' + esc(t.t) + '</b>' + (t.ar ? '<span>' + esc(t.ar) + '</span>' : "") + '</span><span class="d">' + esc(plDur(t.d)) + '</span></button></li>';
      }).join("") + '</ol></div>';
    var back = npTake(i), s;
    if (back) s = back;
    else {
      var a = document.createElement("audio"); a.controls = true; a.preload = "metadata"; if (!DL_ALL) a.setAttribute("controlsList", "nodownload");
      var last = Math.min(p.tr.length - 1, Math.max(0, npPosGetK(plLastK(p)) || 0));
      s = CUR = {i: i, kind: "media", el: a, tr: last}; npBind(s);
      var auto = npAuto === i; if (auto) npAuto = -1;
      plLoad(s, last, auto, false);
    }
    v.querySelector(".plplayer").appendChild(s.el);
    var box = v.querySelector(".plv");
    box.querySelector(".pllist").addEventListener("click", function(e){
      var b = e.target.closest("[data-tr]"); if (!b) return; var j = +b.dataset.tr;
      if (j === s.tr && s.el.src) npToggle(s); else plLoad(s, j, true, false);
    });
    $("plPP").onclick = function(){ if (!s.el.src) plLoad(s, Math.max(0, s.tr), true, false); else npToggle(s); };
    $("plPrev").onclick = function(){ if (s.el.currentTime > 3 || npPickS(s, -1, false) < 0) s.el.currentTime = 0; else npStep(s, -1); };
    $("plNext").onclick = function(){ if (!npStep(s, 1)) toast("End of the playlist."); };
    $("plShuf").onclick = function(){ npPrefSet("shuf", !npPref().shuf); plPaint(); if (NP) npPaint(); };
    $("plRep").onclick = function(){ var r = npPref().rep || "off"; npPrefSet("rep", r === "off" ? "all" : r === "all" ? "one" : "off"); plPaint(); if (NP) npPaint(); };
    plPaint();
  }
  async function plLoad(s, j, play, tell){                                   // switch the player to track j of its playlist
    var p = pages[s.i]; if (!p.tr || j < 0 || j >= p.tr.length) return;
    s.tr = j; npPosSetK(plLastK(p), j); plPaint();
    try {
      var o = await getTrack(s.i, j);
      if (s.tr !== j) return;                                                // another track was chosen meanwhile
      s.el.src = o.url;
      if (play) s.el.play().catch(function(){});
      evict(-1);
      if (s === NP) npPaint();
      plPaint(); msSync();
      if (tell) toast("Now playing: " + p.tr[j].t);
    } catch(e){ toast("This track couldn't be opened."); }
  }
  function plPaint(){
    var box = document.querySelector("#view .plv"); if (!box) return;
    var s = CUR && CUR.i === +box.dataset.i ? CUR : null; if (!s || !npIsPl(s)) return;
    var p = pages[s.i], on = npPlaying(s), pr = npPref(), rp = pr.rep || "off";
    box.querySelectorAll("[data-tr]").forEach(function(b){ var j = +b.dataset.tr, now = j === s.tr; b.classList.toggle("now", now); b.setAttribute("aria-current", now ? "true" : "false"); b.querySelector(".n").textContent = now && on ? "♪" : j + 1; });
    var started = !!s.el.src && (on || s.el.currentTime > 0 || s.tr > 0);
    $("plPP").innerHTML = (on ? NP_ICO.pause : NP_ICO.play) + '<span>' + (on ? "Pause" : started ? "Play" : "Play all") + '</span>';
    $("plShuf").classList.toggle("on", !!pr.shuf); $("plShuf").setAttribute("aria-pressed", !!pr.shuf); $("plShuf").title = pr.shuf ? "Shuffle: on" : "Shuffle: off";
    $("plRep").innerHTML = NP_ICO.rep + '<span class="lbl">' + (rp === "one" ? "Repeat 1" : "Repeat") + '</span>'; $("plRep").classList.toggle("on", rp !== "off");
    $("plRep").title = rp === "one" ? "Repeat: this track" : rp === "all" ? "Repeat: whole playlist" : "Repeat: off";
    $("plNext").disabled = npPickS(s, 1, false) < 0;
    var t = p.tr[s.tr]; $("plNow").innerHTML = t ? (on ? "Now playing: " : "Track " + (s.tr + 1) + ": ") + "<b>" + esc(t.t) + "</b>" + (t.ar ? " · " + esc(t.ar) : "") : "";
  }
  function fileCard(p, msg){
    return '<div class="filecard"><div><span class="big">' + ic(IC[p.k] ? p.k : "file") + '</span><h3>' + esc(p.nm || p.t) + '</h3><p>' + esc([size(p.sz), msg].filter(Boolean).join(" · ")) + '</p></div></div>';
  }
  function bindDl(v, o, p, ok){
    if (!ok) return;
    var b = document.createElement("button"); b.className = "btn"; b.innerHTML = ic("dl") + "Download";
    b.onclick = function(){ save(o, p); };
    v.querySelector(".filecard>div").appendChild(b);
  }
  function save(o, p){
    if (p.k === "pdf"){ askDl(o, p); return; }                          // PDFs: a stamped copy for this student
    var a = document.createElement("a"); a.href = o.url; a.download = p.nm || p.t || "file";
    document.body.appendChild(a); a.click(); a.remove();
  }

  // ---------- stamped PDF downloads ----------
  var DL_NOTE_DEF = "For personal study only. Do not copy, share, upload, distribute or sell this material. Unauthorized reproduction or distribution is prohibited under R.A. 8293 (Intellectual Property Code of the Philippines).";
  function dlNote(){ return String(D.dlNote || DL_NOTE_DEF).trim(); }
  var dlPend = null, dlBusy = false;
  function askDl(o, p){
    if (dlBusy) return;
    dlPend = {o: o, p: p};
    $("dlWho").textContent = [user.name, user.sn, user.em].filter(Boolean).join(" · ");
    $("dlNoteTxt").textContent = dlNote();
    $("dlPw").hidden = D.dlLock === false; $("dlPwSn").textContent = String(user.sn).trim();
    var m = $("dlAsk");
    (document.fullscreenElement || document.webkitFullscreenElement ? $("stage") : document.body).appendChild(m);
    m.hidden = false; $("dlYes").focus();
  }
  function closeDl(ok){ var x = dlPend; $("dlAsk").hidden = true; dlPend = null; if (ok && x) stampedDownload(x.o, x.p); }
  $("dlNo").onclick = function(){ closeDl(false); };
  $("dlYes").onclick = function(){ closeDl(true); };
  $("dlAsk").addEventListener("click", function(e){ if (e.target === this) closeDl(false); });
  $("dlAsk").addEventListener("keydown", function(e){ if (e.key === "Escape"){ e.stopPropagation(); closeDl(false); } });
  async function stampedDownload(o, p){
    dlBusy = true; $("dlBtn").disabled = true;
    try {
      toast("Preparing your copy…");
      var out = await stampPdf(new Uint8Array(await o.blob.arrayBuffer()), p, function(n, of){ toast("Preparing your copy… page " + n + " of " + of); });
      var base = String(p.nm || p.t || "handout").replace(/\.pdf$/i, "").replace(/[\\/:*?"<>|]+/g, " ").trim() || "handout";
      var url = URL.createObjectURL(new Blob([out], {type: "application/pdf"}));
      var a = document.createElement("a"); a.href = url; a.download = base + "_" + String(user.sn).replace(/[^\w-]+/g, "") + ".pdf";
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function(){ URL.revokeObjectURL(url); }, 60000);
      toast(D.dlLock === false ? "Downloaded — your copy is marked with your name and student number." : "Downloaded — open it with your student number (" + String(user.sn).trim() + ") as the password.");
    } catch(e){
      console.error(e); toast("This handout couldn't be prepared for download. " + ((e && e.message) || ""));
    } finally { dlBusy = false; $("dlBtn").disabled = false; }
  }
  function stampDate(d){ return d.toLocaleDateString("en-US", {year: "numeric", month: "long", day: "numeric"}) + ", " + d.toLocaleTimeString("en-US", {hour: "numeric", minute: "2-digit"}); }
  // Helvetica only knows Western characters: keep what it can draw, simplify accents it can't (ā → a), drop the rest
  function fit(font, s){
    var out = "";
    Array.from(String(s || "")).forEach(function(ch){
      try { font.encodeText(ch); out += ch; }
      catch(e){ var b = ch.normalize("NFD").replace(/[\u0300-\u036f]/g, ""); try { if (b) { font.encodeText(b); out += b; } } catch(e2){ out += "?"; } }
    });
    return out;
  }
  function wrap(font, size, text, maxW){
    var words = text.split(/\s+/), lines = [], cur = "";
    words.forEach(function(w){ var t = cur ? cur + " " + w : w; if (font.widthOfTextAtSize(t, size) <= maxW || !cur) cur = t; else { lines.push(cur); cur = w; } });
    if (cur) lines.push(cur); return lines;
  }
  // A page rendered as an image (for PDFs pdf-lib can't edit, e.g. password-protected ones)
  async function rasterPdf(bytes, prog){
    if (!window.pdfjsLib) throw new Error("The PDF tools are missing from this portal file.");
    if (!pdfjsLib.GlobalWorkerOptions.workerSrc){ var w = document.getElementById("pdfjs-worker"); pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(new Blob([w.textContent], {type: "text/javascript"})); }
    var src = await pdfjsLib.getDocument({data: bytes.slice(0), isEvalSupported: false}).promise, L = PDFLib, doc = await L.PDFDocument.create();
    for (var n = 1; n <= src.numPages; n++){
      if (prog) prog(n, src.numPages);
      var pg = await src.getPage(n), vp1 = pg.getViewport({scale: 1}), sc = Math.min(2.2, 2400 / Math.max(vp1.width, vp1.height)), vp = pg.getViewport({scale: sc});
      var c = document.createElement("canvas"); c.width = Math.ceil(vp.width); c.height = Math.ceil(vp.height);
      var g = c.getContext("2d"); g.fillStyle = "#fff"; g.fillRect(0, 0, c.width, c.height);
      await pg.render({canvasContext: g, viewport: vp}).promise;
      var jpg = await new Promise(function(r){ c.toBlob(r, "image/jpeg", 0.86); });
      var im = await doc.embedJpg(new Uint8Array(await jpg.arrayBuffer()));
      var page = doc.addPage([vp1.width, vp1.height]); page.drawImage(im, {x: 0, y: 0, width: vp1.width, height: vp1.height});
      c.width = c.height = 0; pg.cleanup();
    }
    await src.destroy();
    return doc;
  }
  async function stampPdf(bytes, p, prog){
    var L = window.PDFLib; if (!L) throw new Error("The PDF stamp tool is missing from this portal file.");
    var doc = null;
    try { doc = await L.PDFDocument.load(bytes, {updateMetadata: false}); if (doc.isEncrypted) doc = null; } catch(e){ doc = null; }
    if (!doc) doc = await rasterPdf(bytes, prog);
    var font = await doc.embedFont(L.StandardFonts.Helvetica), bold = await doc.embedFont(L.StandardFonts.HelveticaBold);
    var when = new Date(), who = fit(bold, [user.name, user.sn].filter(Boolean).join("  ·  "));
    var line1 = fit(bold, "Licensed copy for " + [user.name, user.sn, user.em].filter(Boolean).join(" · ") + " — downloaded " + stampDate(when));
    var note = fit(font, dlNote()), title = fit(font, D.title || "");
    var grey = L.rgb(0.42, 0.42, 0.42), ink = L.rgb(0.2, 0.2, 0.2), white = L.rgb(1, 1, 1);
    var pages = doc.getPages();
    pages.forEach(function(page, idx){
      if (prog && idx % 10 === 0) prog(idx + 1, pages.length);
      var box = page.getCropBox(), rot = ((page.getRotation().angle % 360) + 360) % 360;
      var W = box.width, H = box.height, x0 = box.x, y0 = box.y;
      var VW = rot % 180 ? H : W, VH = rot % 180 ? W : H;
      // visual (u, v) from the bottom-left of the page as it's seen → PDF coordinates
      function P(u, v){
        if (rot === 90) return {x: x0 + W - v, y: y0 + u};
        if (rot === 180) return {x: x0 + W - u, y: y0 + H - v};
        if (rot === 270) return {x: x0 + v, y: y0 + H - u};
        return {x: x0 + u, y: y0 + v};
      }
      function text(t, u, v, o){ var q = P(u, v); page.drawText(t, Object.assign({x: q.x, y: q.y, rotate: L.degrees((o.angle || 0) + rot)}, o.style)); }
      function rect(u, v, w, h, style){ var q = P(u, v); page.drawRectangle(Object.assign({x: q.x, y: q.y, width: w, height: h, rotate: L.degrees(rot)}, style)); }
      // 1. light diagonal name stamps: 6 per page, evenly spread, thin type, very faint,
      //    so the page reads normally but every region of it still carries the student's name and number
      var ang = 30, cos = Math.cos(ang * Math.PI / 180), sin = Math.sin(ang * Math.PI / 180), faint = L.rgb(0.55, 0.55, 0.55);
      var ds = Math.max(9, Math.min(13, VW / 46)), dw = font.widthOfTextAtSize(who, ds);
      var rowsN = 3, top = ds * 4, bottom = ds * 7, span = VH - top - bottom;   // 3 rows × 2 = 6 stamps on every page
      for (var r = 0; r < rowsN; r++){
        var my = bottom + span * (r + 0.5) / rowsN;
        [0.27, 0.73].forEach(function(fx, c){
          var mx = VW * (fx + (r % 2 ? 0.05 : -0.05));                                   // stagger alternate rows
          text(who, mx - dw / 2 * cos, my - dw / 2 * sin, {angle: ang, style: {font: font, size: ds, color: faint, opacity: 0.16}});
        });
      }
      // 1b. a thin line of small print up the left margin (outside the text area on most handouts)
      var ms = Math.max(5, Math.min(6.5, VW / 100)), mline = fit(font, "Licensed copy · " + [user.name, user.sn, user.em].filter(Boolean).join(" · ") + " · not for distribution or sale");
      var mlw = font.widthOfTextAtSize(mline, ms);
      if (mlw < VH * 0.9) text(mline, ms * 2.2, (VH - mlw) / 2, {angle: 90, style: {font: font, size: ms, color: grey, opacity: 0.55}});
      // 2. footer band: who, when, and the copyright notice
      var fs = Math.max(5.6, Math.min(7.6, VW / 82)), pad = fs * 0.8, maxW = VW - pad * 4;
      var l1 = wrap(bold, fs, line1, maxW), l2 = wrap(font, fs, note, maxW), lh = fs * 1.28;
      var bandH = (l1.length + l2.length) * lh + pad * 1.4;
      rect(0, 0, VW, bandH, {color: white, opacity: 0.86});
      var yy = bandH - pad * 0.7 - fs;
      l1.forEach(function(t){ text(t, pad * 2, yy, {style: {font: bold, size: fs, color: ink}}); yy -= lh; });
      l2.forEach(function(t){ text(t, pad * 2, yy, {style: {font: font, size: fs, color: ink}}); yy -= lh; });
      // 3. small tag at the top right
      var ts = fs * 0.95, tag = fit(font, "Licensed to " + [user.name, user.sn].filter(Boolean).join(" · ") + " · page " + (idx + 1) + " of " + pages.length), tw = font.widthOfTextAtSize(tag, ts);
      rect(VW - tw - pad * 3, VH - ts - pad * 1.6, tw + pad * 2, ts + pad * 1.2, {color: white, opacity: 0.8});
      text(tag, VW - tw - pad * 2, VH - ts - pad, {style: {font: font, size: ts, color: grey}});
    });
    try {
      doc.setSubject(fit(font, "Licensed copy for " + [user.name, user.sn, user.em].filter(Boolean).join(", ") + " — " + stampDate(when)));
      doc.setKeywords([String(user.sn), String(user.em), "licensed copy", "do not distribute"]);
      if (title && !doc.getTitle()) doc.setTitle(fit(font, p.t || title));
      doc.setProducer("Study portal — personal licensed copy"); doc.setModificationDate(when);
    } catch(e){}
    if (prog) prog(pages.length, pages.length);
    if (D.dlLock !== false) return await pdfLockR6(L, doc, String(user.sn).trim());   // opens only with the student number
    return await doc.save({useObjectStreams: true});
  }
  // PDF password protection (AES-256, PDF 2.0 standard security handler R6) for a pdf-lib document.
  // The file opens only with the user password; the owner password is random, so restrictions can't be lifted in normal readers.
  async function pdfLockR6(L, doc, userPw, perms){
    var S = crypto.subtle, te = new TextEncoder();
    function rnd(n){ return crypto.getRandomValues(new Uint8Array(n)); }
    function cat(){ var n = 0, i, o, a = arguments; for (i = 0; i < a.length; i++) n += a[i].length; o = new Uint8Array(n); n = 0; for (i = 0; i < a.length; i++){ o.set(a[i], n); n += a[i].length; } return o; }
    function hex(u){ var s = ""; for (var i = 0; i < u.length; i++) s += (u[i] < 16 ? "0" : "") + u[i].toString(16); return s; }
    async function aesCbc(keyBytes, iv, data, pad){
      var k = await S.importKey("raw", keyBytes, "AES-CBC", false, ["encrypt"]);
      var out = new Uint8Array(await S.encrypt({name: "AES-CBC", iv: iv}, k, data));
      return pad ? out : out.slice(0, data.length);                 // data is a whole number of blocks: drop WebCrypto's padding block
    }
    async function dig(alg, data){ return new Uint8Array(await S.digest(alg, data)); }
    // ISO 32000-2, 7.6.4.3.4 — Algorithm 2.B
    async function hash2B(pw, salt, udata){
      var K = await dig("SHA-256", cat(pw, salt, udata)), E = new Uint8Array([0]), i = 0;
      while (i < 64 || E[E.length - 1] > i - 32){
        var one = cat(pw, K, udata), K1 = new Uint8Array(one.length * 64);
        for (var r = 0; r < 64; r++) K1.set(one, r * one.length);
        E = await aesCbc(K.slice(0, 16), K.slice(16, 32), K1, false);
        var sum = 0; for (var j = 0; j < 16; j++) sum += E[j];
