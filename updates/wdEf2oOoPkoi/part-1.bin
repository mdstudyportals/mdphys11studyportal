    }
    if (band){
      var bs = cs(band);
      K["band"] = thStr(solid(bs.backgroundColor)); K["band-fg"] = thStr(thCol(bs.color) || [255, 255, 255, 1]);
      if (px(bs.borderBottomWidth) >= 1 && solid(bs.borderBottomColor)) K["band-rule"] = bs.borderBottomWidth + " solid " + thStr(solid(bs.borderBottomColor));
      var bk = scan(band, null, upper); if (bk){ var bkc = solid(cs(bk).color); if (bkc && thSat(bkc) > .2) K["band-k"] = thStr(bkc); }
    }
    var avoid = function(el){ return (cov && cov.contains(el)) || (band && band.contains(el)); };
    // fonts: body, headings, labels
