    $("npRep").innerHTML = NP_ICO.rep + (rp === "one" ? '<span class="one">1</span>' : ""); $("npRep").classList.toggle("on", rp !== "off");
    $("npRep").title = rp === "one" ? "Repeat: this track" : rp === "all" ? (npIsPl(NP) ? "Repeat: whole playlist" : "Repeat: whole section") : "Repeat: off";
    $("npList").innerHTML = NP_ICO.list; $("npList").classList.toggle("on", !$("npQ").hidden);
    if (!inf.list) $("npQ").hidden = true; else if (!$("npQ").hidden) npQueue();
    $("npTimer").hidden = !ctl && NP.kind !== "media";
    $("npVol").hidden = inf.vol == null; if (inf.vol != null && document.activeElement !== $("npVol")) $("npVol").value = Math.round(inf.vol * 100);
    $("npHide").innerHTML = NP_ICO.hide; $("npHide").hidden = NP.kind !== "media";      // only our own files: YouTube and Spotify must stay visible
    $("npChipShow").innerHTML = NP_ICO.show; $("npChipShow").hidden = !npHidden;
