  setInterval(checkOpen, 60000);
  window.addEventListener("pagehide", inkFlush);
  document.addEventListener("visibilitychange", function(){ if (document.hidden) inkFlush(); });
  document.addEventListener("visibilitychange", function(){ if (!document.hidden){ checkOpen(); flushScores(); } });
