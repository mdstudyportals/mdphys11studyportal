  }
  var NP_ICO = (function(){
    function sv(d, f){ return '<svg viewBox="0 0 24 24" class="i"><path d="' + d + '" ' + (f ? 'fill="currentColor" stroke="none"' : 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"') + '/></svg>'; }
    return {
      play: sv("M8 5v14l11-7z", 1), pause: sv("M7 5h4v14H7zM13 5h4v14h-4z", 1),
      prev: sv("M6 5h2v14H6zM20 5v14L9 12z", 1), next: sv("M16 5h2v14h-2zM4 5v14l11-7z", 1),
      back: sv("M11 5 4 12l7 7M20 12H4"), fwd: sv("M13 5l7 7-7 7M4 12h16"),
      vol: sv("M4 9v6h4l5 4V5L8 9zM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"), mute: sv("M4 9v6h4l5 4V5L8 9zM17 9l5 6M22 9l-5 6"),
      pip: sv("M3 5h18v14H3zM12 12h7v5h-7z"), open: sv("M14 4h6v6M20 4l-8 8M18 14v5H5V6h5"),
      shuf: sv("M3 6h4l10 12h4M17 3l4 3-4 3M3 18h4l3-3.6M14 9.6 17 6h4M17 15l4 3-4 3"), rep: sv("M4 11V9a3 3 0 0 1 3-3h13M17 3l3 3-3 3M20 13v2a3 3 0 0 1-3 3H4M7 21l-3-3 3-3"),
      list: sv("M4 6h12M4 12h12M4 18h8M18 15v6l4-3z"), timer: sv("M12 8v5l3 2M9 2h6M12 22a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"),
      hide: sv("M5 12h14"), slim: sv("M3 10h18v4H3z"), full: sv("M3 5h18v14H3zM10 9.5l4.5 2.5-4.5 2.5z"), show: sv("M5 15l7-7 7 7"),
      grow: sv("M14 4h6v6M10 20H4v-6M20 4l-6 6M4 20l6-6"), shrink: sv("M4 14h6v6M20 10h-6V4M10 14l-6 6M14 10l6-6"),
      listen: '<svg viewBox="0 0 24 24" class="i"><path d="M4 14v-2a8 8 0 0 1 16 0v2" fill="none" stroke="currentColor" stroke-width="2"/><rect x="3" y="13" width="5" height="7" rx="1.5" fill="currentColor"/><rect x="16" y="13" width="5" height="7" rx="1.5" fill="currentColor"/></svg>',
      video: '<svg viewBox="0 0 24 24" class="i"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 9v6l5-3z" fill="currentColor"/></svg>'
    };
  })();
  function npBind(s){                                                       // uploaded audio / video: follow its state; playlist for audio
    if (s.kind !== "media" || s.bound) return; s.bound = true;
    var pv = npPref().vol; if (pv != null) s.el.volume = Math.max(0, Math.min(1, pv));
    var saved = 0;
    s.el.addEventListener("loadedmetadata", function(){
      // some recordings (screen / voice recorders saving .webm) don't say how long they are, so they can't be skipped:
      // jump to the end once to learn the length, then come back
      var e = s.el;
      if (e.duration === Infinity && !rqOf(pages[s.i])){
        var done = function(){ if (!isFinite(e.duration)) return; e.removeEventListener("durationchange", done); e.currentTime = 0; setTimeout(function(){ e._probe = false; }, 300); npResume(); };
        e._probe = true; e.addEventListener("durationchange", done); try { e.currentTime = 1e101; } catch(x){ e._probe = false; e.removeEventListener("durationchange", done); }
        return;
      }
      npResume();
    });
    function npResume(){                                                       // pick up where the student stopped (not for required items being recorded)
      var at = npPosGetK(npPosK(s));
      if (s.el.autoplay || !npAllowed(s.i) || !at || at < 5 || at > (s.el.duration || 0) - 5) return;
      s.el.currentTime = at; toast("Resumed at " + clock(at) + " — drag the bar to start over.");
    }
    s.el.addEventListener("timeupdate", function(){ if (s.el._probe) return; if (Date.now() - saved > 5000 && npAllowed(s.i) && npPosK(s)){ saved = Date.now(); npPosSetK(npPosK(s), s.el.currentTime); } });
    s.el.addEventListener("pause", function(){ if (!s.el._probe && npAllowed(s.i) && !s.el.ended) npPosSetK(npPosK(s), s.el.currentTime); });
    s.el.addEventListener("ended", function(){ if (!s.el._probe) npPosSetK(npPosK(s), 0); });
    ["play", "pause", "ended", "volumechange", "ratechange", "loadedmetadata", "durationchange"].forEach(function(ev){ s.el.addEventListener(ev, function(){ if (s === NP) npPaint(); if (npIsPl(s)) plPaint(); }); });
    s.el.addEventListener("ended", function(){ if (s.el._probe) return; if (npIsPl(s) || (npOn() && pages[s.i].k === "audio")) npNext(s); });
    s.el.addEventListener("play", function(){ npOnly(s); });
  }
  // One sound at a time. The page's own media starting → the mini-player's media stops and the mini-player closes (it comes
  // back with this one when the student moves to another page). The mini-player's media resumed → the page's media pauses.
  function npOnly(s){
    [NP, CUR].forEach(function(o){
      if (!o || o === s) return;
      // something starts on this page: the mini-player gives way — playing or paused (its place is kept); what plays here
      // moves into the mini-player when you leave the page
      if (o === NP && s === CUR){ if (o.kind === "media") try { npPosSetK(npPosK(o), o.el.currentTime); } catch(e){} npClose(); return; }
      if (!npPlaying(o)) return;
      if (npCtl(o) || o.ctl) npToggle(o); else if (o === NP) npClose();
    });
    pageMediaPause();
  }
  // Skip and next / previous on the item's own page (the mini-player gives way there): ⏮ −10 s +10 s ⏭
  function pgCtl(box, el, i){
    var p = pages[i], bar = document.createElement("div"); bar.className = "pgctl"; bar.setAttribute("role", "group"); bar.setAttribute("aria-label", "Player controls");
    bar.innerHTML = '<button type="button" class="pgb" data-pg="prev" title="Previous / start again" aria-label="Previous">' + NP_ICO.prev + '</button>' +
      '<button type="button" class="pgb" data-pg="back" title="Back 10 seconds (J)" aria-label="Back 10 seconds">' + NP_ICO.back + '<span>10 s</span></button>' +
      '<button type="button" class="pgb" data-pg="fwd" title="Forward 10 seconds (L)" aria-label="Forward 10 seconds"><span>10 s</span>' + NP_ICO.fwd + '</button>' +
      '<button type="button" class="pgb" data-pg="next" title="Next in this section" aria-label="Next">' + NP_ICO.next + '</button>';
    function st(){ return [CUR, NP].filter(function(o){ return o && o.el === el; })[0] || {i: i, kind: "media", el: el}; }
    function paint(){
      if (!bar.isConnected) return;
      var s = st(), inf = npInfo(s), nx = npSection(i).length > 1;
      bar.querySelector('[data-pg="back"]').disabled = bar.querySelector('[data-pg="fwd"]').disabled = !inf.seek;
      bar.querySelector('[data-pg="next"]').hidden = !nx; bar.querySelector('[data-pg="next"]').disabled = npPickS(s, 1, false) < 0;
    }
    bar.addEventListener("click", function(e){
      var b = e.target.closest("[data-pg]"); if (!b || b.disabled) return;
      var s = st(), a = b.dataset.pg;
      if (CB && (a === "next" || a === "prev")){ toast("Music and videos stay paused during closed-book activities."); return; }
      if (a === "back" || a === "fwd") npSeekTo(npInfo(s).t + (a === "fwd" ? 10 : -10), s);
      else if (a === "prev"){ if (el.currentTime > 3 || npPickS(s, -1, false) < 0) el.currentTime = 0; else npStep(s, -1); }
      else if (!npStep(s, 1)) toast("Nothing after this in the section.");
