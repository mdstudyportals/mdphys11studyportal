    busy[key] = false; if (mine){ sending = false; scState = state; paintScoreStatus(); }
    if (done && more) return flushKey(key, to, mine);
  }
  function paintBadges(){
    paintOp();
    if (!SC || !user) return;
    var st = scLoad(), byItem = {};
    Object.keys(st.latest).forEach(function(k){ var l = st.latest[k]; if (l && l.item != null) (byItem[l.item] = byItem[l.item] || []).push(l); });
    document.querySelectorAll("nav button.item").forEach(function(b){
      var i = +b.dataset.i, p = pages[i], old = b.querySelector(".scb"); if (old) old.remove();
      if (!p || !p.sc) return;
      var list = (byItem[i] || []).sort(function(a, c){ return a.at < c.at ? 1 : -1; }), s = document.createElement("span");
      var mk = list.filter(function(l){ return /M[TE]\d+$/.test(l.name); })[0], qcl = list.filter(function(l){ return /QCTOTAL$/.test(l.name); })[0];
      s.className = "scb" + (list.length ? "" : " none");
      s.textContent = mk ? "Best " + Math.round(mk.best) + "%" : qcl ? "QC " + qcl.bestScore + "/" + qcl.bestTotal : "—";
      var lk = st.locks && st.locks[lockId(p)];
      if (lk){ s.textContent = "🔒 " + (list.length ? s.textContent.replace(/^Best /, "") : "Final"); s.className = "scb"; }
      s.title = list.length ? list.map(function(l){ var q = /QCTOTAL$/.test(l.name); return l.name + " · " + (l.label || "") + " — best " + l.bestScore + "/" + l.bestTotal + (q ? "" : " (" + l.best + "%)") + ", last " + l.score + "/" + l.total; }).join("\n") : "Not attempted yet";
      if (lk) s.title = "Answer key opened — scores for this lesson are final.\n" + s.title;
      b.appendChild(s);
    });
    paintScoreStatus();
  }
  function paintScoreStatus(){
    var el = $("scStatus"); if (!el || !SC || !user) return;
    var q = scLoad().queue.filter(function(x){ return x.type !== "visit"; }).length;
    el.className = "scstat " + (scState === "rej" ? "bad" : q ? (scState === "bad" || scState === "err" ? "bad" : "wait") : "ok");
    el.textContent = scState === "rej" ? "Your instructor's score sheet didn't accept a score. Please download the latest portal file."
      : !q ? "Scores: all sent ✓"
      : scState === "bad" ? "Scores can't be sent — tell your instructor the score recorder key doesn't match."
      : scState === "err" ? q + " score" + (q > 1 ? "s" : "") + " waiting — the instructor's score sheet didn't respond; will retry."
      : q + " score" + (q > 1 ? "s" : "") + " waiting — will send when you're online.";
  }

  // ---- reading the score, the mode and the test name from a quiz page
  // Score text: "Score: 17/20", "You got 8 out of 10", "12/15 correct", "Result: 85%"
  var SCORE_RES = [
    /(?:\bscore|\bresult|\byou (?:got|scored)|\bmarks?|\bcorrect(?: answers)?|\bpoints|\btotal)\b[^\d]{0,30}?(\d{1,4}(?:\.\d+)?)\s*(?:\/|out of|of)\s*(\d{1,4})\b/i,
    /\b(\d{1,4})\s*(?:\/|out of)\s*(\d{1,4})\s*(?:correct|points|pts|items|marks|score)\b/i,
    /(?:\bscore|\bresult|\byou (?:got|scored))\b[^\d]{0,20}?(\d{1,3}(?:\.\d+)?)\s*%/i
  ];
  var EXAM_RE = /\bexam\b|\btimed\b|\btest mode\b|\bassessment mode\b/i;
  var PRAC_RE = /\bpractice\b|\bstudy mode\b|\btutor(ial)? mode\b|\breview mode\b|\blearn(ing)? mode\b|\bfeedback mode\b/i;
  var TEST_RE = /\b(?:mock\s*(?:test|exam)?|quick\s*check|quiz|set|part|test|exam)\s*#?\s*(?:\d{1,3}\b|[ivx]{1,4}\b|[a-e]\b)/i;
  var MODE_TXT = /\b(exam|practice|timed|study|tutor|review|learning)\s*mode\b/ig;
  function modeOf(t){ var e = EXAM_RE.test(t), p = PRAC_RE.test(t); return e && !p ? "exam" : p && !e ? "practice" : null; }
  function testOf(t){ var m = TEST_RE.exec(t); return m ? m[0] : null; }
  function labelOf(el){
    if (!el) return "";
    if (el.tagName === "INPUT" && (el.type === "radio" || el.type === "checkbox")){ var l = el.labels && el.labels[0]; return ((l && l.innerText) || el.value || "").trim(); }
    if (el.tagName === "SELECT"){ var o = el.options[el.selectedIndex]; return o ? o.text.trim() : ""; }
    return (el.innerText || el.value || el.getAttribute("aria-label") || el.title || "").trim();
  }
  function shortLabel(t){ t = String(t || ""); return t.length > 60 ? t.split(/\n/)[0].trim() : t; }   // "Exam mode\nFeedback after the exam…" → "Exam mode"
  function visible(el){ return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length); }
  function activeLabels(d){
    var out = [];
    try {
      d.querySelectorAll('[aria-pressed="true"],[aria-selected="true"],[aria-current]:not([aria-current="false"]),.active,.selected,.is-active,.current,.on,input:checked,select').forEach(function(el){
        if (el.tagName !== "SELECT" && !visible(el)) return;
        var t = shortLabel(labelOf(el)); if (t && t.length <= 60) out.push(t);
      });
    } catch(e){}
    return out;
  }
  function pick(list, fn){ var hits = []; list.forEach(function(t){ var v = fn(t); if (v && hits.indexOf(v) < 0) hits.push(v); }); return hits.length === 1 ? hits[0] : null; }
  function context(d, s, clicks){
    var act = activeLabels(d), before = s.text.slice(Math.max(0, s.at - 1500), s.at);
    // mode: highlighted control → last clicked control → nearest "… mode" text above the score
    var mode = pick(act, modeOf) || clicks.mode, mm, lastMode = null;
    if (!mode){ MODE_TXT.lastIndex = 0; while ((mm = MODE_TXT.exec(before))) lastMode = mm[0]; if (lastMode) mode = modeOf(lastMode); }
    // test name: highlighted tab → nearest test name above the score → last clicked test button
    var sub = pick(act, testOf), tm, re = new RegExp(TEST_RE.source, "ig"), near = null;
    if (!sub){ while ((tm = re.exec(before))) near = tm[0]; sub = near || clicks.test; }
    return {mode: mode, sub: sub};
  }
  // Every score shown on the page, in order (duplicates of the same text removed).
  // All text of the page, including parts hidden behind tabs (but not scripts) — so every quick check counts toward the lesson total.
  function fullText(d){
    if (!d.body) return "";
    var w = d.createTreeWalker(d.body, 5, {acceptNode: function(n){
      if (n.nodeType === 3) return 1;
      return /^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE|TEXTAREA|SELECT)$/.test(n.nodeName) ? 2 : 3;
    }}), out = [], n;
    while ((n = w.nextNode())) out.push(n.nodeValue);
    return out.join("\n");
  }
  function scanAll(d, txt){
    var t = txt != null ? txt : ((d.body && d.body.innerText) || ""), out = [];
    if (!t) return out;
    for (var n=0;n<SCORE_RES.length;n++){
      var re = new RegExp(SCORE_RES[n].source, "ig"), m;
      while ((m = re.exec(t))){
        if (/question|item\b|items\b|page|slide|card|step|no\./i.test(m[0].replace(/\d[\s\S]*$/, ""))) continue;   // "Question 3 of 10" is progress, not a score
        var s = +m[1], tot = n === 2 ? 100 : +m[2], a = m.index, b = m.index + m[0].length;
        if (!(tot > 0 && s >= 0 && s <= tot)) continue;
        if (out.some(function(o){ return a < o.end && b > o.at; })) continue;
        out.push({score: s, total: tot, at: a, end: b, text: t, pctOnly: n === 2});
      }
    }
    return out.sort(function(x, y){ return x.at - y.at; });
  }
  function scanScore(d){ var a = scanAll(d); return a.length ? a[0] : null; }
  var QC_LBL = /\bquick\s*-?\s*checks?\b/ig, MOCK_LBL = /\bmock\s*-?\s*(test|exam)s?\b(?:\s*#?\s*(\d{1,2}|[ivx]{1,4})\b)?/ig, PART_LBL = /\bpart\s*#?\s*(\d{1,2}|[ivx]{1,4})\b/ig;
  function lastHit(re, txt){ re.lastIndex = 0; var m, h = null; while ((m = re.exec(txt))) h = {at: m.index, m: m}; return h; }
  // Decides what a score belongs to: a mock test (MTn / MEn) or the quick checks of Part n (QCn).
  function classify(p, s, act, clicks, d){
    var before = s.text.slice(0, s.at);
    var qc = lastHit(QC_LBL, before), mk = lastHit(MOCK_LBL, before), pt = lastHit(PART_LBL, before);
    var actPart = pick(act, function(t){ var m = /\bpart\s*#?\s*(\d{1,2}|[ivx]{1,4})\b/i.exec(t); return m ? String(numOf(m[1])) : null; });
    var partAt = function(limit){ var h = lastHit(PART_LBL, s.text.slice(0, limit)); return h ? numOf(h.m[1]) : 0; };
    var part = actPart ? +actPart : (pt ? numOf(pt.m[1]) : 0);
    var ctx = context(d, s, clicks), titleMock = /\bmock\s*-?\s*(test|exam)/i.exec(p.t || "");
    var near = Math.max(qc ? qc.at : -1, mk ? mk.at : -1, pt ? pt.at : -1);
    function mock(kind, n){ return {code: (/exam/i.test(kind) ? "ME" : "MT") + (n || 1), mode: ctx.mode}; }
    if (qc && qc.at === near) return {code: "QCTOTAL", cum: true};
    if (mk && mk.at === near) return mock(mk.m[1], mk.m[2] ? numOf(mk.m[2]) : (actPart ? +actPart : partAt(mk.at)));
    if (pt && pt.at === near){                                  // only a "Part n" heading above: a long, timed/moded result is that part's mock
      if (ctx.mode || s.total >= 20) return mock(titleMock ? titleMock[1] : "test", part);
      return {code: "QCTOTAL", cum: true};
    }
    if (titleMock || ctx.mode || s.total >= 20) return mock(titleMock ? titleMock[1] : "test", part || 1);
    return {code: "QCTOTAL", cum: true};
  }
  function watchScores(w, i, tok){
    if (!SC || !pages[i] || !pages[i].sc) return;
    var d = w.document, interacted = false, t = null, clicks = {mode: null, test: null}, last = {}, cleared = {}, parked = {};
    scoreSess[i] = newSess();
    var keyCheck = guardKey(w, i, tok);
    function groupsNow(){
      var vis = scanAll(d), g = {}, act = activeLabels(d);
      var cand = {};
      vis.forEach(function(s){                                            // mock tests/exams: from what's on screen
        var c = classify(pages[i], s, act, clicks, d);
        if (!c.cum) (cand[c.code] = cand[c.code] || []).push({s: s, c: c});
      });
      pickMocks(cand, g);
      scanAll(d, fullText(d)).forEach(function(s){                         // quick checks: every one in the lesson, even on hidden tabs
        var c = classify(pages[i], s, act, clicks, d);
        if (c.cum){ var q = g[c.code] || (g[c.code] = {score: 0, total: 0, cum: true}); q.score += s.score; q.total += s.total; }
      });
      return g;
    }
    // Mock results that exist on the page but are hidden (another page/tab of the handout is showing)
    function hiddenMocks(){
      var cand = {}, g = {};
      scanAll(d, fullText(d)).forEach(function(s){ var c = classify(pages[i], s, [], {mode: null, test: null}, d); if (!c.cum) (cand[c.code] = cand[c.code] || []).push({s: s, c: c}); });
      pickMocks(cand, g); return g;
    }
    function pickMocks(cand, g){
      var mi = +pages[i].mi || 0;                                         // items per mock test (set in Portal Builder, e.g. 50)
      Object.keys(cand).forEach(function(code){
        var list = cand[code], fr = list.filter(function(x){ return !x.s.pctOnly; }), pc = list.filter(function(x){ return x.s.pctOnly; })[0], pick1 = null;
        if (mi) pick1 = fr.filter(function(x){ return x.s.total === mi; })[0];   // "41 / 50" — the real result
        else pick1 = fr[0];
        if (!pick1 && pc){ var tot = mi || 100; pick1 = {s: {score: Math.round(pc.s.score * tot / 100), total: tot}, c: pc.c}; }   // only "82%" shown → 41 of 50
        if (pick1) g[code] = {score: pick1.s.score, total: pick1.s.total, mode: pick1.c.mode};
      });
    }
    // A result that went out of view: hidden but unchanged (the student moved to another page) → "parked", so seeing it
    // again isn't a new attempt; really gone (Retake cleared it) → the next result counts even if it's the same score
    function gone(g){
      var ks = Object.keys(last).filter(function(k){ return !g[k]; }), h = null;
      ks.forEach(function(k){
        if (!/^QC/.test(k)){
          h = h || hiddenMocks(); var hv = h[k];
          if (hv && last[k].split("|")[0] === hv.score + "/" + hv.total){ parked[k] = {v: hv.score + "/" + hv.total, at: Date.now()}; delete last[k]; return; }
        }
        cleared[k] = true; delete last[k];
      });
    }
    var g0 = groupsNow(); Object.keys(g0).forEach(function(k){ last[k] = g0[k].score + "/" + g0[k].total + "|" + (g0[k].mode || ""); });  // already on screen when opened
    var h0 = hiddenMocks(); Object.keys(h0).forEach(function(k){ if (!g0[k]) parked[k] = {v: h0[k].score + "/" + h0[k].total, at: Date.now()}; });   // earlier results on other pages
    function hookOpts(score, total, opts){
