    q.innerHTML = '<div class="qh">Up next · ' + esc(String(pages[NP.i].g || "This section")) + '</div>' + list.map(function(k, n){
      return '<button type="button" data-q="' + k + '" class="' + (k === NP.i ? "now" : "") + '"><span class="n">' + (k === NP.i ? "♪" : n + 1) + '</span><span>' + esc(pages[k].t) + '</span></button>'; }).join("");
  }
  // Study timer: pauses the music after the set time (a natural break, Pomodoro-style)
  var TIMES = [0, 15, 25, 45, 60];
  function npTimerPaint(){
    var b = $("npTimer"), left = TIMER ? Math.max(0, TIMER.end - Date.now()) : 0, m = Math.ceil(left / 60000);
    b.innerHTML = NP_ICO.timer + (TIMER ? "<span>" + m + "m</span>" : "");
    b.classList.toggle("on", !!TIMER);
    b.title = TIMER ? "Study timer: pauses in " + clock(left / 1000) + " (click to change)" : "Study timer — pause the music after 15, 25, 45 or 60 minutes";
    var c = $("npChipTm"); c.hidden = !TIMER; if (TIMER) c.textContent = "⏲ " + clock(left / 1000);
  }
  setInterval(function(){
    if (!TIMER) return;
