      p.el.style.width = Math.floor(p.vp.width * sc) + "px"; p.el.style.height = Math.floor(p.vp.height * sc) + "px";
      var vp = p.page.getViewport({scale: sc * dpr});
      var c = document.createElement("canvas"); c.className = "pc"; c.width = Math.floor(vp.width); c.height = Math.floor(vp.height);
      p.task = p.page.render({canvasContext: c.getContext("2d"), viewport: vp});
      await p.task.promise;
      if (s.dead || gen !== s.gen) return;
      var old = p.el.querySelector("canvas.pc"); if (old) old.remove();
      p.el.insertBefore(c, p.el.firstChild); p.gen = gen;
      if (canInk(pages[cur])){
        var icv = p.el.querySelector("canvas.ink");
        if (!icv){ icv = document.createElement("canvas"); icv.className = "ink"; p.el.appendChild(icv); addSurface(boxSurface("p" + p.el.dataset.n, p.el, icv)); }
        else redrawKey("p" + p.el.dataset.n);
      }
    } catch(e){ if (!(e && e.name === "RenderingCancelledException")) console.error(e); }
    finally { p.busy = false; p.task = null; if (pdfS === s && p.gen !== s.gen && isNear(s, p)) renderPg(s, p); }
  }
  function isNear(s, p){ var r = p.el.getBoundingClientRect(), R = s.sc.getBoundingClientRect(); return r.bottom > R.top - 800 && r.top < R.bottom + 800; }
  function dropPg(p){
    if (p.task){ try { p.task.cancel(); } catch(e){} }
    var c = p.el.querySelector("canvas.pc"); if (c){ c.width = 0; c.height = 0; c.remove(); }
    var ic2 = p.el.querySelector("canvas.ink"); if (ic2){ dropSurface(ic2); ic2.width = 0; ic2.height = 0; ic2.remove(); }
    p.gen = -1;
  }
  function pdfLabel(){
    var s = pdfS; if (!s) return;
    var mid = s.sc.getBoundingClientRect().top + s.sc.clientHeight/3, n = 1;
    for (var k=0;k<s.pg.length;k++){ if (s.pg[k].el.getBoundingClientRect().top <= mid) n = k+1; else break; }
    $("pdfPg").textContent = n + " / " + s.pg.length;
  }
  function zoom(f){
    var s = pdfS; if (!s) return;
    var rel = s.sc.scrollTop / Math.max(1, s.sc.scrollHeight);
    s.zoom = Math.max(0.4, Math.min(4, s.zoom * f));
    layoutPdf();
    s.sc.scrollTop = rel * s.sc.scrollHeight;
  }
  $("zIn").onclick = function(){ zoom(1.25); };
  $("zOut").onclick = function(){ zoom(0.8); };
  var rT; window.addEventListener("resize", function(){ clearTimeout(rT); rT = setTimeout(layoutPdf, 200); });

  // ---------- navigation ----------
  // open or close a term tab gradually: the height eases open, then its sections and items arrive one by one
  function tgSet(box, open){
    var h = box.querySelector(".tghd"), kids = box.querySelectorAll(".tgw > .tgb > *");
    if (open){
      for (var k = 0; k < kids.length; k++) kids[k].style.setProperty("--d", Math.min(k, 14));
      box.classList.remove("anim"); void box.offsetWidth; box.classList.add("anim");
      clearTimeout(box._tgT); box._tgT = setTimeout(function(){ box.classList.remove("anim"); }, 60 + Math.min(kids.length, 15) * 45 + 500);
    } else box.classList.remove("anim");
    box.classList.toggle("fold", !open); if (h) h.setAttribute("aria-expanded", open ? "true" : "false");
  }
  // the contents arrive gradually when the portal opens (once per sign-in)
  function navCascade(){
    var nv = $("nav"), its = nv.querySelectorAll(".tghd, .grp, .item"), n = 0;
    for (var k = 0; k < its.length; k++){ if (its[k].offsetParent === null) continue; its[k].style.setProperty("--d", Math.min(n++, 18)); }
    nv.classList.add("cascade"); setTimeout(function(){ nv.classList.remove("cascade"); }, 80 + Math.min(n, 19) * 35 + 520);
  }
  function openNav(){ $("nav").classList.add("open"); $("scrim").hidden = false; }
  function closeNav(){ $("nav").classList.remove("open"); $("scrim").hidden = true; }
  $("nav").addEventListener("click", function(e){
    var h = e.target.closest("button.tghd");
    if (h){ var box = h.parentNode, f = !box.classList.contains("fold"); tgSet(box, !f);
      var l = tgFolded().filter(function(x){ return x !== box.dataset.tg; }); if (f) l.push(box.dataset.tg); tgFolded(l); return; }
    var b = e.target.closest("button.item"); if (b){ show(+b.dataset.i); closeNav(); }
  });
  var NAVKEY = "portal-nav:" + (D.id || "x"), narrow = window.matchMedia ? matchMedia("(max-width: 900px)") : {matches:false};
  try { if (localStorage.getItem(NAVKEY) === "c") document.body.classList.add("navc"); } catch(e){}
  $("menuBtn").onclick = function(){
    if (narrow.matches){ openNav(); return; }
    var c = document.body.classList.toggle("navc");
    try { localStorage.setItem(NAVKEY, c ? "c" : ""); } catch(e){}
    $("menuBtn").setAttribute("aria-label", c ? "Show contents" : "Hide contents");
    setTimeout(layoutPdf, 260);
  };
  if (narrow.addEventListener) narrow.addEventListener("change", function(){ closeNav(); setTimeout(layoutPdf, 260); });
  (function(){ var st = $("stage"); if (!(st.requestFullscreen || st.webkitRequestFullscreen)) $("fs").hidden = true; })();
  $("scrim").onclick = closeNav;
  $("prev").onclick = function(){ show(cur - 1); };
  $("next").onclick = function(){ show(cur + 1); };
  function isFs(){ return !!(document.fullscreenElement || document.webkitFullscreenElement); }
  function toggleFs(){
    var st = $("stage");
    if (isFs()){ (document.exitFullscreen || document.webkitExitFullscreen).call(document); }
    else if (st.requestFullscreen) st.requestFullscreen().catch(function(){});
    else if (st.webkitRequestFullscreen) st.webkitRequestFullscreen();
  }
  $("fs").onclick = toggleFs;
  $("fsExit").onclick = toggleFs;
  $("fsPrev").onclick = function(){ show(cur - 1); };
  $("fsNext").onclick = function(){ show(cur + 1); };

  // floating controls fade out after a few seconds without movement
  var idleT;
  function wake(){
    var b = $("fsbar"); b.classList.remove("idle");
    clearTimeout(idleT); idleT = setTimeout(function(){ if (!b.matches(":hover")) b.classList.add("idle"); }, 2800);
  }
  ["mousemove","touchstart","click"].forEach(function(t){ $("stage").addEventListener(t, wake, {passive:true}); });
  $("fsbar").addEventListener("mouseleave", wake);
  // In full screen the shortcut list opens inside the full-screen area so it stays visible
  function toggleKeys(force){
    var k = $("keys"), open = force === undefined ? k.hidden : force;
    if (open){ (isFs() ? $("stage") : document.body).appendChild(k); }
    k.hidden = !open;
  }
  $("keys").addEventListener("click", function(e){ if (e.target === this) toggleKeys(false); });

  function onKey(e){
    if (!user) return;
    if (/^Media/.test(e.key || "") && msKey(e)) return;
    var t = e.target;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName || ""))) return;
    var k = e.key && e.key.length === 1 ? e.key.toLowerCase() : e.key;
    if (INK.on && (e.ctrlKey || e.metaKey) && !e.altKey && (k === "z" || k === "y")){
      if (k === "y" || e.shiftKey) inkRedo(); else inkUndo();
      e.preventDefault(); return;
    }
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (k === "Escape"){
      if (!$("keys").hidden){ toggleKeys(false); e.preventDefault(); }
      else if (INK.on){ setInk(false); e.preventDefault(); }
      else if ($("nav").classList.contains("open")) closeNav();
      return;
    }
    if (k === "a" && canInk(pages[cur])){ setInk(!INK.on); e.preventDefault(); return; }
    if (INK.on){
      var tools = {"1":"pen","2":"hl","3":"eraser","4":"text"};
      if (tools[k]){ setTool(tools[k]); e.preventDefault(); return; }
      if (k === "c"){ $("inkColor").click(); e.preventDefault(); return; }
      if (k === "s"){ $("inkSize").click(); e.preventDefault(); return; }
      if (k === "z"){ if (e.shiftKey) inkRedo(); else inkUndo(); e.preventDefault(); return; }
    }
    if (!$("keys").hidden && k !== "?"){ toggleKeys(false); }
    var mt = NP || CUR;                                                     // music / video: K play-pause, J/L ∓10 s, U mute, H hide the player
    if (k === "v" && NP && !e.shiftKey && !CB && D.np !== false){ npModeToggle(); e.preventDefault(); return; }
    if (mt && !e.shiftKey && (k === "k" || k === "j" || k === "l" || k === "u" || k === "h") && !CB){
      if (k === "k" && npCtl(mt)){ npToggle(mt); setTimeout(npPaint, 300); }
      else if ((k === "j" || k === "l") && npInfo(mt).seek){ npSeekTo(npInfo(mt).t + (k === "l" ? 10 : -10), mt); setTimeout(npTick, 150); }
      else if (k === "u" && npInfo(mt).muted != null) npMuteToggle(mt);
      else if (k === "h" && NP) npHideToggle();
      else return;
      e.preventDefault(); return;
    }
    if (k === "n") show(cur + 1);
    else if (k === "p") show(cur - 1);
    else if (k === "f"){ if ($("stage").requestFullscreen || $("stage").webkitRequestFullscreen) toggleFs(); }
    else if (k === "m") $("menuBtn").click();
    else if (k === "?") toggleKeys();
