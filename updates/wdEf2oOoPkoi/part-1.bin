  window.addEventListener("blur", function(){                              // a click into an embed: the student is using it
    setTimeout(function(){ var a = document.activeElement; [CUR, NP].forEach(function(s){
      if (!s || s.kind !== "embed" || s.el !== a) return;
      s.touched = true;
      if (s.state == null) npOnly(s);                                     // a player that can't tell us it's playing: the tap is the sign
    }); }, 0);
  });
  // ---------- media-button sensor ----------
  // Play, pause, stop, skip and next/previous from outside the page: headphone and earphone buttons (wired or Bluetooth),
  // keyboard media keys (Mac F7–F9, Windows media keys), the Mac Touch Bar and Control Center, Windows' media overlay,
  // and the lock screen / notification controls on phones and tablets. The device sends these to the page through the
  // Media Session API (and, on some computers, as media-key presses), and they act on the music or video now playing.
  // The same rules apply as with the on-screen buttons: no skipping ahead in required viewing, nothing plays during closed-book activities.
  var MS = {last: 0, lastSrc: "", tgt: null, meta: "", posAt: 0, outs: -1};
  function msTarget(){                                                     // the playing item first, then the mini-player, then this page's player
    var c = [NP, CUR].filter(function(s){ return s && npCtl(s); });
    return c.filter(npPlaying)[0] || c[0] || null;
  }
  function msTell(t){ toast(t + " — media button"); }
  function msAct(a, det, src){
    var now = Date.now();
