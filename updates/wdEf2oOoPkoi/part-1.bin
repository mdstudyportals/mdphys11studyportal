    if (tok !== navTok) return;
    if (notYet(p)){ $("loading").hidden = true; lockedView(p); return; }   // scheduled: not open yet
    $("loadTxt").textContent = "Opening…"; $("loadBar").style.width = "0";
    if (p.k === "link"){ $("loading").hidden = true; linkView(p); return; }
    if (p.k === "playlist"){ $("loading").hidden = true; if (p.ml) mlOpen(i); else plView(i); return; }
    if (p.k === "portal"){ $("loading").hidden = true; psView(i); return; }
    $("loading").querySelector(".spin").hidden = false; $("loading").querySelector(".pbar").hidden = false;
    $("loading").hidden = false;
