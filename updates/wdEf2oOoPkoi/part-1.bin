    try {
      if (!s || s.kind !== "media"){ if (MS.tgt){ ms.playbackState = "none"; MS.tgt = null; MS.meta = ""; } return; }
      var p = pages[s.i], tt = npIsPl(s) && p.tr[s.tr] ? p.tr[s.tr] : null, key = s.i + "|" + (tt ? s.tr : "") + "|" + p.t;
      if (MS.meta !== key){
        MS.meta = key; MS.tgt = s;
        var art = p.k === "playlist" ? plArt(p) : /^data:image\//.test(D.icon || "") ? D.icon : /^data:image\//.test(D.logo || "") ? D.logo : "";
        var aty = (/^data:(image\/[\w.+-]+)/.exec(art) || [])[1];
        ms.metadata = new MediaMetadata({title: (tt ? tt.t : p.t) || "", artist: (tt && (tt.cm && tt.cm !== tt.ar ? [tt.ar, tt.cm].filter(Boolean).join(" · ") : tt.ar)) || D.title || "", album: tt ? p.t : String(p.g || "").trim(), artwork: art ? [aty ? {src: art, sizes: plOwn(p) === art ? "512x512" : "256x256", type: aty} : {src: art, sizes: "512x512"}] : []});
      }
      ms.playbackState = npPlaying(s) ? "playing" : "paused";
