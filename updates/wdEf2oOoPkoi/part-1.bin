    for (var key in K) if (K[key] == null || K[key] === "" || /undefined|NaN/.test(String(K[key]))) delete K[key];
    return {v: K, fonts: fc};
  }
  function thSkin(win, t){                                                   // apply (or clear) the template inside SYNAPSE
    try {
      var d = win.document, rt = d.documentElement, kit = t && t.kit;
      (rt.getAttribute("data-kit-vars") || "").split(" ").filter(Boolean).forEach(function(k){ rt.style.removeProperty("--k-" + k); });
      if (!kit || !SYNTPL){ rt.removeAttribute("data-skin"); rt.removeAttribute("data-kit-vars"); var o = d.getElementById("portalFonts"); if (o) o.textContent = ""; $("synBox").classList.remove("tpl"); return; }
      var keys = Object.keys(kit.v);
      keys.forEach(function(k){ rt.style.setProperty("--k-" + k, kit.v[k]); });
      rt.setAttribute("data-kit-vars", keys.join(" ")); rt.setAttribute("data-skin", "");
      var fs = d.getElementById("portalFonts"); if (!fs){ fs = d.createElement("style"); fs.id = "portalFonts"; d.head.appendChild(fs); }
      if (fs.textContent.length !== kit.fonts.length) fs.textContent = kit.fonts;
      if (win === $("synFrame").contentWindow){                              // the window's title bar, in the portal, too
        var pf = document.getElementById("portalSynFonts"); if (!pf){ pf = document.createElement("style"); pf.id = "portalSynFonts"; document.head.appendChild(pf); }
        if (pf.textContent.length !== kit.fonts.length) pf.textContent = kit.fonts;
        var bx = $("synBox"); bx.style.setProperty("--syn-fh", kit.v.fh || ""); bx.style.setProperty("--syn-fl", kit.v.fl || "");
        var tplOn = function(){ bx.classList.toggle("tpl", rt.getAttribute("data-appearance") === "portal" && rt.hasAttribute("data-skin")); };
        if (!d.__tplObs){ d.__tplObs = new MutationObserver(tplOn); d.__tplObs.observe(rt, {attributes: true, attributeFilter: ["data-appearance", "data-skin"]}); }   // follows the student's Appearance choice
        tplOn();
      }
    } catch(e){}
  }
  function thRender(html){                                                   // a hidden copy of the lesson, no scripts, sound or video
    return new Promise(function(res){
      var f = document.createElement("iframe"), done = false;
      f.setAttribute("sandbox", "allow-same-origin"); f.setAttribute("aria-hidden", "true"); f.tabIndex = -1; f.title = "";
      f.style.cssText = "position:fixed;left:-12000px;top:0;width:1024px;height:768px;border:0;visibility:hidden;pointer-events:none";
      function fin(){ if (done) return; done = true; var t = null; try { t = thSense(f.contentDocument); } catch(e){} f.remove(); res(t); }
      f.onload = fin; setTimeout(fin, 6000);
      f.srcdoc = String(html || "").replace(/<(iframe|video|audio|object|embed)\b/gi, "<x-$1").replace(/\sautoplay\b/gi, " data-x");
      document.body.appendChild(f);
    });
  }
  function thNear(a, b){ a = thCol(a); b = thCol(b); return !!(a && b) && Math.abs(a[0] - b[0]) + Math.abs(a[1] - b[1]) + Math.abs(a[2] - b[2]) < 60; }
  function kitN(o){ return o && o.kit ? Object.keys(o.kit.v).length : 0; }
  async function synKitBest(i, t){                                          // a deck opened on its cover shows little of its template:
    var CORE = ["band", "mast", "pbg", "b2-bg", "chip-bg", "note-bg", "kc"], miss = function(o){ return CORE.filter(function(k){ return !(o.kit.v[k]); }).length; };
    var n = kitN(t); if (!t.kit || !miss(t)) return null;                   // borrow from another lesson made with the same template
    var f1 = function(v){ return String(v || "").split(",")[0].replace(/["']/g, "").trim().toLowerCase(); };
    var same = function(o){ if (!kitN(o)) return false; var a = o.kit, b = t.kit;              // same template: same embedded fonts, or same accent
      return (a.fonts.length > 0 && a.fonts.length === b.fonts.length && f1(a.v.fb) === f1(b.v.fb) && f1(a.v.fh) === f1(b.v.fh)) || thNear(o.accent, t.accent); }, best = null;
    for (var k in SYN.th) if (+k !== i && same(SYN.th[k]) && kitN(SYN.th[k]) > kitN(best)) best = SYN.th[k];
    for (var j = 0, tried = 0; j < pages.length && tried < 3 && (!best || miss(best)); j++){
      if (j === i || !synThOk(j) || SYN.th[j]) continue; tried++;
      try { SYN.th[j] = await thRender(await synHtml(j)); } catch(e){}
      if (same(SYN.th[j]) && kitN(SYN.th[j]) > kitN(best)) best = SYN.th[j];
    }
    if (!best || miss(best) >= miss(t)) return null;
    var out = {}; for (var key in best) if (key !== "kit") out[key] = best[key];              // the fuller reading's colours too
    out.kit = {v: Object.assign({}, t.kit.v, best.kit.v), fonts: best.kit.fonts.length >= t.kit.fonts.length ? best.kit.fonts : t.kit.fonts};
    return out;
  }
  async function synThemeSend(win){
    if (!SYNTH || !win || !user) return;
    var i = synThOk(cur) ? cur : synThOk(SYN.last) ? SYN.last : -1;
    if (i < 0) for (var k = 0; k < pages.length; k++) if (synThOk(k)){ i = k; break; }
    if (i < 0) return;
    var t = null, fr = $("frame");
    try { if (i === cur && !fr.hidden && fr.contentDocument && fr.contentDocument.body) t = thSense(fr.contentDocument); } catch(e){}
    if (!t){ try { t = SYN.th[i] || await thRender(await synHtml(i)); } catch(e){} }
    if (!t) return;
    SYN.th[i] = t; SYN.sent = t;
    try { var rt = win.document.documentElement; if (t.hl) rt.style.setProperty("--portal-hl", t.hl); else rt.style.removeProperty("--portal-hl"); } catch(e){}
    thSkin(win, t);
    if (SYNTPL && t.kit) synKitBest(i, t).then(function(b){
      if (!b) return; SYN.sent = b;
      try { var rt2 = win.document.documentElement; if (b.hl) rt2.style.setProperty("--portal-hl", b.hl); else rt2.style.removeProperty("--portal-hl"); } catch(e){}
      try { if (win.SYNAPSE && typeof win.SYNAPSE.setTheme === "function") win.SYNAPSE.setTheme(b); } catch(e){}
      thSkin(win, b);
    });
    try { if (win.SYNAPSE && typeof win.SYNAPSE.setTheme === "function"){ win.SYNAPSE.setTheme(t); return; } } catch(e){}
    try { win.postMessage({type: "SYNAPSE_THEME", source: "handout", handoutTheme: t}, "*"); } catch(e){}
  }
  window.addEventListener("message", function(e){
    var d = e.data; if (!d || typeof d !== "object" || d.type !== "SYNAPSE_THEME_REQUEST") return;
    if (e.source === $("synFrame").contentWindow || e.source === $("frame").contentWindow) synThemeSend(e.source);
  });
  $("synFrame").addEventListener("load", function(){ if (this.dataset.who) synThemeSend(this.contentWindow); });
  $("synBtn").onclick = synOpen;
  $("synX").onclick = function(){ $("synBox").hidden = true; };
  $("synFocus").onclick = function(){ if (PORTAL_SYN.focus) PORTAL_SYN.focus(); };
  setInterval(function(){ if (CB && !$("synBox").hidden) $("synBox").hidden = true; if (user && SYNHTML && !SYN.m && !SYN.busy && !$("synBox").hidden) synManifest(); }, 1500);
  function synStart(){
    $("synBtn").hidden = !SYNHTML; $("synBtn").innerHTML = ic("brain");
    if (!SYNHTML) return;
    var f = $("synFrame"); f.dataset.who = ""; f.srcdoc = "";
  }
  window.addEventListener("message", function(e){
    var d = e.data; if (!d || typeof d !== "object" || !user) return;
    var f = $("frame"); if (!f || e.source !== f.contentWindow) return;
    if (d.type === "SYNAPSE_READY"){
      (SYN.m ? Promise.resolve(SYN.m) : SYN.busy || (SYN.busy = synBuild())).then(function(m){
        SYN.busy = null; SYN.m = m;
        try { e.source.postMessage({type: "SYNAPSE_MANIFEST", manifest: m, scope: D.id + ":" + user.sn, portal: {title: D.title || "", focus: !!$("fmBtn") && !$("fmBtn").hidden}}, "*"); } catch(x){}
      }, function(){ SYN.busy = null; });
    } else if (d.type === "SYNAPSE_OPEN" && typeof d.item === "number" && pages[d.item]){ show(d.item); }
    else if (d.type === "SYNAPSE_FOCUS"){ if ($("fmBtn") && !$("fmBtn").hidden) $("fmBtn").click(); }
  });

  // ---------- time of day: a subtle morning / afternoon / evening look; a rooster at sunrise and an owl at evening ----------
  // Built-in time-of-day sounds, made with the Web Audio API (no sound files): a rooster at sunrise, an owl at evening.
function todSynth(k){
  var AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
  var ac = todSynth.ac || (todSynth.ac = new AC()); if (ac.state === "suspended") try { ac.resume(); } catch(e){}
  var t0 = ac.currentTime + 0.05, out = ac.createGain(); out.gain.value = 0.55; out.connect(ac.destination);
  function noise(st, d, f0, lvl){                                         // a breath of air under the note
    var n = Math.floor(ac.sampleRate * d), b = ac.createBuffer(1, n, ac.sampleRate), x = b.getChannelData(0);
    for (var i = 0; i < n; i++) x[i] = Math.random() * 2 - 1;
    var s = ac.createBufferSource(), f = ac.createBiquadFilter(), g = ac.createGain(); s.buffer = b; f.type = "bandpass"; f.frequency.value = f0; f.Q.value = 1.2;
    g.gain.setValueAtTime(0.0001, st); g.gain.exponentialRampToValueAtTime(lvl, st + 0.05); g.gain.exponentialRampToValueAtTime(0.0001, st + d);
    s.connect(f); f.connect(g); g.connect(out); s.start(st); s.stop(st + d);
  }
  if (k === "pm"){                                                        // owl: "hoo … hoo-hoo hoooo"
    [[0, 0.5, 1], [1.0, 0.22, 0.85], [1.3, 0.22, 0.85], [1.62, 0.8, 1]].forEach(function(n){
      var st = t0 + n[0], d = n[1], o = ac.createOscillator(), o2 = ac.createOscillator(), g = ac.createGain(), f = ac.createBiquadFilter();
      o.type = "sine"; o2.type = "triangle";
      [o, o2].forEach(function(x, j){ var m = j ? 2 : 1; x.frequency.setValueAtTime(395 * m, st); x.frequency.linearRampToValueAtTime(430 * m, st + d * 0.25); x.frequency.exponentialRampToValueAtTime(350 * m, st + d); });
      var g2 = ac.createGain(); g2.gain.value = 0.12; o2.connect(g2); g2.connect(f);
      g.gain.setValueAtTime(0.0001, st); g.gain.exponentialRampToValueAtTime(0.4 * n[2], st + 0.07); g.gain.setValueAtTime(0.4 * n[2], st + d * 0.55); g.gain.exponentialRampToValueAtTime(0.0001, st + d);
      f.type = "lowpass"; f.frequency.value = 1100; o.connect(f); f.connect(g); g.connect(out);
      o.start(st); o2.start(st); o.stop(st + d + 0.05); o2.stop(st + d + 0.05);
      noise(st, d, 420, 0.025);
    });
    return;
  }
  // rooster: "cock-a-doodle-doooo" — a bright, buzzy voice (sawtooth through two vowel-like resonances), rising then falling
  [[0, 0.14, 520, 640, 10], [0.18, 0.12, 660, 760, 12], [0.33, 0.15, 740, 840, 14], [0.52, 0.95, 940, 660, 26]].forEach(function(sg){
    var st = t0 + sg[0], d = sg[1], o = ac.createOscillator(); o.type = "sawtooth";
    o.frequency.setValueAtTime(sg[2], st); o.frequency.linearRampToValueAtTime(sg[3] * 1.06, st + d * 0.3); o.frequency.linearRampToValueAtTime(sg[3], st + d);
    var vib = ac.createOscillator(), vg = ac.createGain(); vib.frequency.value = 26; vg.gain.value = sg[4]; vib.connect(vg); vg.connect(o.frequency);
    var f1 = ac.createBiquadFilter(), f2 = ac.createBiquadFilter(), hp = ac.createBiquadFilter(), g = ac.createGain();
    f1.type = "bandpass"; f1.frequency.value = 1250; f1.Q.value = 2.5; f2.type = "bandpass"; f2.frequency.value = 2700; f2.Q.value = 3.5; hp.type = "highpass"; hp.frequency.value = 400;
    g.gain.setValueAtTime(0.0001, st); g.gain.exponentialRampToValueAtTime(0.6, st + 0.025); g.gain.setValueAtTime(0.6, st + d * 0.75); g.gain.exponentialRampToValueAtTime(0.0001, st + d);
    o.connect(hp); hp.connect(f1); hp.connect(f2); f1.connect(g); f2.connect(g); g.connect(out);
    o.start(st); vib.start(st); o.stop(st + d + 0.05); vib.stop(st + d + 0.05);
    noise(st, d, 2200, 0.04);
  });
}

  var TODS = {last: null, at: ""};
  function todCfg(){ var t = D.tod || {}; return {on: t.on !== false, snd: !!t.snd, sun: t.sun || "06:00", eve: t.eve || "18:00", am: t.am || "", pm: t.pm || ""}; }
  function todPref(k, v){ var key = "portal-tod:" + D.id + ":" + (user ? user.sn : ""), o = {}; try { o = JSON.parse(localStorage.getItem(key) || "{}") || {}; } catch(e){}
    if (v === undefined) return o[k]; o[k] = v; try { localStorage.setItem(key, JSON.stringify(o)); } catch(e){} }
  function todLookOn(){ var p = todPref("look"); return p == null ? todCfg().on : !!p; }
  function todSndOn(){ var p = todPref("snd"); return p == null ? todCfg().snd : !!p; }
  function todHM(){ var d = new Date(); return String(d.getHours()).padStart(2, "0") + ":" + String(d.getMinutes()).padStart(2, "0"); }
  function todPeriod(hm){ var c = todCfg(); return hm >= c.sun && hm < "12:00" ? "am" : hm >= "12:00" && hm < c.eve ? "pm" : "ev"; }
  function todApply(){
    var r = document.documentElement;
    if (user && todLookOn()) r.setAttribute("data-tod", todPeriod(todHM())); else r.removeAttribute("data-tod");
  }
  function todCheck(){                                                     // crossing sunrise or evening while signed in
    if (!user) return;
    var hm = todHM(), c = todCfg(), prev = TODS.at; TODS.at = hm; todApply();
    if (!prev || prev === hm) return;
    var hit = prev < c.sun && hm >= c.sun ? "am" : prev < c.eve && hm >= c.eve ? "pm" : "";
    if (!hit || CB || !todSndOn()) return;
    if (c[hit]){ try { var a = new Audio(c[hit]); a.volume = 0.8; a.play().catch(function(){}); } catch(e){} } else todSynth(hit);
    toast(hit === "am" ? "🌅 Good morning — the sun is up." : "🦉 Evening has come. Remember to rest well.");
  }
  function todStart(){
    var c = todCfg(); $("todBox").hidden = !c.on && !c.snd;
    $("todLook").checked = todLookOn(); $("todSnd").checked = todSndOn();
    TODS.at = todHM(); todApply();
  }
  $("todLook").addEventListener("change", function(){ todPref("look", this.checked ? 1 : 0); todApply(); });
  $("todSnd").addEventListener("change", function(){ todPref("snd", this.checked ? 1 : 0); if (this.checked){ var k = todPeriod(todHM()) === "ev" ? "pm" : "am", c = todCfg(); if (c[k]){ try { new Audio(c[k]).play().catch(function(){}); } catch(e){} } else todSynth(k); } });
  setInterval(todCheck, 20000);

  // ---------- online updates: checking, downloading, the update bar ----------
  var UPS = {busy: false};
  function upBar(html, acts, pct){
    var b = $("upBar"); if (!html){ b.hidden = true; return; }
    $("upT").innerHTML = html; $("upPw").hidden = pct == null; if (pct != null) $("upP").style.width = Math.round(pct * 100) + "%";
    var a = $("upA"); a.innerHTML = "";
    (acts || []).forEach(function(x, k){ var bt = document.createElement("button"); bt.type = "button"; bt.textContent = x[0]; if (k) bt.className = "l"; bt.onclick = x[1]; a.appendChild(bt); });
    b.hidden = false;
  }
  function upNote(m){ return m.note ? String(m.note).replace(/[.\s]+$/, "") : ""; }
  function upHave(){ var f = upFlag(); return Math.max(Date.parse(D.built) || 0, f ? Date.parse(f.built) || 0 : 0); }
  function upWhen(iso){ try { return new Date(iso).toLocaleDateString(undefined, {month: "short", day: "numeric", year: "numeric"}); } catch(e){ return ""; } }
  function upLine(){
    var l = $("upLine"); if (!l) return;
    if (!upCan()){ l.hidden = true; return; }
    l.hidden = false;
    l.innerHTML = upOn() ? (window.__portalUpd ? "Updated online to the version of " + esc(upWhen(D.built)) + " · " : "Updates itself when you're online · ") + '<a id="upOff">Turn off on this computer</a>'
                         : 'Online updates are off on this computer · <a id="upOff">Turn on</a>';
    $("upOff").onclick = function(){
      if (upOn()){ upLs(UPOFF, "1"); if (window.__portalUpd){ upClear().then(function(){ location.reload(); }); return; } upClear(); }
      else upLs(UPOFF, null);
      upLine();
    };
  }
  function upStart(){
    if (!upCan()) return;
    var f = upFlag();
    if (f && (Date.parse(D.built) || 0) > (Date.parse(f.built) || 0)) upClear();   // this file is newer than the kept update: drop the update
    if (upOn()) setTimeout(function(){ upCheck(false); }, 2500);
  }
  function upCheck(manual){
    if (!upOn() || UPS.busy || !user || navigator.onLine === false) return;
    UPS.busy = true;
    fetch(D.upd + "latest.json?t=" + Date.now(), {cache: "no-store"}).then(function(r){ return r.ok ? r.json() : null; }).then(function(m){
      UPS.busy = false;
      if (!m || m.id !== D.id || !Array.isArray(m.parts) || !m.parts.length || !(Date.parse(m.built) > upHave())) return;
      if (m.size > UP_AUTO && !manual){
        upBar("<b>A new version of this portal is available</b> (" + size(m.size) + ")" + (m.note ? ": " + esc(upNote(m)) : "") + ". Download it now? It replaces this version on this computer.",
          [["Download now", function(){ upGet(m); }], ["Later", function(){ upBar(""); }]]);
        return;
      }
      upGet(m);
    }).catch(function(){ UPS.busy = false; });
  }
  async function upHash(buf){ var h = new Uint8Array(await crypto.subtle.digest("SHA-256", buf)); return Array.prototype.map.call(h, function(b){ return (b < 16 ? "0" : "") + b.toString(16); }).join(""); }
  async function upGet(m){
    if (UPS.busy && UPS.m === m) return;
    UPS.busy = true; UPS.m = m;
    var got = [], done = 0, blob = null;
    try {
      for (var k = 0; k < m.parts.length; k++){
        var pt = m.parts[k];
        upBar("Downloading the new version of this portal… " + Math.round(done / m.size * 100) + "%", null, done / m.size);
        var r = await fetch(D.upd + encodeURIComponent(pt.n) + "?v=" + encodeURIComponent(m.built), {cache: "no-store"});
        if (!r.ok) throw new Error("missing part");
        var buf = await r.arrayBuffer();
        if (buf.byteLength !== pt.s || await upHash(buf) !== pt.h) throw new Error("check");
        got.push(buf); done += buf.byteLength;
      }
      blob = new Blob(got, {type: "text/html"}); got = null;
      var head = await blob.slice(0, 2000000).text();
      if (head.indexOf('"id":"' + D.id + '"') < 0 || head.indexOf('id="portal-data"') < 0) throw new Error("check");
      await upPutRec({built: m.built, blob: blob, title: m.title || "", note: m.note || "", size: blob.size, name: m.name || ""});
      upLs(UPK, JSON.stringify({built: m.built}));
      upBar("<b>New version ready</b>" + (m.note ? " — " + esc(upNote(m)) : "") + ". It opens the next time you open this portal.",
        [["Restart now", function(){ upRestart(); }], ["Later", function(){ upBar(""); }]]);
    } catch(e){
      try { console.warn("portal update:", e); } catch(x){}
      if (blob && !/check/.test(String(e && e.message))){                  // downloaded, but this browser can't keep it: save it as a file instead
        var url = URL.createObjectURL(blob);
        upBar("<b>A new version of this portal is ready</b>, but this browser can't keep it. Save it and use it in place of this file (same name, same folder).",
          [["Save the new version", function(){ var a = document.createElement("a"); a.href = url; a.download = m.name || "portal.html"; document.body.appendChild(a); a.click(); a.remove(); }], ["Later", function(){ upBar(""); }]]);
      } else upBar("");                                                     // try again next time
    } finally { UPS.busy = false; }
  }
  function upRestart(){                                                    // reopen this file: the new version opens, still signed in
    var tag = psTag();
    try { $("out").onclick(); } catch(e){}
    try { history.replaceState(null, "", location.href.split("#")[0] + tag); } catch(e){}
    location.reload();
  }
  window.addEventListener("online", function(){ if (user) setTimeout(function(){ upCheck(false); }, 1500); });
  upLine();

  // ---------- shortcuts to other portals ----------
  // A computer opens the other portal file from the same folder (new tab); a phone opens it in the Portal Opener;
  // an online (app) portal opens its web address. The student is signed in automatically when the other portal allows it.
  function psIcon(p){ return p.ip ? '<svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="' + esc(p.ip) + '"/></svg>' : ic("portal"); }
  function psOpener(){ try { return window.parent !== window && parent.PORTAL_OPENER && typeof parent.PORTAL_OPENER.portal === "function" ? parent.PORTAL_OPENER : null; } catch(e){ return null; } }
  function psWho(){ return user ? {sn: user.sn, em: user.em} : null; }
  function psTag(){ var w = psWho(); return w ? "#signin=" + encodeURIComponent(btoa(unescape(encodeURIComponent(JSON.stringify(w))))) : ""; }
  function psHint(p){
    if (psOpener()) return "It opens here in the Portal Opener. If it isn't on this phone yet, you'll be asked to choose its file once.";
    if (location.protocol === "file:" && p.fn) return "It opens in a new tab. The first time, if it can't find “" + p.fn + "” on its own, you'll be asked to choose that file wherever you saved it" + (window.showOpenFilePicker ? " — this browser then remembers it." : ".");
    if (p.u) return "It opens " + p.u + " in a new tab.";
    return "Open it the way you usually open your portals.";
  }
  function psShow(i, html){ if (cur === i || !html) return psMsg(i, html); Promise.resolve(show(i)).then(function(){ psMsg(i, html); }); }   // from the top button: go to the shortcut's page first
  function psMsg(i, html){ var m = $("psMsg"); if (!m || cur !== i) { if (html) toast(html.replace(/<[^>]+>/g, "")); return; } m.hidden = !html; m.innerHTML = html || ""; }
  function psProbe(name, cb){                                               // is that file next to this one? (a page loaded as a script: it loads, then fails harmlessly)
    var s = document.createElement("script"), done = false;
    function fin(ok){ if (done) return; done = true; s.remove(); window.removeEventListener("error", hush, true); cb(ok); }
    function hush(e){ if (e && e.filename && e.filename.indexOf(encodeURIComponent(name)) > -1){ e.preventDefault(); e.stopImmediatePropagation(); } }
    window.addEventListener("error", hush, true);
    s.onload = function(){ fin(true); }; s.onerror = function(){ fin(false); }; setTimeout(function(){ fin(true); }, 15000);
    s.src = encodeURIComponent(name); document.head.appendChild(s);
  }
  function psGoFile(p){ var w = window.open(encodeURIComponent(p.fn) + psTag(), "_blank"); if (!w) location.href = encodeURIComponent(p.fn) + psTag(); }
  // Not in the same folder? The student chooses the file once, from anywhere (Downloads, a renamed copy…).
  // Chrome and Edge remember that file (only where it is, never a copy), so later it opens straight away.
  function psKey(p){ return p.pid ? "pid:" + p.pid : "fn:" + (p.fn || p.t); }
  function psDb(cb){ try { var q = indexedDB.open("portal-shortcuts", 1); q.onupgradeneeded = function(){ q.result.createObjectStore("files"); }; q.onsuccess = function(){ cb(q.result); }; q.onerror = function(){ cb(null); }; } catch(e){ cb(null); } }
  var PS_MEM = {};
  function psStore(p, h, cb){
    var k = psKey(p);
    if (h === undefined && PS_MEM[k]) return cb && cb(PS_MEM[k]);
    if (h !== undefined){ if (h) PS_MEM[k] = h; else delete PS_MEM[k]; }
    psDb(function(db){ if (!db) return cb && cb(null);
    try { var os = db.transaction("files", h === undefined ? "readonly" : "readwrite").objectStore("files"), r = h === undefined ? os.get(psKey(p)) : (h ? os.put(h, psKey(p)) : os.delete(psKey(p)));
      r.onsuccess = function(){ cb && cb(h === undefined ? r.result || null : null); }; r.onerror = function(){ cb && cb(null); }; } catch(e){ cb && cb(null); } }); }
  var PS_READY = null;
  function psLaunch(i, text){                                                // opens the chosen portal in a new tab, signed in
    var p = pages[i], w = window.open("", "_blank");
    if (!w){ PS_READY = {i: i, text: text}; $("toast").hidden = true; psShow(i, "<b>" + esc(p.t) + " is ready.</b><br>" + '<button type="button" class="btn sm" data-ps-ready>' + ic("ext") + "Open " + esc(p.t) + "</button>"); return; }
    PS_READY = null; psMsg(i, "");
    w.document.open(); var tag = psTag(); if (tag) try { w.history.replaceState(null, "", tag); } catch(e){}
    w.document.write(text); w.document.close(); $("toast").hidden = true;
  }
  function psGot(i, f, h){
    var p = pages[i]; toast("Opening " + p.t + "…");
    return f.text().then(function(t){
      var head = t.slice(0, 1600000), at = head.indexOf('id="portal-data"'), pid = at > -1 ? ((/^[^>]*>\s*\{\s*"v"\s*:\s*\d+\s*,\s*"id"\s*:\s*"([^"]+)"/.exec(head.slice(at)) || [])[1] || "") : "";
      if (!/<html|<!doctype/i.test(head.slice(0, 2000))){ $("toast").hidden = true; psAsk(i, "“" + esc(f.name) + "” isn't a portal file. Choose <b>" + esc(p.fn) + "</b>."); return; }
      if (p.pid && pid && pid !== p.pid){ var tt = ((/<title>([^<]*)<\/title>/i.exec(head) || [])[1] || f.name).trim(); $("toast").hidden = true; psAsk(i, "That file is <b>" + tt + "</b>, a different portal. Choose <b>" + esc(p.t) + "</b> (" + esc(p.fn) + ")."); return; }
      if (h) psStore(p, h);
      psLaunch(i, t);
    });
  }
  function psPick(i){
    var p = pages[i];
    if (window.showOpenFilePicker){
      window.showOpenFilePicker({types: [{description: "Portal file", accept: {"text/html": [".html", ".htm"]}}]}).then(function(hs){ return hs[0].getFile().then(function(f){ return psGot(i, f, hs[0]); }); })
        .catch(function(e){ if (!e || e.name !== "AbortError") psPickInput(i); });
      return;
    }
    psPickInput(i);
  }
  function psPickInput(i){ var inp = document.createElement("input"); inp.type = "file"; inp.accept = ".html,.htm,text/html"; inp.onchange = function(){ if (inp.files[0]) psGot(i, inp.files[0], null); }; inp.click(); }
  function psAsk(i, why){
    var p = pages[i];
    psShow(i, (why ? why + "<br>" : "<b>Where is " + esc(p.t) + "?</b> It isn't next to this portal, so choose its file once — wherever you saved it (Downloads, Documents…), even if it was renamed.<br>") +
      '<button type="button" class="btn sm" data-ps-pick="' + i + '">Choose the file</button>' +
      '<span class="pssub">' + (window.showOpenFilePicker ? "This browser remembers where it is, so next time it opens straight away." : "Tip: keep both portal files in one folder and the shortcut opens it straight away.") + " Your instructor's file name: <b>" + esc(p.fn) + "</b></span>");
  }
  function psOpen(i){
    var p = pages[i]; if (!p) return;
    var op = psOpener();
    if (op){ op.portal({pid: p.pid || "", title: p.pt || p.t, name: p.fn || ""}, psWho()); return; }
    if (location.protocol === "file:" && p.fn){
      psMsg(i, ""); toast("Opening " + p.t + "…");
      psProbe(p.fn, function(ok){
        if (ok){ psGoFile(p); return; }                                       // same folder: open the file itself
        psStore(p, undefined, function(h){                                    // a file chosen before (Chrome, Edge)
          if (!h || !h.getFile){ $("toast").hidden = true; psAsk(i); return; }
          Promise.resolve(h.queryPermission ? h.queryPermission({mode: "read"}) : "granted")
            .then(function(st){ return st === "granted" ? st : h.requestPermission({mode: "read"}); })
            .then(function(st){ if (st !== "granted") throw {name: "perm"}; return h.getFile(); })
            .then(function(f){ return psGot(i, f, null); })
            .catch(function(e){ $("toast").hidden = true;
              if (e && e.name === "perm"){ psAsk(i, "<b>Allow the browser to open " + esc(p.t) + "</b> when it asks, or choose the file again."); return; }
              psStore(p, null); psAsk(i, "<b>" + esc(p.t) + " was moved, renamed or deleted since last time.</b> Choose its file again."); });
        });
      });
      return;
    }
    if (p.u){ window.open(p.u, "_blank", "noopener"); return; }
    psMsg(i, "Open <b>" + esc(p.t) + "</b> the way you usually open your portals" + (location.protocol === "blob:" ? " — go back to <b>My portals</b> in the Portal Opener." : "."));
  }
  function psView(i){
    var p = pages[i], v = $("view"); v.hidden = false; $("wm").classList.add("onview");
    v.innerHTML = '<div class="psv"><div class="pscard"><span class="psic">' + psIcon(p) + '</span><div><div class="psk">Another portal</div><h2>' + esc(p.t) + '</h2>' + (p.d ? '<p>' + esc(p.d) + '</p>' : "") + '</div></div>' +
      '<button type="button" class="btn psgo" id="psGo">' + ic("ext") + 'Open ' + esc(p.t) + '</button>' +
      '<p class="pshint">' + esc(psHint(p)) + (p.pid ? " You'll be signed in with the same student number and email." : "") + '</p><div class="psmsg" id="psMsg" hidden></div></div>';
    $("psGo").onclick = function(){ psOpen(i); };
  }
  document.addEventListener("click", function(e){
    var b = e.target.closest && e.target.closest("[data-ps-pick],[data-ps-ready]"); if (!b) return;
    if (b.hasAttribute("data-ps-pick")) psPick(+b.dataset.psPick);
    else if (PS_READY) psLaunch(PS_READY.i, PS_READY.text);
  });
  function psPinsPaint(){
    var box = $("psPins"), pins = []; pages.forEach(function(p, i){ if (p.k === "portal" && p.pin && !notYet(p)) pins.push(i); });
    pins = pins.slice(0, 2); box.hidden = !pins.length;
    box.innerHTML = pins.map(function(i){ var p = pages[i]; return '<button type="button" class="btn ghost" data-ps-pin="' + i + '" title="Open ' + esc(p.t) + '">' + psIcon(p) + '<span>' + esc(p.t) + '</span></button>'; }).join("");
  }
  $("psPins").addEventListener("click", function(e){ var b = e.target.closest("[data-ps-pin]"); if (b) psOpen(+b.dataset.psPin); });

  // ---------- Focus mode: study techniques with the strongest evidence, inside a time format the student picks ----------
  // Only high-utility techniques (Dunlosky et al., 2013): retrieval practice, practice questions, distributed (spaced) practice.
  // The time formats (Pomodoro, 90-minute blocks, question blocks) only manage focus; each block tells the student what to do inside it.
  var FM_IV = [1, 3, 7, 14, 30];                                             // spaced-review intervals, in days
  var FM_MODES = {
    pomo: {name: "Learn–Recall Pomodoro", short: "25 min focus · 5 min break", tag: "Pomodoro + active recall",
      what: "Four 25-minute focus blocks with 5-minute breaks, then a 20-minute break. Each block has one job: learn, recall, practise, fix the gaps.",
      why: "Retrieval practice — recalling from memory instead of rereading — is one of the most robust findings in learning science (the testing effect; Roediger & Karpicke, 2006). The timer only keeps you focused; the recall inside it is what makes you learn.",
      best: "Starting dense material when it's hard to get going.",
      how: ["<b>Learn</b> (25 min): read or watch one section of a handout or video.", "<b>Recall</b> (25 min): the Recall pad opens. Close the material, write everything you remember, then check it against the source and mark the gaps.", "<b>Practise</b> (25 min): answer that section's quick checks or questions in practice mode, and read every rationale.", "<b>Fix the gaps</b> (25 min): turn what you missed into flashcards or short notes."],
      ph: [{k: "f", t: "Learn", m: 25, d: "Read or watch one section. Stay on that section only."}, {k: "b", t: "Break", m: 5}, {k: "f", t: "Recall", m: 25, pad: 1, d: "Close the material. Write everything you remember on the Recall pad, then check it against the source and mark the gaps."}, {k: "b", t: "Break", m: 5},
           {k: "f", t: "Practise", m: 25, d: "Answer the quick checks or practice questions for this section (practice mode). Read every rationale, including the ones you got right."}, {k: "b", t: "Break", m: 5}, {k: "f", t: "Fix gaps", m: 25, pad: 1, d: "Turn what you missed into flashcards or short notes on the Recall pad."}, {k: "b", t: "Long break", m: 20, d: "A real rest: stand up, move, drink water."}]},
    deep: {name: "Deep Block", short: "90 min: study · recall · check, then rest", tag: "90-minute block + recall from memory",
      what: "One 90-minute block for a hard mechanism: 60 minutes of study, 20 minutes recalling it from memory, 10 minutes checking — then a real 20-minute rest.",
      why: "Drawing and explaining a mechanism from memory is retrieval practice, which beats rereading (Dunlosky et al., 2013). The long block suits integrating a whole system; the recall at the end is what fixes it in memory.",
      best: "Hard mechanisms and whole systems (e.g. the cardiac cycle, renal physiology), at your sharpest time of day.",
      how: ["<b>Study</b> (60 min): one mechanism or topic, in depth.", "<b>Recall</b> (20 min): close the material, draw or write it from memory on the Recall pad, and explain it aloud as if teaching it.", "<b>Check</b> (10 min): open the material again, compare, and correct your errors.", "<b>Rest</b> (20 min): away from the screen before the next block."],
      ph: [{k: "f", t: "Study", m: 60, d: "Study one mechanism or topic in depth."}, {k: "f", t: "Recall", m: 20, pad: 1, d: "Close the material. Draw or write it from memory on the Recall pad and explain it aloud, as if teaching it."},
           {k: "f", t: "Check", m: 10, pad: 1, d: "Open the material again. Compare with what you wrote and correct the errors."}, {k: "b", t: "Rest", m: 20, d: "A real rest: away from the screen, move, drink water."}]},
    qb: {name: "Question Block", short: "50 min questions · 10 min break", tag: "Practice questions + error log",
      what: "Timed blocks of practice questions, then reviewing every rationale and logging why you missed each one.",
      why: "Practice testing is among the highest-utility techniques (Dunlosky et al., 2013): answering questions strengthens memory and trains you to apply it to cases. An error log turns each miss into something to review.",
      best: "After you've covered a topic; before quizzes and exams.",
      how: ["<b>Questions</b> (50 min): answer the portal's quick checks and mock tests in <b>practice mode</b>, mixed across topics if you can.", "Review every rationale — including the ones you got right.", "On the Recall pad, note each miss and why: knowledge gap, misread, or reasoning error.", "<b>Break</b> (10 min), then another block — or review your notes on a 1–3–7 day schedule."],
      ph: [{k: "f", t: "Questions", m: 50, pad: 1, d: "Answer quick checks and mock tests in practice mode. Review every rationale; log each miss and why on the Recall pad."}, {k: "b", t: "Break", m: 10}]},
    sp: {name: "Spaced Review", short: "Review what's due today · 25 min", tag: "Spaced repetition",
      what: "Review materials at widening intervals — 1, 3, 7, 14 and 30 days after you first study them. The portal keeps the schedule and lists what's due.",
      why: "Spaced (distributed) practice has the strongest evidence of any time-based method (Cepeda et al., 2006; Dunlosky et al., 2013). Reviewing just as you start to forget makes memories last.",
      best: "Volume-heavy content you must keep: drugs, organisms, anatomy, normal values.",
      how: ["The portal notes the day you first open each material.", "Each day, open Focus mode: <b>Due today</b> lists what to review.", "Tap <b>Review</b>: recall it first on the Recall pad, then open the material and check.", "Mark it <b>Done</b> (next review further out) or <b>Again tomorrow</b>."],
      ph: [{k: "f", t: "Review", m: 25, pad: 1, d: "Pick a material that's due. Recall it first on the Recall pad, then open it to check, then mark it done."}, {k: "b", t: "Break", m: 5}]},
    fey: {name: "Feynman Technique", short: "Explain it simply · find the gaps · 55 min", tag: "Self-explanation + recall", ev: "moderate",
      what: "Study one concept, then explain it from memory in plain words as if teaching a classmate. Where the explanation breaks down is exactly what to go back to.",
      why: "Explaining in your own words is self-explanation, which has moderate evidence (Dunlosky et al., 2013); doing it from memory adds retrieval practice. It works best for mechanisms and cause-and-effect, less for lists to memorise.",
      best: "Mechanisms and concepts you can recite but can't yet explain — e.g. why the resting membrane potential is negative.",
      how: ["<b>Study</b> (20 min): one concept only.", "<b>Explain</b> (15 min): the Recall pad opens. Without the material, write the explanation as if teaching a first-year student — short sentences, no jargon you can't define.", "<b>Find the gaps</b> (10 min): open the material and mark every place where you got stuck, were vague or were wrong. Fix them.", "<b>Simplify</b> (5 min): rewrite the explanation shorter, with one analogy or example. Then take a break."],
      ph: [{k: "f", t: "Study", m: 20, d: "Study one concept only."}, {k: "f", t: "Explain", m: 15, pad: 1, d: "Without the material, explain the concept in plain words on the Recall pad, as if teaching a first-year student."},
           {k: "f", t: "Find gaps", m: 10, pad: 1, d: "Open the material. Mark where your explanation was stuck, vague or wrong, and fix it."}, {k: "f", t: "Simplify", m: 5, pad: 1, d: "Rewrite the explanation shorter, with one analogy or example."}, {k: "b", t: "Break", m: 5}]},
    ei: {name: "Elaborative Interrogation", short: "Ask why and how · 50 min", tag: "Why-questions", ev: "moderate",
      what: "While you read, stop at each key fact and ask “Why is this true?” or “How does this work?” — then answer it, connecting the fact to what you already know.",
      why: "Elaborative interrogation has moderate evidence (Dunlosky et al., 2013): explaining why a fact is true links it to existing knowledge, so it is easier to remember and to use. It helps most when you already know a little about the topic.",
      best: "Fact-heavy sections (normal values, drug effects, histology features) where you'd otherwise memorise without understanding.",
      how: ["<b>Read</b> (20 min): read one section. At each key fact, write a why- or how-question on the Recall pad — don't answer yet.", "<b>Answer</b> (15 min): close the material and answer your questions from what you know.", "<b>Check</b> (10 min): open the material, correct your answers, and note the ones you couldn't explain."],
      ph: [{k: "f", t: "Read + ask", m: 20, pad: 1, d: "Read one section. At each key fact, write a why- or how-question on the Recall pad."}, {k: "f", t: "Answer", m: 15, pad: 1, d: "Close the material and answer your why- and how-questions from what you know."},
           {k: "f", t: "Check", m: 10, d: "Open the material, correct your answers, and note the ones you couldn't explain."}, {k: "b", t: "Break", m: 5}]},
    il: {name: "Interleaving", short: "Mix 2–3 topics · 65 min", tag: "Mixed practice", ev: "moderate",
      what: "Practise two or three related topics in one session, switching between them, instead of finishing one before starting the next. The portal suggests a mix from your materials.",
      why: "Interleaved practice has moderate evidence (Dunlosky et al., 2013) and strong results for telling similar things apart — tissues, organisms, ECG patterns, similar drugs. It feels harder than blocked practice; that difficulty is what helps.",
      best: "Topics that are easy to confuse, once you've studied each one at least once.",
      how: ["Pick two or three related materials (the portal suggests a mix below).", "<b>Mixed set</b> (20 min): alternate between them every few questions or every few minutes — A, B, C, A, B, C.", "<b>Compare</b> (10 min): on the Recall pad, write how the topics differ and how you tell them apart.", "Break, then a second mixed set in a different order."],
      ph: [{k: "f", t: "Mixed set", m: 20, d: "Alternate between your 2–3 topics every few questions or minutes: A, B, C, A, B, C."}, {k: "f", t: "Compare", m: 10, pad: 1, d: "On the Recall pad, write how the topics differ and how you tell them apart."}, {k: "b", t: "Break", m: 5},
           {k: "f", t: "Mixed set", m: 20, d: "A second mixed set, in a different order: C, A, B…"}, {k: "f", t: "Compare", m: 5, pad: 1, d: "Add anything new to your comparison."}, {k: "b", t: "Break", m: 5}]}
  };
  var FM = null, FMT = 0, fmAC = null;
  function fmOn(){ return D.fm !== false; }
  function fmKey(){ return "portal-focus:" + D.id + ":" + normSN(user.sn); }
  function fmLoad(){ try { return JSON.parse(localStorage.getItem(fmKey()) || "null"); } catch(e){ return null; } }
  function fmSave(){ if (!FM || !user) return; try { localStorage.setItem(fmKey(), JSON.stringify(FM)); } catch(e){} }
  function fmDay(off){ var d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() + (off || 0)); return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0"); }
  function fmMs(x){ x = Math.max(0, Math.round(x / 1000)); return Math.floor(x / 60) + ":" + String(x % 60).padStart(2, "0"); }
  function fmStart(){
    clearInterval(FMT);
    $("fmBtn").hidden = !fmOn(); $("fmBtn").innerHTML = ic("target");
    if (!fmOn()){ FM = null; $("fmChip").hidden = true; return; }
    FM = fmLoad() || {};
    if (FM.keep == null) FM.keep = D.fmKeep !== "reset";
    if (FM.snd == null) FM.snd = true;
    FM.rev = FM.rev || {}; FM.pad = FM.pad || ""; FM.cal = FM.cal || {}; FM.edit = null; FM._mix = null;
    if (FM.mode && !FM_MODES[FM.mode]) FM.mode = "";
    if (FM.run && FM.run.end){ FM.run.left = Math.max(0, FM.run.end - Date.now()); FM.run.end = 0; }   // never runs while signed out
    fmSave(); fmChip(); fmDot(); fmNavPlan();
    var tl = fmToday().filter(function(x){ return !x.done; });
    if (tl.length) setTimeout(function(){ if (user) toast("Today’s plan: " + tl.slice(0, 2).map(fmItemTxt).join(" · ") + (tl.length > 2 ? " and " + (tl.length - 2) + " more" : "") + ". It’s at the top of the contents."); }, 3200);
    if (FM.mode && FM.run) setTimeout(function(){ if (user) toast("Focus mode: " + FM_MODES[FM.mode].name + " — paused at " + fmPh().t + " (" + fmMs(FM.run.left) + " left). Tap the timer at the top to resume."); }, 1600);
    FMT = setInterval(fmTick, 1000);
  }
  function fmSignOut(){
    clearInterval(FMT); $("fmChip").hidden = true; $("fmBox").hidden = true; $("fmPad").hidden = true;
    if (!FM || !user) { FM = null; return; }
    if (FM.keep){ if (FM.run && FM.run.end){ FM.run.left = Math.max(0, FM.run.end - Date.now()); FM.run.end = 0; } }
    else { FM.mode = ""; FM.run = null; FM.pad = ""; }                     // reset the study mode (the review schedule, plan and calendar are kept)
    fmSave(); FM = null;
  }
  function fmPh(){ var m = FM && FM_MODES[FM.mode]; return m && FM.run ? m.ph[FM.run.i % m.ph.length] : null; }
  function fmLeft(){ return !FM || !FM.run ? 0 : FM.run.end ? Math.max(0, FM.run.end - Date.now()) : FM.run.left || 0; }
  function fmBeep(two){
    if (!FM || !FM.snd || CB) return;
    try {
      fmAC = fmAC || new (window.AudioContext || window.webkitAudioContext)();
      [0, two ? 0.28 : -1].forEach(function(t, n){ if (t < 0) return; var o = fmAC.createOscillator(), g = fmAC.createGain(); o.type = "sine"; o.frequency.value = n ? 784 : 659;
        g.gain.setValueAtTime(0.0001, fmAC.currentTime + t); g.gain.exponentialRampToValueAtTime(0.18, fmAC.currentTime + t + 0.02); g.gain.exponentialRampToValueAtTime(0.0001, fmAC.currentTime + t + 0.6);
        o.connect(g); g.connect(fmAC.destination); o.start(fmAC.currentTime + t); o.stop(fmAC.currentTime + t + 0.65); });
    } catch(e){}
  }
  function fmGo(i, quiet){                                                   // move to phase i and start its clock
    var m = FM_MODES[FM.mode]; FM.run = {i: i, end: Date.now() + m.ph[i % m.ph.length].m * 60000, left: 0};
    var ph = fmPh(); fmSave(); fmChip();
    if (!quiet){
      fmBeep(ph.k === "f");
      if (!CB) toast((ph.k === "f" ? "Focus — " : "") + ph.t + " (" + ph.m + " min)" + (ph.d ? ": " + ph.d : ""));
    }
    if (ph.pad && !CB) fmPadOpen(); else if (ph.k === "b") $("fmPad").hidden = true;
    if (!$("fmBox").hidden) fmPaint();
  }
  function fmTick(){
    if (!FM || !user) return;
    if (CB) $("fmPad").hidden = true;                                       // no notes during closed-book activities
    if (FM.run && FM.run.end && Date.now() >= FM.run.end) fmGo(FM.run.i + 1);
    var dk = fmDay(0); if (dk !== FM._d){ FM._d = dk; fmDot(); fmNavPlan(); }   // a new day: refresh what's due
    if (Date.now() - (FM._r || 0) > 20000){ FM._r = Date.now(); fmRemind(); }
    fmChip();
    if (!$("fmBox").hidden && FM.run) { var c = $("fmClock"); if (c) c.textContent = fmMs(fmLeft()); }
  }
  function fmChip(){
    var c = $("fmChip"), ph = fmPh();
    if (!FM || !FM.mode || !FM.run || !ph){ c.hidden = true; return; }
    c.hidden = false; c.classList.toggle("brk", ph.k === "b");
    $("fmChipT").innerHTML = '<span class="lb">' + esc(ph.t) + ' · </span>' + fmMs(fmLeft());
    $("fmChipT").title = FM_MODES[FM.mode].name + " — " + ph.t + (FM.run.end ? "" : " (paused)") + ". Open Focus mode";
    $("fmChipPP").innerHTML = FM.run.end ? NP_ICO.pause : NP_ICO.play; $("fmChipPP").title = FM.run.end ? "Pause the focus timer" : "Resume the focus timer";
  }
  function fmToggle(){
    if (!FM || !FM.run) return;
    if (FM.run.end){ FM.run.left = Math.max(0, FM.run.end - Date.now()); FM.run.end = 0; }
    else { FM.run.end = Date.now() + (FM.run.left || fmPh().m * 60000); FM.run.left = 0; }
    fmSave(); fmChip(); if (!$("fmBox").hidden) fmPaint();
  }
  function fmSeen(i){                                                        // spaced review: remember when each material was first studied
    if (!FM || !pages[i]) return;
    var p = pages[i]; if (!/^(html|pdf|video|audio|image)$/.test(p.k) || !fmStudyable(p)) return;
    var k = p.sid || p.t;
    if (!FM.rev[k]){ FM.rev[k] = {f: fmDay(0), s: 0, n: fmDay(FM_IV[0])}; fmSave(); fmDot(); }
  }
  function fmDue(){
    if (!FM) return [];
    var today = fmDay(0), out = [];
    pages.forEach(function(p, i){ var r = FM.rev[p.sid || p.t]; if (r && r.n && r.n <= today && fmStudyable(p)) out.push(i); });
    return out;
  }
  function fmDot(){
    var b = $("fmBtn"), d = b.querySelector(".fmdot"), n = FM && FM.mode === "sp" ? fmDue().length : 0;
    if (n && !d){ d = document.createElement("span"); d.className = "fmdot"; b.appendChild(d); }
    if (d){ if (n) d.textContent = n; else d.remove(); }
    b.title = "Focus mode" + (n ? " — " + n + " due for review today" : " — study techniques with the strongest evidence");
  }
  function fmPadOpen(ctx){
    if (CB){ toast("The Recall pad is closed during closed-book activities."); return; }
    var pad = $("fmPad"), ph = fmPh();
    $("fmPadX").innerHTML = ic("close");
    $("fmPadTx").value = FM.pad || "";
    $("fmPadTip").textContent = ctx != null ? "Recall first: write everything you remember about “" + pages[ctx].t + "”. Then open it to check, and mark the gaps." : ph && ph.pad ? ph.d : "Close the material and write everything you remember. Then check it against the source and mark the gaps.";
    $("fmPadT").textContent = ph && ph.pad ? "Recall pad · " + ph.t : "Recall pad";
    $("fmPadFt").innerHTML = ctx != null ? '<button type="button" class="btn sm" data-fm-open="' + ctx + '">Open “' + esc(pages[ctx].t) + '” to check</button>' : "";
    pad.hidden = false; setTimeout(function(){ $("fmPadTx").focus(); }, 50);
  }
  $("fmPadTx").addEventListener("input", function(){ if (FM){ FM.pad = this.value; fmSave(); } });
  $("fmPadClr").onclick = function(){ if (FM && (!FM.pad || confirm("Clear the Recall pad?"))){ FM.pad = ""; $("fmPadTx").value = ""; fmSave(); } };
  $("fmPadX").onclick = function(){ $("fmPad").hidden = true; };
  $("fmPadFt").addEventListener("click", function(e){ var b = e.target.closest("[data-fm-open]"); if (b) show(+b.dataset.fmOpen); });
  function fmPaint(){
    var mode = FM.mode || "", m = FM_MODES[mode], ph = fmPh(), h = "";
    h += '<label class="fmlbl" for="fmSel">Choose a focus mode</label><select id="fmSel"><option value="">Off — no focus mode</option>' +
      Object.keys(FM_MODES).map(function(k){ return '<option value="' + k + '"' + (k === mode ? " selected" : "") + '>' + esc(FM_MODES[k].name + " — " + FM_MODES[k].short) + '</option>'; }).join("") + '</select>';
    if (!m) h += '<div class="fmcard"><p style="margin:0">Pick the mode that fits your schedule and what you’re studying. Each one is built on the techniques with the strongest evidence — <b>active recall</b>, <b>practice questions</b> and <b>spaced repetition</b> — and tells you what to do in every block.</p></div>';
    else {
      h += '<div class="fmcard"><div class="fmtag">' + esc(m.tag) + ' · ' + (m.ev === "moderate" ? "moderate evidence" : "strong evidence") + '</div><h4>' + esc(m.name) + '</h4><p>' + esc(m.what) + '</p>' +
        '<p><b>Best for:</b> ' + esc(m.best) + '</p><p class="fmev"><b>Why it works:</b> ' + esc(m.why) + '</p>' +
        '<p style="margin-top:10px"><b>How to use it here</b></p><ol>' + m.how.map(function(x){ return '<li>' + x + '</li>'; }).join("") + '</ol>' +
        '<div class="fmtl" aria-label="Blocks">' + m.ph.map(function(x, n){ return '<span class="' + (x.k === "b" ? "br" : "") + (ph && FM.run.i % m.ph.length === n ? " now" : "") + '">' + esc(x.t) + ' ' + x.m + "′" + '</span>'; }).join("") + '</div></div>';
      if (FM.run && ph) h += '<div class="fmrun"><div><div class="fmph">' + (FM.run.end ? "Now" : "Paused") + ' · <b>' + esc(ph.t) + '</b></div><div class="fmclock" id="fmClock">' + fmMs(fmLeft()) + '</div></div><span class="sp"></span>' +
        '<button type="button" class="btn" data-fm="pp">' + (FM.run.end ? NP_ICO.pause + "Pause" : NP_ICO.play + "Resume") + '</button><button type="button" class="btn ghost" data-fm="skip">Next block</button><button type="button" class="btn ghost" data-fm="stop">Stop</button></div>' +
        (ph.d ? '<div class="fmnow">' + esc(ph.d) + '</div>' : "");
      else h += '<div class="fmrun"><button type="button" class="btn" data-fm="go">' + NP_ICO.play + 'Start ' + esc(m.ph[0].t.toLowerCase()) + ' (' + m.ph[0].m + ' min)</button><span class="sp"></span></div>';
      if (mode === "sp"){
        var due = fmDue(), all = Object.keys(FM.rev).length;
        h += '<label class="fmlbl">Due today (' + due.length + ')</label>' + (due.length ? '<div class="fmdue">' + due.map(function(i){ var r = FM.rev[pages[i].sid || pages[i].t];
          return '<div class="row"><span>' + esc(pages[i].t) + '<small>First studied ' + esc(r.f) + ' · review ' + (r.s + 1) + ' of ' + FM_IV.length + '</small></span><button type="button" class="btn sm" data-fm="rev" data-i="' + i + '">Review</button><button type="button" class="btn ghost sm" data-fm="done" data-i="' + i + '" title="Next review in ' + FM_IV[Math.min(r.s + 1, FM_IV.length - 1)] + ' days">Done</button><button type="button" class="btn ghost sm" data-fm="again" data-i="' + i + '">Again tomorrow</button></div>'; }).join("") + '</div>'
          : '<p class="fmnow" style="margin-top:6px">' + (all ? "Nothing due today — well done. Keep studying new materials; each one joins the schedule the day you first open it." : "Nothing yet: each material joins the schedule the day you first open it. Come back tomorrow for your first reviews.") + '</p>');
      }
      if (mode === "il"){
        var mix = fmMix();
        h += '<label class="fmlbl">A mix to try (' + mix.length + ')</label>' + (mix.length > 1 ? '<div class="fmdue">' + mix.map(function(i){ return '<div class="row"><span>' + esc(pages[i].t) + '<small>' + esc(String(pages[i].g || "").trim() || "—") + '</small></span><button type="button" class="btn ghost sm" data-fm="openi" data-i="' + i + '">Open</button></div>'; }).join("") + '</div><div class="fmrun" style="margin-top:8px"><button type="button" class="btn ghost sm" data-fm="remix">Suggest another mix</button></div>'
          : '<p class="fmnow" style="margin-top:6px">Open a few materials first — interleaving mixes topics you have already studied once.</p>');
      }
      h += '<div class="fmrun" style="margin-top:12px"><button type="button" class="btn ghost" data-fm="pad">' + ic("pen") + 'Open the Recall pad</button></div>';
    }
    var syn = pages.map(function(x, j){ return synIsCenter(x) && !notYet(x) ? j : -1; }).filter(function(j){ return j >= 0; })[0];
    if (SYNHTML) h += '<div class="fmcard fmsyn"><b>Want to go deeper?</b> <span>SYNAPSE™ turns this portal\'s quick checks and flashcards into today\'s recall, retrieval sessions with spaced review, and a learning monitor.</span><button type="button" class="btn sm" data-fm="syn">Open SYNAPSE</button></div>';
    else if (syn != null) h += '<div class="fmcard fmsyn"><b>Want to go deeper?</b> <span>' + esc(pages[syn].t) + ' turns this portal\'s quick checks and flashcards into retrieval sessions with spaced review and a learning monitor.</span><button type="button" class="btn sm" data-fm="openi" data-i="' + syn + '">Open it</button></div>';
    h += '<div class="fmset"><b style="font-size:13px">When I sign out</b>' +
      '<label><input type="radio" name="fmKeep" value="1"' + (FM.keep ? " checked" : "") + '><span>Keep my focus mode — it\'s here, paused, when I sign in again</span></label>' +
      '<label><input type="radio" name="fmKeep" value="0"' + (FM.keep ? "" : " checked") + '><span>Reset it — start fresh each time I sign in</span></label>' +
      '<label><input type="checkbox" id="fmSnd"' + (FM.snd ? " checked" : "") + '><span>Soft chime when a block starts or ends</span></label>' +
      '<span class="fine">Timers keep you focused; the learning comes from recalling and testing yourself inside each block. Your review schedule stays on this device either way.</span></div>';
    $("fmBody").innerHTML = fmTabs() + h;
  }
  function fmTabs(){ return '<div class="fmtabs" role="tablist"><button type="button" role="tab" data-fmt="focus" aria-selected="' + (FM.tab !== "plan") + '">Focus mode</button><button type="button" role="tab" data-fmt="plan" aria-selected="' + (FM.tab === "plan") + '">My study plan &amp; calendar' + (fmToday().filter(function(x){ return !x.done; }).length ? ' <span class="fmn">' + fmToday().filter(function(x){ return !x.done; }).length + '</span>' : "") + '</button></div>'; }
  // ---------- My study plan & calendar: the student spreads the portal's materials over a period they choose; the plan stays
  // (on the sidebar as "Today", with reminders while the portal is open) until they change or clear it ----------
  var FM_PER = [["3", "3 days"], ["7", "1 week"], ["14", "2 weeks"], ["30", "1 month"], ["90", "3 months"], ["d", "Until a date…"]];
  function fmKeyOf(p){ return p.sid || p.t; }
  function fmIdx(k){ for (var i = 0; i < pages.length; i++) if (fmKeyOf(pages[i]) === k) return i; return -1; }
  function fmDate(s){ var a = String(s).split("-"); return new Date(+a[0], +a[1] - 1, +a[2]); }
  function fmIso(d){ return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0"); }
  function fmAdd(iso, n){ var d = fmDate(iso); d.setDate(d.getDate() + n); return fmIso(d); }
  function fmNice(iso, long){ return fmDate(iso).toLocaleDateString(undefined, long ? {weekday: "long", month: "long", day: "numeric"} : {month: "short", day: "numeric"}); }
  function fmToday(){ return FM && FM.cal ? (FM.cal[fmDay(0)] || []) : []; }
  function fmStudyable(p){ return !!p && /^(html|pdf|video|audio|image|link|playlist)$/.test(p.k) && !synIsCenter(p) && !isCover(p) && !isMusic(p); }   // covers, welcome page and music stay out
  function fmPlanMake(f){                                                   // spread the chosen materials over the study days, with spaced reviews
    var start = fmDay(0), end = f.per === "d" ? f.to : fmAdd(start, (+f.per || 7) - 1);
    if (!end || end < start) return "Choose an end date from today on.";
    var days = []; for (var d = start; d <= end; d = fmAdd(d, 1)) if (f.wd.indexOf(fmDate(d).getDay()) > -1) days.push(d);
    if (!days.length) return "Choose at least one study day in that period.";
    if (!f.ids.length) return "Tick at least one material to study.";
    Object.keys(FM.cal).forEach(function(k){ FM.cal[k] = FM.cal[k].filter(function(x){ return !x.gen || x.done || k < start; }); if (!FM.cal[k].length) delete FM.cal[k]; });   // replace the old plan, keep notes and what's done
    var per = Math.ceil(f.ids.length / days.length);
    f.ids.forEach(function(k, n){
      var day = days[Math.min(days.length - 1, Math.floor(n / per))];
      (FM.cal[day] = FM.cal[day] || []).push({s: k, k: "study", gen: 1});
      if (f.rev) [1, 3, 7].forEach(function(off){
        var r = fmAdd(day, off); if (r > end) return;
        while (f.wd.indexOf(fmDate(r).getDay()) < 0 && r <= end) r = fmAdd(r, 1);
        if (r <= end) (FM.cal[r] = FM.cal[r] || []).push({s: k, k: "review", gen: 1});
      });
    });
    FM.plan = {from: start, to: end, wd: f.wd, ids: f.ids, rev: f.rev, per: f.per, made: Date.now()};
    fmSave(); return "";
  }
  function fmItemTxt(x){ var i = x.s ? fmIdx(x.s) : -1; return i > -1 ? pages[i].t : x.t || "(removed from the portal)"; }
  function fmRowHtml(x, day, n){
    var i = x.s ? fmIdx(x.s) : -1, lab = x.k === "review" ? "Review" : x.k === "study" ? "Study" : "Topic";
    return '<div class="row' + (x.done ? " dn" : "") + '"><input type="checkbox" data-fmc="done" data-d="' + day + '" data-n="' + n + '"' + (x.done ? " checked" : "") + ' aria-label="Done">' +
      '<span><em class="k">' + lab + '</em>' + esc(fmItemTxt(x)) + (x.tm ? ' <small>⏰ ' + esc(x.tm) + '</small>' : "") + (x.t && x.s ? '<small>' + esc(x.t) + '</small>' : "") + '</span>' +
      (i > -1 ? '<button type="button" class="btn ghost sm" data-fmc="open" data-i="' + i + '">Open</button>' : "") +
      '<button type="button" class="btn ghost sm" data-fmc="del" data-d="' + day + '" data-n="' + n + '" aria-label="Remove" title="Remove">✕</button></div>';
  }
  function fmPlanPaint(){
    var P = FM.plan, h = fmTabs(), today = fmDay(0), t = fmToday();
    if (P && P.to < today){ h += '<div class="fmcard"><b>Your plan ended on ' + esc(fmNice(P.to)) + '.</b> Make a new one below, or keep the calendar as it is.</div>'; }
    if (P && P.to >= today && !FM.edit){
      var all = [], left = 0; Object.keys(FM.cal).forEach(function(k){ if (k >= P.from && k <= P.to) FM.cal[k].forEach(function(x){ if (x.gen){ all.push(x); if (!x.done) left++; } }); });
      h += '<div class="fmcard"><div class="fmtag">Study plan</div><h4>' + esc(fmNice(P.from)) + ' – ' + esc(fmNice(P.to)) + '</h4><p>' + P.ids.length + ' material' + (P.ids.length === 1 ? "" : "s") + (P.rev ? ", with reviews 1, 3 and 7 days later" : "") + ' · ' + (all.length - left) + ' of ' + all.length + ' sessions done.</p>' +
        '<div class="fmrun"><button type="button" class="btn ghost sm" data-fmc="edit">Change my plan</button><button type="button" class="btn ghost sm" data-fmc="clear">Clear it (blank slate)</button><button type="button" class="btn ghost sm" data-fmc="ics">Add to my phone’s calendar</button></div></div>';
    } else {
      var f = FM.edit || {per: "7", wd: [1, 2, 3, 4, 5, 6], ids: null, rev: true, to: ""};
      var ids = f.ids || pages.filter(function(p){ return fmStudyable(p) && !notYet(p) && !FM.rev[fmKeyOf(p)]; }).map(fmKeyOf);
      h += '<div class="fmcard"><div class="fmtag">Plan how you’ll study this portal</div><h4>' + (P ? "Change my plan" : "Make a study plan") + '</h4><p>Choose how long, which days, and what to cover. The portal spreads the materials over your study days, adds reviews 1, 3 and 7 days later, and shows today’s part in the sidebar until you change it or clear it.</p>' +
        '<div class="fmform"><label class="fmlbl" style="margin:4px 0 0">Plan for</label><div class="row2"><select id="fmPer">' + FM_PER.map(function(x){ return '<option value="' + x[0] + '"' + (x[0] === String(f.per) ? " selected" : "") + '>' + x[1] + '</option>'; }).join("") + '</select>' +
        '<input type="date" id="fmTo" value="' + esc(f.to || "") + '" min="' + today + '"' + (f.per === "d" ? "" : " hidden") + ' aria-label="Until"></div>' +
        '<label class="fmlbl" style="margin:4px 0 0">Study on</label><div class="fmwd">' + ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map(function(d, n){ return '<label><input type="checkbox" class="fmwdx" value="' + n + '"' + (f.wd.indexOf(n) > -1 ? " checked" : "") + '>' + d + '</label>'; }).join("") + '</div>' +
        '<label class="fmlbl" style="margin:4px 0 0">Materials to cover <button type="button" class="linkbtn" data-fmc="all" style="margin:0 0 0 8px">all</button> <button type="button" class="linkbtn" data-fmc="none" style="margin:0 0 0 4px">none</button></label><div class="fmmats">' + fmMatsHtml(ids) + '</div>' +
        '<label style="font-size:14px;display:flex;gap:8px;align-items:center"><input type="checkbox" id="fmRev"' + (f.rev ? " checked" : "") + '> Add spaced reviews (1, 3 and 7 days after each)</label>' +
        '<div class="fmrun" style="margin:4px 0 0"><button type="button" class="btn" data-fmc="make">' + (P ? "Save my plan" : "Make my plan") + '</button>' + (P ? '<button type="button" class="btn ghost" data-fmc="cancel">Cancel</button>' : "") + '<span class="small" id="fmPlanMsg" style="color:var(--danger)"></span></div></div></div>';
    }
    // today
    h += '<label class="fmlbl">Today · ' + esc(fmNice(today, true)) + '</label>' + (t.length ? '<div class="fmdue fmday">' + t.map(function(x, n){ return fmRowHtml(x, today, n); }).join("") + '</div>' : '<p class="fmnow" style="margin-top:4px">Nothing planned for today.</p>');
    // calendar
    var mo = FM.calM || today.slice(0, 7), first = fmDate(mo + "-01"), sel = FM.calSel || today;
    var gs = new Date(first); gs.setDate(1 - first.getDay());
    h += '<div class="fmcalhd"><button type="button" class="btn ghost sm" data-fmc="mprev" aria-label="Previous month">‹</button><b>' + esc(first.toLocaleDateString(undefined, {month: "long", year: "numeric"})) + '</b><button type="button" class="btn ghost sm" data-fmc="mnext" aria-label="Next month">›</button></div><div class="fmcal">' +
      ["S", "M", "T", "W", "T", "F", "S"].map(function(d){ return '<span class="hd">' + d + '</span>'; }).join("");
    for (var k = 0; k < 42; k++){
      var d = new Date(gs); d.setDate(gs.getDate() + k); var iso = fmIso(d), L = FM.cal[iso] || [];
      if (k >= 35 && d.getMonth() !== first.getMonth()) break;
      h += '<button type="button" data-fmc="day" data-d="' + iso + '" class="' + (d.getMonth() !== first.getMonth() ? "out " : "") + (iso === today ? "td " : "") + (iso === sel ? "sel" : "") + '">' + d.getDate() + '<i>' + L.slice(0, 4).map(function(x){ return '<b' + (x.done ? ' class="dn"' : "") + '></b>'; }).join("") + '</i></button>';
    }
    h += '</div>';
    var SL = FM.cal[sel] || [];
    h += '<label class="fmlbl">' + esc(fmNice(sel, true)) + '</label>' + (SL.length ? '<div class="fmdue fmday">' + SL.map(function(x, n){ return fmRowHtml(x, sel, n); }).join("") + '</div>' : '<p class="fmnow" style="margin-top:4px">Nothing planned yet.</p>') +
      '<div class="fmform"><div class="row2"><input type="text" id="fmNt" placeholder="Next topic or task, e.g. Renal physiology — read and recall" maxlength="140"><select id="fmNm"><option value="">Link a material (optional)</option>' +
      pages.map(function(p, i){ return fmStudyable(p) ? '<option value="' + esc(fmKeyOf(p)) + '">' + esc(p.t) + '</option>' : ""; }).join("") + '</select></div>' +
      '<div class="row2"><input type="time" id="fmNtm" aria-label="Reminder time (optional)" title="Reminder time (optional)"><button type="button" class="btn sm" data-fmc="add">Add to ' + esc(fmNice(sel)) + '</button></div>' +
      '<span class="fine">Reminders show here and in the sidebar while the portal is open' + (FM.snd ? ", with a soft chime" : "") + '. For reminders on your phone, use <b>Add to my phone’s calendar</b>.</span></div>';
    $("fmBody").innerHTML = h;
  }
  function fmMatsHtml(ids){
    var h = "", lastG = null;
    pages.forEach(function(p, i){
      if (!fmStudyable(p)) return;
      var g = String(p.g || "").trim(), tg = tgOf(p);
      if (g !== lastG){ h += '<div class="g">' + esc((tg ? tg.n + " · " : "") + (g || "Other")) + '</div>'; lastG = g; }
      var k = fmKeyOf(p), lk = notYet(p);
      h += '<label><input type="checkbox" class="fmmx" value="' + esc(k) + '"' + (ids.indexOf(k) > -1 ? " checked" : "") + '><span>' + esc(p.t) + (FM.rev[k] ? ' <small class="muted">· studied</small>' : "") + (lk ? ' <small class="muted">· opens later</small>' : "") + '</span></label>';
    });
    return h;
  }
  function fmFormRead(){
    var per = $("fmPer").value, wd = [].map.call(document.querySelectorAll(".fmwdx:checked"), function(x){ return +x.value; }), ids = [].map.call(document.querySelectorAll(".fmmx:checked"), function(x){ return x.value; });
    return {per: per, to: $("fmTo").value, wd: wd, ids: ids, rev: $("fmRev").checked};
  }
  function fmPlanClick(e){
    var b = e.target.closest("[data-fmc]"); if (!b) return false;
    var a = b.dataset.fmc, d = b.dataset.d, n = +b.dataset.n;
    if (a === "done"){ var x = (FM.cal[d] || [])[n]; if (x){ x.done = b.checked; fmSave(); fmNavPlan(); if (x.done && x.s){ var j = fmIdx(x.s); if (j > -1) fmSeen(j); } } fmPlanPaint(); return true; }
    if (a === "open"){ $("fmBox").hidden = true; show(+b.dataset.i); return true; }
    if (a === "del"){ if (FM.cal[d]){ FM.cal[d].splice(n, 1); if (!FM.cal[d].length) delete FM.cal[d]; fmSave(); fmNavPlan(); } fmPlanPaint(); return true; }
    if (a === "edit"){ var P = FM.plan; FM.edit = {per: P.per || "d", to: P.to, wd: P.wd.slice(), ids: P.ids.slice(), rev: P.rev}; fmPlanPaint(); return true; }
    if (a === "cancel"){ FM.edit = null; fmPlanPaint(); return true; }
    if (a === "clear"){
      if (!confirm("Clear your study plan? Its planned sessions are removed; your own topics and what you've done stay.")) return true;
      Object.keys(FM.cal).forEach(function(k){ FM.cal[k] = FM.cal[k].filter(function(x){ return !x.gen || x.done; }); if (!FM.cal[k].length) delete FM.cal[k]; });
      FM.plan = null; FM.edit = null; fmSave(); fmNavPlan(); fmPlanPaint(); toast("Study plan cleared — a blank slate until you make a new one."); return true;
    }
    if (a === "all" || a === "none"){ document.querySelectorAll(".fmmx").forEach(function(x){ x.checked = a === "all"; }); return true; }
    if (a === "make"){ var f = fmFormRead(), err = fmPlanMake(f); if (err){ $("fmPlanMsg").textContent = err; return true; } FM.edit = null; fmNavPlan(); fmPlanPaint(); toast("Your study plan is ready: " + fmNice(FM.plan.from) + " – " + fmNice(FM.plan.to) + "."); return true; }
    if (a === "mprev" || a === "mnext"){ var m = fmDate((FM.calM || fmDay(0).slice(0, 7)) + "-01"); m.setMonth(m.getMonth() + (a === "mnext" ? 1 : -1)); FM.calM = fmIso(m).slice(0, 7); fmPlanPaint(); return true; }
    if (a === "day"){ FM.calSel = d; fmPlanPaint(); return true; }
    if (a === "add"){
      var t = $("fmNt").value.trim(), mk = $("fmNm").value, tm = $("fmNtm").value, day = FM.calSel || fmDay(0);
      if (!t && !mk){ $("fmNt").focus(); return true; }
      (FM.cal[day] = FM.cal[day] || []).push({s: mk || null, t: t, k: mk ? "study" : "note", tm: tm || ""});
      fmSave(); fmNavPlan(); fmPlanPaint(); toast("Added to " + fmNice(day) + (tm ? " with a reminder at " + tm : "") + "."); return true;
    }
    if (a === "ics"){ fmIcs(); return true; }
    return false;
  }
  function fmIcs(){                                                         // the plan as calendar events, with reminders, for the phone's own calendar
    var L = ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//Study Portal//Study plan//EN", "CALSCALE:GREGORIAN"], stamp = new Date().toISOString().replace(/[-:]/g, "").slice(0, 15) + "Z", n = 0;
    var e = function(x){ return String(x).replace(/[\\;,]/g, function(c){ return "\\" + c; }).replace(/\n/g, "\\n"); };
    Object.keys(FM.cal).sort().forEach(function(day){
      if (day < fmDay(0)) return;
      FM.cal[day].forEach(function(x){
        if (x.done) return; n++;
        var ttl = (x.k === "review" ? "Review: " : x.k === "study" ? "Study: " : "") + fmItemTxt(x), dd = day.replace(/-/g, "");
        L.push("BEGIN:VEVENT", "UID:" + D.id + "-" + dd + "-" + n + "@study-portal", "DTSTAMP:" + stamp, "SUMMARY:" + e(ttl + " · " + (D.title || "Study portal")));
        if (x.tm){ var hm = x.tm.replace(":", ""); L.push("DTSTART:" + dd + "T" + hm + "00", "DURATION:PT45M"); }
        else L.push("DTSTART;VALUE=DATE:" + dd, "DTEND;VALUE=DATE:" + fmAdd(day, 1).replace(/-/g, ""));
        L.push("BEGIN:VALARM", "ACTION:DISPLAY", "DESCRIPTION:" + e(ttl), "TRIGGER:" + (x.tm ? "-PT10M" : "PT8H"), "END:VALARM", "END:VEVENT");
      });
    });
    L.push("END:VCALENDAR");
    if (!n){ toast("Nothing planned from today on to add."); return; }
    var a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([L.join("\r\n")], {type: "text/calendar"})); a.download = (D.title || "Study portal").replace(/[^\w\- ]+/g, "").trim() + " – study plan.ics";
    document.body.appendChild(a); a.click(); a.remove(); setTimeout(function(){ URL.revokeObjectURL(a.href); }, 30000);
    toast("Saved " + n + " planned session" + (n === 1 ? "" : "s") + ". Open the file to add them to your phone or computer calendar, with reminders.");
  }
  function fmNavPlan(){                                                    // "Today" at the top of the sidebar while a plan or topics exist
    var nv = $("nav"), c = $("navPlan"); if (!nv || !FM) return;
    var t = fmToday(), left = t.filter(function(x){ return !x.done; });
    if (!t.length && !FM.plan){ if (c) c.remove(); return; }
    if (!c){ c = document.createElement("button"); c.type = "button"; c.id = "navPlan"; c.className = "navplan"; var w = nv.querySelector(".navwho"); nv.insertBefore(c, w ? w.nextSibling : nv.firstChild); c.onclick = function(){ FM.tab = "plan"; FM.calSel = fmDay(0); fmOpen(); closeNav(); }; }
    c.innerHTML = '<b>Today’s plan</b>' + (t.length ? (left.length ? esc(left.slice(0, 3).map(function(x){ return (x.k === "review" ? "Review " : "") + fmItemTxt(x); }).join(" · ")) + (left.length > 3 ? " · +" + (left.length - 3) + " more" : "") : "All done for today ✓") : "Nothing planned today") + '';
  }
  function fmRemind(){                                                     // a topic with a time: remind once, while the portal is open
    var now = new Date(), hm = String(now.getHours()).padStart(2, "0") + ":" + String(now.getMinutes()).padStart(2, "0"), day = fmDay(0);
    (FM.cal[day] || []).forEach(function(x){ if (x.tm && !x.done && x.tm <= hm && x.rem !== day){ x.rem = day; fmSave(); fmBeep(true); toast("⏰ Study reminder: " + fmItemTxt(x)); } });
  }
  function fmMix(){                                                        // 2–3 already-studied materials from different sections
    if (FM._mix && FM._mix.length > 1 && FM._mix.every(function(i){ return pages[i]; })) return FM._mix;
    var seen = pages.map(function(x, i){ return FM.rev[x.sid || x.t] && !notYet(x) && fmStudyable(x) ? i : -1; }).filter(function(i){ return i >= 0; });
    seen.sort(function(){ return Math.random() - 0.5; });
    var out = [], secs = {};
    seen.forEach(function(i){ var g = String(pages[i].g || "").trim(); if (out.length < 3 && !secs[g]){ secs[g] = 1; out.push(i); } });
    seen.forEach(function(i){ if (out.length < 3 && out.indexOf(i) < 0) out.push(i); });
    FM._mix = out; return out;
  }
  function fmOpen(){ if (!FM) return; $("fmIc").innerHTML = ic("target"); $("fmX").innerHTML = ic("close"); if (FM.tab === "plan") fmPlanPaint(); else fmPaint(); $("fmBox").hidden = false; setTimeout(function(){ var x = $("fmSel"); if (x) x.focus(); }, 30); }
  $("fmBtn").onclick = fmOpen; $("fmChipT").onclick = fmOpen; $("fmChipPP").onclick = fmToggle;
  $("fmX").onclick = function(){ $("fmBox").hidden = true; };
  $("fmBox").addEventListener("click", function(e){
    if (e.target === this){ this.hidden = true; return; }
    var tb = e.target.closest("[data-fmt]"); if (tb && FM){ FM.tab = tb.dataset.fmt; fmSave(); if (FM.tab === "plan") fmPlanPaint(); else fmPaint(); return; }
    if (FM && fmPlanClick(e)) return;
    var b = e.target.closest("[data-fm]"); if (!b || !FM) return;
    var a = b.dataset.fm, i = +b.dataset.i;
    if (a === "go"){ fmAC = fmAC || (window.AudioContext ? new AudioContext() : null); fmGo(0); }
    if (a === "pp") fmToggle();
    if (a === "skip") fmGo(FM.run.i + 1);
    if (a === "stop"){ FM.run = null; fmSave(); fmChip(); fmPaint(); $("fmPad").hidden = true; toast("Focus timer stopped."); }
    if (a === "pad"){ $("fmBox").hidden = true; fmPadOpen(); }
    if (a === "openi"){ $("fmBox").hidden = true; show(i); }
    if (a === "syn"){ $("fmBox").hidden = true; synOpen(); }
    if (a === "remix"){ FM._mix = null; fmPaint(); }
    if (a === "rev"){ $("fmBox").hidden = true; fmPadOpen(i); }
    if (a === "done" || a === "again"){
      var r = FM.rev[pages[i].sid || pages[i].t]; if (!r) return;
      if (a === "done"){ r.s = Math.min(r.s + 1, FM_IV.length); r.n = r.s >= FM_IV.length ? "" : fmDay(FM_IV[r.s]); toast(r.n ? "Next review of “" + pages[i].t + "” in " + FM_IV[r.s] + " days." : "“" + pages[i].t + "” has finished its review schedule."); }
      else { r.n = fmDay(1); toast("“" + pages[i].t + "” is due again tomorrow."); }
      fmSave(); fmDot(); fmPaint();
    }
  });
  $("fmBox").addEventListener("change", function(e){
    if (!FM) return;
    if (e.target.id === "fmSel"){ var was = FM.mode; FM.mode = e.target.value; if (was !== FM.mode){ FM.run = null; $("fmPad").hidden = true; } fmSave(); fmChip(); fmDot(); fmPaint(); setTimeout(function(){ var x = $("fmSel"); if (x) x.focus(); }, 0); }
    if (e.target.name === "fmKeep"){ FM.keep = e.target.value === "1"; fmSave(); toast(FM.keep ? "Your focus mode will be kept when you sign out." : "Your focus mode will reset when you sign out."); }
    if (e.target.id === "fmSnd"){ FM.snd = e.target.checked; fmSave(); }
    if (e.target.id === "fmPer"){ $("fmTo").hidden = e.target.value !== "d"; if (e.target.value === "d") $("fmTo").focus(); }
  });
  document.addEventListener("keydown", function(e){ if (e.key === "Escape"){ if (!$("fmBox").hidden){ $("fmBox").hidden = true; e.stopPropagation(); } } }, true);

  // ---------- What's new: a short guide after each portal update ----------
  // Shown the first time a student opens the portal (a tour of what it can do) and after each update
  // (new features, new materials since their last visit, and the instructor's message). Remembered per student on this device.
  var WN_V = "2026-11-25", WN_DATE = "2026-11-25", WNS = null;
  function wnFeat(){
    var np = D.np !== false, links = pages.some(function(p){ return p.k === "link" && p.e; }), up = pages.some(function(p){ return p.k === "audio" || p.k === "video"; });
    var music = pages.some(function(p){ return p.svc === "Spotify" || p.svc === "YouTube Music"; });
    return [
      {v: "2026-11-25", ico: "audio", on: up || pages.some(function(p){ return p.k === "playlist"; }), t: "Skip and next on every player",
       d: "Videos, recordings and playlists now have <b>⏮ previous</b>, <b>10 s back</b>, <b>10 s forward</b> and <b>⏭ next</b> buttons right on their own page, not just in the mini-player. ⏭ goes to the next video or recording in the same section. When something plays on its own page, the mini-player steps aside and comes back with it when you move to another page."},
      {v: "2026-11-25", ico: "lock", on: !!(D.lic && D.lic.own), t: "Copyright and licence",
       d: "This portal and everything in it is licensed to you for your own study. Please don't copy, share or upload its content, including to AI tools."},
      {v: "2026-11-17", ico: "audio", on: np && (links || up), t: "Easier music and video controls",
       d: "Press <kbd>K</kbd> to play or pause, <kbd>J</kbd> / <kbd>L</kbd> to go back or forward 10 seconds and <kbd>U</kbd> to mute. The mini-player now has a volume slider, and uploaded recordings have shuffle, repeat and an <b>Up next</b> list. Uploaded audio and video pick up where you stopped."},
      {v: "2026-11-24e", ico: "playlist", on: pages.some(function(p){ return p.k === "playlist"; }), t: "Song titles, artists and composers",
       d: "Playlists now show each song's real title, artist and composer, read from the music files themselves — also for music playlists, once their songs are kept on this device."},
      {v: "2026-11-24d", ico: "brain", on: !!SYNHTML && SYNTH, t: "SYNAPSE™ matches your lessons",
       d: "SYNAPSE™ now takes on the look of your handouts and lecture decks — their fonts, colours, headings, boxes and buttons — so it feels part of the same material. Prefer its own look? Choose <b>SYNAPSE identity</b> under <b>Appearance</b> at the top of SYNAPSE."},
      {v: "2026-11-24c", ico: "playlist", on: pages.some(function(p){ return p.ml; }), t: "Music playlists play offline",
       d: "Play a music playlist once with internet and it's kept on this device — after that it plays offline too, inside the portal and the mini-player. When you're online it picks up your instructor's changes by itself."},
      {v: "2026-11-24b", ico: "brain", on: !!SYNHTML, t: "SYNAPSE™ is built in",
       d: "The brain button at the top opens SYNAPSE™, the Memory Consolidation Center: today's recall, retrieval sessions and spaced review made from this portal's quick checks and flashcards. Sources open right here in the portal."},
      {v: "2026-11-24", ico: "cal", on: fmOn(), t: "Your study plan and calendar",
       d: "In Focus mode, open <b>My study plan &amp; calendar</b>: choose 3 days, a week, 2 weeks, a month or 3 months, your study days and the materials. The portal spreads them out with reviews, shows <b>Today’s plan</b> at the top of the contents, reminds you while the portal is open, and can add the plan to your phone’s calendar."},
      {v: "2026-11-24", ico: "target", on: fmOn(), t: "Three more study techniques",
       d: "Focus mode now also has the <b>Feynman Technique</b> (explain it simply, find the gaps), <b>Elaborative Interrogation</b> (ask why and how) and <b>Interleaving</b> (mix related topics), each with a tip on how to use it."},
      {v: "2026-11-24", ico: "menu", on: !!(D.tg && D.tg.length), t: "Terms in the contents",
       d: "Sections are grouped under their term (for example Prelim and Midterm). Tap a term to fold or unfold it. A term's end cover leads back to the term's first resource."},
      {v: "2026-11-24", ico: "audio", on: np && (links || up), t: "One sound at a time",
       d: "Start a video or recording and whatever was playing in the mini-player stops, so sounds never overlap. Your headphones' and keyboard's ⏭ / ⏮ buttons skip 10 seconds forward or back in videos."},
      {v: "2026-11-24", ico: "spark", on: todCfg().on || todCfg().snd, t: "Morning, afternoon and evening",
       d: "The portal takes on a subtle tint that follows the time of day. Turn on sunrise and evening sounds — or turn the look off — with the Aa button."},
      {v: "2026-11-21c", ico: "dl", on: upCan(), t: "Updates itself online",
       d: "When you open this portal with internet, it fetches your instructor's newest version by itself and opens it next time — no need to download the file again. It still opens offline. You can turn this off under the sign-in button."},
      {v: "2026-11-21c", ico: "video", on: pages.some(function(p){ return p.k === "link" && p.rq && p.rq.until; }), t: "More required videos",
       d: "Vimeo videos and other online videos can now be required viewing. Vimeo counts how much you watched, like YouTube; other players count the time the video stays open on screen."},
      {v: "2026-11-21b", ico: "portal", on: pages.some(function(p){ return p.k === "portal"; }), t: "Shortcuts to your other portals",
       d: "Your instructor added shortcuts to related portals" + (pages.some(function(p){ return p.k === "portal" && p.pin; }) ? " — find them at the top of the portal and in the contents" : " in the contents") + ". On a computer, the first time you'll be asked to choose the other portal's file wherever you saved it; on a phone, they open in the Portal Opener."},
      {v: "2026-11-20b", ico: "target", on: D.fm !== false, t: "Focus mode",
       d: "Tap the <b>target</b> button at the top and choose a mode that fits your schedule: <b>Learn–Recall Pomodoro</b>, <b>Deep Block</b>, <b>Question Block</b> or <b>Spaced Review</b>. Each uses the study methods with the strongest evidence — recalling from memory, practice questions and spaced review — and tells you what to do in every block. A <b>Recall pad</b> opens when it's time to write from memory."},
      {v: "2026-11-20", ico: "playlist", on: pages.some(function(p){ return p.k === "playlist"; }), t: "Playlists",
       d: "Study music and recordings can now come as one playlist. Open it, tap <b>Play all</b> or any track, and it plays through in order — or turn on <b>Shuffle</b> and <b>Repeat</b>. It keeps playing in the mini-player while you study, and next/previous work from the mini-player, your keyboard's media keys and your headphones."},
      {v: "2026-11-17d", ico: "audio", on: np && (links || up), t: "Headphone and keyboard buttons",
       d: "Play, pause, skip and next/previous now work from your earphone or headphone buttons, your keyboard's media keys (on a Mac, F7–F9), Control Center, and the lock screen on your phone or tablet. The portal's own player follows along. They pause by themselves if your headphones disconnect."},
      {v: "2026-11-17c", ico: "home", on: DSK_ON, t: "Put the portal on your desktop",
       d: "Make a desktop shortcut with this portal's own icon, so you can open it like an app. <button type=\"button\" class=\"linkbtn\" data-wn-act=\"dsk\" style=\"margin:4px 0 0;display:block\">Show me how</button>"},
      {v: "2026-11-17c", ico: "home", on: location.protocol !== "file:" && !!document.querySelector('link[rel="manifest"]'), t: "Install the portal as an app",
       d: "Install it from the button at the top (Chrome, Edge, Android) or with <b>Share → Add to Home Screen</b> (iPhone, iPad). It gets its own icon and opens even without internet."},
      {v: "2026-11-17b", ico: "video", on: np && (links || up), t: "Full player or slim bar",
       d: "Switch the mini-player between the <b>full player</b> (video and all controls) and a <b>slim bar</b> with just play/pause, the progress bar and mute — with the button on the mini-player, under <b>Aa → Music &amp; video player</b>, or by pressing <kbd>V</kbd>. Uploaded videos play as sound only in the slim bar; YouTube and Spotify keep their own player visible."},
      {v: "2026-11-17", ico: "eyeoff", on: np && up, t: "Hide the player, keep listening",
       d: "Press <kbd>H</kbd> (or the – button on the mini-player) to hide it while an uploaded recording or video keeps playing. Control it from the bar at the top; press <kbd>H</kbd> again to bring it back."},
      {v: "2026-11-17", ico: "timer", on: np && (links || up), t: "Study timer",
       d: "Tap the timer on the mini-player to pause the music after 15, 25, 45 or 60 minutes — a cue for a short break. The time left shows at the top."},
      {v: "2026-11-17", ico: "audio", on: np && music, t: "YouTube Music and whole Spotify songs",
       d: "YouTube Music links play in the mini-player while you're online (YouTube's player stays visible). Spotify plays whole songs when you're signed in to Spotify in this browser; otherwise open it in the Spotify app, where songs you've downloaded play even offline."},
      {v: "2026-11-16", ico: "aa", on: true, t: "Reading settings (Aa)",
       d: "Change the text size, pick an easy-to-read or dyslexia-friendly font, widen line and letter spacing, turn on high contrast or underlined links, or use a reading ruler. Day, night and automatic modes are there too."},
      {v: "2026-11-15", ico: "audio", on: np && (links || up), t: "Keep playing while you study",
       d: "Music and videos keep playing in a small mini-player when you move to another page. Drag it to any corner or make it larger."},
      {v: "2026-11-12", ico: "cal", on: pages.some(function(p){ return p.op; }), t: "Materials that open on a date",
       d: "Some materials show the date they open and unlock by themselves at that time. A quick online check confirms the time, so changing your device's clock doesn't open them early."},
      {v: "2026-11-12", ico: "lock", on: !!D.hasRq, t: "Required viewing" + (D.hasPt ? " and post-tests" : ""),
       d: "Items marked <b>Required</b> must be viewed by their deadline to count as attendance (videos up to 1.25× speed, no skipping)." + (D.hasPt ? " Post-tests are closed-book: leaving the post-test closes and submits it. Answer keys open after the deadline." : "")},
      {v: "2026-11-10", ico: "dl", on: !!D.dl, t: "Download handouts",
       d: "PDF handouts can be downloaded as a copy stamped with your name, for personal study only" + (D.dlLock !== false ? ", locked with your student number as the password" : "") + "."},
      {v: "2026-11-08", ico: "chart", on: !!(SC && pages.some(function(p){ return p.sc; })), t: "Practice scores",
       d: "Quick checks and mock tests in exam mode are sent to your instructor; your best attempt counts. Opening an answer key locks your best score before it."},
      {v: "2026-11-01", ico: "pen", on: D.ink !== false, t: "Notes on handouts",
       d: "Press <kbd>A</kbd> or the Annotate button to draw, highlight or add typed notes on handouts. Notes stay on this device."}
    ].filter(function(f){ return f.on; });
  }
  function wnKey(){ return "portal-wn:" + D.id + ":" + normSN(user.sn); }
  function wnItemKey(p){ return p.sid || ("t:" + p.t); }
  function wnLoad(){ try { return JSON.parse(localStorage.getItem(wnKey()) || "null"); } catch(e){ return null; } }
  function wnSave(){ try { localStorage.setItem(wnKey(), JSON.stringify(WNS)); } catch(e){} }
  function wnNoteH(){ var n = String(D.wn || "").trim(); return n ? hashStr(n) : ""; }
  try { $("lcLine").textContent = LIC_WHO + " " + licTxt(); $("lcLine").hidden = false; licCopy(document); } catch(e){}
  try { $("pVer").textContent = "Portal version " + new Date(WN_DATE + "T00:00:00").toLocaleDateString(undefined, {day: "numeric", month: "short", year: "numeric"}) + (/[b-z]$/.test(WN_V) ? " · " + (WN_V.slice(-1).charCodeAt(0) - 96) : "") + (D.built ? " · updated " + new Date(D.built).toLocaleDateString(undefined, {day: "numeric", month: "short", year: "numeric"}) : ""); } catch(e){}
  function wnStart(){
    $("wnBtn").innerHTML = ic("spark"); $("wnBtn").hidden = D.wnOn === false;
    if (D.wnOn === false){ WNS = null; return; }
    var old = wnLoad(), all = pages.map(wnItemKey), feats = wnFeat(), first = !old;
    WNS = old || {v: "", note: "", known: [], fresh: []};
    var newItems = first ? [] : pages.map(function(p, i){ return i; }).filter(function(i){ return WNS.known.indexOf(wnItemKey(pages[i])) < 0; });
    var nf = first ? feats : feats.filter(function(f){ return f.v > (WNS.v || ""); });
    var note = wnNoteH() && wnNoteH() !== WNS.note;
    newItems.forEach(function(i){ var k = wnItemKey(pages[i]); if (WNS.fresh.indexOf(k) < 0) WNS.fresh.push(k); });
    WNS.fresh = WNS.fresh.filter(function(k){ return all.indexOf(k) > -1; });
    var show1 = first || nf.length || note || newItems.length;
    WNS.known = all; WNS.v = WN_V; WNS.note = wnNoteH(); wnSave();
    wnPaint();
    if (show1) setTimeout(function(){ if (user && $("cbAsk").hidden) wnOpen({first: first, feats: nf, note: first || note, items: newItems}); }, 700);
  }
  function wnPaint(){                                                       // "New" tags on materials added since the last visit, until opened
    document.querySelectorAll("nav button.item").forEach(function(b){
      var x = b.querySelector(".newb"), p = pages[+b.dataset.i], on = !!(WNS && p && WNS.fresh.indexOf(wnItemKey(p)) > -1);
      if (on && !x){ x = document.createElement("span"); x.className = "newb"; x.textContent = "New"; b.appendChild(x); }
      else if (!on && x) x.remove();
    });
  }
  function wnOpened(i){
    if (!WNS || !pages[i]) return;
    var k = wnItemKey(pages[i]), j = WNS.fresh.indexOf(k);
    if (j > -1){ WNS.fresh.splice(j, 1); wnSave(); wnPaint(); }
  }
  function wnOpen(o){
    o = o || {first: false, feats: wnFeat(), note: true, items: [], all: true};
    var h = "", built = D.built ? new Date(D.built).toLocaleDateString(undefined, {month: "long", day: "numeric", year: "numeric"}) : "";
    if (/^data:image\//.test(D.logo || "")){ $("wnIc").innerHTML = '<img alt="" src="' + D.logo + '">'; $("wnIc").classList.add("lgo"); } else $("wnIc").innerHTML = ic("spark");
    $("wnT").textContent = o.first ? "Welcome to " + (D.title || "your study portal") : o.all ? "What's in this portal" : "What's new in this update";
    $("wnSub").textContent = o.first ? "A quick guide to what this portal can do" : built ? "Portal updated " + built : "";
    if (o.note && String(D.wn || "").trim()) h += '<h4>From your instructor</h4><div class="wnnote">' + esc(String(D.wn).trim()) + '</div>';
    var fresh = o.items.length ? o.items : (o.all && WNS ? pages.map(function(p, i){ return i; }).filter(function(i){ return WNS.fresh.indexOf(wnItemKey(pages[i])) > -1; }) : []);
    if (fresh.length) h += '<h4>New materials</h4><div class="wnitems">' + fresh.map(function(i){
      var p = pages[i]; return '<button type="button" data-wn-go="' + i + '">' + ic(p.k === "link" ? (IC[p.ico] ? p.ico : "link") : IC[p.k] ? p.k : "file") + '<span>' + esc(p.t) + '</span><small>' + esc(notYet(p) ? "Opens " + opWhen(p) : String(p.g || "")) + '</small></button>'; }).join("") + '</div>';
    if (o.feats.length) h += '<h4>' + (o.first || o.all ? "What you can do here" : "New in the portal") + '</h4>' + o.feats.map(function(f){
      return '<div class="wnf">' + ic(f.ico) + '<div><b>' + esc(f.t) + '</b><p>' + f.d + '</p></div></div>'; }).join("");
    if (!h) h = '<p style="margin:14px 0">Nothing new since your last visit.</p>';
    h += '<p style="margin:14px 0 0;font-size:12.5px;color:var(--muted)">Press <kbd>?</kbd> for all keyboard shortcuts.</p>';
    $("wnBody").innerHTML = h; $("wnBox").hidden = false; $("wnOk").focus();
  }
  function wnClose(){ $("wnBox").hidden = true; }
  $("wnBtn").onclick = function(){ wnOpen(); };
  $("wnOk").onclick = wnClose; $("wnX").onclick = wnClose;
  $("wnX").innerHTML = ic("close");
  $("wnBox").addEventListener("click", function(e){
    if (e.target === this){ wnClose(); return; }
    var b = e.target.closest("[data-wn-go]"); if (b){ wnClose(); show(+b.dataset.wnGo); }
    if (e.target.closest("[data-wn-act=dsk]")){ wnClose(); dskOpen(); }
  });
  document.addEventListener("keydown", function(e){ if (e.key === "Escape" && !$("wnBox").hidden){ wnClose(); e.stopPropagation(); } }, true);

  function linkView(p){
    var v = $("view"); v.hidden = false; $("wm").classList.add("onview");
    var online = navigator.onLine !== false, lay = p.l || "video";
    var h = '<div class="linkwrap">';
    if (p.e && online){
      var st = typeof lay === "number" ? ' style="height:' + lay + 'px"' : "";
      h += '<div class="embed ' + (typeof lay === "number" ? "audio" : lay) + '" id="npSlot"' + st + '></div>';
    }
    var label = p.svc ? "Open in " + p.svc : "Open link", sp = p.svc === "Spotify" && !!spUri(p.e), ytm = p.svc === "YouTube Music";
    h += '<div class="linkcard"><span class="big">' + ic(IC[p.ico] ? p.ico : "link") + '</span><div class="lt"><b>' + esc(p.t) + '</b><span>' + esc((p.svc ? p.svc + " · " : "") + host(p.u)) + '</span></div><a class="btn" href="' + esc(p.u) + '" target="_blank" rel="noopener noreferrer">' + esc(label) + ic("ext") + '</a></div>';
    h += '<p class="lnote">' + (!online ? "You're offline. Connect to the internet, then open this item again."
          : p.e ? "Loads from the internet. If it doesn't appear here, use the " + esc(label) + " button."
          : "Opens in a new browser tab and needs an internet connection.") + '</p>';
    if (sp) h += '<div class="spfull" id="spHelp"><b id="spHelpT">' + (online ? "Whole songs, not 30-second previews" : "Listen offline in the Spotify app") + '</b>' +
      (online ? '<p>Spotify plays full songs here when you\'re signed in to Spotify in this browser — this works best in Chrome, Edge or Firefox on a computer. If you\'re not signed in, or on Safari, iPhone or iPad, it plays 30-second previews; use the Spotify app instead.</p>' : '') +
      '<div class="row">' + (online ? '<a class="btn" href="https://accounts.spotify.com/login?continue=https%3A%2F%2Fopen.spotify.com%2F" target="_blank" rel="noopener noreferrer">Sign in to Spotify' + ic("ext") + '</a><button type="button" class="btn ghost" id="spReload">I\'ve signed in — reload the player</button>' : '') +
      '<a class="btn ' + (online ? "ghost" : "") + '" id="spApp" href="' + esc(spAppUrl(p)) + '" target="_blank" rel="noopener noreferrer">Open in the Spotify app' + ic("ext") + '</a></div>' +
      '<p class="fine">In the Spotify app, songs you\'ve downloaded with Spotify Premium play even without internet. The app plays on its own, so use its controls (or your keyboard\'s media keys) — the portal\'s mini-player can\'t control it.</p></div>';
    if (ytm) h += '<div class="spfull"><b>YouTube Music in the portal</b><p>Plays inside the portal while you\'re online, with YouTube\'s player showing (YouTube doesn\'t allow hiding it). Songs downloaded with YouTube Music Premium play only inside the YouTube Music app, so for offline listening use the ' + esc(label) + ' button on your phone, or study music your instructor uploaded to the portal.</p></div>';
    h += '</div>';
    v.innerHTML = h;
    if ($("spReload")) $("spReload").onclick = function(){
      if (CUR && CUR.kind === "embed"){ npKill(CUR); CUR = null; }
      if (NP && NP.i === cur){ npKill(NP); NP = null; npPaint(); }
      show(cur);
    };
    if (p.e && online){ var i = cur; CUR = npTake(i) || npFrame(p, i); npLoop(); }
    if (rqTm(p)) rqRead(cur);
  }
  window.addEventListener("online", function(){ if (cur >= 0 && pages[cur] && pages[cur].k === "link") show(cur); });
  window.addEventListener("offline", function(){ if (cur >= 0 && pages[cur] && pages[cur].k === "link") show(cur); });
  // ---------- playlists: several tracks under one item, played in order (or shuffled), carried on in the mini-player ----------
  function plLastK(p){ return npPosKey(p) + "#last"; }
  function plDur(sec){ sec = Math.round(sec || 0); if (!sec) return ""; var h = Math.floor(sec / 3600), m = Math.floor(sec % 3600 / 60), x = sec % 60; return h ? h + ":" + String(m).padStart(2, "0") + ":" + String(x).padStart(2, "0") : m + ":" + String(x).padStart(2, "0"); }
  function plTotal(p){ var t = 0; p.tr.forEach(function(x){ t += x.d || 0; }); if (!t) return ""; var m = Math.round(t / 60); return m >= 60 ? Math.floor(m / 60) + " h " + (m % 60) + " min" : m + " min"; }
  function plOwn(p){ return p && (p.lg || p.lgU) || ""; }                    // the playlist's own logo (square, 512×512)
  function plAnim(p){ return p && plOwn(p) && (p.lga || p.lgaU) || ""; }      // its animated version (SVG), when it has one
  function plPlayingI(){ var s = CUR && npPlaying(CUR) ? CUR : NP && npPlaying(NP) ? NP : null; return s && pages[s.i] && pages[s.i].k === "playlist" ? s.i : -1; }
  function lgMove(){                                                         // logos move while their playlist plays, still otherwise
    var pi = plPlayingI();
    var set = function(img, p, i){ if (!img || !p) return; var want = i === pi && plAnim(p) ? plAnim(p) : plOwn(p); if (want && img.getAttribute("src") !== want) img.src = want; };
    var v = document.querySelector(".plv[data-i]"); if (v){ var vi = +v.dataset.i; set(v.querySelector(".plcov.own img"), pages[vi], vi); }
    if (NP && pages[NP.i] && pages[NP.i].k === "playlist" && !$("npArt").hidden) set($("npArt"), pages[NP.i], NP.i);
  }
  function plArt(p){ return plOwn(p) || (/^data:image\//.test(D.icon || "") ? D.icon : /^data:image\//.test(D.logo || "") ? D.logo : ""); }
  function plView(i){
    var p = pages[i], v = $("view"); v.hidden = false; $("wm").classList.add("onview");
    var art = plPlayingI() === i && plAnim(p) || plArt(p);
    v.innerHTML = '<div class="plv" data-i="' + i + '"><div class="plhd"><div class="plcov' + (plOwn(p) ? " own" : "") + '">' + (art ? '<img alt="" src="' + esc(art) + '">' : ic("playlist")) + '</div>' +
      '<div><div class="plk">Playlist</div><h2>' + esc(p.t) + '</h2><div class="plmeta">' + esc([p.tr.length + " track" + (p.tr.length === 1 ? "" : "s"), plTotal(p)].filter(Boolean).join(" · ")) + '</div></div></div>' +
      '<div class="plctl"><button type="button" class="btn" id="plPP"></button>' +
      '<button type="button" class="btn ghost icon" id="plPrev" aria-label="Previous track" title="Previous track / start again">' + NP_ICO.prev + '</button>' +
      '<button type="button" class="btn ghost" id="plBack" aria-label="Back 10 seconds" title="Back 10 seconds (J)">' + NP_ICO.back + '<span class="lbl">10 s</span></button>' +
      '<button type="button" class="btn ghost" id="plFwd" aria-label="Forward 10 seconds" title="Forward 10 seconds (L)"><span class="lbl">10 s</span>' + NP_ICO.fwd + '</button>' +
      '<button type="button" class="btn ghost icon" id="plNext" aria-label="Next track" title="Next track">' + NP_ICO.next + '</button><span class="sp"></span>' +
      '<button type="button" class="btn ghost" id="plShuf">' + NP_ICO.shuf + '<span class="lbl">Shuffle</span></button>' +
      '<button type="button" class="btn ghost" id="plRep"></button></div>' +
      '<p class="plnow" id="plNow"></p><div class="plplayer"></div>' +
      '<ol class="pllist">' + p.tr.map(function(t, j){
        return '<li><button type="button" data-tr="' + j + '"><span class="n">' + (j + 1) + '</span><span class="tt"><b>' + esc(t.t) + '</b>' + (trBy(t) ? '<span>' + esc(trBy(t)) + '</span>' : "") + '</span><span class="d">' + esc(plDur(t.d)) + '</span></button></li>';
      }).join("") + '</ol></div>';
    var back = npTake(i), s;
    if (back) s = back;
    else {
      var a = document.createElement("audio"); a.controls = true; a.preload = "metadata"; if (!DL_ALL) a.setAttribute("controlsList", "nodownload");
      var last = Math.min(p.tr.length - 1, Math.max(0, npPosGetK(plLastK(p)) || 0));
      s = CUR = {i: i, kind: "media", el: a, tr: last}; npBind(s);
      var auto = npAuto === i; if (auto) npAuto = -1;
      plLoad(s, last, auto, false);
    }
    v.querySelector(".plplayer").appendChild(s.el);
    var box = v.querySelector(".plv");
    box.querySelector(".pllist").addEventListener("click", function(e){
      var b = e.target.closest("[data-tr]"); if (!b) return; var j = +b.dataset.tr;
      if (j === s.tr && s.el.src) npToggle(s); else plLoad(s, j, true, false);
    });
    $("plPP").onclick = function(){ if (!s.el.src) plLoad(s, Math.max(0, s.tr), true, false); else npToggle(s); };
    $("plPrev").onclick = function(){ if (s.el.currentTime > 3 || npPickS(s, -1, false) < 0) s.el.currentTime = 0; else npStep(s, -1); };
    $("plNext").onclick = function(){ if (!npStep(s, 1)) toast("End of the playlist."); };
    $("plBack").onclick = function(){ if (s.el.src) npSeekTo(npInfo(s).t - 10, s); };
    $("plFwd").onclick = function(){ if (s.el.src) npSeekTo(npInfo(s).t + 10, s); };
    $("plShuf").onclick = function(){ npPrefSet("shuf", !npPref().shuf); plPaint(); if (NP) npPaint(); };
    $("plRep").onclick = function(){ var r = npPref().rep || "off"; npPrefSet("rep", r === "off" ? "all" : r === "all" ? "one" : "off"); plPaint(); if (NP) npPaint(); };
    plPaint();
  }
  async function plLoad(s, j, play, tell){                                   // switch the player to track j of its playlist
    var p = pages[s.i]; if (!p.tr || j < 0 || j >= p.tr.length) return;
    s.tr = j; npPosSetK(plLastK(p), j); plPaint();
    try {
      var o = await getTrack(s.i, j);
      if (s.tr !== j) return;                                                // another track was chosen meanwhile
      s.el.src = o.url;
      if (play) s.el.play().catch(function(){});
      evict(-1);
      if (s === NP) npPaint();
      plPaint(); msSync();
      if (tell) toast("Now playing: " + p.tr[j].t);
    } catch(e){ toast(e && e.message === "missing" ? "This song isn't online yet" + (user && user.inst ? " — it isn't in the music folder of your music repository." : " — your instructor is adding it.") : e && e.message === "offline" ? "This song isn't kept on this device yet — play it once with internet." : "This track couldn't be opened."); }
  }
  function plPaint(){
    lgMove();
    var box = document.querySelector("#view .plv"); if (!box) return;
    var s = CUR && CUR.i === +box.dataset.i ? CUR : null; if (!s || !npIsPl(s)) return;
    var p = pages[s.i], on = npPlaying(s), pr = npPref(), rp = pr.rep || "off";
    box.querySelectorAll("[data-tr]").forEach(function(b){ var j = +b.dataset.tr, now = j === s.tr; b.classList.toggle("now", now); b.setAttribute("aria-current", now ? "true" : "false"); b.querySelector(".n").textContent = now && on ? "♪" : j + 1; });
    var started = !!s.el.src && (on || s.el.currentTime > 0 || s.tr > 0);
    $("plPP").innerHTML = (on ? NP_ICO.pause : NP_ICO.play) + '<span>' + (on ? "Pause" : started ? "Play" : "Play all") + '</span>';
    $("plShuf").classList.toggle("on", !!pr.shuf); $("plShuf").setAttribute("aria-pressed", !!pr.shuf); $("plShuf").title = pr.shuf ? "Shuffle: on" : "Shuffle: off";
    $("plRep").innerHTML = NP_ICO.rep + '<span class="lbl">' + (rp === "one" ? "Repeat 1" : "Repeat") + '</span>'; $("plRep").classList.toggle("on", rp !== "off");
    $("plRep").title = rp === "one" ? "Repeat: this track" : rp === "all" ? "Repeat: whole playlist" : "Repeat: off";
    $("plNext").disabled = npPickS(s, 1, false) < 0; $("plBack").disabled = $("plFwd").disabled = !npInfo(s).seek;
    var t = p.tr[s.tr]; $("plNow").innerHTML = t ? (on ? "Now playing: " : "Track " + (s.tr + 1) + ": ") + "<b>" + esc(t.t) + "</b>" + (trBy(t) ? " · " + esc(trBy(t)) : "") : "";
  }
  function fileCard(p, msg){
    return '<div class="filecard"><div><span class="big">' + ic(IC[p.k] ? p.k : "file") + '</span><h3>' + esc(p.nm || p.t) + '</h3><p>' + esc([size(p.sz), msg].filter(Boolean).join(" · ")) + '</p></div></div>';
  }
  function bindDl(v, o, p, ok){
    if (!ok) return;
    var b = document.createElement("button"); b.className = "btn"; b.innerHTML = ic("dl") + "Download";
    b.onclick = function(){ save(o, p); };
    v.querySelector(".filecard>div").appendChild(b);
  }
  function save(o, p){
    if (p.k === "pdf"){ askDl(o, p); return; }                          // PDFs: a stamped copy for this student
    var a = document.createElement("a"); a.href = o.url; a.download = p.nm || p.t || "file";
    document.body.appendChild(a); a.click(); a.remove();
  }

  // ---------- stamped PDF downloads ----------
  var DL_NOTE_DEF = "For personal study only. Do not copy, share, upload, distribute or sell this material. Unauthorized reproduction or distribution is prohibited under R.A. 8293 (Intellectual Property Code of the Philippines).";
  function dlNote(){ return String(D.dlNote || DL_NOTE_DEF).trim(); }
  var dlPend = null, dlBusy = false;
  function askDl(o, p){
    if (dlBusy) return;
    dlPend = {o: o, p: p};
    $("dlWho").textContent = [user.name, user.sn, user.em].filter(Boolean).join(" · ");
    $("dlNoteTxt").textContent = dlNote();
    $("dlPw").hidden = D.dlLock === false; $("dlPwSn").textContent = String(user.sn).trim();
    var m = $("dlAsk");
    (document.fullscreenElement || document.webkitFullscreenElement ? $("stage") : document.body).appendChild(m);
    m.hidden = false; $("dlYes").focus();
  }
  function closeDl(ok){ var x = dlPend; $("dlAsk").hidden = true; dlPend = null; if (ok && x) stampedDownload(x.o, x.p); }
  $("dlNo").onclick = function(){ closeDl(false); };
  $("dlYes").onclick = function(){ closeDl(true); };
  $("dlAsk").addEventListener("click", function(e){ if (e.target === this) closeDl(false); });
  $("dlAsk").addEventListener("keydown", function(e){ if (e.key === "Escape"){ e.stopPropagation(); closeDl(false); } });
  async function stampedDownload(o, p){
    dlBusy = true; $("dlBtn").disabled = true;
    try {
      toast("Preparing your copy…");
      var out = await stampPdf(new Uint8Array(await o.blob.arrayBuffer()), p, function(n, of){ toast("Preparing your copy… page " + n + " of " + of); });
      var base = String(p.nm || p.t || "handout").replace(/\.pdf$/i, "").replace(/[\\/:*?"<>|]+/g, " ").trim() || "handout";
      var url = URL.createObjectURL(new Blob([out], {type: "application/pdf"}));
      var a = document.createElement("a"); a.href = url; a.download = base + "_" + String(user.sn).replace(/[^\w-]+/g, "") + ".pdf";
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function(){ URL.revokeObjectURL(url); }, 60000);
      toast(D.dlLock === false ? "Downloaded — your copy is marked with your name and student number." : "Downloaded — open it with your student number (" + String(user.sn).trim() + ") as the password.");
    } catch(e){
      console.error(e); toast("This handout couldn't be prepared for download. " + ((e && e.message) || ""));
    } finally { dlBusy = false; $("dlBtn").disabled = false; }
  }
  function stampDate(d){ return d.toLocaleDateString("en-US", {year: "numeric", month: "long", day: "numeric"}) + ", " + d.toLocaleTimeString("en-US", {hour: "numeric", minute: "2-digit"}); }
  // Helvetica only knows Western characters: keep what it can draw, simplify accents it can't (ā → a), drop the rest
  function fit(font, s){
    var out = "";
    Array.from(String(s || "")).forEach(function(ch){
      try { font.encodeText(ch); out += ch; }
      catch(e){ var b = ch.normalize("NFD").replace(/[\u0300-\u036f]/g, ""); try { if (b) { font.encodeText(b); out += b; } } catch(e2){ out += "?"; } }
    });
    return out;
  }
  function wrap(font, size, text, maxW){
    var words = text.split(/\s+/), lines = [], cur = "";
    words.forEach(function(w){ var t = cur ? cur + " " + w : w; if (font.widthOfTextAtSize(t, size) <= maxW || !cur) cur = t; else { lines.push(cur); cur = w; } });
    if (cur) lines.push(cur); return lines;
  }
  // A page rendered as an image (for PDFs pdf-lib can't edit, e.g. password-protected ones)
  async function rasterPdf(bytes, prog){
    if (!window.pdfjsLib) throw new Error("The PDF tools are missing from this portal file.");
    if (!pdfjsLib.GlobalWorkerOptions.workerSrc){ var w = document.getElementById("pdfjs-worker"); pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(new Blob([w.textContent], {type: "text/javascript"})); }
    var src = await pdfjsLib.getDocument({data: bytes.slice(0), isEvalSupported: false}).promise, L = PDFLib, doc = await L.PDFDocument.create();
    for (var n = 1; n <= src.numPages; n++){
      if (prog) prog(n, src.numPages);
      var pg = await src.getPage(n), vp1 = pg.getViewport({scale: 1}), sc = Math.min(2.2, 2400 / Math.max(vp1.width, vp1.height)), vp = pg.getViewport({scale: sc});
      var c = document.createElement("canvas"); c.width = Math.ceil(vp.width); c.height = Math.ceil(vp.height);
      var g = c.getContext("2d"); g.fillStyle = "#fff"; g.fillRect(0, 0, c.width, c.height);
      await pg.render({canvasContext: g, viewport: vp}).promise;
      var jpg = await new Promise(function(r){ c.toBlob(r, "image/jpeg", 0.86); });
      var im = await doc.embedJpg(new Uint8Array(await jpg.arrayBuffer()));
      var page = doc.addPage([vp1.width, vp1.height]); page.drawImage(im, {x: 0, y: 0, width: vp1.width, height: vp1.height});
      c.width = c.height = 0; pg.cleanup();
    }
    await src.destroy();
    return doc;
  }
  async function stampPdf(bytes, p, prog){
    var L = window.PDFLib; if (!L) throw new Error("The PDF stamp tool is missing from this portal file.");
    var doc = null;
    try { doc = await L.PDFDocument.load(bytes, {updateMetadata: false}); if (doc.isEncrypted) doc = null; } catch(e){ doc = null; }
    if (!doc) doc = await rasterPdf(bytes, prog);
    var font = await doc.embedFont(L.StandardFonts.Helvetica), bold = await doc.embedFont(L.StandardFonts.HelveticaBold);
    var when = new Date(), who = fit(bold, [user.name, user.sn].filter(Boolean).join("  ·  "));
    var line1 = fit(bold, "Licensed copy for " + [user.name, user.sn, user.em].filter(Boolean).join(" · ") + " — downloaded " + stampDate(when));
    var note = fit(font, dlNote()), title = fit(font, D.title || "");
    var grey = L.rgb(0.42, 0.42, 0.42), ink = L.rgb(0.2, 0.2, 0.2), white = L.rgb(1, 1, 1);
    var pages = doc.getPages();
    pages.forEach(function(page, idx){
      if (prog && idx % 10 === 0) prog(idx + 1, pages.length);
      var box = page.getCropBox(), rot = ((page.getRotation().angle % 360) + 360) % 360;
      var W = box.width, H = box.height, x0 = box.x, y0 = box.y;
      var VW = rot % 180 ? H : W, VH = rot % 180 ? W : H;
      // visual (u, v) from the bottom-left of the page as it's seen → PDF coordinates
      function P(u, v){
        if (rot === 90) return {x: x0 + W - v, y: y0 + u};
        if (rot === 180) return {x: x0 + W - u, y: y0 + H - v};
        if (rot === 270) return {x: x0 + v, y: y0 + H - u};
        return {x: x0 + u, y: y0 + v};
      }
      function text(t, u, v, o){ var q = P(u, v); page.drawText(t, Object.assign({x: q.x, y: q.y, rotate: L.degrees((o.angle || 0) + rot)}, o.style)); }
      function rect(u, v, w, h, style){ var q = P(u, v); page.drawRectangle(Object.assign({x: q.x, y: q.y, width: w, height: h, rotate: L.degrees(rot)}, style)); }
      // 1. light diagonal name stamps: 6 per page, evenly spread, thin type, very faint,
      //    so the page reads normally but every region of it still carries the student's name and number
      var ang = 30, cos = Math.cos(ang * Math.PI / 180), sin = Math.sin(ang * Math.PI / 180), faint = L.rgb(0.55, 0.55, 0.55);
      var ds = Math.max(9, Math.min(13, VW / 46)), dw = font.widthOfTextAtSize(who, ds);
      var rowsN = 3, top = ds * 4, bottom = ds * 7, span = VH - top - bottom;   // 3 rows × 2 = 6 stamps on every page
      for (var r = 0; r < rowsN; r++){
        var my = bottom + span * (r + 0.5) / rowsN;
        [0.27, 0.73].forEach(function(fx, c){
          var mx = VW * (fx + (r % 2 ? 0.05 : -0.05));                                   // stagger alternate rows
          text(who, mx - dw / 2 * cos, my - dw / 2 * sin, {angle: ang, style: {font: font, size: ds, color: faint, opacity: 0.16}});
        });
      }
      // 1b. a thin line of small print up the left margin (outside the text area on most handouts)
      var ms = Math.max(5, Math.min(6.5, VW / 100)), mline = fit(font, "Licensed copy · " + [user.name, user.sn, user.em].filter(Boolean).join(" · ") + " · not for distribution or sale");
      var mlw = font.widthOfTextAtSize(mline, ms);
      if (mlw < VH * 0.9) text(mline, ms * 2.2, (VH - mlw) / 2, {angle: 90, style: {font: font, size: ms, color: grey, opacity: 0.55}});
      // 2. footer band: who, when, and the copyright notice
      var fs = Math.max(5.6, Math.min(7.6, VW / 82)), pad = fs * 0.8, maxW = VW - pad * 4;
      var l1 = wrap(bold, fs, line1, maxW), l2 = wrap(font, fs, note, maxW), lh = fs * 1.28;
      var bandH = (l1.length + l2.length) * lh + pad * 1.4;
      rect(0, 0, VW, bandH, {color: white, opacity: 0.86});
      var yy = bandH - pad * 0.7 - fs;
      l1.forEach(function(t){ text(t, pad * 2, yy, {style: {font: bold, size: fs, color: ink}}); yy -= lh; });
      l2.forEach(function(t){ text(t, pad * 2, yy, {style: {font: font, size: fs, color: ink}}); yy -= lh; });
      // 3. small tag at the top right
      var ts = fs * 0.95, tag = fit(font, "Licensed to " + [user.name, user.sn].filter(Boolean).join(" · ") + " · page " + (idx + 1) + " of " + pages.length), tw = font.widthOfTextAtSize(tag, ts);
      rect(VW - tw - pad * 3, VH - ts - pad * 1.6, tw + pad * 2, ts + pad * 1.2, {color: white, opacity: 0.8});
      text(tag, VW - tw - pad * 2, VH - ts - pad, {style: {font: font, size: ts, color: grey}});
    });
    try {
      doc.setSubject(fit(font, "Licensed copy for " + [user.name, user.sn, user.em].filter(Boolean).join(", ") + " — " + stampDate(when)));
      doc.setKeywords([String(user.sn), String(user.em), "licensed copy", "do not distribute"]);
      if (title && !doc.getTitle()) doc.setTitle(fit(font, p.t || title));
      doc.setProducer("Study portal — personal licensed copy"); doc.setModificationDate(when);
    } catch(e){}
    if (prog) prog(pages.length, pages.length);
    if (D.dlLock !== false) return await pdfLockR6(L, doc, String(user.sn).trim());   // opens only with the student number
    return await doc.save({useObjectStreams: true});
  }
  // PDF password protection (AES-256, PDF 2.0 standard security handler R6) for a pdf-lib document.
  // The file opens only with the user password; the owner password is random, so restrictions can't be lifted in normal readers.
  async function pdfLockR6(L, doc, userPw, perms){
    var S = crypto.subtle, te = new TextEncoder();
    function rnd(n){ return crypto.getRandomValues(new Uint8Array(n)); }
    function cat(){ var n = 0, i, o, a = arguments; for (i = 0; i < a.length; i++) n += a[i].length; o = new Uint8Array(n); n = 0; for (i = 0; i < a.length; i++){ o.set(a[i], n); n += a[i].length; } return o; }
    function hex(u){ var s = ""; for (var i = 0; i < u.length; i++) s += (u[i] < 16 ? "0" : "") + u[i].toString(16); return s; }
    async function aesCbc(keyBytes, iv, data, pad){
      var k = await S.importKey("raw", keyBytes, "AES-CBC", false, ["encrypt"]);
      var out = new Uint8Array(await S.encrypt({name: "AES-CBC", iv: iv}, k, data));
      return pad ? out : out.slice(0, data.length);                 // data is a whole number of blocks: drop WebCrypto's padding block
    }
    async function dig(alg, data){ return new Uint8Array(await S.digest(alg, data)); }
    // ISO 32000-2, 7.6.4.3.4 — Algorithm 2.B
    async function hash2B(pw, salt, udata){
      var K = await dig("SHA-256", cat(pw, salt, udata)), E = new Uint8Array([0]), i = 0;
      while (i < 64 || E[E.length - 1] > i - 32){
        var one = cat(pw, K, udata), K1 = new Uint8Array(one.length * 64);
        for (var r = 0; r < 64; r++) K1.set(one, r * one.length);
        E = await aesCbc(K.slice(0, 16), K.slice(16, 32), K1, false);
        var sum = 0; for (var j = 0; j < 16; j++) sum += E[j];
        var m = sum % 3;
        K = await dig(m === 0 ? "SHA-256" : m === 1 ? "SHA-384" : "SHA-512", E);
        i++;
      }
      return K.slice(0, 32);
    }
    var upw = te.encode(String(userPw).normalize("NFKC")).slice(0, 127);
    var opw = te.encode(hex(rnd(16)));
    var fileKey = rnd(32), zero = new Uint8Array(16);
    var uvs = rnd(8), uks = rnd(8), ovs = rnd(8), oks = rnd(8), none = new Uint8Array(0);
    var U = cat(await hash2B(upw, uvs, none), uvs, uks);
    var UE = await aesCbc(await hash2B(upw, uks, none), zero, fileKey, false);
    var O = cat(await hash2B(opw, ovs, U), ovs, oks);
    var OE = await aesCbc(await hash2B(opw, oks, U), zero, fileKey, false);
    // P: bits 7–8 and 13–32 must be 1; then the allowed actions
    var P = (0xFFFFF0C0 | (perms == null ? (4 | 32 | 256 | 512 | 2048) : perms)) | 0;
    var pb = new Uint8Array(16); pb[0] = P & 255; pb[1] = (P >>> 8) & 255; pb[2] = (P >>> 16) & 255; pb[3] = (P >>> 24) & 255;
    pb[4] = pb[5] = pb[6] = pb[7] = 255; pb[8] = 84; pb[9] = 97; pb[10] = 100; pb[11] = 98; pb.set(rnd(4), 12);
    var Perms = await aesCbc(fileKey, zero, pb, false);           // one block in CBC with a zero IV = ECB

    var fk = await S.importKey("raw", fileKey, "AES-CBC", false, ["encrypt"]);
    async function enc(bytes){ var iv = rnd(16); return cat(iv, new Uint8Array(await S.encrypt({name: "AES-CBC", iv: iv}, fk, bytes))); }
    function hexStr(u){ return L.PDFHexString.of(hex(u)); }
    async function walk(o){                                       // encrypt strings inside dicts and arrays (returns a replacement or null)
      if (o instanceof L.PDFString || o instanceof L.PDFHexString) return hexStr(await enc(o.asBytes()));
      if (o instanceof L.PDFDict){
        var es = o.entries();
        for (var i = 0; i < es.length; i++){ var r = await walk(es[i][1]); if (r) o.set(es[i][0], r); }
      } else if (o instanceof L.PDFArray){
        for (var j = 0; j < o.size(); j++){ var r2 = await walk(o.get(j)); if (r2) o.set(j, r2); }
      }
      return null;
    }
    await doc.flush();
    var ctx = doc.context, objs = ctx.enumerateIndirectObjects();
    for (var n = 0; n < objs.length; n++){
      var ref = objs[n][0], ob = objs[n][1];
      if (ob instanceof L.PDFStream){
        var type = ob.dict.get(L.PDFName.of("Type"));
        if (type && (type === L.PDFName.of("XRef") || type === L.PDFName.of("ObjStm"))) continue;
        var raw = ob.getContents();
        await walk(ob.dict);
        ctx.assign(ref, L.PDFRawStream.of(ob.dict, await enc(raw)));
      } else {
        var rep = await walk(ob); if (rep) ctx.assign(ref, rep);
      }
    }
    var N = L.PDFName.of;
    var encDict = ctx.obj({});
    encDict.set(N("Filter"), N("Standard")); encDict.set(N("V"), L.PDFNumber.of(5)); encDict.set(N("R"), L.PDFNumber.of(6));
    encDict.set(N("Length"), L.PDFNumber.of(256)); encDict.set(N("P"), L.PDFNumber.of(P));
    var std = ctx.obj({}); std.set(N("AuthEvent"), N("DocOpen")); std.set(N("CFM"), N("AESV3")); std.set(N("Length"), L.PDFNumber.of(32));
    var cf = ctx.obj({}); cf.set(N("StdCF"), std);
    encDict.set(N("CF"), cf); encDict.set(N("StmF"), N("StdCF")); encDict.set(N("StrF"), N("StdCF"));
    encDict.set(N("O"), hexStr(O)); encDict.set(N("U"), hexStr(U)); encDict.set(N("OE"), hexStr(OE)); encDict.set(N("UE"), hexStr(UE));
    encDict.set(N("Perms"), hexStr(Perms)); encDict.set(N("EncryptMetadata"), L.PDFBool.True);
    ctx.trailerInfo.Encrypt = ctx.register(encDict);
    var id = hexStr(rnd(16)); ctx.trailerInfo.ID = ctx.obj([id, id]);
    return doc.save({useObjectStreams: false, addDefaultPage: false, updateFieldAppearances: false});
  }
  $("view").addEventListener("contextmenu", function(e){ if (!DL_ALL) e.preventDefault(); });

  var DL_ALL = D.dl === true, DL_PDF = DL_ALL || D.dl === "pdf";
  // ---------- PDF viewer (pdf.js) ----------
  async function showPdf(o, tok){
    if (!window.pdfjsLib) throw new Error("The PDF viewer is missing from this portal file.");
    if (!pdfjsLib.GlobalWorkerOptions.workerSrc){
      var w = document.getElementById("pdfjs-worker");
      pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(new Blob([w.textContent], {type:"text/javascript"}));
    }
    $("loadTxt").textContent = "Preparing pages…";
    var data = new Uint8Array(await o.blob.arrayBuffer());
    var doc = await pdfjsLib.getDocument({data: data, isEvalSupported: false}).promise;
    if (tok !== navTok){ doc.destroy(); return; }
    var first = await doc.getPage(1);
    var v = $("view"); v.innerHTML = '<div class="pdf"></div>';
    var sc = v.firstChild;
    pdfS = {doc: doc, zoom: 1, sc: sc, base: first.getViewport({scale:1}), pg: [], gen: 0};
    for (var n=1;n<=doc.numPages;n++){
      var el = document.createElement("div"); el.className = "pg"; el.dataset.n = n;
      sc.appendChild(el);
      pdfS.pg.push({el: el, page: n === 1 ? first : null, vp: n === 1 ? pdfS.base : null, gen: -1, task: null});
    }
    pdfS.io = new IntersectionObserver(function(ents){
      ents.forEach(function(en){
        var s = pdfS; if (!s) return;
        var p = s.pg[+en.target.dataset.n - 1];
        if (en.isIntersecting) renderPg(s, p); else dropPg(p);
      });
    }, {root: sc, rootMargin: "800px 0px"});
    pdfS.pg.forEach(function(p){ pdfS.io.observe(p.el); });
    sc.addEventListener("scroll", pdfLabel, {passive:true});
    $("pdfCtl").hidden = false;
    layoutPdf();
  }
  function pdfScale(s){ var w = Math.min(s.sc.clientWidth - 32, 960); return Math.max(0.2, w / s.base.width) * s.zoom; }
  function layoutPdf(){
    var s = pdfS; if (!s) return;
    s.gen++; var sc = pdfScale(s);
    s.pg.forEach(function(p){
      var vp = p.vp || s.base;
      p.el.style.width = Math.floor(vp.width * sc) + "px"; p.el.style.height = Math.floor(vp.height * sc) + "px";
      dropPg(p);
    });
    // re-render what's visible
    s.io.disconnect(); s.pg.forEach(function(p){ s.io.observe(p.el); });
    pdfLabel();
  }
  async function renderPg(s, p){
    if (p.gen === s.gen || p.busy) return;
    p.busy = true;
    try{
      var gen = s.gen;
      if (!p.page){ p.page = await s.doc.getPage(+p.el.dataset.n); p.vp = p.page.getViewport({scale:1}); }
      if (s.dead) return;
