  function synFocusOK(){ return !!$("fmBtn") && !$("fmBtn").hidden; }
  async function synManifest(){ if (!SYN.m) SYN.m = await (SYN.busy || (SYN.busy = synBuild())); SYN.busy = null; window.SYNAPSE_MANIFEST = SYN.m; return SYN.m; }
  async function synOpen(){
    if (!SYNHTML || !user) return;
    if (CB){ toast("SYNAPSE is closed during closed-book activities."); return; }
    PORTAL_SYN.focus = synFocusOK() ? function(){ $("synBox").hidden = true; $("fmBtn").click(); } : null;
    $("synFocus").hidden = !PORTAL_SYN.focus; $("synX").innerHTML = ic("close");
    toast("Preparing SYNAPSE from this portal…");
    await synManifest();
    var f = $("synFrame");
    if (f.dataset.who !== D.id + ":" + user.sn){ f.dataset.who = D.id + ":" + user.sn; f.srcdoc = synWithShim(SYNHTML); } else synThemeSend(f.contentWindow);
    $("toast").hidden = true; $("synBox").hidden = false;
  }

  // ---------- SYNAPSE takes on the colours of the lessons it carries ----------
  // A sensor reads the lesson the student is on (else the last lesson they opened, else the first lesson): page colour, text,
  // accent, header band, cards, lines, corners and font. It hands them to SYNAPSE's own theme hook (SYNAPSE.setTheme), so the
  // logo, name and welcome message stay SYNAPSE's while the colours match. Students can still pick "SYNAPSE identity" under
  // Appearance; the instructor can switch the sensor off in the builder.
  var SYNTH = D.synTh !== false, SYNTPL = D.synTpl !== false;        // colours; template (fonts, layout details)
  SYN.th = {}; SYN.last = -1;
  function synThOk(i){ var p = pages[i]; return !!p && p.k === "html" && !synIsCenter(p) && !synSkip(p) && !notYet(p); }
  var TH_CV = null, TH_C = {};
  function thCol(v){                                                         // any CSS colour -> [r,g,b,a] (null when not a colour)
    v = String(v || "").trim(); if (!v || v.length > 90 || /var\(|currentcolor|inherit|initial|unset/i.test(v)) return null;
    if (TH_C[v] !== undefined) return TH_C[v];
    var out = null;
    try {
      if (window.CSS && CSS.supports && CSS.supports("color", v)){
        if (!TH_CV){ TH_CV = document.createElement("canvas"); TH_CV.width = TH_CV.height = 1; }
        var x = TH_CV.getContext("2d", {willReadFrequently: true}); x.clearRect(0, 0, 1, 1); x.fillStyle = "#000"; x.fillStyle = v; x.fillRect(0, 0, 1, 1);
        var d = x.getImageData(0, 0, 1, 1).data; out = [d[0], d[1], d[2], d[3] / 255];
      }
    } catch(e){}
    return (TH_C[v] = out);
  }
  function thLum(c){ var v = c.slice(0, 3).map(function(x){ x /= 255; return x <= .04045 ? x / 12.92 : Math.pow((x + .055) / 1.055, 2.4); }); return .2126 * v[0] + .7152 * v[1] + .0722 * v[2]; }
  function thCon(a, b){ var x = thLum(a), y = thLum(b); return (Math.max(x, y) + .05) / (Math.min(x, y) + .05); }
  function thSat(c){ var mx = Math.max(c[0], c[1], c[2]) / 255, mn = Math.min(c[0], c[1], c[2]) / 255; return mx === mn ? 0 : (mx - mn) / (1 - Math.abs(mx + mn - 1)); }
  function thHue(c){ var r = c[0] / 255, g = c[1] / 255, b = c[2] / 255, mx = Math.max(r, g, b), d = mx - Math.min(r, g, b); if (!d) return 0;
    var h = mx === r ? ((g - b) / d) % 6 : mx === g ? (b - r) / d + 2 : (r - g) / d + 4; return (h * 60 + 360) % 360; }
  function thMix(a, b, t){ return [0, 1, 2].map(function(k){ return Math.round(a[k] + (b[k] - a[k]) * t); }).concat(1); }
  function thStr(c){ return "rgb(" + c[0] + ", " + c[1] + ", " + c[2] + ")"; }
