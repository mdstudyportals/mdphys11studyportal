    }
    function upper(el, st){ return st.textTransform === "uppercase" && px(st.letterSpacing) >= 0.6 && px(st.fontSize) <= 15 && (el.textContent || "").trim().length > 2; }
    function scan(root, avoid, fn){ var L = root.querySelectorAll("span,div,p,small,h5,h6,b,strong,em,a,li"); for (var k = 0; k < L.length && k < 900; k++){ if (avoid && skip(L[k], avoid)) continue; var st = cs(L[k]); if (fn(L[k], st)) return L[k]; } return null; }
    function fam(v){ return String(v || "").split(",")[0].replace(/["']/g, "").trim().toLowerCase(); }
    var cov = null, cl = doc.querySelectorAll(COVER);
    for (var q0 = 0; q0 < cl.length && q0 < 30; q0++){
      if (cl[q0] === doc.body || cl[q0] === doc.documentElement) continue;
      var cvs0 = cs(cl[q0]), cbg0 = solid(cvs0.backgroundColor); if (/gradient/.test(cvs0.backgroundImage) || (cbg0 && thCon(cbg0, c.bg) > 3)){ cov = cl[q0]; break; }
    }
    // the top bar (fixed or sticky at the top, full width, solid colour)
    var band = null, all = doc.querySelectorAll("header,nav,div,section");
    for (var k = 0; k < all.length && k < 600; k++){
      var st0 = cs(all[k]); if (!/fixed|sticky/.test(st0.position) || px(st0.top) > 2) continue;
      if (cov && cov.contains(all[k])) continue;
