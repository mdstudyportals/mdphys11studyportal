  document.addEventListener("fullscreenchange", function(){ setTimeout(layoutPdf, 100); if (isFs()) wake(); else toggleKeys(false); });
  document.addEventListener("webkitfullscreenchange", function(){ setTimeout(layoutPdf, 100); if (isFs()) wake(); });
