    $("inkBtn").setAttribute("aria-pressed", INK.on);
    ink.surfaces.forEach(inkPointerMode);
    $("view").classList.toggle("inking", INK.on);
    inkBarState();
  }
  function setTool(t){ INK.tool = t; ink.surfaces.forEach(inkPointerMode); inkBarState(); }
  function inkBarState(){
    var bar = $("inkbar"); if (!bar) return;
    bar.querySelectorAll("[data-tool]").forEach(function(b){ b.setAttribute("aria-pressed", b.dataset.tool === INK.tool); });
    var hl = INK.tool === "hl", col = (hl ? INK_HL : INK_PEN)[INK.color];
    $("inkColor").querySelector(".dot").style.background = col;
    $("inkColor").title = "Color: " + (hl ? INK_HL_NAMES : INK_NAMES)[INK.color] + " (C)";
    var sz = $("inkSize").querySelector(".sz"); sz.style.height = sz.style.width = [6, 10, 15][INK.size] + "px";
    $("inkSize").title = "Size: " + INK_SIZE[INK.size].n + " (S)";
    $("inkUndo").disabled = !ink.hist.length; $("inkRedo").disabled = !ink.redo.length; $("inkClear").disabled = !hasNotes();
  }

  var toastT;
  function toast(m){ var t = $("toast"); t.textContent = m; t.hidden = false; clearTimeout(toastT); toastT = setTimeout(function(){ t.hidden = true; }, 3500); }
  $("inkBtn").onclick = function(){ setInk(!INK.on); };
  $("inkDone").onclick = function(){ setInk(false); };
  $("inkbar").addEventListener("click", function(e){ var b = e.target.closest("[data-tool]"); if (b) setTool(b.dataset.tool); });
  $("inkColor").onclick = function(){ INK.color = (INK.color + 1) % INK_PEN.length; inkBarState(); };
  $("inkSize").onclick = function(){ INK.size = (INK.size + 1) % INK_SIZE.length; inkBarState(); };
  $("inkUndo").onclick = inkUndo; $("inkRedo").onclick = inkRedo; $("inkClear").onclick = inkClear;

  // ---------- page display ----------
  var pdfS = null;
  function clearView(){
    if (pdfS){ pdfS.dead = true; if (pdfS.io) pdfS.io.disconnect(); try { pdfS.doc.destroy(); } catch(e){} pdfS = null; }
    $("view").innerHTML = ""; $("view").hidden = true;
    $("frame").hidden = true; $("frame").srcdoc = "";
    $("pdfCtl").hidden = true; $("dlBtn").hidden = true;
    ink.surfaces = [];
    $("wm").classList.remove("onview");
  }

  // ---------- required items (attendance), post-tests, closed-book sensor ----------
  // An item marked Required in Portal Builder has a logging period (from → until). Inside it: a video can't be skipped ahead
  // and plays at 1.25× at most; a reading needs a minimum time and reaching its end. Finishing is recorded as attendance.
  // A post-test (optional) opens once the item is finished: one closed-book attempt; its key and rationales open after the
  // period ends, when the test itself is no longer available. After the period the item stays viewable, but nothing is logged.
  var CB = null, rqCur = null, lastAct = Date.now(), rqTold = 0;
  function rqOf(p){ return p && p.rq && p.rq.until && !ivFull() ? p.rq : null; }
  function rqT(s){ var t = Date.parse(s); return isNaN(t) ? 0 : t; }
  function rqPhase(r){ var n = effNow(); if (r.from && n < rqT(r.from)) return "early"; return n <= rqT(r.until) ? "open" : "closed"; }
  function rqGet(p){ var st = scLoad(), o = st.rq && st.rq[lockId(p)]; return o || {max: 0, secs: 0, end: false, done: null, pt: null}; }
  function rqPut(p, o){ var st = scLoad(); st.rq = st.rq || {}; st.rq[lockId(p)] = o; scStore(st); }
  function fmtWhen(s){ return new Date(rqT(s)).toLocaleString(undefined, {month: "short", day: "numeric", hour: "numeric", minute: "2-digit"}); }
  function clock(s){ s = Math.max(0, Math.floor(s)); var h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60; return (h ? h + ":" + String(m).padStart(2, "0") : m) + ":" + String(x).padStart(2, "0"); }
  function rqMedia(p){ return p.k === "video" || p.k === "audio" || (p.k === "link" && !rqTm(p)); }
  function rqTm(p){ return !!(p && p.k === "link" && p.rq && p.rq.tm); }        // a link whose player reports nothing: time kept open counts
  function rqKind(p){ return p.k === "link" ? (p.ico === "audio" ? "Recording" : "Video") + " (" + (p.svc || "online") + ")" : p.k === "video" ? "Video" : p.k === "audio" ? "Recording" : p.k === "pdf" ? "Reading (PDF)" : "Reading / activity"; }
  function rqTell(m){ if (Date.now() - rqTold > 2500){ rqTold = Date.now(); toast(m); } }
  function rqQueue(rec){
    if (!SC || !user || ivOn()) return;
    var st = scLoad();
    st.queue.push(Object.assign({id: rid(), portal: D.id, portalTitle: D.title || "", sn: user.sn, name: user.name, email: user.em, tok: user.tok || "", at: new Date(effNow()).toISOString()}, rec));
    st.to = {u: SC.u, k: SC.k}; scStore(st); flushScores();
  }
  // ---------- visit counter ----------
  // One visit = one stretch of using the portal; coming back after 30 minutes or more away counts as a new visit.
  // Counted per student on this device, shown in the contents, and sent to the instructor's Google Sheet (Visits tab) as
  // this device's running total, so a lost or late message never undercounts and the sheet adds up phone + laptop.
  var VIS_GAP = 30 * 60000;
  function visKey(){ return "portal-visits:" + D.id + ":" + String(user.sn || "").replace(/[\s-]/g, "").toUpperCase(); }
  function visGet(){ try { return JSON.parse(localStorage.getItem(visKey()) || "null") || {n: 0, first: "", last: 0}; } catch(e){ return {n: 0, first: "", last: 0}; } }
  function visSet(v){ try { localStorage.setItem(visKey(), JSON.stringify(v)); } catch(e){} }
  function visDev(){ try { var d = localStorage.getItem("portal-dev"); if (!d){ d = rid(); localStorage.setItem("portal-dev", d); } return d; } catch(e){ return "device"; } }
  function visOn(){ return !!user && !user.inst && !ivOn(); }
  function visCount(){
    if (!visOn()) return;
    var v = visGet(), now = Date.now();
    if (v.last && now - v.last < VIS_GAP && now >= v.last){ v.last = now; visSet(v); visPaint(v); return; }   // the same visit
    v.n = (v.n || 0) + 1; v.last = now; if (!v.first) v.first = new Date(effNow()).toISOString(); visSet(v); visPaint(v);
    if (SC){
      var st = scLoad(); st.queue = st.queue.filter(function(q){ return q.type !== "visit"; }); scStore(st);   // only the newest total waits
      rqQueue({type: "visit", item: "Portal visit", itemTitle: "Portal visit", itemId: "visit", n: v.n, dev: visDev(), first: v.first});
    }
  }
  function visSeen(){ if (!visOn() || document.hidden) return; var v = visGet(); if (v.n){ v.last = Date.now(); visSet(v); } }
  function visPaint(v){
    var el = $("navVis"); if (!el) return; v = v || visGet(); if (!v.n){ el.hidden = true; return; }
    var since = v.first ? new Date(v.first).toLocaleDateString(undefined, {month: "short", day: "numeric", year: "numeric"}) : "";
    el.innerHTML = ic("eye") + '<span>' + (v.n === 1 ? "<b>First visit</b> — welcome!" : "Visits: <b>" + v.n + "</b>" + (since ? " · since " + esc(since) : "")) + '</span>';
    el.title = "How many times you've opened this portal on this device (a new visit after 30 minutes away)"; el.hidden = false;
  }
  document.addEventListener("visibilitychange", function(){ if (!visOn()) return; if (document.hidden) visSeen(); else visCount(); });
  setInterval(visSeen, 120000);
  window.addEventListener("pagehide", visSeen);
  function rqSend(i){
    var p = pages[i], r = rqOf(p), s = rqGet(p); if (!r || !s.done) return;
    rqQueue({type: "attend", item: p.t, itemTitle: p.t, itemId: lockId(p), ix: i, kind: rqKind(p), done: s.done, secs: Math.round(s.secs || 0), until: r.until,
             hasPt: !!(r.pt && r.pt.length), pt: s.pt ? {score: s.pt.score, total: s.pt.total, at: s.pt.at, left: !!s.pt.left, why: s.pt.why || ""} : null});
  }
  function rqComplete(i){
    var p = pages[i], r = rqOf(p), s = rqGet(p); if (!r || s.done || rqPhase(r) !== "open") return;
    s.done = new Date(effNow()).toISOString(); rqPut(p, s); rqSend(i);
    toast(r.pt && r.pt.length ? "Completed and recorded. The post-test is now open." : "Completed — recorded as attendance.");
    rqPaint(); paintRq();
  }
  function paintRq(){ paintOp(); paintRq2(); }
  function paintRq2(){
    document.querySelectorAll("nav button.item").forEach(function(b){
      var p = pages[+b.dataset.i], old = b.querySelector(".rqb"); if (old) old.remove();
      var r = rqOf(p); if (!r) return;
      var s = rqGet(p), ph = rqPhase(r), x = document.createElement("span"); x.className = "rqb";
      var needPt = r.pt && r.pt.length && !s.pt;
      if (s.done && !needPt){ x.textContent = "✓ Done"; x.classList.add("ok"); }
      else if (s.done && ph === "open"){ x.textContent = "Post-test"; }
      else if (ph === "open"){ x.textContent = "Required"; }
      else if (ph === "early"){ x.textContent = "Soon"; x.classList.add("off"); }
      else { x.textContent = s.done ? "✓ Done" : "Closed"; x.classList.add(s.done ? "ok" : "off"); }
      x.title = ph === "open" ? "Required — recorded until " + fmtWhen(r.until) : ph === "early" ? "Recording opens " + fmtWhen(r.from) : "Recording ended " + fmtWhen(r.until);
      b.appendChild(x);
    });
  }
  // The strip above the content: what is required, progress, and the post-test button
  function rqPaint(){
    var bar = $("rqBar"), p = pages[cur], r = rqOf(p);
    if (CB && CB.type === "exam" && CB.i === cur){
      bar.className = "rqbar cb"; bar.hidden = false;
      bar.innerHTML = ic("lock") + "<span><b>Closed-book exam mode is on.</b> Leaving this page, switching tabs or apps, opening any other page of the portal, or opening the answer key signs you out.</span>";
      return;
    }
    if (CB && CB.type === "pt" && CB.i === cur){
      bar.className = "rqbar cb"; bar.hidden = false;
      bar.innerHTML = ic("lock") + "<span><b>Post-test in progress — closed book.</b> Switching tabs or apps, or opening any other page of the portal, closes it and submits your answers as they are.</span>";
      return;
    }
    if (!r){ bar.hidden = true; return; }
    var s = rqGet(p), ph = rqPhase(r), n = r.pt ? r.pt.length : 0, h = "", btn = "", cls = "rqbar";
    var what = rqMedia(p) ? "watch it to the end" : rqTm(p) ? "keep it open here for at least " + (+r.min || 0) + " min" : "spend at least " + (+r.min || 0) + " min on it and reach the end";
    if (ph === "early") h = "<b>Required " + esc(rqKind(p).toLowerCase()) + ".</b> Recording opens " + esc(fmtWhen(r.from)) + " and ends " + esc(fmtWhen(r.until)) + ". You can preview it now; it isn't recorded yet.";
    else if (ph === "open" && !s.done){
      var prog = rqMedia(p) ? "Watched " + clock(s.max) + (rqCur && rqCur.dur ? " of " + clock(rqCur.dur) : "")
                            : rqTm(p) ? "Time open " + clock(s.secs) + " / " + clock((+r.min || 0) * 60) + " — it counts only while this page is on screen and you're online"
                            : "Time " + clock(s.secs) + " / " + clock((+r.min || 0) * 60) + " · end " + (s.end ? "reached ✓" : "not reached yet");
      h = "<b>Required — " + what + " by " + esc(fmtWhen(r.until)) + ".</b> " + (rqMedia(p) ? "No skipping ahead; speed up to 1.25×. " : "") + '<span class="pr">' + prog + "</span>" + (n ? " A " + n + "-item post-test follows." : "");
    } else if (ph === "open" && s.done && n && !s.pt){
      h = "<b>Completed ✓ recorded.</b> Post-test: " + n + " item" + (n === 1 ? "" : "s") + ", <b>closed book</b>, one attempt — take it by " + esc(fmtWhen(r.until)) + ".";
      btn = '<button class="btn sm" id="rqGo" type="button">Take the post-test</button>'; cls += " go";
    } else if (ph === "open" && s.done){
      h = "<b>Completed ✓ recorded as attendance.</b>" + (s.pt ? " Post-test score: <b>" + s.pt.score + " / " + s.pt.total + "</b>. The answer key and rationales open after " + esc(fmtWhen(r.until)) + "." : ""); cls += " ok";
    } else {
      h = (s.done ? "<b>Completed on time ✓ (recorded).</b> " : "<b>The recording period ended " + esc(fmtWhen(r.until)) + ".</b> You can still view this, but it is no longer recorded. ") +
          (n ? (s.pt ? "Post-test: " + s.pt.score + "/" + s.pt.total + ". " : "The post-test is closed. ") : "");
      if (n) btn = '<button class="btn ghost sm" id="rqGo" type="button">Answer key and rationales</button>';
      cls += s.done ? " ok" : " off";
    }
    bar.className = cls; bar.innerHTML = ic(s.done ? "lock" : "cal") + "<span>" + h + "</span>" + btn; bar.hidden = false;
    var g = $("rqGo"); if (g) g.onclick = function(){ if (rqPhase(r) === "closed") ptReview(cur); else ptAsk(cur); };
  }
  // Video / audio: no skipping ahead, 1.25× at most, resumes where the student stopped
  function rqWatch(el, i, tok){
    var p = pages[i], r = rqOf(p); if (!r) return;
    var s = rqGet(p), lastT = null, saved = 0, enf = rqPhase(r) === "open" && !s.done;
    rqCur = {i: i, media: true, dur: 0};
    el.addEventListener("loadedmetadata", function(){ rqCur.dur = el.duration || 0; if (enf && s.max > 1 && s.max < el.duration - 1) el.currentTime = s.max; rqPaint(); });
    el.addEventListener("ratechange", function(){ if (enf && el.playbackRate > 1.25){ el.playbackRate = 1.25; rqTell("Required viewing: speed is limited to 1.25×."); } });
    el.addEventListener("seeking", function(){ lastT = null; if (enf && el.currentTime > s.max + 0.75){ el.currentTime = s.max; rqTell("Required viewing: you can't skip ahead. You can go back and replay."); } });
    el.addEventListener("pause", function(){ lastT = null; if (enf){ rqPut(p, s); rqPaint(); } });
    el.addEventListener("timeupdate", function(){
      if (tok !== navTok || !enf) return;
      if (rqPhase(r) !== "open"){ enf = false; rqPaint(); return; }
      var t = el.currentTime;
      if (!el.seeking && !el.paused){
        if (lastT != null){ var d = t - lastT; if (d > 0 && d < 2){ s.secs += d / (el.playbackRate || 1); if (t <= s.max + 2) s.max = Math.max(s.max, t); } }
        lastT = t;
      }
      if (Date.now() - saved > 4000){ saved = Date.now(); rqPut(p, s); rqPaint(); }
    });
    el.addEventListener("ended", function(){
      if (tok !== navTok || !enf) return;
      if (s.max >= (el.duration || 0) - 2){ s.end = true; s.max = el.duration || s.max; rqPut(p, s); enf = false; rqComplete(i); }
    });
  }
  // Online video / audio (YouTube through your player page, Spotify): the same rules, from the position the player reports.
  // Only real playing counts; skipping ahead or playing faster than 1.25× sends it back to where the student has reached.
  function rqSeek(e, t){ try { if (e.ctl && e.ctl.seek) e.ctl.seek(t); else if (e.el) npSend(e, "seek", t); } catch(x){} e._t = t; }
  function rqEmbTick(){
    (NP && NP !== CUR ? [CUR, NP] : [CUR]).forEach(function(e){
      if (!e || e.kind !== "embed" || e.i == null) return;
      var p = pages[e.i], r = rqOf(p); if (!r || p.k !== "link" || rqTm(p)) return;
      if (cur === e.i && (!rqCur || rqCur.i !== e.i || rqCur.dur !== (e.d || 0))){ rqCur = {i: e.i, media: true, dur: e.d || 0}; rqPaint(); }
      var s = e.rqS || (e.rqS = rqGet(p));
      if (s.done || rqPhase(r) !== "open" || typeof e.t !== "number" || !e.tAt || e._at === e.tAt) return;
      var first = !e._at, w = first ? 0 : (e.tAt - e._at) / 1000, prev = first ? e.t : e._t, d = e.t - prev; e._at = e.tAt; e._t = e.t;
      var pv = /Spotify/.test(e.svc) && e.preview;
      if (pv){ rqTell("Required: a 30-second Spotify preview doesn't count. Sign in to Spotify in this browser, then reload the player."); return; }
      if (first && s.max > 5 && e.t < s.max - 5 && !(e.d && s.max >= e.d - 3)){ rqSeek(e, s.max); toast("Required viewing: continuing where you stopped (" + clock(s.max) + ")."); return; }
      var allow = w * 1.25 + 0.6;
      if (e.t > s.max + Math.max(4, allow + 2)){ rqSeek(e, s.max); rqTell(d > 0 && d <= w * 2.2 + 1 ? "Required viewing: speed is limited to 1.25×." : "Required viewing: you can't skip ahead. You can go back and replay."); return; }
      if (e.state === "playing" && w > 0 && d > 0){ var adv = Math.min(d, allow); s.secs += Math.min(d, w); if (prev <= s.max + 1) s.max = Math.max(s.max, Math.min(e.t, prev + adv)); }
      if (e.d && s.max >= e.d - 2.5){ s.end = true; s.max = e.d; rqPut(p, s); e.rqS = null; rqComplete(e.i); return; }
      if (Date.now() - (e._sv || 0) > 4000){ e._sv = Date.now(); rqPut(p, s); if (cur === e.i) rqPaint(); }
    });
  }
  setInterval(rqEmbTick, 1000);
  // Reading / activity: time actually spent with the page in front, plus reaching the end
  function rqEnd(){
    try {
      if (pages[cur].k === "pdf"){ var sc = pdfS && pdfS.sc; return !!sc && sc.scrollTop + sc.clientHeight >= sc.scrollHeight - 80; }
      var w = $("frame").contentWindow, de = w.document.scrollingElement || w.document.documentElement;
      return de.scrollHeight <= w.innerHeight + 80 || w.scrollY + w.innerHeight >= de.scrollHeight - 80;
    } catch(e){ return false; }
  }
  ["pointerdown", "keydown", "wheel", "touchstart", "mousemove", "scroll"].forEach(function(ev){ document.addEventListener(ev, function(){ lastAct = Date.now(); }, {passive: true, capture: true}); });
  function rqActHook(w){ ["pointerdown", "keydown", "wheel", "touchstart", "mousemove", "scroll"].forEach(function(ev){ w.addEventListener(ev, function(){ lastAct = Date.now(); }, {passive: true, capture: true}); }); }
  setInterval(function(){
    if (!user || cur < 0) return;
    if (CB && CB.type === "exam"){                                          // exam in progress: still on the test? finished?
      try {
        var kh = keyHeadsVisible(CB.d).filter(function(el){ return CB.keys.indexOf(el) < 0; });
        if (kh.length && !keyGateIn(kh[0].closest('[data-view],[data-page],.view,.page,.slide') || CB.d.body)){ cbLeft("opened the answer key", true); return; }
        if (CB.box && !visible(CB.box)){ cbLeft(kh.length ? "opened the answer key page" : "opened another page of the handout", kh.length > 0); return; }
        if (CB.snap != null){ var now = examSnap(CB.d); if (now && now !== CB.snap){ CB = null; rqPaint(); } }
      } catch(e){}
      return;
    }
    var p = pages[cur], r = rqOf(p);
    if (!r || rqMedia(p) || !rqCur || rqCur.i !== cur || !rqCur.ready) return;
    if (rqPhase(r) !== "open"){ if (rqCur.open){ rqCur.open = false; rqPaint(); paintRq(); } return; }
    rqCur.open = true;
    var s = rqCur.s; if (s.done || CB) return;
    if (rqTm(p)){                                                          // a video link: on screen and online (watching needs no clicks)
      if (document.hidden || navigator.onLine === false || !$("loading").hidden) return;
      s.secs += 1; s.end = true;
    } else {
      if (document.hidden || !document.hasFocus() || Date.now() - lastAct > 180000 || !$("loading").hidden) return;   // only while actually reading
      s.secs += 1; if (!s.end && rqEnd()) s.end = true;
    }
    if (++rqCur.n % 5 === 0){ rqPut(p, s); rqPaint(); }
    if (s.secs >= (+r.min || 0) * 60 && s.end){ rqPut(p, s); rqComplete(cur); }
  }, 1000);
  function rqRead(i){ var p = pages[i]; if (!rqOf(p) || rqMedia(p)) return; rqCur = {i: i, s: rqGet(p), n: 0, ready: true, open: rqPhase(rqOf(p)) === "open"}; }

  // ---- generic confirmation (closed-book notices)
  var cbGo = null;
  function ask(title, html, yes, go){
    var m = $("cbAsk"); cbGo = go;
    $("cbAskT").textContent = title; $("cbAskB").innerHTML = html; $("cbYes").textContent = yes;
    (document.fullscreenElement || document.webkitFullscreenElement ? $("stage") : document.body).appendChild(m);
    m.hidden = false; $("cbYes").focus();
  }
  function askClose(ok){ var g = cbGo; cbGo = null; $("cbAsk").hidden = true; if (ok && g) g(); }
  $("cbNo").onclick = function(){ askClose(false); };
  $("cbYes").onclick = function(){ askClose(true); };
  $("cbAsk").addEventListener("keydown", function(e){ if (e.key === "Escape"){ e.stopPropagation(); askClose(false); } });
  var CB_RULE = "This is a <b>closed-book</b> activity, unlike the readings and quick checks. ";

  // ---- post-test
  function ptAsk(i){
    var p = pages[i], r = rqOf(p), s = rqGet(p);
    if (!r || !r.pt || !r.pt.length || s.pt || !s.done || rqPhase(r) !== "open") return;
    ask("Start the post-test?", "<p>" + CB_RULE + r.pt.length + " item" + (r.pt.length === 1 ? "" : "s") + ", <b>one attempt</b>.</p>" +
        "<p>Once you start, <b>switching tabs or apps for 5 seconds or more, or opening any other page of the portal, closes the post-test</b> and submits your answers as they are. Notifications don't count.</p>" +
        "<p class='fine'>You see your score right after submitting. The answer key and rationales open after " + esc(fmtWhen(r.until)) + ".</p>", "Start post-test", function(){ ptStart(i); });
  }
  function ptStart(i){
    var p = pages[i], r = rqOf(p); if (cur !== i) return;
    document.querySelectorAll("#view video, #view audio").forEach(function(m){ try { m.pause(); } catch(e){} });
    if (isFs()) try { (document.exitFullscreen || document.webkitExitFullscreen).call(document); } catch(e){}
    CB = {type: "pt", i: i, t0: Date.now()}; brief = 0; away = null; npQuiet(); rqPaint();
    var h = '<div class="ptin"><div class="pth"><h3>Post-test — ' + esc(p.t) + '</h3><p>' + ic("lock") + '<span><b>Closed book.</b> Stay on this page: switching tabs or apps, or opening any other page of the portal, closes the post-test and submits your answers as they are.</span></p></div><form id="ptForm">';
    r.pt.forEach(function(q, n){
      h += '<fieldset class="ptq"><legend><b>' + (n + 1) + '.</b> ' + esc(q.q) + '</legend>' + q.o.map(function(o, k){
        return '<label><input type="radio" name="q' + n + '" value="' + k + '"><span><b>' + String.fromCharCode(65 + k) + '.</b> ' + esc(o) + '</span></label>'; }).join("") + '</fieldset>';
    });
    h += '<div class="ptf"><span id="ptCount">0 of ' + r.pt.length + ' answered</span><button class="btn" type="submit">Submit post-test</button></div></form></div>';
    var w = $("ptWrap"); w.innerHTML = h; w.hidden = false; w.scrollTop = 0;
    $("ptForm").addEventListener("change", function(){ $("ptCount").textContent = w.querySelectorAll("input:checked").length + " of " + r.pt.length + " answered"; });
    $("ptForm").addEventListener("submit", function(e){
      e.preventDefault();
      var left = r.pt.length - w.querySelectorAll("input:checked").length;
      if (left) ask("Submit with unanswered items?", "<p>" + left + " item" + (left === 1 ? " is" : "s are") + " unanswered and will be marked wrong. You can't reopen the post-test after submitting.</p>", "Submit anyway", function(){ ptSubmit(false); });
      else ptSubmit(false);
    });
  }
  function ptSubmit(left, why){
    if (!CB || CB.type !== "pt") return;
    var i = CB.i, p = pages[i], r = rqOf(p), w = $("ptWrap"), ans = [], score = 0;
    r.pt.forEach(function(q, n){ var c = w.querySelector('input[name="q' + n + '"]:checked'), a = c ? +c.value : -1; ans.push(a); if (a === q.a) score++; });
    CB = null; askClose(false);
    var s = rqGet(p); s.pt = {at: new Date(effNow()).toISOString(), ans: ans, score: score, total: r.pt.length, left: !!left, why: why || ""}; rqPut(p, s);
    w.hidden = true; w.innerHTML = "";
    rqSend(i);
    if (left) rqQueue({type: "event", item: p.t, itemTitle: p.t, itemId: lockId(p), what: "Post-test closed early: " + (why || "left the page") + " — submitted as it was (" + ans.filter(function(a){ return a >= 0; }).length + " of " + r.pt.length + " answered)"});
    toast(left ? "Post-test closed and submitted as it was (score " + score + " / " + r.pt.length + ") — you " + (why || "left the page") + "." : "Post-test submitted and recorded — your score: " + score + " / " + r.pt.length + ". The answer key opens after " + fmtWhen(r.until) + ".");
    if (cur === i) rqPaint(); paintRq();
  }
  function ptReview(i){
    var p = pages[i], r = rqOf(p), s = rqGet(p); if (!r || !r.pt || rqPhase(r) !== "closed") return;
    var mine = s.pt ? s.pt.ans : null;
    var h = '<div class="ptin"><div class="pth"><h3>Post-test answer key — ' + esc(p.t) + '</h3><p><span>' + (s.pt ? "Your score: <b>" + s.pt.score + " / " + s.pt.total + "</b>" + (s.pt.left ? " (closed early)" : "") : "You didn't take this post-test. It closed on " + esc(fmtWhen(r.until)) + ".") + '</span></p></div>';
    r.pt.forEach(function(q, n){
      h += '<div class="ptq rev"><p class="lg"><b>' + (n + 1) + '.</b> ' + esc(q.q) + '</p>' + q.o.map(function(o, k){
        var c = k === q.a ? " right" : mine && mine[n] === k ? " wrong" : "";
        return '<div class="opt' + c + '"><b>' + String.fromCharCode(65 + k) + '.</b> ' + esc(o) + (k === q.a ? " ✓" : "") + (mine && mine[n] === k ? ' <i>(your answer)</i>' : "") + '</div>'; }).join("") +
        (mine && mine[n] < 0 ? '<div class="opt wrong"><i>Not answered</i></div>' : "") + (q.r ? '<p class="rat"><b>Rationale.</b> ' + esc(q.r) + '</p>' : "") + '</div>';
    });
    h += '<div class="ptf"><span></span><button class="btn" type="button" id="ptClose">Close</button></div></div>';
    var w = $("ptWrap"); w.innerHTML = h; w.hidden = false; w.scrollTop = 0;
    $("ptClose").onclick = function(){ w.hidden = true; w.innerHTML = ""; };
  }

  // ---- closed-book sensor: post-test → closes and submits; mock test in exam mode → signs the student out
  var CB_EXAM = /\b(exam|timed|test|assessment)\s*mode\b|^\W*(start|begin|take)\s+(the\s+)?(mock\s+)?exam\b/i;
  function cbLeft(why, key){
    if (!CB) return;
    if (CB.type === "pt"){ ptSubmit(true, why); return; }
    var i = CB.i, p = pages[i]; CB = null;
    var locked = false;
    if (key && p && SC && p.sc && !isLocked(p)){ lockItem(i); locked = true; }   // answer key during the exam: best scores so far become final
    if (p) rqQueue({type: "event", item: p.t, itemTitle: p.t, itemId: lockId(p), what: "Left a mock test in exam mode: " + why + (locked ? " — best scores locked" : "") + " — signed out"});
    $("out").onclick();
    $("err").textContent = "You were signed out because you " + why + " during a mock test in exam mode. Mock tests in exam mode are closed-book." +
      (key && p && p.sc ? " Your best scores in this lesson from before are now final; later attempts won't be recorded." : "");
  }
  // Leaving only counts when it is real: away for 5 seconds or more. A notification banner, the notification shade or an
  // incoming-call banner doesn't hide the page, and on phones and tablets losing focus alone is ignored. A short slip
  // (back within 5 seconds) is forgiven twice per test, with a warning.
  var away = null, brief = 0, AWAY_MS = 5000, TOUCH = !!(window.matchMedia && matchMedia("(pointer: coarse)").matches);
  function cbAway(why){ if (!CB || away) return; away = {t: Date.now(), why: why, timer: setTimeout(cbCheck, AWAY_MS)}; }
  function cbGone(){ return document.hidden || (!TOUCH && !document.hasFocus()); }
  function cbCheck(){ if (!away) return; if (!CB){ away = null; return; } if (cbGone()){ var w = away.why; away = null; cbLeft(w); } else cbBack(); }
  function cbBack(){
    if (!away || cbGone()) return;
    var a = away; clearTimeout(a.timer); away = null; if (!CB) return;
    if (Date.now() - a.t >= AWAY_MS || ++brief > 2) cbLeft(a.why);
    else toast("Closed book — stay on this page. That was short interruption " + brief + " of 2 allowed.");
  }
  function cbBlur(){ if (CB && !TOUCH) setTimeout(function(){ if (CB && !document.hidden && !document.hasFocus()) cbAway("switched to another window or app"); }, 300); }
  document.addEventListener("visibilitychange", function(){ if (document.hidden) cbAway("switched to another tab or app"); else cbBack(); });
  window.addEventListener("blur", cbBlur);
  window.addEventListener("focus", function(){ setTimeout(cbBack, 50); });
  window.addEventListener("pagehide", function(){ if (CB && CB.type === "pt") ptSubmit(true, "closed the portal"); });
  function examSnap(d){ try { return scanAll(d, d.body.innerText || "").filter(function(x){ return x.total >= 5; }).map(function(x){ return x.score + "/" + x.total; }).join(","); } catch(e){ return ""; } }
  function guardExam(w, i, tok){
    if (D.cbx === false) return;
    var d = w.document, allow = null;
    d.addEventListener("click", function(e){
      if (tok !== navTok) return;
      var el = e.target && e.target.closest ? e.target.closest('button,a,[role=tab],[role=button],[role=radio],label,input[type=button],input[type=submit],input[type=radio],.tab,.btn') : null;
      if (!el) return;
      var full = labelOf(el);
      if (CB && CB.type === "exam" && CB.i === i && full && full.length <= 80 && KEY_CTRL.test(full)){          // answer key during the exam
        e.preventDefault(); e.stopImmediatePropagation(); cbLeft("tried to open the answer key", true); return;
      }
      var txt = shortLabel(full); if (!txt || txt.length > 60) return;
      if (CB && CB.type === "exam" && PRAC_RE.test(txt) && !CB_EXAM.test(txt)){ CB = null; rqPaint(); return; }      // switched to practice mode
      if (!CB_EXAM.test(txt) || PRAC_RE.test(txt)) return;
      if (allow === el){ allow = null; return; }
      if (CB && CB.type === "exam") return;
      e.preventDefault(); e.stopImmediatePropagation();
      ask("Start exam mode?", "<p>" + CB_RULE + "</p><p>While the mock test is in exam mode, <b>switching tabs or apps for 5 seconds or more, opening any other page of the portal or of this handout, or opening the answer key signs you out of the portal.</b> Opening the answer key also makes your best scores in this lesson final. Notifications don't count.</p><p class='fine'>Close your notes and other tabs first. Closed-book mode ends when you submit the exam.</p>", "Start exam mode", function(){
        if (tok !== navTok) return;
        var box = el.closest('[data-view],[data-page],.view,.page,.slide,section,article');
        CB = {type: "exam", i: i, box: box, d: d, snap: null, keys: keyHeadsVisible(d)}; brief = 0; away = null; npQuiet();
        allow = el; el.click();
        setTimeout(function(){ if (CB && CB.type === "exam") CB.snap = examSnap(d); }, 400);
        rqPaint();
      });
    }, true);
    w.addEventListener("blur", cbBlur); w.addEventListener("focus", function(){ setTimeout(cbBack, 50); });
  }

  // ---------- Now playing: music and videos keep playing while the student moves to other pages ----------
  // A link embed (YouTube, Spotify, Apple Music…) lives in its own layer over the page, so it never reloads: on its page the
  // layer sits over the page's player area; on other pages it shrinks into the mini-player. Uploaded audio and video move
  // between the page and the mini-player (a media element keeps playing when moved). Pausing is always the student's choice.
  // One item plays in the background at a time; required items still being recorded stay on their own page.
  var NP = null, CUR = null, npRAF = 0, npAuto = -1;
  // Uploaded videos in the mini-player: "video" (picture shown) or "listen" (slim bar, sound only). The student's choice is
  // remembered on this device; the default comes from Portal Builder. YouTube always shows its picture (YouTube's rules
  // don't allow hiding the video or playing audio only, and its player must be at least 200 px tall).
  function npMode(){ var m = null; try { m = localStorage.getItem("portal-np-mode:" + D.id); } catch(e){} return m === "listen" || m === "video" ? m : (D.npv === "listen" ? "listen" : "video"); }
  function npSetMode(m){ try { localStorage.setItem("portal-np-mode:" + D.id, m); } catch(e){} }
  function npYT(p){ return p.k === "link" && /youtube|youtu\.be|yt-player/i.test((p.svc || "") + " " + (p.e || "")); }
  function npOn(){ return D.np !== false; }
  function npAllowed(i){ var p = pages[i], r = rqOf(p); return !(r && rqPhase(r) === "open" && !rqGet(p).done); }
  function npKind(p){ return p.k === "link" ? (/youtube|vimeo|video/i.test(p.svc || "") || p.l === "video" ? "vid" : "aud") : p.k === "video" ? "vid" : "aud"; }
  function npPlaying(s){ if (!s) return false; if (s.kind === "media") return !s.el.paused && !s.el.ended; return s.state == null ? !!s.touched : s.state === "playing"; }
  function npCtl(s){ return s && (s.kind === "media" || s.state != null); }
  // Embed layer: one positioned box per embed, following a target (its page slot, or the mini-player slot)
  function npFrame(p, i){
    var box = document.createElement("div"); box.className = "npframe"; $("stage").appendChild(box);
    var s = {i: i, kind: "embed", box: box, el: null, svc: p.svc || "", state: null, touched: false, ctl: null};
    function plain(){                                                     // an ordinary embed (also the fallback for Spotify)
      if (s.el || !box.isConnected) return;
      var f = document.createElement("iframe");
      f.title = p.t; f.setAttribute("allow", "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture");
      f.allowFullscreen = true; f.referrerPolicy = "strict-origin-when-cross-origin";
      var src = p.e;
      if (/^https:\/\/www\.youtube(-nocookie)?\.com\/embed\//i.test(src)){            // YouTube straight in the portal (no player page):
        s.dir = "yt";                                                     // its player API tells us when it plays or pauses
        src += (src.indexOf("?") > -1 ? "&" : "?") + "enablejsapi=1" + (/^https?:/.test(location.protocol) ? "&origin=" + encodeURIComponent(location.origin) : "");
      } else if (/^https:\/\/player\.vimeo\.com\/video\//i.test(src)) s.dir = "vm";
      box.appendChild(f); f.src = src; s.el = f;
      if (s.dir) f.addEventListener("load", function(){ npHello(s); var n = 0, t = setInterval(function(){ if (!f.isConnected || ++n > 10 || s.state != null) clearInterval(t); else npHello(s); }, 500); });
    }
    var uri = spUri(p.e);
    if (uri){                                                             // Spotify: its official iFrame API, so play/pause can be controlled
      var slot = document.createElement("div"); box.appendChild(slot);
      var late = setTimeout(function(){ if (!s.ctl){ slot.remove(); plain(); } }, 8000);
      spApi(function(API){
        if (s.el || !box.isConnected) return;
        try {
          API.createController(slot, {uri: uri, width: "100%", height: "100%"}, function(ctl){
            clearTimeout(late); s.ctl = ctl; s.el = box.querySelector("iframe");
            ctl.addListener("playback_update", function(e){
              var d = e && e.data; if (!d) return; var was = s.state;
              if (d.duration && /^spotify:(track|album|playlist|artist)/.test(uri)){       // ≈30 s long = Spotify is playing its preview
                var pv = d.duration >= 25000 && d.duration <= 31000;
                if (pv !== !!s.preview){ s.preview = pv; spPreview(s); }
              }
              s.state = d.isPaused ? "paused" : "playing"; if (was !== "playing" && s.state === "playing") npOnly(s);
              if (d.duration) s.d = d.duration / 1000; if (typeof d.position === "number"){ s.t = d.position / 1000; s.tAt = performance.now(); }
              if (s === NP && was !== s.state) npPaint();
            });
          });
        } catch(x){ clearTimeout(late); slot.remove(); plain(); }
      }, function(){ clearTimeout(late); slot.remove(); plain(); });
    } else plain();
    npLoop(); return s;
  }
  // ask a YouTube / Vimeo player to report its play state, position and volume
  function npHello(s){
    if (!s.el || !s.el.contentWindow) return;
    try {
      if (s.dir === "yt") s.el.contentWindow.postMessage(JSON.stringify({event: "listening", id: 1, channel: "widget"}), "*");
      else if (s.dir === "vm") ["play", "pause", "ended", "timeupdate", "volumechange"].forEach(function(ev){ s.el.contentWindow.postMessage(JSON.stringify({method: "addEventListener", value: ev}), "*"); });
    } catch(e){}
  }
  // one way to give any embedded player a command: through the YouTube player page, or straight to YouTube / Vimeo
  function npSend(s, c, v){
    if (!s || !s.el || !s.el.contentWindow) return;
    var w = s.el.contentWindow;
    function yt(fn, args){ w.postMessage(JSON.stringify({event: "command", func: fn, args: args || []}), "*"); }
    function vm(m, val){ w.postMessage(JSON.stringify(val === undefined ? {method: m} : {method: m, value: val}), "*"); }
    try {
      if (s.dir === "yt"){
        if (c === "play") yt("playVideo"); else if (c === "pause") yt("pauseVideo");
        else if (c === "mute") yt("mute"); else if (c === "unmute") yt("unMute");
        else if (c === "vol"){ yt("setVolume", [v]); yt(v > 0 ? "unMute" : "mute"); }
        else if (c === "seek") yt("seekTo", [v, true]);
        else if (c === "next") yt("nextVideo"); else if (c === "prev") yt("previousVideo");
      } else if (s.dir === "vm"){
        if (c === "play") vm("play"); else if (c === "pause") vm("pause");
        else if (c === "mute") vm("setVolume", 0); else if (c === "unmute") vm("setVolume", Math.max(.05, (s.vol || 100) / 100));
        else if (c === "vol") vm("setVolume", Math.max(0, Math.min(1, v / 100)));
        else if (c === "seek") vm("setCurrentTime", v);
      } else w.postMessage(v === undefined ? {portalYT: 1, cmd: c} : {portalYT: 1, cmd: c, v: v}, "*");
    } catch(e){}
  }
  // Spotify plays whole songs only for listeners signed in to Spotify in this browser; otherwise 30-second previews
  var spWarned = false;
  function spPreview(s){
    var h = $("spHelp");
    if (h && CUR === s){ h.classList.toggle("warn", !!s.preview); $("spHelpT").textContent = s.preview ? "This is playing a 30-second preview" : "Playing whole songs"; }
    if (s.preview && !spWarned){ spWarned = true; toast("Spotify is playing 30-second previews. To hear whole songs, sign in to Spotify in this browser — or open it in the Spotify app."); }
    if (NP) npPaint();
  }
  function spAppUrl(p){                                                    // the Spotify app: spotify: link on computers; phones open the app from the normal link
    var uri = spUri(p.e);
    return uri && !matchMedia("(pointer:coarse)").matches ? uri : p.u;
  }
  // "https://open.spotify.com/embed/track/ID?…" → "spotify:track:ID"
  function spUri(u){ var m = /open\.spotify\.com\/embed\/(?:intl-[\w-]+\/)?(track|album|playlist|episode|show|artist)\/([A-Za-z0-9]+)/.exec(u || ""); return m ? "spotify:" + m[1] + ":" + m[2] : ""; }
  var SP = {api: null, wait: [], fail: [], loading: false};
  function spApi(ok, bad){
    if (SP.api){ ok(SP.api); return; }
    SP.wait.push(ok); SP.fail.push(bad);
    if (SP.loading) return; SP.loading = true;
    window.onSpotifyIframeApiReady = function(API){ SP.api = API; var w = SP.wait; SP.wait = []; SP.fail = []; w.forEach(function(f){ f(API); }); };
    var sc = document.createElement("script"); sc.async = true; sc.src = window.__spotifyApi || "https://open.spotify.com/embed/iframe-api/v1";
    sc.onerror = function(){ SP.loading = false; var f = SP.fail; SP.wait = []; SP.fail = []; f.forEach(function(g){ g(); }); };
    document.head.appendChild(sc);
  }
  function npPlace(s, target){
    if (!s || s.kind !== "embed") return;
    var b = s.box, st = $("stage").getBoundingClientRect();
    if (!target || !target.isConnected || target.offsetParent === null){ b.style.cssText = "left:-10000px;top:0;width:320px;height:180px"; return; }   // off screen, still playing
    var r = target.getBoundingClientRect();
    b.style.cssText = "left:" + (r.left - st.left) + "px;top:" + (r.top - st.top) + "px;width:" + r.width + "px;height:" + r.height + "px;z-index:" + (target.id === "npMiniSlot" ? 26 : 24);   // in the mini-player: above its panel
  }
  function npLoop(){
    if (npRAF) return;
    (function tick(){
      if (!NP && !CUR){ npRAF = 0; return; }
      if (CUR && CUR.kind === "embed") npPlace(CUR, $("npSlot"));
      if (NP && NP.kind === "embed") npPlace(NP, $("npMiniSlot"));
      npRAF = requestAnimationFrame(tick);
    })();
  }
  function npKill(s){ if (!s) return; if (s.kind === "embed"){ if (s.ctl) try { s.ctl.destroy(); } catch(e){} s.box.remove(); } else { try { s.el.pause(); } catch(e){} s.el.removeAttribute("src"); try { s.el.load(); } catch(e){} s.el.remove(); } }
  // Leaving the current page: keep its media going in the mini-player if it is playing
  function npLeave(next){
    var s = CUR; CUR = null;
    if (!s) return;
    if (npOn() && next !== s.i && npPlaying(s) && npAllowed(s.i)){
      if (NP && NP !== s) npKill(NP);
      NP = s;
      if (s.kind === "media"){ s.el.controls = false; $("npMiniSlot").appendChild(s.el); s.el.addEventListener("click", npClickToggle); }
      npPaint(); npLoop();
    } else if (s !== NP) npKill(s);
  }
  // Opening a page whose media is the one in the mini-player: hand it back to the page
  function npTake(i){
    if (NP && NP.i === i){ CUR = NP; NP = null; if (CUR.kind === "media"){ CUR.el.controls = true; CUR.el.removeEventListener("click", npClickToggle); } npPaint(); return CUR; }
    return null;
  }
  function npClickToggle(){ if (NP && NP.el === this) npToggle(NP); }
  function npClose(){ if (NP){ npKill(NP); NP = null; } npHidden = false; $("npQ").hidden = true; npPaint(); }
  function npStopAll(){ npClose(); if (CUR){ npKill(CUR); CUR = null; } }
  function npToggle(s){
    s = s || NP; if (!s) return;
    var play = !npPlaying(s);
    if (s.kind === "media"){ if (play) s.el.play().catch(function(){}); else s.el.pause(); return; }
    if (s.ctl){ if (play) s.ctl.resume(); else s.ctl.pause(); return; }
    if (!s.el) return;
    if (/spotify/i.test(s.svc) || /open\.spotify\.com/.test(s.el.src)) s.el.contentWindow.postMessage({command: play ? "resume" : "pause"}, "*");
    else npSend(s, play ? "play" : "pause");
  }
  function npQuiet(){ [NP, CUR].forEach(function(s){ if (!s || !npPlaying(s)) return; if (npCtl(s)) npToggle(s); else if (s === NP) npClose(); }); }   // closed-book activity starting
  // Player preferences on this device: repeat, shuffle, volume, hidden; position resume for uploaded media
  function npPref(){ try { return JSON.parse(localStorage.getItem("portal-np:" + D.id) || "{}") || {}; } catch(e){ return {}; } }
  function npPrefSet(k, v){ var o = npPref(); o[k] = v; try { localStorage.setItem("portal-np:" + D.id, JSON.stringify(o)); } catch(e){} }
  function npPosKey(p){ return p.sid || p.t; }
  function npPosK(s){ var p = pages[s.i]; return p ? npPosKey(p) + (npIsPl(s) ? "#" + s.tr : "") : ""; }   // playlists: one position per track ("" after sign-out)
  function npPosGetK(k){ try { return (JSON.parse(localStorage.getItem("portal-npos:" + D.id) || "{}") || {})[k] || 0; } catch(e){ return 0; } }
  function npPosSetK(k, t){ if (!k) return; try { var o = JSON.parse(localStorage.getItem("portal-npos:" + D.id) || "{}") || {}; if (t > 0) o[k] = Math.round(t); else delete o[k]; localStorage.setItem("portal-npos:" + D.id, JSON.stringify(o)); } catch(e){} }
  function npIsPl(s){ return !!(s && s.kind === "media" && pages[s.i] && pages[s.i].k === "playlist"); }
  function npPosGet(p){ try { return (JSON.parse(localStorage.getItem("portal-npos:" + D.id) || "{}") || {})[npPosKey(p)] || 0; } catch(e){ return 0; } }
  function npPosSet(p, t){ try { var o = JSON.parse(localStorage.getItem("portal-npos:" + D.id) || "{}") || {}; if (t > 0) o[npPosKey(p)] = Math.round(t); else delete o[npPosKey(p)]; localStorage.setItem("portal-npos:" + D.id, JSON.stringify(o)); } catch(e){} }
  var npHidden = false, TIMER = null;
  function npLarge(){ try { return localStorage.getItem("portal-np-lg:" + D.id) === "1"; } catch(e){ return false; } }
  function npPos(){ try { return localStorage.getItem("portal-np-pos:" + D.id) || "br"; } catch(e){ return "br"; } }
  // What the mini-player knows and can do for the item now in it
  function npInfo(s){
    var o = {t: 0, d: 0, muted: null, seek: false, rate: false, pip: false, list: false};
    if (!s) return o;
    if (s.kind === "media"){
      var e = s.el; o.t = e.currentTime || 0; o.d = isFinite(e.duration) ? e.duration : 0; o.muted = e.muted; o.seek = o.d > 0; o.rate = true; o.vol = e.muted ? 0 : e.volume;
      o.pip = pages[s.i].k === "video" && !!document.pictureInPictureEnabled && !e.disablePictureInPicture; o.list = pages[s.i].k === "audio" || pages[s.i].k === "playlist";
      o.nx = o.list || (pages[s.i].k === "video" && npSection(s.i).length > 1);
      return o;
    }
    if (s.d){ o.d = s.d; o.t = Math.min(s.d, (s.t || 0) + (s.state === "playing" && s.tAt ? (performance.now() - s.tAt) / 1000 : 0)); o.seek = true; }
    if (s.muted != null && !s.ctl) o.muted = s.muted;
    if (s.vol != null && !s.ctl) o.vol = s.muted ? 0 : s.vol / 100;
    return o;
  }
  function npPaint(){
    lgMove();
    var m = $("npMini"), c = $("npChip");
    if (!NP){ m.hidden = true; c.hidden = true; return; }
    var p = pages[NP.i], on = npPlaying(NP), ctl = npCtl(NP), k = npKind(p), up = p.k === "video", slim = npMode() === "listen", listen = up && slim, yt = npYT(p), inf = npInfo(NP);
    m.hidden = false; c.hidden = false;
    m.className = "npmini " + k + (NP.kind === "media" ? " npmedia" : "") + (yt ? " yt" : "") + (listen ? " small" : "") + (slim ? " slim" : "") + (npLarge() && !slim ? " lg" : "") + (ctl ? "" : " nocl") +
                  (npPos() !== "br" ? " pos-" + npPos() : "");
    var ttl = npIsPl(NP) && p.tr[NP.tr] ? p.tr[NP.tr].t : NP.pl && NP.title ? NP.title : p.t;
    $("npT").textContent = ttl; $("npChipT").textContent = ttl; $("npT").title = "Go to “" + p.t + "”";
    var nart = p.k === "playlist" ? (on && plAnim(p) || plOwn(p)) : ""; if ($("npArt").getAttribute("src") !== nart){ if (nart) $("npArt").src = nart; else $("npArt").removeAttribute("src"); } $("npArt").hidden = !nart;
    [$("npPP"), $("npChipPP")].forEach(function(b){ b.hidden = !ctl; b.innerHTML = on ? NP_ICO.pause : NP_ICO.play; b.setAttribute("aria-label", on ? "Pause" : "Play"); b.title = on ? "Pause" : "Play"; });
    $("npChip").classList.toggle("on", on);
    var sz = $("npSize"); sz.hidden = false;                                 // full player ↔ slim bar (any media; YouTube/Spotify keep their picture)
    sz.innerHTML = slim ? NP_ICO.full : NP_ICO.slim;
    sz.title = slim ? "Full player — " + (up || yt || k === "vid" ? "show the video and " : "show ") + "all controls (V)" : "Slim bar — " + (up ? "hide the video, " : "") + "just play/pause and progress (V)";
    sz.setAttribute("aria-label", sz.title); sz.setAttribute("aria-pressed", slim);
    npModePaint();
    var lg = $("npLg"); lg.hidden = k !== "vid" || slim;                   // videos: larger / smaller player
    lg.innerHTML = npLarge() ? NP_ICO.shrink : NP_ICO.grow; lg.title = npLarge() ? "Smaller player" : "Larger player"; lg.setAttribute("aria-label", lg.title);
    $("npOpen").innerHTML = NP_ICO.open;
    $("npTag").hidden = !NP.preview;
    $("npPrev").innerHTML = NP_ICO.prev; $("npNext").innerHTML = NP_ICO.next; $("npBack").innerHTML = NP_ICO.back; $("npFwd").innerHTML = NP_ICO.fwd; $("npPip").innerHTML = NP_ICO.pip;
    $("npPrev").hidden = NP.kind !== "media" && !NP.pl; $("npNext").hidden = !inf.nx && !NP.pl; $("npNext").disabled = NP.pl ? false : npPickS(NP, 1, false) < 0;
    $("npBack").hidden = $("npFwd").hidden = !inf.seek;
    $("npMute").hidden = inf.muted == null; $("npMute").innerHTML = inf.muted ? NP_ICO.mute : NP_ICO.vol; $("npMute").title = inf.muted ? "Unmute" : "Mute"; $("npMute").setAttribute("aria-label", $("npMute").title);
    $("npRate").hidden = !inf.rate; if (inf.rate) $("npRate").textContent = (NP.el.playbackRate || 1) + "×";
    $("npPip").hidden = !inf.pip;
