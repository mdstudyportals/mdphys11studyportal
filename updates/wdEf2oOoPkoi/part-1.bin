  // Drag the player by its top bar; it settles in the nearest corner (remembered on this device)
  (function(){
    var bar = $("npDrag"), m = $("npMini"), st = null;
    bar.addEventListener("pointerdown", function(e){                      // the title can be grabbed too; a plain tap still opens the page
      if (e.button) return; var b = e.target.closest("button"); if (b && b.id !== "npT") return;
      var r = m.getBoundingClientRect(), sr = $("stage").getBoundingClientRect();
      st = {x: e.clientX, y: e.clientY, l: r.left - sr.left, t: r.top - sr.top, moved: false, id: e.pointerId};
