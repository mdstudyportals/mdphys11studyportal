  function thReach(c, bg, min){                                              // darken (or lighten on a dark page) until readable
    var to = thLum(bg) > .3 ? [0, 0, 0] : [255, 255, 255], k = 0;
    while (thCon(c, bg) < min && k++ < 12) c = thMix(c, to, .12);
    return c;
  }
  function thSense(doc){
    var w = doc && doc.defaultView, b = doc && doc.body; if (!w || !b) return null;
    var cs = function(e){ return w.getComputedStyle(e); }, R = cs(doc.documentElement), B = cs(b), vars = {}, faces = {}, faceCss = {}, okC = null, okBg = null;
    var solid = function(c){ return c && c[3] > .55 ? c : null; };
    try {
      [].forEach.call(doc.styleSheets, function(sh){
        var rules; try { rules = sh.cssRules; } catch(e){ return; }
        for (var r = 0; rules && r < rules.length && r < 4000; r++){
          var ru = rules[r];
          if (ru.type === 5 && ru.style){ var fnm = String(ru.style.getPropertyValue("font-family")).replace(/["']/g, "").trim().toLowerCase(); faces[fnm] = 1; if (/url\(\s*["']?data:/i.test(ru.cssText) || !/url\(/i.test(ru.cssText)) faceCss[fnm] = (faceCss[fnm] || "") + ru.cssText + "\n"; continue; }
          if (ru.style && /\.(right|correct|ok)\b/.test(ru.selectorText || "") && !/dark/i.test(ru.selectorText)){
            ["color", "border-color", "border-left-color", "background-color", "background"].forEach(function(pp){ var v = thCol(ru.style.getPropertyValue(pp)); if (!v || v[3] < .55 || thSat(v) < .2) return; var l = thLum(v); if (l < .3 && !okC) okC = v; else if (l > .7 && !okBg) okBg = v; });
          }
          if (!ru.style || !/(^|,)\s*(:root|html|body)\s*(,|$)/i.test(ru.selectorText || "")) continue;
          for (var k = 0; k < ru.style.length; k++){
            var n = ru.style[k]; if (n.slice(0, 2) !== "--" || n in vars) continue;
            var c = solid(thCol(R.getPropertyValue(n) || B.getPropertyValue(n))); if (c) vars[n] = c;
          }
        }
      });
    } catch(e){}
    var pick = function(re){ for (var n in vars) if (re.test(n)) return vars[n]; return null; };
    var bg = solid(thCol(B.backgroundColor)) || solid(thCol(R.backgroundColor)) || pick(/^--(bg|background|paper|page)$/i) || [255, 255, 255, 1];
    var text = solid(thCol(B.color)) || pick(/^--(ink|text|fg|foreground)$/i) || [30, 30, 30, 1];
    if (thCon(text, bg) < 4.5) text = thOn(bg);
    // the accent: the most colourful colour the lesson uses for headings, links, buttons, bands and its own colour variables
    var score = {}, add = function(c, wt){ c = solid(c); if (!c) return; var s = thSat(c); if (s < .2) return; var l = thLum(c); if (l > .85 || l < .004) return;
      var key = c.slice(0, 3).join(","); score[key] = score[key] || {c: c, s: 0}; score[key].s += wt * s * (thCon(c, bg) >= 2 ? 1 : .35); };
    for (var n in vars){ var wt = /primary|accent|brand|main|theme|key|highlight/i.test(n) ? 6 : /soft|light|pale|bg|paper|line|shadow|card|white|black|muted|hl\b/i.test(n) ? .3 : 2; add(vars[n], wt); }
    var els = doc.querySelectorAll("h1,h2,h3,h4,a[href],button,.btn,header,nav,.hero,.banner,.masthead,th,blockquote,.callout,.note,aside,summary,strong,.badge,.pill,.tag,[class*=title]");
    for (var e = 0; e < els.length && e < 500; e++){
      var el = els[e], st = cs(el), tg = el.tagName;
      add(thCol(st.color), /^H[1-3]$/.test(tg) ? 3 : tg === "A" ? 2 : 1);
      add(thCol(st.backgroundColor), /^(BUTTON|HEADER|NAV|TH)$/.test(tg) || /btn|hero|banner|masthead/.test(el.className) ? 3 : 1);
      if (parseFloat(st.borderLeftWidth) >= 3) add(thCol(st.borderLeftColor), 1);
      if (parseFloat(st.borderBottomWidth) >= 2) add(thCol(st.borderBottomColor), 1);
    }
    var best = null; for (var k2 in score) if (!best || score[k2].s > best.s) best = score[k2];
    var accent = best ? thReach(best.c, bg, 3) : text;
    // the header band: the lesson's own coloured header if it has one, else a deep shade of the accent
    var head = null, area = 0, bands = doc.querySelectorAll("header,.hero,.banner,.masthead,.cover,.title-slide,[class*=header],[class*=hero]");
    for (var h = 0; h < bands.length && h < 60; h++){
      var hs = cs(bands[h]), hc = solid(thCol(hs.backgroundColor)), a = bands[h].offsetWidth * bands[h].offsetHeight;
      if (hc && thCon(hc, bg) >= 1.6 && a > area){ head = hc; area = a; }
    }
    if (!head){ var deep = null; for (var n2 in vars) if (/deep|dark/i.test(n2) && thSat(vars[n2]) >= .2){ deep = vars[n2]; break; } head = deep || (best ? thMix(best.c, [0, 0, 0], .3) : thMix(bg, text, .85)); }
    var headText = thOn(head), hl = null, hb = 0;                          // a second colour for SYNAPSE's highlights (logo, initials)
    for (var k3 in score){ var o = score[k3]; if (best && Math.min(Math.abs(thHue(o.c) - thHue(best.c)), 360 - Math.abs(thHue(o.c) - thHue(best.c))) < 35) continue;
      if (thCon(o.c, head) >= 3 && o.s > hb){ hl = o.c; hb = o.s; } }
    var surface = pick(/^--(card|surface|panel|white|slide)$/i), cards = doc.querySelectorAll(".card,.panel,article,.box,.concept-card,section"), rad = "";
    for (var q = 0; q < cards.length && q < 80; q++){ var qs = cs(cards[q]), qc = solid(thCol(qs.backgroundColor)); if (!rad && /^\d+(\.\d+)?px$/.test(qs.borderTopLeftRadius) && parseFloat(qs.borderTopLeftRadius) > 0) rad = qs.borderTopLeftRadius; if (!surface && qc && thCon(qc, bg) < 1.6) surface = qc; }
    if (!surface || thCon(text, surface) < 4.5) surface = thMix(bg, thLum(bg) > .3 ? [255, 255, 255] : [0, 0, 0], .5);
    var line = pick(/^--(line|border|rule|hair)/i) || thMix(text, bg, .85), muted = pick(/^--(muted|text-muted|subtle|soft-ink|gray|grey)$/i);
    if (!muted || thCon(muted, bg) < 3.5) muted = thMix(text, bg, .38);
    var font = String(B.fontFamily || "").split(",").map(function(f){ return f.trim(); }).filter(function(f){ return f && !faces[f.replace(/["']/g, "").toLowerCase()]; }).join(", ");
    var t = {background: thStr(bg), surface: thStr(surface), text: thStr(text), muted: thStr(muted), accent: thStr(accent), accentText: thStr(thOn(accent)),
             header: thStr(head), headerText: thStr(headText), border: thStr(line)};
