    wnOpened(i); fmSeen(i);
    $("prev").disabled = i === 0; $("next").disabled = i === pages.length - 1;
    $("fsPrev").disabled = i === 0; $("fsNext").disabled = i === pages.length - 1;
    $("fsTitle").textContent = p.t || ("Item " + (i+1)); $("fsPos").textContent = (i+1) + " / " + pages.length;
    wake(); rqPaint(); paintRq();
