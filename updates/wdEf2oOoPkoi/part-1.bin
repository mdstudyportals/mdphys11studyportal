    }
    if (NP) npTimerPaint(); else { var c = $("npChipTm"); c.hidden = true; }
  }, 1000);
  window.addEventListener("message", function(e){
    var d = e.data, s = [CUR, NP].filter(function(x){ return x && x.kind === "embed" && !x.ctl && x.el && x.el.contentWindow === e.source; })[0];
    if (!s || !d) return;
    if (typeof d === "string"){ try { d = JSON.parse(d); } catch(x){ return; } }
    var was0 = s.state;
    if (d.portalYT && d.state){                                               // YouTube, through the player page
      s.state = d.state === "playing" ? "playing" : "paused";
      if (typeof d.t === "number"){ s.t = d.t; s.tAt = performance.now(); } if (d.d) s.d = d.d; if (typeof d.muted === "boolean") s.muted = d.muted; if (typeof d.vol === "number") s.vol = d.vol;
      if (d.pl) s.pl = true; if (typeof d.title === "string") s.title = d.title.slice(0, 120);       // an online playlist page (see the builder's guide)
    }
    else if (s.dir === "yt" && /^(infoDelivery|onStateChange|initialDelivery)$/.test(d.event || "")){     // YouTube straight in the portal
      var inf = d.event === "onStateChange" ? {playerState: d.info} : (d.info || {}), ps = inf.playerState;
      if (typeof ps === "number") s.state = ps === 1 || ps === 3 ? "playing" : "paused";
      else if (s.state == null) s.state = "paused";                       // it answers: we can follow and control it from now on
      if (typeof inf.currentTime === "number"){ s.t = inf.currentTime; s.tAt = performance.now(); } if (inf.duration > 0) s.d = inf.duration;
      if (typeof inf.muted === "boolean") s.muted = inf.muted; if (typeof inf.volume === "number") s.vol = inf.volume;
      if (inf.videoData && typeof inf.videoData.title === "string" && inf.videoData.title) s.title = inf.videoData.title.slice(0, 120);
      if (Array.isArray(inf.playlist) && inf.playlist.length > 1) s.pl = true;
    }
    else if (s.dir === "vm" && typeof d.event === "string"){                // Vimeo straight in the portal
      var vd = d.data || {};
      if (d.event === "ready"){ npHello(s); if (s.state == null) s.state = "paused"; }
      else if (d.event === "play" || d.event === "playing") s.state = "playing";
      else if (/^(pause|ended|finish)$/.test(d.event)) s.state = "paused";
      else if (d.event === "timeupdate" || d.event === "playProgress"){ if (s.state == null) s.state = "paused"; }
      else if (d.event === "volumechange"){ if (typeof vd.volume === "number"){ s.vol = Math.round(vd.volume * 100); s.muted = vd.volume === 0; } }
      else return;
