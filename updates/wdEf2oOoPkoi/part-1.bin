    K.fb = bst.fontFamily; K.fh = hs.fontFamily; K.hw = hs.fontWeight; K.hls = hs.letterSpacing === "normal" ? "normal" : hs.letterSpacing;
    K.fs = Math.max(15, Math.min(17.5, px(bst.fontSize) || 16)) + "px";
    // kicker / eyebrow
    var kick = first([".kicker", ".eyebrow", ".overline", "[class*=kicker]", "[class*=eyebrow]"], avoid) || scan(doc.body, avoid, upper);
    if (kick){ var ks = cs(kick); K.fl = ks.fontFamily; K.kc = thStr(solid(ks.color) || c.accent); K.kls = ks.letterSpacing; K.kfs = Math.min(13, px(ks.fontSize) || 11.5) + "px"; K.kfw = ks.fontWeight; }
    else { var lab = first(["button", "th", "label", "nav a"], avoid); if (lab) K.fl = cs(lab).fontFamily; }
    // masthead: a heavy rule on top, a finer one below; subtitle style
    var mast = first([".mast", ".masthead", ".doc-head", ".title-block", "header"], avoid, function(el, st){ return px(st.borderTopWidth) >= 3 || px(st.borderBottomWidth) >= 2; });
    if (mast){ var ms = cs(mast); if (px(ms.borderTopWidth) >= 3 && solid(ms.borderTopColor)) K.mast = ms.borderTopWidth + " solid " + thStr(solid(ms.borderTopColor)); if (px(ms.borderBottomWidth) >= 1 && solid(ms.borderBottomColor)) K.rule = ms.borderBottomWidth + " solid " + thStr(solid(ms.borderBottomColor)); }
    if (!K.rule){ var hd2 = first([".chead", ".section-head", "h2", "h3"], avoid, function(el, st){ return px(st.borderBottomWidth) >= 2 && solid(st.borderBottomColor); }); if (hd2){ var h2s = cs(hd2); K.rule = h2s.borderBottomWidth + " solid " + thStr(solid(h2s.borderBottomColor)); } }
    var sub = first([".mast .sub", ".subtitle", ".sub", ".lede", ".intro", ".standfirst"], avoid);
    if (sub){ var ss = cs(sub); K["sub-c"] = thStr(solid(ss.color) || c.text); K["sub-st"] = ss.fontStyle; K["sub-f"] = ss.fontFamily; }
    // cards, small stat boxes, number chips
    var pan = first([".panel", ".card", ".box", ".concept-card", "article"], avoid, function(el, st){ return px(st.borderTopWidth) > 0 || solid(st.backgroundColor) || st.boxShadow !== "none"; });
    if (pan){ var ps = cs(pan); K.pbg = thStr(solid(ps.backgroundColor) || c.bg); K.pbd = px(ps.borderTopWidth) ? ps.borderTopWidth + " " + ps.borderTopStyle + " " + thStr(solid(ps.borderTopColor) || c.text) : "0 solid transparent"; K.prad = ps.borderTopLeftRadius; if (ps.boxShadow !== "none") K.psh = ps.boxShadow; }
    var mini = first([".mini", ".stat", ".metric", "[class*=mini]", "[class*=stat]", ".tile"], avoid, function(el, st){ return px(st.borderTopWidth) >= 2 && solid(st.borderTopColor); });
    if (mini){ var mi = cs(mini); K.mtop = mi.borderTopWidth + " solid " + thStr(solid(mi.borderTopColor)); K.mrad = mi.borderTopLeftRadius; }
    var chip = first([".cnum", ".num", ".badge", ".chip", "[class*=num]", "[class*=badge]"], avoid, function(el, st){ return !!solid(st.backgroundColor) && thSat(solid(st.backgroundColor)) > .15; });
    if (chip){ var cp = cs(chip); K["chip-bg"] = thStr(solid(cp.backgroundColor)); K["chip-fg"] = thStr(solid(cp.color) || [255, 255, 255, 1]); K["chip-rad"] = cp.borderTopLeftRadius; }
    // notes: key-point box; callout with a coloured edge; aside / pitfall
    var note = first([".keys", ".key-points", ".keypoints", ".takeaway", ".summary", ".note", ".tip", ".eq"], avoid, function(el, st){ var x = solid(st.backgroundColor); return x && thCon(x, c.bg) > 1.03; });
    if (note){ var ns = cs(note); K["note-bg"] = thStr(solid(ns.backgroundColor)); K["note-bd"] = px(ns.borderTopWidth) ? ns.borderTopWidth + " solid " + thStr(solid(ns.borderTopColor) || c.text) : "0 solid transparent"; K["note-rad"] = ns.borderTopLeftRadius;
      var nk = scan(note, null, upper); if (nk) K["note-k"] = thStr(solid(cs(nk).color) || c.accent); }
    function edge(sels){ return first(sels, avoid, function(el, st){ return px(st.borderLeftWidth) >= 3 && solid(st.borderLeftColor); }); }
    var co = edge([".clinical", ".case", ".callout", ".important", "blockquote", "aside"]);
    if (co){ var cos = cs(co); K["co-bg"] = thStr(solid(cos.backgroundColor) || c.bg); K["co-l"] = cos.borderLeftWidth + " solid " + thStr(solid(cos.borderLeftColor)); }
    var pit = edge([".pitfall", ".caution", ".aside", ".tip", ".note", "blockquote"]);
    if (pit && pit !== co){ var pts = cs(pit); K["pit-bg"] = thStr(solid(pts.backgroundColor) || c.bg); K["pit-l"] = pts.borderLeftWidth + " solid " + thStr(solid(pts.borderLeftColor)); }
    var th = first(["th"], avoid, function(el, st){ return !!solid(st.backgroundColor); });
    if (th){ var ts = cs(th); K["th-bg"] = thStr(solid(ts.backgroundColor)); K["th-fg"] = thStr(solid(ts.color) || thOn(solid(ts.backgroundColor))); }
    var mk = first(["mark"], null); if (mk){ var mks = cs(mk); if (/gradient/.test(mks.backgroundImage)) K.mark = mks.backgroundImage; }
    // buttons: the main one (solid, coloured) and a quiet one
    var b1 = first(["button.primary", ".btn-primary", "#next", "button.next", ".next", "[class*=next]", "button", "a.btn", ".btn"], avoid, function(el, st){ var x = solid(st.backgroundColor); return x && thSat(x) > .2 && thCon(x, c.bg) >= 3; });
    if (b1){ var b1s = cs(b1); K["b1-bg"] = thStr(solid(b1s.backgroundColor)); K["b1-fg"] = thStr(solid(b1s.color) || thOn(solid(b1s.backgroundColor))); K["b1-rad"] = b1s.borderTopLeftRadius; K["b1-w"] = b1s.fontWeight; if (b1s.boxShadow !== "none") K["b1-sh"] = b1s.boxShadow; K["b1-f"] = b1s.fontFamily; }
    var b2 = first(["button.secondary", ".btn-secondary", "#back", "button.back", ".back", "[class*=back]", "button.ghost", ".btn-ghost"], avoid, function(el, st){ var x = solid(st.backgroundColor); return !x || thSat(x) < .25; });
    if (b2){ var b2s = cs(b2); K["b2-bg"] = thStr(solid(b2s.backgroundColor) || c.bg); K["b2-fg"] = thStr(solid(b2s.color) || c.text); K["b2-bd"] = px(b2s.borderTopWidth) ? b2s.borderTopWidth + " solid " + thStr(solid(b2s.borderTopColor) || c.text) : "1px solid " + thStr(thMix(c.text, c.bg, .8)); K["b2-rad"] = b2s.borderTopLeftRadius; }
    // the cover: its background (gradient), kicker, text and its button
